@@ -158,6 +167,62 @@ pub fn clear(self: *Timers, id: u32) void {
     sc.value.removed = true;
 }
 
+fn animationFrame(self: *Timers, exec: *js.Execution) !*AnimationFrame {
+    if (self._animation_frame) |frame| {
+        frame.references += 1;
+        return frame;
+    }
+
+    const arena = try exec.getArena(.tiny, "Timers.animationFrame");
+    errdefer arena.release();
+    const frame = try arena.create(AnimationFrame);
+    const now = lp.datetime.milliTimestamp(.boot);
+    const epoch = self._animation_epoch_ms orelse now;
+    self._animation_epoch_ms = epoch;
+    // Quantize a 60 Hz display to the scheduler's millisecond deadlines,
+    // retaining the phase instead of accumulating a fixed 17 ms delay.
+    const tick = (now - epoch) * 60 / 1000 + 1;
+    frame.* = .{
+        .timers = self,
+        .arena = arena,
+        .deadline_ms = epoch + (tick * 1000 + 59) / 60,
+    };
+    self._animation_frame = frame;
+    return frame;
+}
+
+const AnimationFrame = struct {
+    timers: *Timers,
+    arena: *lp.Arena,
+    deadline_ms: u64,
+    references: usize = 1,
+    timestamp: ?f64 = null,
+
+    fn release(self: *AnimationFrame) void {
+        self.references -= 1;
+        if (self.references == 0) {
+            if (self.timers._animation_frame == self) {
+                self.timers._animation_frame = null;
+            }
+            self.arena.release();
+        }
+    }
+
+    fn time(self: *AnimationFrame, exec: *js.Execution) f64 {
+        if (self.timestamp) |timestamp| return timestamp;
+        const timestamp = switch (exec.js.global) {
+            .frame => |frame| frame.window._performance.now(),
+            .worker => |worker| worker._performance.now(),
+        };
+        self.timestamp = timestamp;
+        // Requests from a callback or its microtasks belong to a later frame.
+        if (self.timers._animation_frame == self) {
+            self.timers._animation_frame = null;
+        }
+        return timestamp;
+    }
+};
+
