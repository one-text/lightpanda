 const DrawingContext = union(enum) {
     @"2d": *OffscreenCanvasRenderingContext2D,
+    webgl: *WebGLRenderingContext,
 };
 
 pub fn constructor(width: u32, height: u32, exec: *Execution) !*OffscreenCanvas {
@@ -55,7 +57,7 @@ pub fn getWidth(self: *const OffscreenCanvas) u32 {
 
 fn setWidth(self: *OffscreenCanvas, value: u32) void {
     self._width = value;
-    if (self._cached) |cached| cached.@"2d".reset();
+    self.resetBitmap();
 }
 
 pub fn getHeight(self: *const OffscreenCanvas) u32 {
@@ -64,13 +66,21 @@ pub fn getHeight(self: *const OffscreenCanvas) u32 {
 
 fn setHeight(self: *OffscreenCanvas, value: u32) void {
     self._height = value;
-    if (self._cached) |cached| cached.@"2d".reset();
+    self.resetBitmap();
+}
+
+fn resetBitmap(self: *OffscreenCanvas) void {
+    if (self._cached) |cached| switch (cached) {
+        .@"2d" => |ctx| ctx.reset(),
+        .webgl => {},
+    };
 }
 
 fn getContext(self: *OffscreenCanvas, context_type: []const u8, exec: *Execution) !?DrawingContext {
     if (self._cached) |cached| {
         return switch (cached) {
             .@"2d" => if (std.mem.eql(u8, context_type, "2d")) cached else null,
+            .webgl => if (std.mem.eql(u8, context_type, "webgl") or std.mem.eql(u8, context_type, "experimental-webgl")) cached else null,
         };
     }
 
@@ -80,6 +90,12 @@ fn getContext(self: *OffscreenCanvas, context_type: []const u8, exec: *Execution
         return self._cached;
     }
 
+    if (std.mem.eql(u8, context_type, "webgl") or std.mem.eql(u8, context_type, "experimental-webgl")) {
+        const ctx = try exec._factory.create(WebGLRenderingContext{ ._canvas = .{ .offscreen = self } });
+        self._cached = .{ .webgl = ctx };
+        return self._cached;
+    }
+
     return null;
 }
 
@@ -89,7 +105,10 @@ fn convertToBlob(self: *const OffscreenCanvas, exec: *Execution) !js.Promise {
     if (!Recording.hasBitmap(self._width, self._height)) {
         return error.IndexSizeError;
     }
-    const recording = if (self._cached) |cached| &cached.@"2d"._recording else &empty_recording;
+    const recording = if (self._cached) |cached| switch (cached) {
+        .@"2d" => |ctx| &ctx._recording,
+        .webgl => &empty_recording,
+    } else &empty_recording;
     const blob = try Blob.initFromBytes(try recording.png(self._width, self._height, exec), "image/png", exec);
     return exec.js.local.?.resolvePromise(blob);
 }
