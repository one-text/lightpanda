diff --git a/src/browser/webapi/Navigator.zig b/src/browser/webapi/Navigator.zig
index ca36bda..fe2010d 100644
--- a/src/browser/webapi/Navigator.zig
+++ b/src/browser/webapi/Navigator.zig
@@ -76,8 +76,10 @@ pub fn getAppCodeName(_: *const Navigator) []const u8 {
     return "Mozilla";
 }
 
-pub fn getAppVersion(_: *const Navigator) []const u8 {
-    return "1.0";
+pub fn getAppVersion(self: *const Navigator, exec: *const Execution) []const u8 {
+    const agent = self.getUserAgent(exec);
+    const start = if (std.mem.indexOfScalar(u8, agent, '/')) |index| index + 1 else 0;
+    return agent[start..];
 }
 
 pub fn getLanguage(self: *const Navigator, exec: *const Execution) []const u8 {
diff --git a/src/browser/webapi/WorkerNavigator.zig b/src/browser/webapi/WorkerNavigator.zig
