+pub fn init(text: ?js.Value, frame: *Frame) !*Utterance {
+    const value = if (text) |v| if (v.isUndefined()) "" else try domString(v) else "";
+    const arena = try frame.getArena(.small, "SpeechSynthesisUtterance");
+    errdefer arena.release();
+    const self = try frame._factory.eventTargetWithAllocator(arena.allocator(), Utterance{
+        ._proto = undefined,
+        ._arena = arena,
+        ._navigator = frame.window._navigator,
+        ._text = try arena.dupe(u8, value),
+        ._events = .init(arena.allocator()),
+    });
+    inline for (.{ "start", "end", "error", "pause", "resume", "mark", "boundary" }, 0..) |name, i| {
+        self._handlers[i] = .{ .target = self._proto, .events = &self._events, .name = name, .weak = true };
+    }
+    return self;
+}
+pub fn acquireRef(self: *Utterance) void {
+    self._rc.acquire();
+}
+pub fn releaseRef(self: *Utterance, page: *Page) void {
+    self._rc.release(self, page);
+}
+pub fn deinit(self: *Utterance, _: *Page) void {
+    for (&self._handlers) |*handler| handler.deinit();
+    for (self._listener_roots.items) |slot| slot.release();
+    self._arena.release();
+}
+
+pub fn registerListener(self: *Utterance, typ: []const u8, callback: EventManagerBase.Callback, options: EventManagerBase.RegisterOptions, exec: *js.Execution) !void {
+    try self._listener_roots.ensureUnusedCapacity(self._arena.allocator(), 1);
+    const listener = (try self._events.register(self._proto, typ, callback, options)) orelse return;
+    const slot = switch (listener.function) {
+        .value => |value| value.slot,
+        .object => |value| value.slot,
+        .string => unreachable,
+    };
+    errdefer {
+        self._events.remove(self._proto, typ, callback, options.capture);
+        slot.release();
+    }
+    const value = switch (callback) {
+        .function => |f| js.Value{ .local = f.local, .handle = @ptrCast(f.handle) },
+        .object => |o| o.toValue(),
+    };
+    const data = try Speech.callbackData(self._proto, exec.js.local.?);
+    var buf: [32]u8 = undefined;
+    const key = try std.fmt.bufPrint(&buf, "listener{d}", .{self._listener_roots.items.len});
+    if (!(data.defineOwnProperty(key, value, 0) orelse false)) return error.JsException;
+    js.v8.v8__Global__SetWeak(&slot.handle);
+    self._listener_roots.appendAssumeCapacity(slot);
+}
