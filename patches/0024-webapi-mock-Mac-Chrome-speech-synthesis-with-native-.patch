+const std = @import("std");
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Frame = @import("../Frame.zig");
+const Event = @import("Event.zig");
+const EventTarget = @import("EventTarget.zig");
+const EventManagerBase = @import("../EventManagerBase.zig");
+const Voice = @import("SpeechSynthesisVoice.zig");
+const Utterance = @import("SpeechSynthesisUtterance.zig");
+const SpeechEvent = @import("event/SpeechSynthesisEvent.zig");
+const Speech = @This();
+
+pub const Proto = EventTarget;
+_proto: *EventTarget,
+_frame: *Frame,
+_events: EventManagerBase,
+_handlers: [1]Handler = undefined,
+_voices: [Voice.inventory.len]*Voice = undefined,
+_loading: bool = false,
+_loaded: bool = false,
+_paused: bool = false,
+_detached: bool = false,
+_queue: std.DoublyLinkedList = .{},
+_current: ?*Entry = null,
+_generation: u64 = 0,
+
+pub fn init(frame: *Frame) !*Speech {
+    const self = try frame._factory.eventTarget(Speech{
+        ._proto = undefined,
+        ._frame = frame,
+        ._events = .init(frame.arena),
+    });
+    self._handlers[0] = .{ .target = self._proto, .events = &self._events, .name = "voiceschanged" };
+    for (Voice.inventory, 0..) |data, i| {
+        const voice = try frame.arena.create(Voice);
+        voice.* = .{ ._navigator = frame.window._navigator, ._data = data };
+        self._voices[i] = voice;
+    }
+    return self;
+}
+pub fn creationContext(self: *const Speech, local: *const js.Local) *const js.v8.Context {
+    return self._frame.window._navigator.creationContext(local);
+}
+pub fn dispatch(self: *Speech, event: *Event, exec: *js.Execution) !void {
+    try dispatchDirect(self._proto, &self._events, event, exec);
+}
+fn getVoices(self: *Speech) ![]const *Voice {
+    if (!self._loaded) {
+        if (!self._loading and !self._detached) {
+            try self.schedule(.voices, null, 0, null);
+            self._loading = true;
+        }
+        return &.{};
+    }
+    return &self._voices;
+}
+fn getPending(self: *const Speech) bool {
+    return self._queue.first != null;
+}
+fn getSpeaking(self: *const Speech) bool {
+    return self._current != null;
+}
+fn getPaused(self: *const Speech) bool {
+    return self._paused;
+}
+
+const Entry = struct {
+    node: std.DoublyLinkedList.Node = .{},
+    utterance: *Utterance,
+    root: ?js.Value.Global,
+    started: bool = false,
+    start_ms: u64 = 0,
+    active_ms: u64 = 0,
+    remaining_ms: u32 = 0,
+    char_count: u32 = 0,
+
+    fn release(self: *Entry) void {
+        if (self.root) |root| root.release();
+        self.root = null;
+    }
+};
+
+fn speak(self: *Speech, utterance: *Utterance, exec: *js.Execution) !void {
+    if (self._detached) return;
+    const entry = try self._frame.arena.create(Entry);
+    entry.* = .{ .utterance = utterance, .root = null };
+    entry.root = try (try exec.js.local.?.zigValueToJs(utterance, .{})).persist();
+    // Desktop Chrome requires sticky user activation, not a transient grant.
+    if (!self._frame.window._navigator._speech_has_activation) {
+        self.schedule(.failure, entry, 0, .@"not-allowed") catch |err| {
+            entry.release();
+            return err;
+        };
+        return;
+    }
+    self._queue.append(&entry.node);
+    try self.startNext();
+}
+fn startNext(self: *Speech) !void {
+    if (self._detached or self._paused or self._current != null) return;
+    const node = self._queue.popFirst() orelse return;
+    const entry: *Entry = @fieldParentPtr("node", node);
+    self._current = entry;
+    self._generation +%= 1;
+    self.schedule(.pump, entry, 0, null) catch |err| {
+        self._current = null;
+        entry.release();
+        return err;
+    };
+}
+fn cancel(self: *Speech) !void {
+    self._generation +%= 1;
+    const current = self._current;
+    self._current = null;
+    var queue = self._queue;
+    self._queue = .{};
+    var failure: ?anyerror = null;
+    if (current) |entry| {
+        if (entry.started and !self._paused) entry.active_ms += lp.datetime.milliTimestamp(.boot) - entry.start_ms;
+        self.schedule(.failure, entry, 0, if (entry.started) .interrupted else .canceled) catch |err| {
+            entry.release();
+            failure = err;
+        };
+    }
+    while (queue.popFirst()) |node| {
+        const entry: *Entry = @fieldParentPtr("node", node);
+        self.schedule(.failure, entry, 0, .canceled) catch |err| {
+            entry.release();
+            failure = err;
+        };
+    }
+    if (failure) |err| return err;
+}
+fn pause(self: *Speech) !void {
+    if (self._paused or self._detached) return;
+    self._paused = true;
+    self._generation +%= 1;
+    const entry = self._current orelse return;
+    if (entry.started) {
+        const elapsed = lp.datetime.milliTimestamp(.boot) - entry.start_ms;
+        const used = @min(elapsed, entry.remaining_ms);
+        entry.remaining_ms -= @intCast(used);
+        entry.active_ms += used;
+        try self.schedule(.pause, entry, 0, null);
+    }
+}
+fn @"resume"(self: *Speech) !void {
+    if (!self._paused) return;
+    self._paused = false;
+    self._generation +%= 1;
+    if (self._current) |entry| {
+        entry.start_ms = lp.datetime.milliTimestamp(.boot);
+        if (entry.started) try self.schedule(.@"resume", entry, 0, null);
+        try self.schedule(.pump, entry, if (entry.started) entry.remaining_ms else 0, null);
+    } else try self.startNext();
+}
+
+pub fn detach(self: *Speech) void {
+    self._detached = true;
+    self._generation +%= 1;
+    if (self._current) |entry| entry.release();
+    self._current = null;
+    while (self._queue.popFirst()) |node| {
+        const entry: *Entry = @fieldParentPtr("node", node);
+        entry.release();
+    }
+}
+
+const Kind = enum { voices, pump, pause, @"resume", failure };
+fn schedule(self: *Speech, kind: Kind, entry: ?*Entry, delay: u32, code: ?SpeechEvent.Code) !void {
+    const exec = &self._frame.js.execution;
+    const arena = try exec.getArena(.tiny, "SpeechSynthesis.task");
+    errdefer arena.release();
+    const task = try arena.create(Task);
+    task.* = .{ .speech = self, .arena = arena, .kind = kind, .entry = entry, .generation = self._generation, .code = code };
+    try exec.js.scheduler.add(task, Task.run, delay, .{
+        .name = "SpeechSynthesis",
+        .finalizer = Task.finalize,
+    });
+}
+
+const Task = struct {
+    speech: *Speech,
+    arena: *lp.Arena,
+    kind: Kind,
+    entry: ?*Entry,
+    generation: u64,
+    code: ?SpeechEvent.Code,
+
+    fn finalize(ctx: *anyopaque) void {
+        const task: *Task = @ptrCast(@alignCast(ctx));
+        if (task.kind == .failure) if (task.entry) |entry| {
+            entry.release();
+        };
+        task.arena.release();
+    }
+    fn run(ctx: *anyopaque) !?u32 {
+        const task: *Task = @ptrCast(@alignCast(ctx));
+        defer finalize(ctx);
+        const self = task.speech;
+        if (self._detached) return null;
+        var scope: js.Local.Scope = undefined;
+        self._frame.js.localScope(&scope);
+        defer scope.deinit();
+        const exec = &self._frame.js.execution;
+        defer scope.local.runMicrotasks();
+
+        if (task.kind == .voices) {
+            self._loaded = true;
+            self._loading = false;
+            const event = try Event.init("voiceschanged", null, exec.page);
+            event._is_trusted = true;
+            try self.dispatch(event, exec);
+            return null;
+        }
+        const entry = task.entry.?;
+        if (task.kind == .failure) {
+            const event = try SpeechEvent.create(SpeechEvent.ErrorEvent, "error", SpeechEvent.ErrorEvent.Options{
+                .utterance = entry.utterance,
+                .@"error" = scope.local.newString(@tagName(task.code.?)).toValue(),
+                .elapsedTime = @as(f32, @floatFromInt(entry.active_ms)) / 1000,
+            }, true, exec, &scope.local);
+            try entry.utterance.dispatch(event.asEvent(), exec);
+            return null;
+        }
+        if (self._current != entry) return null;
+        if (task.kind == .pause or task.kind == .@"resume") {
+            try emit(entry, if (task.kind == .pause) "pause" else "resume", false, exec, &scope.local);
+            return null;
+        }
+        if (task.generation != self._generation or self._paused) return null;
+        if (!entry.started) {
+            entry.started = true;
+            entry.start_ms = lp.datetime.milliTimestamp(.boot);
+            // Synthetic duration only: no PCM, phonemes, marks or word boundaries.
+            entry.char_count = @intCast(scope.local.newString(entry.utterance._text).len());
+            const duration = @as(f64, @floatFromInt(entry.char_count)) * 30 / entry.utterance._rate;
+            entry.remaining_ms = @intFromFloat(std.math.clamp(duration, 20, 2000));
+            self.schedule(.pump, entry, entry.remaining_ms, null) catch |err| {
+                self._current = null;
+                entry.release();
+                return err;
+            };
+            try emit(entry, "start", false, exec, &scope.local);
+        } else {
+            entry.active_ms += lp.datetime.milliTimestamp(.boot) - entry.start_ms;
+            self._current = null;
+            defer entry.release();
+            try emit(entry, "end", true, exec, &scope.local);
+            try self.startNext();
+        }
+        return null;
+    }
+};
+fn emit(entry: *Entry, typ: []const u8, finished: bool, exec: *js.Execution, local: *const js.Local) !void {
+    const event = try SpeechEvent.create(SpeechEvent, typ, SpeechEvent.Options{
+        .utterance = entry.utterance,
+        .charIndex = if (finished) entry.char_count else 0,
+        .elapsedTime = @as(f32, @floatFromInt(entry.active_ms)) / 1000,
+    }, true, exec, local);
+    try entry.utterance.dispatch(event.asEvent(), exec);
+}
+
+// Attribute listeners keep their insertion position when replaced.
+pub const Handler = struct {
+    target: *EventTarget,
+    events: *EventManagerBase,
+    name: []const u8,
+    callback: ?js.Object.Global = null,
+    listener: ?js.Function.Global = null,
+    registration: ?js.Function.Global = null,
+    weak: bool = false,
+
+    fn set(self: *Handler, value: js.Value, exec: *js.Execution) !void {
+        const local = exec.js.local.?;
+        const callback = if (value.isObject())
+            try (js.Object{ .local = local, .handle = @ptrCast(value.handle) }).persist()
+        else
+            null;
+        errdefer if (callback) |cb| cb.release();
+        if (self.weak) {
+            const data = try callbackData(self.target, local);
+            if (!(data.defineOwnProperty(self.name, value, 0) orelse false)) return error.JsException;
+            if (callback) |cb| js.v8.v8__Global__SetWeak(&cb.slot.handle);
+        }
+        if (self.callback == null and callback != null) {
+            if (self.listener == null) self.listener = try local.newCallback(Handler.invoke, self).persist();
+            if (try self.events.register(self.target, self.name, .{ .function = self.listener.?.local(local) }, .{})) |listener| {
+                self.registration = listener.function.value;
+            }
+        } else if (self.callback != null and callback == null) {
+            self.events.remove(self.target, self.name, .{ .function = self.listener.?.local(local) }, false);
+            if (self.registration) |registration| registration.release();
+            self.registration = null;
+        }
+        if (self.callback) |old| old.release();
+        self.callback = callback;
+    }
+    pub fn deinit(self: *Handler) void {
+        if (self.callback) |callback| callback.release();
+        if (self.listener) |listener| listener.release();
+        if (self.registration) |registration| registration.release();
+    }
+    fn invoke(self: *Handler, event: *Event, exec: *js.Execution) !void {
+        const callback = self.callback orelse return;
+        const object = callback.local(exec.js.local.?);
+        if (!object.toValue().isFunction()) return exec.js.local.?.typeError("The event handler is not callable");
+        const function = js.Function{ .local = exec.js.local.?, .handle = @ptrCast(object.handle) };
+        const result = try function.callWithThisRethrow(js.Value, self.target, .{event});
+        if (result.isBoolean() and result.isFalse()) event.preventDefault();
+    }
+};
+// JS owns callback edges so closures referring to their utterance form a
+// collectible JS cycle rather than a permanent native persistent root.
+pub fn callbackData(target: *EventTarget, local: *const js.Local) !js.Object {
+    const owner = try local.zigValueToJs(target, .{});
+    const key: *const js.v8.Private = @ptrCast(js.v8.v8__Global__Get(&local.ctx.env.private_symbols.speech_callbacks.handle, local.isolate.handle).?);
+    if (js.v8.v8__Object__GetPrivate(@ptrCast(owner.handle), local.handle, key)) |value| {
+        const wrapped = js.Value{ .local = local, .handle = @ptrCast(value) };
+        if (wrapped.isObject()) return .{ .local = local, .handle = @ptrCast(value) };
+    }
+    const data = local.newObject();
+    var saved: js.v8.MaybeBool = undefined;
+    js.v8.v8__Object__SetPrivate(@ptrCast(owner.handle), local.handle, key, @ptrCast(data.handle), &saved);
+    if (!saved.has_value or !saved.value) return error.JsException;
+    return data;
+}
+pub fn Binding(comptime T: type, comptime index: usize) type {
+    return struct {
+        pub fn get(self: *const T) ?js.Object.Global {
+            return self._handlers[index].callback;
+        }
+        pub fn set(self: *T, value: js.Value, exec: *js.Execution) !void {
+            try self._handlers[index].set(value, exec);
+        }
+    };
+}
+pub fn dispatchDirect(target: *EventTarget, events: *EventManagerBase, event: *Event, exec: *js.Execution) !void {
+    event.acquireRef();
+    defer event.releaseRef(exec.page);
+    event._target = target;
+    event._dispatch_target = target;
+    event._event_phase = .at_target;
+    defer {
+        event._event_phase = .none;
+        event._current_target = null;
+        event._dispatch_target = null;
+        event._stop_propagation = false;
+        event._stop_immediate_propagation = false;
+        event._in_passive_listener = false;
+    }
+    try events.dispatchDirect(exec.call_arena, exec.js, target, event, null, exec.page, .{ .run_microtasks = false });
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(Speech);
+    pub const Meta = struct {
+        pub const name = "SpeechSynthesis";
+        pub const creation_context = Speech.creationContext;
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const pending = bridge.accessor(getPending, null, .{});
+    pub const speaking = bridge.accessor(getSpeaking, null, .{});
+    pub const paused = bridge.accessor(getPaused, null, .{});
+    pub const onvoiceschanged = bridge.accessor(Binding(Speech, 0).get, Binding(Speech, 0).set, .{});
+    pub const getVoices = bridge.function(Speech.getVoices, .{});
+    pub const speak = bridge.function(Speech.speak, .{});
+    pub const cancel = bridge.function(Speech.cancel, .{});
+    pub const pause = bridge.function(Speech.pause, .{});
+    pub const @"resume" = bridge.function(Speech.@"resume", .{});
+};
