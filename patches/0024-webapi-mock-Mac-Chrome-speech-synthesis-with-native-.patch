+}
+pub fn domString(value: js.Value) ![]const u8 {
+    if (value.isSymbol()) return error.TypeError;
+    return value.toStringSlice();
+}
+fn getVoice(self: *const Utterance) ?*Voice {
+    return self._voice;
+}
+fn setVoice(self: *Utterance, value: js.Nullable(*Voice)) void {
+    self._voice = value.value;
+}
+
+fn Number(comptime field: []const u8, comptime min: f32, comptime max: f32) type {
+    return struct {
+        fn get(self: *const Utterance) f32 {
+            return @field(self, field);
+        }
+        fn set(self: *Utterance, value: f32) !void {
+            if (!std.math.isFinite(value)) return error.TypeError;
+            @field(self, field) = std.math.clamp(value, min, max);
+        }
+    };
+}
