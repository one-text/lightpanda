+        pub const maxStorageBuffersInVertexStage = bridge.accessor(struct {
+            fn get(_: *const Limits) u32 {
+                return 8;
+            }
+        }.get, null, .{});
+        pub const maxStorageTexturesInVertexStage = bridge.accessor(struct {
+            fn get(_: *const Limits) u32 {
+                return 4;
+            }
+        }.get, null, .{});
+    };
+};
+
+fn deviceDescriptor(input: ?js.Value) !void {
+    const descriptor = try Convert.dictionary(input) orelse return;
+    const label = try descriptor.get("label");
+    if (!label.isUndefined()) _ = try Convert.domString(label);
+    if (try Convert.dictionary(try descriptor.get("defaultQueue"))) |queue| {
+        const queue_label = try queue.get("label");
+        if (!queue_label.isUndefined()) _ = try Convert.domString(queue_label);
+    }
+    const features = try descriptor.get("requiredFeatures");
+    if (!features.isUndefined()) {
+        const iterator = try features.iterator() orelse return error.TypeError;
+        while (try iterator.next()) |entry| {
+            errdefer Convert.closeIterator(iterator, entry.local);
+            const text = try (try Convert.domString(entry)).toSlice();
+            if (!validFeature(text)) return error.TypeError;
+        }
+    }
+    const limits = try descriptor.get("requiredLimits");
+    if (!limits.isUndefined()) {
+        if (!limits.isObject()) return error.TypeError;
+        const local = limits.local;
+        const bindings = &(local.ctx.webgpu_bindings orelse return error.JsException);
+        const own_keys = js.Function{ .local = local, .handle = @ptrCast(v8.v8__Global__Get(&bindings[9], local.isolate.handle)) };
+        const key_array = try own_keys.callRethrow(js.Value, .{limits});
+        const keys = js.Array{ .local = local, .handle = @ptrCast(key_array.handle) };
+        for (0..keys.len()) |i| {
+            const key = try keys.get(@intCast(i));
+            const handle = v8.v8__Object__GetOwnPropertyDescriptor(limits.toObject().handle, local.handle, @ptrCast(key.handle)) orelse return error.JsException;
+            const descriptor_value = js.Value{ .local = local, .handle = handle };
+            if (descriptor_value.isUndefined()) continue;
+            if (!(try descriptor_value.toObject().get("enumerable")).toBool()) continue;
+            const name = try Convert.domString(key);
+            const member = try limits.toObject().get(name.handle);
+            if (member.isUndefined()) continue;
+            const value = try member.toF64();
+            // [EnforceRange] unsigned long long.
+            if (!std.math.isFinite(value) or @trunc(value) < 0 or @trunc(value) >= 18446744073709551616.0) return error.TypeError;
+        }
+    }
+}
+fn validFeature(text: []const u8) bool {
+    const extra = [_][]const u8{
+        "texture-compression-bc-sliced-3d",                    "texture-compression-astc-sliced-3d",
+        "float32-blendable",                                   "clip-distances",
+        "dual-source-blending",                                "texture-component-swizzle",
+        "texture-formats-tier1",                               "texture-formats-tier2",
+        "primitive-index",                                     "subgroup-size-control",
+        "atomic-vec2u-min-max",                                "chromium-experimental-sampling-resource-table",
+        "chromium-experimental-timestamp-query-inside-passes", "chromium-experimental-multi-draw-indirect",
+        "chromium-experimental-subgroup-matrix",               "texture-compression-unaligned",
+    };
+    for (feature_names ++ extra) |name| {
+        if (std.mem.eql(u8, text, name)) return true;
+    }
+    return false;
+}
+
+const interface_names = .{ "GPU", "GPUAdapter", "GPUAdapterInfo", "GPUSupportedFeatures", "GPUSupportedLimits", "WGSLLanguageFeatures" };
+
+pub fn capture(ctx: *js.Context, context: *const v8.Context, global: *const v8.Object, comptime navigator_name: []const u8) !void {
+    const isolate = ctx.isolate;
+    const key = isolate.initStringHandle("gpu");
+    const navigator = v8.v8__Object__Get(global, context, isolate.initStringHandle(navigator_name)) orelse return error.JsException;
+    const prototype = v8.v8__Object__Get(@ptrCast(navigator), context, isolate.initStringHandle("prototype")) orelse return error.JsException;
+    var bindings: [10]v8.Global = @splat(.{ .data_ptr = 0 });
+    errdefer for (&bindings) |*binding| v8.v8__Global__Reset(binding);
+    inline for (interface_names, 0..) |name, i| {
+        const constructor = v8.v8__Object__Get(global, context, isolate.initStringHandle(name)) orelse return error.JsException;
+        v8.v8__Global__New(isolate.handle, constructor, &bindings[i]);
+        if (comptime std.mem.eql(u8, name, "GPUSupportedFeatures") or std.mem.eql(u8, name, "WGSLLanguageFeatures")) {
+            const proto = v8.v8__Object__Get(@ptrCast(constructor), context, isolate.initStringHandle("prototype")) orelse return error.JsException;
+            const values = v8.v8__Object__Get(@ptrCast(proto), context, isolate.initStringHandle("values")) orelse return error.JsException;
+            var result: v8.MaybeBool = undefined;
+            v8.v8__Object__DefineOwnProperty(@ptrCast(proto), context, isolate.initStringHandle("keys"), values, v8.None, &result);
+            if (!result.has_value or !result.value) return error.JsException;
+            v8.v8__Object__DefineOwnProperty(@ptrCast(proto), context, @ptrCast(v8.v8__Symbol__GetIterator(isolate.handle)), values, v8.DontEnum, &result);
+            if (!result.has_value or !result.value) return error.JsException;
+        }
+    }
+    const descriptor = v8.v8__Object__GetOwnPropertyDescriptor(@ptrCast(prototype), context, key) orelse return error.JsException;
+    const object = v8.v8__Object__Get(global, context, isolate.initStringHandle("Object")) orelse return error.JsException;
+    const define = v8.v8__Object__Get(@ptrCast(object), context, isolate.initStringHandle("defineProperty")) orelse return error.JsException;
+    v8.v8__Global__New(isolate.handle, descriptor, &bindings[6]);
+    v8.v8__Global__New(isolate.handle, define, &bindings[7]);
+    v8.v8__Global__New(isolate.handle, prototype, &bindings[8]);
+    const reflect = v8.v8__Object__Get(global, context, isolate.initStringHandle("Reflect")) orelse return error.JsException;
+    const own_keys = v8.v8__Object__Get(@ptrCast(reflect), context, isolate.initStringHandle("ownKeys")) orelse return error.JsException;
+    v8.v8__Global__New(isolate.handle, own_keys, &bindings[9]);
+    ctx.webgpu_bindings = bindings;
+}
+
+pub fn expose(ctx: *js.Context, context: *const v8.Context, global: *const v8.Object, secure: bool) !void {
+    if (secure == !ctx.webgpu_hidden) return;
+    const isolate = ctx.isolate;
+    const bindings = &(ctx.webgpu_bindings orelse return error.JsException);
+    const prototype: *const v8.Object = @ptrCast(v8.v8__Global__Get(&bindings[8], isolate.handle));
+    var result: v8.MaybeBool = undefined;
+    if (secure) {
+        const define: *const v8.Function = @ptrCast(v8.v8__Global__Get(&bindings[7], isolate.handle));
+        const args = [_]?*const v8.Value{ @ptrCast(prototype), isolate.initStringHandle("gpu"), v8.v8__Global__Get(&bindings[6], isolate.handle) };
+        _ = v8.v8__Function__Call(define, context, @ptrCast(global), args.len, &args) orelse return error.JsException;
+    } else {
+        v8.v8__Object__Delete(prototype, context, isolate.initStringHandle("gpu"), &result);
+        if (!result.has_value or !result.value) return error.JsException;
+    }
+    inline for (interface_names, 0..) |name, i| {
+        const key = isolate.initStringHandle(name);
+        if (secure) {
+            v8.v8__Object__DefineOwnProperty(global, context, key, v8.v8__Global__Get(&bindings[i], isolate.handle), v8.DontEnum, &result);
+        } else {
+            v8.v8__Object__Delete(global, context, key, &result);
+        }
+        if (!result.has_value or !result.value) return error.JsException;
+    }
+    ctx.webgpu_hidden = !secure;
+}
+
+comptime {
+    if (@offsetOf(GPU, "_languages") == 0) @compileError("GPU aliases language features");
+    for (.{ "_features", "_limits", "_info" }) |field| {
+        if (@offsetOf(Adapter, field) == 0) @compileError("GPUAdapter aliases " ++ field);
+    }
+}
