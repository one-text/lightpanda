+// Chrome 155 discovery surface. Values are a conservative A18 Pro mock,
+// not measurements or a rendering backend.
+pub fn registerTypes() []const type {
+    return &.{ GPU, Adapter, Info, Features, Limits, LanguageFeatures, ValueIterator, PairIterator };
+}
+
+pub const GPU = struct {
+    _pad: bool = false,
+    _languages: LanguageFeatures = .{},
+
+    pub fn init(exec: *js.Execution) !*GPU {
+        return exec._factory.create(GPU{});
+    }
+    fn languages(self: *GPU) *LanguageFeatures {
+        return &self._languages;
+    }
+    fn format(_: *GPU) []const u8 {
+        return "bgra8unorm";
+    }
+    fn request(self: *GPU, input: ?js.Value, exec: *js.Execution) !js.Promise {
+        var caught: js.TryCatch = undefined;
+        caught.init(exec.js.local.?);
+        defer caught.deinit();
+        return self.adapter(input, exec) catch |err| reject(exec, &caught, err);
+    }
+    fn adapter(_: *GPU, input: ?js.Value, exec: *js.Execution) !js.Promise {
+        var fallback = false;
+        var supported = true;
+        if (try Convert.dictionary(input)) |options| {
+            const level = try options.get("featureLevel");
+            if (!level.isUndefined()) {
+                const text = try (try Convert.domString(level)).toSlice();
+                supported = std.mem.eql(u8, text, "core") or std.mem.eql(u8, text, "compatibility");
+            }
+            fallback = (try options.get("forceFallbackAdapter")).toBool();
+            const preference = try options.get("powerPreference");
+            if (!preference.isUndefined()) {
+                const text = try (try Convert.domString(preference)).toSlice();
+                if (!std.mem.eql(u8, text, "low-power") and !std.mem.eql(u8, text, "high-performance")) return error.TypeError;
+            }
+        }
+        const result = if (!fallback and supported) try exec._factory.create(Adapter{}) else null;
+        return resolved(exec, result);
+    }
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(GPU);
+        pub const Meta = struct {
+            pub const name = "GPU";
+            pub const prototype_chain = bridge.prototypeChain();
+            pub var class_id: bridge.ClassId = undefined;
+        };
+        pub const requestAdapter = bridge.function(GPU.request, .{});
+        pub const getPreferredCanvasFormat = bridge.function(GPU.format, .{});
+        pub const wgslLanguageFeatures = bridge.accessor(GPU.languages, null, .{});
+    };
+};
+
+pub const Adapter = struct {
+    _pad: bool = false,
+    _features: Features = .{},
+    _limits: Limits = .{},
+    _info: Info = .{},
+
+    fn features(self: *Adapter) *Features {
+        return &self._features;
+    }
+    fn limits(self: *Adapter) *Limits {
+        return &self._limits;
+    }
+    fn info(self: *Adapter) *Info {
+        return &self._info;
+    }
+    fn requestDevice(_: *Adapter, input: ?js.Value, exec: *js.Execution) !js.Promise {
+        var caught: js.TryCatch = undefined;
+        caught.init(exec.js.local.?);
+        defer caught.deinit();
+        deviceDescriptor(input) catch |err| return reject(exec, &caught, err);
+        const local = exec.js.local.?;
+        const resolver = local.createPromiseResolver();
+        const exception = try exec._factory.create(DOMException.init("WebGPU device execution is not implemented", "OperationError"));
+        try resolver.rejectValue(try local.zigValueToJs(exception, .{}));
+        return resolver.promise();
+    }
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(Adapter);
+        pub const Meta = struct {
+            pub const name = "GPUAdapter";
+            pub const prototype_chain = bridge.prototypeChain();
+            pub var class_id: bridge.ClassId = undefined;
+        };
+        pub const features = bridge.accessor(Adapter.features, null, .{});
+        pub const limits = bridge.accessor(Adapter.limits, null, .{});
+        pub const info = bridge.accessor(Adapter.info, null, .{});
+        pub const requestDevice = bridge.function(Adapter.requestDevice, .{});
+    };
+};
+
+fn resolved(exec: *js.Execution, value: anytype) !js.Promise {
+    const local = exec.js.local.?;
+    const resolver = local.createPromiseResolver();
+    try resolver.resolveValue(try local.zigValueToJs(value, .{}));
+    return resolver.promise();
+}
+fn reject(exec: *js.Execution, caught: *js.TryCatch, err: anyerror) !js.Promise {
+    if (err == error.ExecutionTerminated or exec.js.env.terminatePending()) return error.ExecutionTerminated;
+    if (err == error.OutOfMemory) return err;
+    const local = exec.js.local.?;
+    const reason = caught.exceptionValue() orelse js.Value{ .local = local, .handle = local.isolate.createTypeError("Invalid WebGPU arguments") };
+    const resolver = local.createPromiseResolver();
+    try resolver.rejectValue(reason);
+    return resolver.promise();
+}
