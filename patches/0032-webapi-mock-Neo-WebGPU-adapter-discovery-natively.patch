+pub const Features = Setlike("GPUSupportedFeatures", &feature_names);
+pub const LanguageFeatures = Setlike("WGSLLanguageFeatures", &language_names);
+
+fn Setlike(comptime interface_name: [:0]const u8, comptime names: []const []const u8) type {
+    return struct {
+        _pad: bool = false,
+        const Self = @This();
+        fn size(_: *const Self) u32 {
+            return names.len;
+        }
+        fn has(_: *const Self, input: js.Value) !bool {
+            const text = try (try Convert.domString(input)).toSlice();
+            for (names) |entry| {
+                if (std.mem.eql(u8, text, entry)) return true;
+            }
+            return false;
+        }
+        fn values(_: *const Self, exec: *js.Execution) !*ValueIterator {
+            return ValueIterator.init(.{ .names = names }, exec);
+        }
+        fn entries(_: *const Self, exec: *js.Execution) !*PairIterator {
+            return PairIterator.init(.{ .names = names }, exec);
+        }
+        fn forEach(self: *Self, cb: js.Function, this_arg: ?js.Value, exec: *js.Execution) !void {
+            const receiver = this_arg orelse try exec.js.local.?.zigValueToJs(js.Undefined{}, .{});
+            for (names) |entry| {
+                try cb.callWithThisRethrow(void, receiver, .{ entry, entry, self });
+            }
+        }
+        pub const JsApi = struct {
+            pub const bridge = js.Bridge(Self);
+            pub const Meta = struct {
+                pub const name = interface_name;
+                pub const prototype_chain = bridge.prototypeChain();
+                pub var class_id: bridge.ClassId = undefined;
+            };
+            pub const size = bridge.accessor(Self.size, null, .{});
+            pub const has = bridge.function(Self.has, .{});
+            pub const values = bridge.function(Self.values, .{});
+            pub const keys = bridge.function(Self.values, .{});
+            pub const entries = bridge.function(Self.entries, .{});
+            pub const forEach = bridge.function(Self.forEach, .{});
+            pub const symbol_iterator = bridge.iterator(Self.values, .{});
+        };
+    };
+}
+
+const InnerIterator = struct {
+    names: []const []const u8,
+    index: usize = 0,
+    pub fn next(self: *InnerIterator, _: *js.Execution) ?struct { []const u8, []const u8 } {
+        if (self.index == self.names.len) return null;
+        const text = self.names[self.index];
+        self.index += 1;
+        return .{ text, text };
+    }
+};
+const Iterator = @import("collections/iterator.zig").Entry;
+const ValueIterator = Iterator(InnerIterator, "0");
+const PairIterator = Iterator(InnerIterator, null);
