index 0000000..d39159c
--- /dev/null
+++ b/tools/curl_http1_profile.zig
@@ -0,0 +1,55 @@
+// Copyright (C) 2026 Brenno Flávio
+// Brenno Flávio <contato@brennoflavio.com.br>
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Add Chrome's HTTP/1.1 navigation Connection default in pinned curl sources.
+const std = @import("std");
+
+pub fn main(init: std.process.Init) !void {
+    const allocator = init.arena.allocator();
+    var args = std.process.Args.Iterator.init(init.minimal.args);
+    _ = args.next();
+    const input = args.next() orelse return error.Usage;
+    const output = args.next() orelse return error.Usage;
+    if (args.next() != null) return error.Usage;
+    const cwd = std.Io.Dir.cwd();
+    const source = try cwd.readFileAlloc(init.io, input, allocator, .unlimited);
+    if (std.mem.count(u8, source, before) != 1) {
+        std.debug.print("Pinned HTTP/1 source changed ({s}); expected one match for:\n{s}\n", .{ input, before });
+        return error.CurlSourceMismatch;
+    }
+    const patched = try std.mem.replaceOwned(u8, allocator, source, before, after);
+    try cwd.writeFile(init.io, .{ .sub_path = output, .data = patched });
+}
+
+const before =
+    \\  case H1_HD_HOST:
+    \\    if(data->state.http_host) {
+    \\      result = curlx_dyn_add(req, data->state.http_host);
+    \\      if(!result)
+    \\        result = curlx_dyn_addn(req, STRCONST("\r\n"));
+    \\    }
+    \\    break;
+;
+
+const after =
+    \\  case H1_HD_HOST:
+    \\    if(data->state.http_host) {
+    \\      result = curlx_dyn_add(req, data->state.http_host);
+    \\      if(!result)
+    \\        result = curlx_dyn_addn(req, STRCONST("\r\n"));
+    \\      /* Weight 256 identifies Lightpanda's non-internal navigations.
+    \\       * Leave explicit headers and curl's late TE/upgrade handling alone. */
+    \\      if(!result && httpversion == 11 && data->set.weight == 256 &&
+    \\         !data->conn->bits.close && !data->set.reuse_forbid &&
+    \\         !data->set.http_transfer_encoding &&
+    \\         !(data->conn->scheme->protocol & (CURLPROTO_WS | CURLPROTO_WSS)) &&
+    \\         !(!Curl_conn_is_ssl(data->conn, FIRSTSOCKET) &&
+    \\           (data->state.http_neg.wanted & CURL_HTTP_V2x) &&
+    \\           data->state.http_neg.h2_upgrade) &&
+    \\         !Curl_checkheaders(data, STRCONST("Connection")) &&
+    \\         !Curl_checkheaders(data, STRCONST("Upgrade")))
+    \\        result = curlx_dyn_addn(req, STRCONST("Connection: keep-alive\r\n"));
+    \\    }
+    \\    break;
+;
