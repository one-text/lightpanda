+fn http1ProfileSource(b: *Build, source: Build.LazyPath) Build.LazyPath {
+    const tool = b.addExecutable(.{
+        .name = "curl_http1_profile",
+        .root_module = b.createModule(.{
+            .root_source_file = b.path("tools/curl_http1_profile.zig"),
+            .target = b.graph.host,
+            .optimize = .ReleaseSafe,
+        }),
+    });
+    const run = b.addRunArtifact(tool);
+    run.addFileArg(source);
+    return run.addOutputFileArg("http.c");
