+const TextLength = struct {
+    value: f64 = 0,
+    unit: enum { presentation, inherit, normal, px, em, percentage, rem, number } = .inherit,
+
+    fn parse(value: []const u8, line_height: bool) ?TextLength {
+        if (std.ascii.eqlIgnoreCase(value, "inherit") or std.ascii.eqlIgnoreCase(value, "unset")) return .{};
+        if (std.ascii.eqlIgnoreCase(value, "initial") or std.ascii.eqlIgnoreCase(value, "revert") or std.ascii.eqlIgnoreCase(value, "revert-layer")) {
+            return if (line_height) .{ .unit = .normal } else .{ .value = 16, .unit = .px };
+        }
+        if (line_height and std.ascii.eqlIgnoreCase(value, "normal")) return .{ .unit = .normal };
+        if (!line_height and std.ascii.eqlIgnoreCase(value, "medium")) return .{ .value = 16, .unit = .px };
+        if (std.ascii.endsWithIgnoreCase(value, "rem")) {
+            const number = std.fmt.parseFloat(f64, value[0 .. value.len - 3]) catch return null;
+            if (!std.math.isFinite(number) or number < 0) return null;
+            return .{ .value = number, .unit = .rem };
+        }
+        const parsed = units.parse(value) catch return null;
+        if (parsed.value < 0) return null;
+        return switch (parsed.unit) {
+            .em => .{ .value = parsed.value, .unit = .em },
+            .ex => .{ .value = parsed.value / 2, .unit = .em },
+            .percentage => .{ .value = parsed.value, .unit = .percentage },
+            .none => if (line_height) .{ .value = parsed.value, .unit = .number } else if (parsed.value == 0) .{ .unit = .px } else null,
+            else => .{ .value = parsed.value * (units.absoluteLengthFactor(parsed.unit) orelse return null), .unit = .px },
+        };
+    }
+};
+
+// Keep hostile but individually finite relative lengths from overflowing layout.
+const MAX_TEXT_SIZE: f64 = 1_000_000;
+
+pub fn validTextDeclaration(name: []const u8, value: []const u8) bool {
+    if (value.len == 0 or isFontGlobal(value)) return true;
+    if (std.ascii.eqlIgnoreCase(name, "font-size")) return TextLength.parse(value, false) != null;
+    if (std.ascii.eqlIgnoreCase(name, "line-height")) return TextLength.parse(value, true) != null;
+    if (std.ascii.eqlIgnoreCase(name, "font-family")) return text_measure.resolveFamilies(value) != null;
+    if (std.ascii.eqlIgnoreCase(name, "white-space")) {
+        inline for (.{ "normal", "nowrap", "pre", "pre-wrap", "pre-line", "break-spaces" }) |keyword| {
+            if (std.ascii.eqlIgnoreCase(value, keyword)) return true;
+        }
+        return false;
+    }
+    return true;
+}
+
+fn isFontGlobal(value: []const u8) bool {
+    inline for (.{ "inherit", "initial", "unset", "revert", "revert-layer" }) |keyword| {
+        if (std.ascii.eqlIgnoreCase(value, keyword)) return true;
+    }
+    return false;
+}
+
+const Text = struct {
+    const Family = union(enum) { inherit, face: text_measure.FontFace };
+    const DisplayMode = enum { ua, inline_box, other };
+    const WhiteSpace = enum { inherit, normal, nowrap, pre, pre_wrap, pre_line };
+
+    const Declared = struct {
+        const names = [_][]const u8{ "display", "font-size", "font-family", "line-height", "white-space" };
+        display: ?DisplayMode = null,
+        font_size: ?TextLength = null,
+        font_family: ?Family = null,
+        line_height: ?TextLength = null,
+        white_space: ?WhiteSpace = null,
+
+        fn apply(self: *Declared, name: []const u8, value: []const u8) void {
+            if (std.ascii.eqlIgnoreCase(name, "display")) {
+                self.display = if (std.ascii.eqlIgnoreCase(value, "inline") or std.ascii.eqlIgnoreCase(value, "inline-block") or std.ascii.eqlIgnoreCase(value, "initial")) .inline_box else .other;
+            } else if (std.ascii.eqlIgnoreCase(name, "font-size")) {
+                self.font_size = TextLength.parse(value, false);
+            } else if (std.ascii.eqlIgnoreCase(name, "font-family")) {
+                self.font_family = if (std.ascii.eqlIgnoreCase(value, "inherit") or std.ascii.eqlIgnoreCase(value, "unset")) .inherit else if (isFontGlobal(value)) .{ .face = .serif } else .{ .face = text_measure.resolveFamilies(value) orelse return };
+            } else if (std.ascii.eqlIgnoreCase(name, "line-height")) {
+                self.line_height = TextLength.parse(value, true);
+            } else if (std.ascii.eqlIgnoreCase(name, "white-space")) {
+                self.white_space = if (std.ascii.eqlIgnoreCase(value, "inherit") or std.ascii.eqlIgnoreCase(value, "unset")) .inherit else if (std.ascii.eqlIgnoreCase(value, "pre")) .pre else if (std.ascii.eqlIgnoreCase(value, "pre-wrap") or std.ascii.eqlIgnoreCase(value, "break-spaces")) .pre_wrap else if (std.ascii.eqlIgnoreCase(value, "pre-line")) .pre_line else if (std.ascii.eqlIgnoreCase(value, "nowrap")) .nowrap else .normal;
+            }
+        }
+    };
+
+    const Computed = struct {
+        display: DisplayMode = .ua,
+        font_size: TextLength = .{ .unit = .presentation },
+        font_family: Family = .inherit,
+        line_height: TextLength = .{},
+        white_space: WhiteSpace = .inherit,
+    };
+};
+
+pub const TextStyle = struct {
+    size: f64 = 16,
+    face: text_measure.FontFace = .serif,
+    line_height: TextLength = .{ .unit = .normal },
+    white_space: Text.WhiteSpace = .normal,
+
+    pub fn lineHeight(self: TextStyle) f64 {
+        return @min(MAX_TEXT_SIZE, switch (self.line_height.unit) {
+            .px => self.line_height.value,
+            .number => self.size * self.line_height.value,
+            else => self.size * text_measure.LINE_HEIGHT,
+        });
+    }
+};
+
+pub fn inlineTextBox(self: *StyleManager, element: *Element) bool {
+    self.rebuildIfDirty() catch return false;
+    return switch (self.text.ownProps(self.arena.allocator(), element, self.frame).display) {
+        .inline_box => true,
+        .other => false,
+        .ua => std.mem.eql(u8, @import("webapi/css/CSSStyleDeclaration.zig").getDefaultDisplay(element), "inline"),
+    };
+}
+
+pub fn textStyle(self: *StyleManager, element: *Element) TextStyle {
+    self.assertOwns(element);
+    self.rebuildIfDirty() catch return .{};
+    return self.textStyleAt(element, 0);
+}
+
+fn textStyleAt(self: *StyleManager, element: ?*Element, depth: u8) TextStyle {
+    const current = element orelse return .{};
+    if (depth >= MAX_FONT_ANCESTOR_DEPTH) return .{};
+    var result = self.textStyleAt(current.parentElement(), depth + 1);
+    const own = self.text.ownProps(self.arena.allocator(), current, self.frame);
+    const size = if (own.font_size.unit == .presentation)
+        presentationFontSize(current)
+    else
+        own.font_size;
+    switch (size.unit) {
+        .px => result.size = size.value,
+        .em => result.size *= size.value,
+        .percentage => result.size *= size.value / 100,
+        .rem => result.size = size.value * self.rootFontSize(current, depth + 1),
+        else => {},
+    }
+    result.size = @min(MAX_TEXT_SIZE, result.size);
+    if (own.font_family == .face) result.face = own.font_family.face;
+    switch (own.line_height.unit) {
+        .inherit => {},
+        .em, .percentage, .rem => result.line_height = .{ .unit = .px, .value = own.line_height.value * (if (own.line_height.unit == .percentage) result.size / 100 else if (own.line_height.unit == .rem) (if (self.frame.document.getDocumentElement() == current) result.size else self.rootFontSize(current, depth + 1)) else result.size) },
+        else => result.line_height = own.line_height,
+    }
+    result.line_height.value = @min(MAX_TEXT_SIZE, result.line_height.value);
+    if (own.white_space != .inherit) result.white_space = own.white_space;
+    return result;
+}
+
+fn presentationFontSize(element: *Element) TextLength {
+    const raw = element.getAttributeSafe(comptime .wrap("font-size")) orelse return .{};
+    if (TextLength.parse(raw, false)) |size| return size;
+    // SVG presentation attributes also allow nonzero unitless pixel sizes.
+    const number = std.fmt.parseFloat(f64, raw) catch return .{};
+    if (number < 0 or !std.math.isFinite(number)) return .{};
+    return .{ .value = number, .unit = .px };
+}
+
+fn rootFontSize(self: *StyleManager, current: *Element, depth: u8) f64 {
+    const root = self.frame.document.getDocumentElement() orelse return 16;
+    return if (root == current) 16 else self.textStyleAt(root, depth).size;
+}
