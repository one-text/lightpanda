-/// Map the deprecated `device-*` features onto their viewport counterparts.
-/// `device-width` is the width of the output device; we have no separate
-/// screen geometry, and `window.screen.width` already reports the viewport
-/// (see webapi/Screen.zig), so both stay consistent.
+/// Normalize deprecated `device-*` names; their dimensions come from the screen.
 fn stripDevice(lname: []const u8) []const u8 {
     if (std.mem.eql(u8, lname, "device-width")) return "width";
     if (std.mem.eql(u8, lname, "min-device-width")) return "min-width";
@@ -296,30 +294,34 @@ fn evalNameValue(name: []const u8, value: []const u8, viewport: Viewport) bool {
     }
 
     var buf: [max_feature_name_len]u8 = undefined;
-    const lname = stripDevice(std.ascii.lowerString(&buf, name));
+    const lower_name = std.ascii.lowerString(&buf, name);
+    const lname = stripDevice(lower_name);
+    const device = lname.len != lower_name.len;
+    const width = if (device) viewport.screen_width orelse viewport.width else viewport.width;
+    const height = if (device) viewport.screen_height orelse viewport.height else viewport.height;
     if (std.mem.eql(u8, lname, "min-width")) {
         const px = parseLengthPx(value) orelse return false;
-        return viewport.width >= px;
+        return width >= px;
     }
     if (std.mem.eql(u8, lname, "max-width")) {
         const px = parseLengthPx(value) orelse return false;
-        return viewport.width <= px;
+        return width <= px;
     }
     if (std.mem.eql(u8, lname, "width")) {
         const px = parseLengthPx(value) orelse return false;
-        return viewport.width == px;
+        return width == px;
     }
     if (std.mem.eql(u8, lname, "min-height")) {
         const px = parseLengthPx(value) orelse return false;
-        return viewport.height >= px;
+        return height >= px;
     }
     if (std.mem.eql(u8, lname, "max-height")) {
         const px = parseLengthPx(value) orelse return false;
-        return viewport.height <= px;
+        return height <= px;
     }
     if (std.mem.eql(u8, lname, "height")) {
         const px = parseLengthPx(value) orelse return false;
-        return viewport.height == px;
+        return height == px;
     }
     if (std.mem.eql(u8, lname, "orientation")) {
         if (std.ascii.eqlIgnoreCase(value, "landscape")) return viewport.width >= viewport.height;
@@ -334,10 +336,14 @@ fn evalBoolean(name: []const u8, viewport: Viewport) bool {
         return false;
     }
     var buf: [max_feature_name_len]u8 = undefined;
-    const lname = stripDevice(std.ascii.lowerString(&buf, name));
-
-    if (std.mem.eql(u8, lname, "width")) return viewport.width > 0;
-    if (std.mem.eql(u8, lname, "height")) return viewport.height > 0;
+    const lower_name = std.ascii.lowerString(&buf, name);
+    const lname = stripDevice(lower_name);
+    const device = lname.len != lower_name.len;
