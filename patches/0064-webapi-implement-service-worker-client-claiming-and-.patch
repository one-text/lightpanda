+const std = @import("std");
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const URL = @import("../URL.zig");
+const Session = @import("../Session.zig");
+const DOMException = @import("DOMException.zig");
+const ServiceWorkerContainer = @import("ServiceWorkerContainer.zig");
+const ServiceWorkerGlobalScope = @import("ServiceWorkerGlobalScope.zig");
+
+const Clients = @This();
+
+_scope: *ServiceWorkerGlobalScope,
+
+// The spec compares serialized URL prefixes, not path segments. Callers supply
+// canonical URLs and scope registration enforces the same-origin boundary.
+pub fn scopeMatches(scope: *ServiceWorkerGlobalScope, client_url: [:0]const u8) bool {
+    const origin = scope._proto.origin orelse return false;
+    return URL.isSameOrigin(client_url, origin) and
+        URL.isSameOrigin(scope._scope_url, origin) and
+        std.mem.startsWith(u8, client_url, scope._scope_url);
+}
+
+fn matchingRegistration(session: *Session, client_url: [:0]const u8) ?*ServiceWorkerGlobalScope {
+    var best: ?*ServiceWorkerGlobalScope = null;
+    var it = session.service_workers.valueIterator();
+    while (it.next()) |entry| {
+        const scope = entry.*;
+        if (scopeMatches(scope, client_url) == false) continue;
+        // Even an installing, more-specific registration prevents an outer
+        // registration from claiming this client.
+        if (best == null or scope._scope_url.len > best.?._scope_url.len) {
+            best = scope;
+        }
+    }
+    return best;
+}
+
+pub fn claim(self: *Clients, exec: *js.Execution) !js.Promise {
+    const resolver = exec.js.local.?.createPromiseResolver();
+    const scope = self._scope;
+    if (scope.hasActiveWorker() == false) {
+        const exception = DOMException.init("The service worker is not active.", "InvalidStateError");
+        try resolver.rejectValue(try exec.js.local.?.zigValueToJs(exception, .{}));
+        return resolver.promise();
+    }
+
+    const session = scope._proto._session;
+    var it = session.service_worker_clients.valueIterator();
+    while (it.next()) |entry| {
+        const frame = entry.*;
+        const client_url = frame._service_worker_creation_url orelse continue;
+        if (frame.page.destroying or frame.window._closed or frame.isSecureContext() == false or frame.isSameOrigin(scope._proto.url) == false) continue;
+        if (matchingRegistration(session, client_url) != scope) continue;
+
+        const navigator = frame.window._navigator;
+        const container = navigator._service_worker orelse blk: {
+            const container = try ServiceWorkerContainer.init(frame);
+            navigator._service_worker = container;
+            break :blk container;
+        };
+        try container.claim(scope);
+    }
+
+    // Queue resolution after updating controllers and queuing their change
+    // events. Never run page JS inside the discovery walk.
+    const arena = try session.getArena(.tiny, "Clients.claim");
+    errdefer arena.release();
+    const callback = try arena.create(ClaimCallback);
+    callback.* = .{ .arena = arena, .js_context = exec.js, .resolver = try resolver.persist() };
+    errdefer callback.resolver.release();
+    try exec.js.scheduler.add(callback, ClaimCallback.run, 0, .{
+        .name = "Clients.claim",
+        .finalizer = ClaimCallback.cancelled,
+    });
+    return resolver.promise();
+}
+
+const ClaimCallback = struct {
+    arena: *lp.Arena,
+    js_context: *js.Context,
+    resolver: js.PromiseResolver.Global,
+
+    fn cancelled(ctx: *anyopaque) void {
+        const self: *ClaimCallback = @ptrCast(@alignCast(ctx));
+        self.resolver.release();
+        self.arena.release();
+    }
+
+    fn run(ctx: *anyopaque) !?u32 {
+        const self: *ClaimCallback = @ptrCast(@alignCast(ctx));
+        defer cancelled(ctx);
+        var ls: js.Local.Scope = undefined;
+        self.js_context.localScope(&ls);
+        defer ls.deinit();
+        ls.toLocal(self.resolver).resolve("Clients.claim", {});
+        return null;
+    }
+};
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(Clients);
+    pub const Meta = struct {
+        pub const name = "Clients";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const claim = bridge.function(Clients.claim, .{});
+};
