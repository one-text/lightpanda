+
+pub fn claim(self: *ServiceWorkerContainer, scope: *ServiceWorkerGlobalScope) !void {
+    if (self._controller) |registration| {
+        if (registration._scope == scope) return;
+    }
+    const registration = try self.track(scope);
+    try self.scheduleControllerChange();
+    self._controller = registration;
