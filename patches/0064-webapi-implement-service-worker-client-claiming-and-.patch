+
+// Called before a worker's native memory is released. Container teardown clears
+// its controller first and invalidates its document ID, so it queues no event.
+pub fn workerDetached(self: *ServiceWorkerContainer, registration: *ServiceWorkerRegistration) void {
+    if (self._controller != registration) return;
+    self._controller = null;
+    self.scheduleControllerChange() catch |err| {
+        log.debug(.browser, "SWC controllerchange", .{ .err = err });
+    };
+}
+
+fn scheduleControllerChange(self: *ServiceWorkerContainer) !void {
+    const frame = self._frame;
+    const id = frame._service_worker_client_id;
+    if (id == 0) return;
+    const arena = try frame._session.getArena(.tiny, "ServiceWorkerContainer.controllerchange");
+    errdefer arena.release();
+    const callback = try arena.create(ControllerChangeCallback);
+    callback.* = .{ .arena = arena, .session = frame._session, .client_id = id };
+    try frame.js.scheduler.add(callback, ControllerChangeCallback.run, 0, .{
+        .name = "ServiceWorkerContainer.controllerchange",
+        .finalizer = ControllerChangeCallback.cancelled,
+    });
+}
