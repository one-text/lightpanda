+const ControllerChangeCallback = struct {
+    arena: *lp.Arena,
+    session: *@import("../Session.zig"),
+    client_id: u64,
+
+    fn cancelled(ctx: *anyopaque) void {
+        const self: *ControllerChangeCallback = @ptrCast(@alignCast(ctx));
+        self.arena.release();
+    }
+
+    fn run(ctx: *anyopaque) !?u32 {
+        const self: *ControllerChangeCallback = @ptrCast(@alignCast(ctx));
+        defer self.arena.release();
+        const frame = self.session.service_worker_clients.get(self.client_id) orelse return null;
+        if (frame.page.destroying) return null;
+        const container = frame.window._navigator._service_worker orelse return null;
+        const event = try Event.initTrusted(.wrap("controllerchange"), .{
+            .bubbles = false,
+            .cancelable = false,
+        }, frame.page);
+        try frame.js.execution.dispatch(container._proto, event, container._on_controller_change, .{
+            .context = "SWC controllerchange",
+        });
+        return null;
+    }
+};
