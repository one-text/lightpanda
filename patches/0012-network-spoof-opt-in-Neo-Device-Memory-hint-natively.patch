+// Session-owned opt-in for the legacy memory hint; not shared by browser contexts.
+pub const DeviceMemoryHints = struct {
+    origins: std.StringHashMapUnmanaged(void) = .empty,
+
+    pub fn deinit(self: *DeviceMemoryHints, allocator: Allocator) void {
+        var it = self.origins.keyIterator();
+        while (it.next()) |key| allocator.free(key.*);
+        self.origins.deinit(allocator);
+    }
+
+    fn update(self: *DeviceMemoryHints, allocator: Allocator, origin: []const u8, enabled: bool) !void {
+        if (!enabled) {
+            if (self.origins.fetchRemove(origin)) |removed| allocator.free(removed.key);
+        } else if (!self.origins.contains(origin)) {
+            const owned = try allocator.dupe(u8, origin);
+            errdefer allocator.free(owned);
+            try self.origins.put(allocator, owned, {});
+        }
+    }
+};
+
+// Accept-CH is a structured list of tokens. Validate the entire list before
+// changing opt-in, including parameters (which do not affect hint selection).
+const MemoryHintList = struct {
+    rest: []const u8,
+    allocator: Allocator,
+
+    fn token(self: *MemoryHintList) ?[]const u8 {
+        const text = self.rest;
+        if (text.len == 0 or (!std.ascii.isAlphabetic(text[0]) and text[0] != '*')) return null;
+        var len: usize = 1;
+        while (len < text.len) : (len += 1) {
+            switch (text[len]) {
+                'a'...'z', 'A'...'Z', '0'...'9', '!', '#', '$', '%', '&', '\'', '*', '+', '-', '.', '^', '_', '`', '|', '~', ':', '/' => {},
+                else => break,
+            }
+        }
+        self.rest = text[len..];
+        return text[0..len];
+    }
+
+    fn bareItem(self: *MemoryHintList) !bool {
+        if (self.rest.len == 0) return false;
+        switch (self.rest[0]) {
+            '"' => {
+                self.rest = self.rest[1..];
+                while (self.rest.len > 0) {
+                    const c = self.rest[0];
+                    self.rest = self.rest[1..];
+                    if (c == '"') return true;
+                    if (c < 0x20 or c > 0x7e) return false;
+                    if (c == '\\') {
+                        if (self.rest.len == 0 or (self.rest[0] != '"' and self.rest[0] != '\\')) return false;
+                        self.rest = self.rest[1..];
+                    }
+                }
+                return false;
+            },
+            '?' => {
+                if (self.rest.len < 2 or (self.rest[1] != '0' and self.rest[1] != '1')) return false;
+                self.rest = self.rest[2..];
+                return true;
+            },
+            ':' => {
+                const end = std.mem.indexOfScalarPos(u8, self.rest, 1, ':') orelse return false;
+                const encoded = self.rest[1..end];
+                const decoder = if (std.mem.endsWith(u8, encoded, "=")) std.base64.standard.Decoder else std.base64.standard_no_pad.Decoder;
+                const size = decoder.calcSizeForSlice(encoded) catch return false;
+                const decoded = try self.allocator.alloc(u8, size);
+                defer self.allocator.free(decoded);
+                decoder.decode(decoded, encoded) catch return false;
+                self.rest = self.rest[end + 1 ..];
+                return true;
+            },
+            '-', '0'...'9' => {
+                if (self.rest[0] == '-') self.rest = self.rest[1..];
+                var digits: usize = 0;
+                while (self.rest.len > 0 and std.ascii.isDigit(self.rest[0])) : (digits += 1) self.rest = self.rest[1..];
+                if (digits == 0 or digits > 15) return false;
+                if (self.rest.len > 0 and self.rest[0] == '.') {
+                    if (digits > 12) return false;
+                    self.rest = self.rest[1..];
+                    var fraction: usize = 0;
+                    while (self.rest.len > 0 and std.ascii.isDigit(self.rest[0])) : (fraction += 1) self.rest = self.rest[1..];
+                    if (fraction == 0 or fraction > 3) return false;
+                }
+                return true;
+            },
+            else => return self.token() != null,
+        }
+    }
+
+    fn parse(allocator: Allocator, value: []const u8) !?bool {
+        var parser = MemoryHintList{ .rest = std.mem.trim(u8, value, " \t"), .allocator = allocator };
+        var requested = false;
+        if (parser.rest.len == 0) return false;
+        while (true) {
+            const hint = parser.token() orelse return null;
+            requested = requested or std.ascii.eqlIgnoreCase(hint, "device-memory");
+            while (parser.rest.len > 0 and parser.rest[0] == ';') {
+                parser.rest = std.mem.trimStart(u8, parser.rest[1..], " ");
+                var len: usize = 0;
+                for (parser.rest) |c| {
+                    if (!(c >= 'a' and c <= 'z') and c != '*' and (len == 0 or (!std.ascii.isDigit(c) and c != '_' and c != '-' and c != '.'))) break;
+                    len += 1;
+                }
+                if (len == 0) return null;
+                parser.rest = parser.rest[len..];
+                if (parser.rest.len > 0 and parser.rest[0] == '=') {
+                    parser.rest = parser.rest[1..];
+                    if (!try parser.bareItem()) return null;
+                }
+            }
+            parser.rest = std.mem.trimStart(u8, parser.rest, " \t");
+            if (parser.rest.len == 0) return requested;
+            if (parser.rest[0] != ',') return null;
+            parser.rest = std.mem.trimStart(u8, parser.rest[1..], " \t");
+        }
+    }
+};
+
+fn setDeviceMemoryHeader(transfer: *Transfer) !void {
+    // Recompute browser-generated values after redirects and CDP URL/header
+    // replacement, without stripping an explicitly supplied legacy header.
+    var i: usize = 0;
+    while (i < transfer.req_headers.items.len) {
+        const hdr = transfer.req_headers.items[i];
+        if (hdr.source == .user_agent and std.ascii.eqlIgnoreCase(hdr.name, "device-memory")) {
+            _ = transfer.req_headers.orderedRemove(i);
+        } else {
+            i += 1;
+        }
+    }
+
+    if (transfer.req.internal or !URL.isPotentiallyTrustworthy(transfer.req.url)) return;
+    const owner = transfer.owner orelse return;
+    const hints = owner.device_memory_hints orelse return;
+    if (transfer.req.resource_type != .document or owner.parent != null) {
+        var top: *const Owner = owner;
+        while (top.parent) |parent| top = parent;
+        const origin = top.scope.origin() orelse return;
+        // The default memory-hint permissions policy is self. No delegation
+        // is synthesized for third-party subresources or nested documents.
+        if (!URL.isSameOrigin(transfer.req.url, origin)) return;
+    }
+    const origin = try URL.getOrigin(transfer.arena.allocator(), transfer.req.url) orelse return;
+    if (hints.origins.contains(origin)) {
+        try transfer.setHeader("Device-Memory", lp.Config.HttpHeaders.device_memory_header, .{});
+    }
+}
+
+fn updateDeviceMemoryHints(transfer: *Transfer, headers: []const http.Header) !void {
+    if (transfer.req.internal or transfer.req.resource_type != .document or !URL.isPotentiallyTrustworthy(transfer.req.url)) return;
+    const owner = transfer.owner orelse return;
+    if (owner.parent != null) return;
+    const hints = owner.device_memory_hints orelse return;
+    var value: std.Io.Writer.Allocating = .init(transfer.arena.allocator());
+    defer value.deinit();
+    var present = false;
+    for (headers) |hdr| {
+        if (!std.ascii.eqlIgnoreCase(hdr.name, "accept-ch")) continue;
+        if (present) try value.writer.writeAll(", ");
+        try value.writer.writeAll(hdr.value);
+        present = true;
+    }
+    // Missing or malformed Accept-CH leaves the previous preference intact;
+    // an empty valid list (or one without Device-Memory) clears it.
+    if (!present) return;
+    const enabled = (try MemoryHintList.parse(transfer.arena.allocator(), value.written())) orelse return;
+    const origin = try URL.getOrigin(transfer.arena.allocator(), transfer.req.url) orelse return;
+    try hints.update(transfer.client.allocator, origin, enabled);
+}
+
