-fn getBrands(_: *const NavigatorUAData) []const Brand {
-    return brandList();
+fn getBrands(_: *const NavigatorUAData, exec: *const Execution) !js.Value {
+    const local = exec.js.local.?;
+    const brands = try local.zigValueToJs(brandList(false), .{});
+    const freeze = js.Function{ .local = local, .handle = @ptrCast(js.v8.v8__Global__Get(&exec.js.object_freeze, local.isolate.handle).?) };
+    return freeze.call(js.Value, .{brands});
 }
 
 fn getMobile(_: *const NavigatorUAData) bool {
@@ -50,41 +55,46 @@ pub fn toJSON(_: *const NavigatorUAData) struct {
 } {
     return .{
         .mobile = false,
-        .brands = brandList(),
