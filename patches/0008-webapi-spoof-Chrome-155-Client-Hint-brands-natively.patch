         .platform = uaPlatform(),
     };
 }
 
 fn getHighEntropyValues(_: *const NavigatorUAData, hints: []const []const u8, exec: *const Execution) !js.Promise {
-    // This should always return `brands` + `mobile` + `platform` and then whatever
-    // "hints" field is requested (assuming the browser has permission), but it's
-    // also valid to just return everything.
-
-    _ = hints;
-
-    const brands = brandList();
-
-    return exec.js.local.?.resolvePromise(.{
-        .brands = brandList(),
-        .mobile = false,
-        .platform = uaPlatform(),
-        .architecture = uaArchitecture(),
-        .bitness = uaBitness(),
-        .model = "",
-        .platformVersion = "",
-        .uaFullVersion = if (brands.len > 0) brands[0].version else "1.0.0.0",
-        .fullVersionList = brands,
-        .wow64 = false,
-        .formFactor = [_][]const u8{"Desktop"},
-    });
+    const local = exec.js.local.?;
+    const result = local.newObject();
+    _ = try result.set("brands", brandList(false), .{});
+    _ = try result.set("mobile", false, .{});
+    _ = try result.set("platform", uaPlatform(), .{});
+
+    for (hints) |hint| {
+        if (std.mem.eql(u8, hint, "architecture")) {
+            _ = try result.set("architecture", uaArchitecture(), .{});
+        } else if (std.mem.eql(u8, hint, "bitness")) {
+            _ = try result.set("bitness", uaBitness(), .{});
+        } else if (std.mem.eql(u8, hint, "model")) {
+            _ = try result.set("model", "", .{});
+        } else if (std.mem.eql(u8, hint, "platformVersion")) {
+            _ = try result.set("platformVersion", "", .{});
+        } else if (std.mem.eql(u8, hint, "uaFullVersion")) {
+            _ = try result.set("uaFullVersion", Config.HttpHeaders.chrome_full_version, .{});
+        } else if (std.mem.eql(u8, hint, "fullVersionList")) {
+            _ = try result.set("fullVersionList", brandList(true), .{});
+        } else if (std.mem.eql(u8, hint, "wow64")) {
+            _ = try result.set("wow64", false, .{});
+        } else if (std.mem.eql(u8, hint, "formFactors")) {
+            _ = try result.set("formFactors", [_][]const u8{"Desktop"}, .{});
+        }
+    }
+    return local.resolvePromise(result);
 }
 
-fn brandList() []const Brand {
+fn brandList(comptime full: bool) []const Brand {
     const out = comptime blk: {
         const src = &Config.HttpHeaders.brands;
         var arr: [src.len]Brand = undefined;
         for (src, 0..) |b, i| {
-            arr[i] = .{ .brand = b.brand, .version = b.full_version };
+            arr[i] = .{ .brand = b.brand, .version = if (full) b.full_version else b.version };
         }
         const final = arr;
         break :blk final;
