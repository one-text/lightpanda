From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: brennoflavio <contato@brennoflavio.com.br>
Date: Thu, 29 Oct 2026 13:27:33 -0300
Subject: [PATCH] tls: enable native GREASE and ClientHello extension
 permutation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Enable BoringSSL's existing general GREASE and extension-permutation
controls on each connection's SSL context before curl creates the SSL
object. Let the TLS backend generate and retain the values and ordering,
including across HelloRetryRequest, rather than constructing offers.

Install the context callback regardless of host-verification mode. Make
its certificate-store argument nullable and pass the existing store only
when verification is configured. Preserve store reference ownership,
callback failure propagation and host/peer/proxy verification options.

Scope this change to group 2 of docs/tls-patch-group-plan.md, using the
fingerprint recorder's TLS scenarios and GREASE/permutation acceptance
rules. It does not add signature GREASE, ECH, ALPS, certificate compression,
cipher/signature policy changes, or session resumption fixes, and does not
claim complete Chrome TLS parity.

Validation before export: release build, all 1658 existing upstream tests,
fingerprint TypeScript check, and targeted normal/HRR captures in fresh
processes with verification enabled and disabled. Trusted test certificates
succeed; untrusted and wrong-host certificates remain rejected unless the
explicit insecure option is supplied. HRR retains GREASE and ordinary
extension order, replacing initial key shares with the requested P-256.

Signed-off-by: Brenno Flávio <contato@brennoflavio.com.br>
---
 src/network/http.zig  | 34 ++++++++++++++++++----------------
 src/sys/libcrypto.zig |  2 ++
 src/sys/libcurl.zig   |  4 ++--
 3 files changed, 22 insertions(+), 18 deletions(-)

diff --git a/src/network/http.zig b/src/network/http.zig
index f01896d..303b27f 100644
--- a/src/network/http.zig
+++ b/src/network/http.zig
@@ -469,27 +469,29 @@ pub const Connection = struct {
         }
 
         // TLS.
-        if (config.tlsVerifyHost()) {
-            // Provide certificate store to connection's SSL_CTX.
-            try libcurl.curl_easy_setopt(self._easy, .ssl_ctx_function, &(struct {
-                fn wrap(
-                    _: *libcurl.Curl,
-                    raw_ssl_ctx: *anyopaque,
-                    raw_x509_store: *anyopaque,
-                ) callconv(.c) libcurl.CurlCode {
-                    const ssl_ctx: *crypto.SSL_CTX = @ptrCast(raw_ssl_ctx);
-                    const store: *crypto.X509_STORE = @ptrCast(raw_x509_store);
-
+        try libcurl.curl_easy_setopt(self._easy, .ssl_ctx_function, &(struct {
+            fn wrap(
+                _: *libcurl.Curl,
+                raw_ssl_ctx: *anyopaque,
+                raw_x509_store: ?*anyopaque,
+            ) callconv(.c) libcurl.CurlCode {
+                const ssl_ctx: *crypto.SSL_CTX = @ptrCast(raw_ssl_ctx);
+                crypto.SSL_CTX_set_grease_enabled(ssl_ctx, 1);
+                crypto.SSL_CTX_set_permute_extensions(ssl_ctx, 1);
+
+                if (raw_x509_store) |raw_store| {
+                    const store: *crypto.X509_STORE = @ptrCast(raw_store);
                     const result = crypto.SSL_CTX_set1_verify_cert_store(ssl_ctx, store);
                     if (result != 1) {
                         return libcurl.CURLE.ABORTED_BY_CALLBACK;
                     }
-                    return libcurl.CURLE.OK;
                 }
-            }).wrap);
-            // Pass our store to CURLOPT_SSL_CTX_FUNCTION.
-            try libcurl.curl_easy_setopt(self._easy, .ssl_ctx_data, certificates.store);
-        } else {
+                return libcurl.CURLE.OK;
+            }
+        }).wrap);
+        // Provide our certificate store only when verification is enabled.
+        try libcurl.curl_easy_setopt(self._easy, .ssl_ctx_data, if (config.tlsVerifyHost()) certificates.store else null);
+        if (!config.tlsVerifyHost()) {
             try libcurl.curl_easy_setopt(self._easy, .ssl_verify_host, false);
             try libcurl.curl_easy_setopt(self._easy, .ssl_verify_peer, false);
 
diff --git a/src/sys/libcrypto.zig b/src/sys/libcrypto.zig
index 7dc433c..7c474b9 100644
--- a/src/sys/libcrypto.zig
+++ b/src/sys/libcrypto.zig
@@ -179,6 +179,8 @@ pub const SSL_CTX = struct_ssl_ctx_st;
 pub const SSL = opaque {};
 pub extern fn SSL_get0_alpn_selected(ssl: *const SSL, data: *?[*]const u8, len: *c_uint) void;
 pub extern fn SSL_CTX_set1_verify_cert_store(ctx: ?*SSL_CTX, store: ?*X509_STORE) c_int;
+pub extern fn SSL_CTX_set_grease_enabled(ctx: *SSL_CTX, enabled: c_int) void;
+pub extern fn SSL_CTX_set_permute_extensions(ctx: *SSL_CTX, enabled: c_int) void;
 
 /// Returns the desired digest by its name.
 pub fn findDigest(name: []const u8) error{Invalid}!*const EVP_MD {
diff --git a/src/sys/libcurl.zig b/src/sys/libcurl.zig
index 8385ad5..80c06fb 100644
--- a/src/sys/libcurl.zig
+++ b/src/sys/libcurl.zig
@@ -43,7 +43,7 @@ pub const curl_writefunc_error: usize = c.CURL_WRITEFUNC_ERROR;
 pub const curl_readfunc_pause: usize = c.CURL_READFUNC_PAUSE;
 pub const CurlReadFunction = *const fn ([*]u8, usize, usize, *anyopaque) callconv(.c) usize;
 const CurlOpenSocketFunction = *const fn (?*anyopaque, c_uint, [*c]CurlSockAddr) callconv(.c) CurlSocket;
-const CurlSslCtxFunction = *const fn (*Curl, *anyopaque, *anyopaque) callconv(.c) CurlCode;
+const CurlSslCtxFunction = *const fn (*Curl, *anyopaque, ?*anyopaque) callconv(.c) CurlCode;
 const CurlDebugFunction = *const fn (*Curl, CurlInfoType, [*c]u8, usize, ?*anyopaque) callconv(.c) c_int;
 
 pub const CurlSockType = enum(c.curlsocktype) {
@@ -654,7 +654,7 @@ pub fn curl_easy_setopt(easy: *Curl, comptime option: CurlOption, value: anytype
         .opensocket_data,
         => @as(?*anyopaque, @ptrCast(value)),
 
-        .ssl_ctx_data => @as(*crypto.X509_STORE, value),
+        .ssl_ctx_data => @as(?*crypto.X509_STORE, value),
 
         .http_version => @as(c_long, @intFromEnum(@as(CurlHttpVersion, value))),
 
