+++ b/tools/curl_http2_profile.zig
@@ -90,20 +90,22 @@ const edits = [_]Edit{
     .{
         .before = "  nghttp2_priority_spec_init(pri_spec, 0, sweight_wanted(data), FALSE);",
         .after =
-        \\  /* Weight 256 is selected by Lightpanda for document navigations. */
+        \\  /* Lightpanda selects weights 256/220 for navigation/default fetch. */
         \\  nghttp2_priority_spec_init(pri_spec, 0, sweight_wanted(data),
-        \\                             data->set.weight == 256);
+        \\                             data->set.weight == 256 ||
+        \\                             data->set.weight == 220);
         ,
     },
     .{
         .before = "  nva = Curl_dynhds_to_nva(&h2_headers, &nheader);",
         .after =
-        \\  /* Generate the navigation default only after HTTP/2 is selected. A
-        \\   * caller's Priority (including curl's empty suppression form) wins. */
-        \\  if(data->set.weight == 256 &&
+        \\  /* Generate defaults only after HTTP/2 is selected. A caller's
+        \\   * Priority (including curl's empty suppression form) wins. */
+        \\  if((data->set.weight == 256 || data->set.weight == 220) &&
         \\     (data->state.http_ignorecustom ||
         \\      !Curl_checkheaders(data, STRCONST("Priority")))) {
-        \\    result = Curl_dynhds_cadd(&h2_headers, "priority", "u=0, i");
+        \\    result = Curl_dynhds_cadd(&h2_headers, "priority",
+        \\                              data->set.weight == 256 ? "u=0, i" : "u=1, i");
         \\    if(result)
         \\      goto out;
         \\  }
@@ -134,8 +136,8 @@ const edits = [_]Edit{
     },
 };
 
-// nghttp2 1.70 discards legacy request priority. Restore only the navigation
-// HEADERS field through its existing encoder, not the removed priority scheduler.
+// nghttp2 1.70 discards legacy request priority. Restore navigation/default-fetch
+// HEADERS fields through its existing encoder, not the removed priority scheduler.
 const nghttp2_edits = [_]Edit{
     .{
         .before =
@@ -159,7 +161,8 @@ const nghttp2_edits = [_]Edit{
         \\  if (!session->server &&
         \\      session->remote_settings.no_rfc7540_priorities != 1 &&
         \\      pri_spec && pri_spec->stream_id == 0 &&
-        \\      pri_spec->weight == 256 && pri_spec->exclusive) {
+        \\      (pri_spec->weight == 256 || pri_spec->weight == 220) &&
+        \\      pri_spec->exclusive) {
         \\    flags_copy |= NGHTTP2_FLAG_PRIORITY;
         \\  } else {
         \\    pri_spec = NULL;
