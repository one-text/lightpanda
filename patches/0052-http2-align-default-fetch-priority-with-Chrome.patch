From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: brennoflavio <contato@brennoflavio.com.br>
Date: Sat, 31 Oct 2026 18:45:46 -0300
Subject: [PATCH] http2: align default fetch priority with Chrome

Select per-attempt weight 220 for non-internal fetches, retaining navigation 256 and other/internal 16. Extend curl/nghttp2 overlays to send Priority: u=1, i and exclusive dependency-zero weight-220 HEADERS. Preserve explicit Priority override/suppression, peer settings, navigation and HTTP/1.1 behavior. Scope is default fetch, not fetchPriority API or scheduler parity; TLS and Mac persona unchanged. Add no tests. Reference: fingerprint/README.md.
---
 src/network/HttpClient.zig   |  2 +-
 src/network/http.zig         | 13 +++++++++----
 tools/curl_http2_profile.zig | 21 ++++++++++++---------
 3 files changed, 22 insertions(+), 14 deletions(-)

diff --git a/src/network/HttpClient.zig b/src/network/HttpClient.zig
index b8a101d..fa115b2 100644
--- a/src/network/HttpClient.zig
+++ b/src/network/HttpClient.zig
@@ -3661,7 +3661,7 @@ pub const Transfer = struct {
         try conn.setProxy(client.http_proxy);
         try conn.setTlsVerify(client.tls_verify, client.use_proxy);
         try conn.setHttpVersion(client.http_version);
-        try conn.setNavigationPriority(!req.internal and req.request_mode == .navigate);
+        try conn.setRequestPriority(if (req.internal) .other else if (req.request_mode == .navigate) .navigation else if (req.resource_type == .fetch) .fetch else .other);
 
         try conn.setURL(req.url);
         try conn.setMethod(req.method);
diff --git a/src/network/http.zig b/src/network/http.zig
index d51da1e..6bdb650 100644
--- a/src/network/http.zig
+++ b/src/network/http.zig
@@ -567,10 +567,15 @@ pub const Connection = struct {
         try libcurl.curl_easy_setopt(self._easy, .http_version, v);
     }
 
-    pub fn setNavigationPriority(self: *const Connection, navigation: bool) !void {
-        // The curl HTTP/2 overlay uses weight 256 for navigation defaults.
-        // Set both paths on every attempt so pooled handles cannot leak it.
-        try libcurl.curl_easy_setopt(self._easy, .stream_weight, @as(u16, if (navigation) 256 else 16));
+    pub fn setRequestPriority(self: *const Connection, kind: enum { navigation, fetch, other }) !void {
+        // The HTTP/2 overlay uses these weights for browser-generated defaults.
+        // Set every path on every attempt so pooled handles cannot leak it.
+        const weight: u16 = switch (kind) {
+            .navigation => 256,
+            .fetch => 220,
+            .other => 16,
+        };
+        try libcurl.curl_easy_setopt(self._easy, .stream_weight, weight);
     }
 
     pub fn setFollowLocation(self: *const Connection, follow: bool) !void {
