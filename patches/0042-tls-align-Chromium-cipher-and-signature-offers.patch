From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: brennoflavio <contato@brennoflavio.com.br>
Date: Thu, 29 Oct 2026 14:18:07 -0300
Subject: [PATCH] tls: align Chromium cipher and signature offers

Apply Chromium's ALL:!aPSK:!ECDSA+SHA1:!3DES cipher policy in the
existing SSL-context callback. This removes ECDHE-ECDSA CBC/SHA-1 suites
0xc009 and 0xc00a while retaining BoringSSL's AES-hardware-aware cipher
ordering, including its separate TLS 1.3 ordering.

Set the verification signature preferences to ML-DSA-44/65/87 followed by
Chromium's ECDSA/RSA SHA-2 order, without RSA PKCS#1 SHA-1 (0x0201).
Enable native signature-algorithm GREASE alongside patch 0041's general
GREASE and extension permutation. The pinned BoringSSL 7c1efd8 already
implements all these algorithms and the dedicated GREASE control; no
unsupported offers, serializer changes or dependency upgrade are needed.
Both policy setters copy/own their configuration and callback errors abort
the connection rather than falling back to the default policy.

The fingerprint benchmark's fresh Linux Chrome 154.0.8037.97 captures are
the practical ordered-vector reference, not proof of the target MacBook
Neo/macOS identity. Preserve the already matching group/key-share policy,
certificate verification, ALPN and session lifecycle. Ordering still uses
native AES detection; it is not a forced target profile on non-AES hosts.
Missing extensions and the known TLS 1.2/1.3 resumption gaps remain outside
this patch, so matching these offers does not imply a complete TLS match.

References: fingerprint/README.md, fingerprint/chromium-tls-research.md,
docs/tls-patch-group-plan.md (group 3); Chromium 155.0.8059.40,
net/socket/ssl_client_socket_impl.cc (cipher/signature configuration).
---
 src/network/http.zig  | 22 ++++++++++++++++++++++
 src/sys/libcrypto.zig | 15 +++++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/src/network/http.zig b/src/network/http.zig
index 303b27f..2cc8461 100644
--- a/src/network/http.zig
+++ b/src/network/http.zig
@@ -477,8 +477,30 @@ pub const Connection = struct {
             ) callconv(.c) libcurl.CurlCode {
                 const ssl_ctx: *crypto.SSL_CTX = @ptrCast(raw_ssl_ctx);
                 crypto.SSL_CTX_set_grease_enabled(ssl_ctx, 1);
+                crypto.SSL_CTX_set_grease_sigalgs_enabled(ssl_ctx, 1);
                 crypto.SSL_CTX_set_permute_extensions(ssl_ctx, 1);
 
+                // Chromium's cipher policy retains the backend's AES-aware ordering.
+                if (crypto.SSL_CTX_set_strict_cipher_list(ssl_ctx, "ALL:!aPSK:!ECDSA+SHA1:!3DES") != 1) {
+                    return libcurl.CURLE.ABORTED_BY_CALLBACK;
+                }
+                const signature_algorithms = [_]u16{
+                    crypto.SSL_SIGN_ML_DSA_44,
+                    crypto.SSL_SIGN_ML_DSA_65,
+                    crypto.SSL_SIGN_ML_DSA_87,
+                    crypto.SSL_SIGN_ECDSA_SECP256R1_SHA256,
+                    crypto.SSL_SIGN_RSA_PSS_RSAE_SHA256,
+                    crypto.SSL_SIGN_RSA_PKCS1_SHA256,
+                    crypto.SSL_SIGN_ECDSA_SECP384R1_SHA384,
+                    crypto.SSL_SIGN_RSA_PSS_RSAE_SHA384,
+                    crypto.SSL_SIGN_RSA_PKCS1_SHA384,
+                    crypto.SSL_SIGN_RSA_PSS_RSAE_SHA512,
+                    crypto.SSL_SIGN_RSA_PKCS1_SHA512,
+                };
+                if (crypto.SSL_CTX_set_verify_algorithm_prefs(ssl_ctx, &signature_algorithms, signature_algorithms.len) != 1) {
+                    return libcurl.CURLE.ABORTED_BY_CALLBACK;
+                }
+
                 if (raw_x509_store) |raw_store| {
                     const store: *crypto.X509_STORE = @ptrCast(raw_store);
                     const result = crypto.SSL_CTX_set1_verify_cert_store(ssl_ctx, store);
diff --git a/src/sys/libcrypto.zig b/src/sys/libcrypto.zig
index 7c474b9..3f49a95 100644
--- a/src/sys/libcrypto.zig
+++ b/src/sys/libcrypto.zig
@@ -180,7 +180,22 @@ pub const SSL = opaque {};
 pub extern fn SSL_get0_alpn_selected(ssl: *const SSL, data: *?[*]const u8, len: *c_uint) void;
 pub extern fn SSL_CTX_set1_verify_cert_store(ctx: ?*SSL_CTX, store: ?*X509_STORE) c_int;
 pub extern fn SSL_CTX_set_grease_enabled(ctx: *SSL_CTX, enabled: c_int) void;
+pub extern fn SSL_CTX_set_grease_sigalgs_enabled(ctx: *SSL_CTX, enabled: c_int) void;
 pub extern fn SSL_CTX_set_permute_extensions(ctx: *SSL_CTX, enabled: c_int) void;
+pub extern fn SSL_CTX_set_strict_cipher_list(ctx: *SSL_CTX, str: [*:0]const u8) c_int;
+pub extern fn SSL_CTX_set_verify_algorithm_prefs(ctx: *SSL_CTX, prefs: [*]const u16, num_prefs: usize) c_int;
+
+pub const SSL_SIGN_ML_DSA_44 = 0x0904;
+pub const SSL_SIGN_ML_DSA_65 = 0x0905;
+pub const SSL_SIGN_ML_DSA_87 = 0x0906;
+pub const SSL_SIGN_ECDSA_SECP256R1_SHA256 = 0x0403;
+pub const SSL_SIGN_RSA_PSS_RSAE_SHA256 = 0x0804;
+pub const SSL_SIGN_RSA_PKCS1_SHA256 = 0x0401;
+pub const SSL_SIGN_ECDSA_SECP384R1_SHA384 = 0x0503;
+pub const SSL_SIGN_RSA_PSS_RSAE_SHA384 = 0x0805;
+pub const SSL_SIGN_RSA_PKCS1_SHA384 = 0x0501;
+pub const SSL_SIGN_RSA_PSS_RSAE_SHA512 = 0x0806;
+pub const SSL_SIGN_RSA_PKCS1_SHA512 = 0x0601;
 
 /// Returns the desired digest by its name.
 pub fn findDigest(name: []const u8) error{Invalid}!*const EVP_MD {
