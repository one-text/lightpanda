+/// Iframe layout viewports use the embedding element's untransformed size.
+/// Screen metrics and scale remain page-wide; the owner is always an ancestor.
+pub fn getViewport(self: *Frame) Viewport {
+    var viewport = self.page.getViewport();
+    // Reuse ancestors within one lookup, not across independent layout reads.
+    if (viewport_depth == 0) viewport_epoch +%= 1;
+    viewport_depth += 1;
+    defer viewport_depth -= 1;
+    if (self._viewport_epoch == viewport_epoch) return self._last_viewport orelse viewport;
+    self._viewport_epoch = viewport_epoch;
+    const iframe = self.iframe orelse return viewport;
+    const parent = self.parent orelse return viewport;
+    const element = iframe.asElement();
+    viewport.screen_width = viewport.screen_width orelse viewport.width;
+    viewport.screen_height = viewport.screen_height orelse viewport.height;
+    viewport.width = 0;
+    viewport.height = 0;
+    if (element.asNode().isConnected() and element.ownerFrame(parent) == parent and element.isVisible(parent)) {
+        inline for (.{ Element.Axis.width, Element.Axis.height }) |axis| {
+            const value = element.getElementAxis(parent, axis).value;
+            @field(viewport, @tagName(axis)) = if (std.math.isFinite(value)) @intFromFloat(@round(std.math.clamp(value, 0, std.math.maxInt(u32)))) else 0;
+        }
+    }
+    if (self._last_viewport) |previous| {
+        if (!std.meta.eql(previous, viewport)) {
+            self._style_manager.dirty = true;
+            self.scheduleViewportUpdate();
+        }
+    }
+    self._last_viewport = viewport;
+    return viewport;
+}
+
+fn scheduleViewportUpdate(self: *Frame) void {
+    if (self.document._frame != self) return;
+    if (self._viewport_update_scheduled) return;
+    self._viewport_update_scheduled = true;
+    self.js.scheduler.add(self, struct {
+        fn run(ctx: *anyopaque) !?u32 {
+            const frame: *Frame = @ptrCast(@alignCast(ctx));
+            frame._viewport_update_scheduled = false;
+            frame.viewportChanged();
+            return null;
+        }
+    }.run, 0, .{ .name = "frame.viewportChanged" }) catch {
+        self._viewport_update_scheduled = false;
+    };
+}
