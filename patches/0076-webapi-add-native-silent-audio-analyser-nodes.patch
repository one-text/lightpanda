-        return self._interpretation;
+        return @tagName(self._interpretation);
     }
-    fn setInterpretation(self: *Node, value: []const u8) void {
-        inline for (.{ "speakers", "discrete" }) |mode| {
-            if (std.mem.eql(u8, value, mode)) self._interpretation = mode;
-        }
+    fn setInterpretation(self: *Node, value: js.Value) !void {
+        self._interpretation = std.meta.stringToEnum(Interpretation, try value.toStringSlice()) orelse return error.TypeError;
     }
-    fn connect(self: *Node, destination: *Node, _: ?u32, _: ?u32) !*Node {
-        if (self._audio != destination._audio) return error.InvalidAccessError;
-        // The destination is a sink, so no output index can be connected.
-        return error.IndexSizeError;
+    fn linkContext(self: *Node, local: *const js.Local) !void {
+        try self._audio.linkWrappers(local);
+        const data = try Speech.callbackData(self._proto, local);
+        const context = try local.zigValueToJs(self._audio, .{});
+        if (!(data.defineOwnProperty("context", context, 0) orelse false)) return error.JsException;
     }
-    fn disconnect(_: *Node, destination: ?js.Value, _: ?u32, _: ?u32) !void {
-        const value = destination orelse return;
-        if (value.isNumber()) return error.IndexSizeError;
-        _ = try value.toZig(*Node);
-        return error.InvalidAccessError;
+    fn connect(self: *Node, destination: *Node, output: ?u32, input: ?u32, exec: *js.Execution) !*Node {
+        if (self._audio != destination._audio) return error.InvalidAccessError;
+        if ((output orelse 0) >= self.getOutputs() or (input orelse 0) >= destination.getInputs()) return error.IndexSizeError;
+        for (self._connections.items) |node| {
+            if (node == destination) return destination;
+        }
+        try self._connections.ensureUnusedCapacity(self.subtype(Analyser)._arena.allocator(), 1);
+        const local = exec.js.local.?;
+        const data = try Speech.callbackData(self._proto, local);
+        var buffer: [40]u8 = undefined;
+        const key = try std.fmt.bufPrint(&buffer, "connection{d}", .{@intFromPtr(destination)});
+        const wrapper = try local.zigValueToJs(destination, .{});
+        if (!(data.defineOwnProperty(key, wrapper, 0) orelse false)) return error.JsException;
+        self._connections.appendAssumeCapacity(destination);
+        return destination;
+    }
+    fn removeConnection(self: *Node, index: usize, local: *const js.Local) !void {
+        const data = try Speech.callbackData(self._proto, local);
+        var buffer: [40]u8 = undefined;
+        const key = try std.fmt.bufPrint(&buffer, "connection{d}", .{@intFromPtr(self._connections.items[index])});
+        var deleted: js.v8.MaybeBool = undefined;
+        js.v8.v8__Object__Delete(data.handle, local.handle, @ptrCast(local.newString(key).handle), &deleted);
+        if (!deleted.has_value or !deleted.value) return error.JsException;
+        _ = self._connections.swapRemove(index);
+    }
+    fn disconnect(self: *Node, args: []const js.Value, exec: *js.Execution) !void {
+        const local = exec.js.local.?;
+        if (args.len > 0) {
+            const value = args[0];
+            const target = if (value.isObject()) value.toZig(*Node) catch null else null;
+            if (target) |destination| {
+                if (args.len > 1 and try args[1].toU32() >= self.getOutputs()) return error.IndexSizeError;
+                if (args.len > 2 and try args[2].toU32() >= destination.getInputs()) return error.IndexSizeError;
+                for (self._connections.items, 0..) |node, i| {
+                    if (node == destination) return self.removeConnection(i, local);
+                }
+                return error.InvalidAccessError;
+            }
+            // Only the one-argument overload accepts a numeric output index.
+            if (args.len > 1) return error.TypeError;
+            if (try value.toU32() >= self.getOutputs()) return error.IndexSizeError;
+        }
+        while (self._connections.items.len > 0) try self.removeConnection(self._connections.items.len - 1, local);
     }
     pub const JsApi = struct {
         pub const bridge = js.Bridge(Node);
