+pub const Analyser = struct {
+    pub const Proto = Node;
+    _proto: *Node,
+    _arena: *lp.Arena,
+    _rc: lp.RC = .{},
+    _fft_size: u32 = 2048,
+    _min_decibels: f64 = -100,
+    _max_decibels: f64 = -30,
+    _smoothing: f64 = 0.8,
+
+    const Options = struct {
+        channelCount: u32 = 2,
+        channelCountMode: ?js.Value = null,
+        channelInterpretation: ?js.Value = null,
+        fftSize: u32 = 2048,
+        maxDecibels: f64 = -30,
+        minDecibels: f64 = -100,
+        smoothingTimeConstant: f64 = 0.8,
+    };
+
+    fn init(context: *Base, options_: ?Analyser.Options, exec: *js.Execution) !*Analyser {
+        const options = options_ orelse Analyser.Options{};
+        var value = Analyser{ ._proto = undefined, ._arena = undefined, ._min_decibels = options.minDecibels, ._max_decibels = options.maxDecibels };
+        try value.setFftSize(options.fftSize);
+        try value.setMinDecibels(options.minDecibels);
+        try value.setMaxDecibels(options.maxDecibels);
+        try value.setSmoothing(options.smoothingTimeConstant);
+        var node = Node{ ._proto = undefined, ._audio = context._audio, ._type = .analyser_node, ._mode = .max };
+        try node.setChannels(options.channelCount);
+        if (options.channelCountMode) |mode| try node.setMode(mode);
+        if (options.channelInterpretation) |interpretation| try node.setInterpretation(interpretation);
+        const arena = try exec.getArena(.tiny, "AnalyserNode");
+        value._arena = arena;
+        const self = Factory.chainedWithAllocator(arena.allocator(), .{
+            EventTarget{ ._type = .audio_node },
+            node,
+            value,
+        }) catch |err| {
+            arena.release();
+            return err;
+        };
+        context._audio.acquireRef();
+        // Hold the native node until wrapper creation has either succeeded or failed.
+        self.acquireRef();
+        defer self.releaseRef(exec.page);
+        try self._proto.linkContext(exec.js.local.?);
+        return self;
+    }
+    pub fn acquireRef(self: *Analyser) void {
+        self._rc.acquire();
+    }
+    pub fn releaseRef(self: *Analyser, page: *Page) void {
+        self._rc.release(self, page);
+    }
+    pub fn deinit(self: *Analyser, page: *Page) void {
+        const audio = self._proto._audio;
+        var entry = audio._listener_roots.first;
+        while (entry) |node| {
+            const root: *ListenerRoot = @fieldParentPtr("node", node);
+            entry = node.next;
+            if (root.target != self._proto._proto) continue;
+            const listener = root.listener;
+            const list = audio._events.getListeners(root.target, listener.typ).?;
+            // Detach signal dependents immediately, even during another target's dispatch.
+            listener.on_remove = null;
+            audio._events.removeListener(list, listener);
+            root.dispose(null);
+        }
+        self._arena.release();
+        audio.releaseRef(page);
+    }
+    fn creationContext(self: *const Analyser, local: *const js.Local) *const js.v8.Context {
+        return self._proto._audio.creationContext(local);
+    }
+    fn getFftSize(self: *const Analyser) u32 {
+        return self._fft_size;
+    }
+    fn setFftSize(self: *Analyser, value: u32) !void {
+        if (value < 32 or value > 32768 or !std.math.isPowerOfTwo(value)) return error.IndexSizeError;
+        self._fft_size = value;
+    }
+    fn getFrequencyBinCount(self: *const Analyser) u32 {
+        return self._fft_size / 2;
+    }
+    fn getMinDecibels(self: *const Analyser) f64 {
+        return self._min_decibels;
+    }
+    fn setMinDecibels(self: *Analyser, value: f64) !void {
+        if (!std.math.isFinite(value)) return error.TypeError;
+        if (value >= self._max_decibels) return error.IndexSizeError;
+        self._min_decibels = value;
+    }
+    fn getMaxDecibels(self: *const Analyser) f64 {
+        return self._max_decibels;
+    }
+    fn setMaxDecibels(self: *Analyser, value: f64) !void {
+        if (!std.math.isFinite(value)) return error.TypeError;
+        if (value <= self._min_decibels) return error.IndexSizeError;
+        self._max_decibels = value;
+    }
+    fn getSmoothing(self: *const Analyser) f64 {
+        return self._smoothing;
+    }
+    fn setSmoothing(self: *Analyser, value: f64) !void {
+        if (!std.math.isFinite(value)) return error.TypeError;
+        if (value < 0 or value > 1) return error.IndexSizeError;
+        self._smoothing = value;
+    }
+    fn readback(comptime T: type, array: js.Value, count: u32, silence: T) !void {
+        if (comptime T == f32) {
+            if (!array.isFloat32Array()) return error.TypeError;
+        } else {
+            if (!array.isUint8Array()) return error.TypeError;
+        }
+        const buffer = js.v8.v8__ArrayBufferView__Buffer(@ptrCast(array.handle)).?;
+        if (js.arrayBufferIsShared(buffer)) return error.TypeError;
+        const values = try array.toZig([]T);
+        // The supported graph has no signal sources: all inputs are silence.
+        @memset(values[0..@min(values.len, count)], silence);
+    }
+    fn getFloatFrequencyData(self: *const Analyser, array: js.Value) !void {
+        try readback(f32, array, self.getFrequencyBinCount(), -std.math.inf(f32));
+    }
+    fn getByteFrequencyData(self: *const Analyser, array: js.Value) !void {
+        try readback(u8, array, self.getFrequencyBinCount(), 0);
+    }
+    fn getFloatTimeDomainData(self: *const Analyser, array: js.Value) !void {
+        try readback(f32, array, self._fft_size, 0);
+    }
+    fn getByteTimeDomainData(self: *const Analyser, array: js.Value) !void {
+        try readback(u8, array, self._fft_size, 128);
+    }
+
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(Analyser);
+        pub const Meta = struct {
+            pub const name = "AnalyserNode";
+            pub const prototype_chain = bridge.prototypeChain();
+            pub const creation_context = Analyser.creationContext;
+            pub var class_id: bridge.ClassId = undefined;
+        };
+        pub const constructor = bridge.constructor(Analyser.init, .{});
+        pub const fftSize = bridge.accessor(getFftSize, setFftSize, .{});
+        pub const frequencyBinCount = bridge.accessor(getFrequencyBinCount, null, .{});
+        pub const minDecibels = bridge.accessor(getMinDecibels, setMinDecibels, .{});
+        pub const maxDecibels = bridge.accessor(getMaxDecibels, setMaxDecibels, .{});
+        pub const smoothingTimeConstant = bridge.accessor(getSmoothing, setSmoothing, .{});
+        pub const getFloatFrequencyData = bridge.function(Analyser.getFloatFrequencyData, .{});
+        pub const getByteFrequencyData = bridge.function(Analyser.getByteFrequencyData, .{});
+        pub const getFloatTimeDomainData = bridge.function(Analyser.getFloatTimeDomainData, .{});
+        pub const getByteTimeDomainData = bridge.function(Analyser.getByteTimeDomainData, .{});
+    };
+};
+
 pub const Destination = struct {
     pub const Proto = Node;
     _proto: *Node,
