+        return Audio;
+    }
+    pub fn subtype(self: *Base, comptime _: type) *Audio {
+        return self._audio;
+    }
+    fn getDestination(self: *const Base, exec: *js.Execution) !*Destination {
+        try self._audio.linkWrappers(exec.js.local.?);
+        return self._audio._destination;
+    }
+    fn getSampleRate(self: *const Base) f64 {
+        return self._audio._sample_rate;
+    }
+    fn getCurrentTime(self: *const Base) f64 {
+        return self._audio.currentTime();
+    }
+    fn getState(self: *const Base) []const u8 {
+        return @tagName(self._audio._state);
+    }
+    fn getHandler(self: *const Base) ?js.Object.Global {
+        return Speech.Binding(Audio, 0).get(self._audio);
+    }
+    fn setHandler(self: *Base, value: js.Value, exec: *js.Execution) !void {
+        try Speech.Binding(Audio, 0).set(self._audio, value, exec);
+    }
