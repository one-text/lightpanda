+
+const std = @import("std");
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Page = @import("../Page.zig");
+const Factory = @import("../Factory.zig");
+const EventManagerBase = @import("../EventManagerBase.zig");
+const EventTarget = @import("EventTarget.zig");
+const Event = @import("Event.zig");
+const DOMException = @import("DOMException.zig");
+const Speech = @import("SpeechSynthesis.zig");
+const Audio = @This();
+
+pub fn registerTypes() []const type {
+    return &.{ Audio, Base, Node, Destination };
+}
+
+pub const Proto = Base;
+_proto: *Base,
+_arena: *lp.Arena,
+_rc: lp.RC = .{},
+_context: ?*js.Context,
+_context_node: std.DoublyLinkedList.Node = .{},
+_destination: *Destination = undefined,
+_events: EventManagerBase,
+_handlers: [1]Speech.Handler = undefined,
+_listener_roots: std.DoublyLinkedList = .{},
+_listener_pool: std.heap.MemoryPool(ListenerRoot) = .empty,
+_listener_local: ?*const js.Local = null,
+_state: State = .suspended,
+_sample_rate: f64,
+_base_latency: f64,
+_elapsed: f64 = 0,
+_started_us: u64 = 0,
+_user_suspended: bool = false,
+_pending: std.DoublyLinkedList = .{},
+
+const State = enum { suspended, running, closed };
+const Options = struct { latencyHint: ?js.Value = null, sampleRate: ?js.Value = null };
+
+fn init(options_: ?Options, exec: *js.Execution) !*Audio {
+    const options = options_ orelse Options{};
+    // Synthetic built-in stereo output on the MacBook Neo, never host audio.
+    const rate: f64 = if (options.sampleRate) |value| @as(f32, @floatCast(try value.toF64())) else 48000;
+    if (!std.math.isFinite(rate)) return error.TypeError;
+    if (rate < 3000 or rate > 768000) return error.NotSupported;
+    var frames: f64 = 128;
+    if (options.latencyHint) |hint| {
+        if (hint.isNumber()) {
+            const seconds = try hint.toF64();
+            if (!std.math.isFinite(seconds)) return error.TypeError;
+            frames = @min(8192, @max(128, @ceil(seconds * 48000 / 128) * 128));
+        } else {
+            const category = try hint.toStringSlice();
+            if (std.mem.eql(u8, category, "balanced")) {
+                frames = 512;
+            } else if (std.mem.eql(u8, category, "playback")) {
+                frames = 1024;
+            } else if (!std.mem.eql(u8, category, "interactive")) return error.TypeError;
+        }
+    }
+    const arena = try exec.getArena(.small, "AudioContext");
+    errdefer arena.release();
+    const self = try Factory.chainedWithAllocator(arena.allocator(), .{
+        EventTarget{ ._type = .base_audio_context },
+        Base{ ._proto = undefined, ._audio = undefined },
+        Audio{ ._proto = undefined, ._arena = arena, ._context = exec.js, ._events = .init(arena.allocator()), ._sample_rate = rate, ._base_latency = @ceil(frames * rate / 48000) / rate },
+    });
+    self._proto._audio = self;
+    self._destination = try Factory.chainedWithAllocator(arena.allocator(), .{
+        EventTarget{ ._type = .audio_node },
+        Node{ ._proto = undefined, ._audio = self },
+        Destination{ ._proto = undefined },
+    });
+    self._handlers[0] = .{ .target = self._proto._proto, .events = &self._events, .name = "statechange", .weak = true };
+    if (self.allowed()) {
+        self._state = .running;
+        self._started_us = lp.datetime.microTimestamp(.boot);
+    }
+    exec.js.audio_contexts.append(&self._context_node);
+    return self;
+}
+
+pub fn acquireRef(self: *Audio) void {
+    self._rc.acquire();
+}
+pub fn releaseRef(self: *Audio, page: *Page) void {
+    self._rc.release(self, page);
+}
+pub fn deinit(self: *Audio, _: *Page) void {
+    if (self._context) |ctx| ctx.audio_contexts.remove(&self._context_node);
+    for (&self._handlers) |*handler| handler.deinit();
+    while (self._listener_roots.first) |node| {
+        const root: *ListenerRoot = @fieldParentPtr("node", node);
+        root.dispose(null);
+    }
+    self._arena.release();
+}
+pub fn detach(self: *Audio) void {
+    const ctx = self._context orelse return;
+    ctx.audio_contexts.remove(&self._context_node);
+    self.freeze();
+    self._context = null;
+    self._state = .closed;
+    // Releasing the last waiting operation can collect this context.
+    self.acquireRef();
+    defer self.releaseRef(ctx.page);
+    while (self._pending.first) |node| {
+        const task: *Task = @fieldParentPtr("node", node);
+        task.abandon();
+    }
+}
+fn creationContext(self: *const Audio, local: *const js.Local) *const js.v8.Context {
+    return if (self._context) |ctx| js.v8.v8__Global__Get(&ctx.handle, local.isolate.handle).? else local.handle;
+}
+fn linkWrappers(self: *Audio, local: *const js.Local) !void {
+    const context = try local.zigValueToJs(self, .{});
+    const destination = try local.zigValueToJs(self._destination, .{});
+    const context_data = try Speech.callbackData(self._proto._proto, local);
+    const destination_data = try Speech.callbackData(self._destination._proto._proto, local);
+    // Both wrappers own the other's callback edges, but the JS cycle is collectible.
+    if (!(context_data.defineOwnProperty("destination", destination, 0) orelse false)) return error.JsException;
+    if (!(destination_data.defineOwnProperty("context", context, 0) orelse false)) return error.JsException;
+}
+fn allowed(self: *const Audio) bool {
+    const ctx = self._context orelse return false;
+    return ctx.global.frame.window._navigator._speech_has_activation;
+}
+
+// Called after trusted activation has propagated to the frame's navigator.
+pub fn notifyActivation(ctx: *js.Context) void {
+    var entry = ctx.audio_contexts.first;
+    while (entry) |node| {
+        const self: *Audio = @fieldParentPtr("_context_node", node);
+        entry = node.next;
+        if (!self._user_suspended and self._pending.first != null) {
+            self.startResume() catch |err| ctx.page.recordJsError(err);
+        }
+    }
+}
+
+pub fn registerListenerAt(self: *Audio, target: *EventTarget, typ: []const u8, callback: EventManagerBase.Callback, options: EventManagerBase.RegisterOptions, exec: *js.Execution) !void {
+    const listener = (try self._events.register(target, typ, callback, options)) orelse return;
+    const slot = switch (listener.function) {
+        .value => |value| value.slot,
+        .object => |value| value.slot,
+        .string => unreachable,
+    };
+    errdefer {
+        self._events.remove(target, typ, callback, options.capture);
+        slot.release();
+    }
+    const root = try self._listener_pool.create(self._arena.allocator());
+    errdefer self._listener_pool.destroy(root);
+    const value = switch (callback) {
+        .function => |f| js.Value{ .local = f.local, .handle = @ptrCast(f.handle) },
+        .object => |o| o.toValue(),
+    };
+    const data = try Speech.callbackData(target, exec.js.local.?);
+    root.* = .{ .audio = self, .target = target, .listener = listener, .slot = slot, .data = try data.persist(), .signal = options.signal };
+    errdefer root.data.release();
+    const key = try std.fmt.bufPrint(&root.key, "listener{d}", .{@intFromPtr(root)});
+    root.key_len = key.len;
+    if (!(data.defineOwnProperty(key, value, 0) orelse false)) return error.JsException;
+    if (options.signal) |signal| try signal._dependents.append(exec.arena, .{ .audio_listener = root });
+    js.v8.v8__Global__SetWeak(&slot.handle);
+    js.v8.v8__Global__SetWeak(&root.data.slot.handle);
+    self._listener_roots.append(&root.node);
+    listener.on_remove = .{ .ctx = root, .callback = ListenerRoot.removed };
+}
+
+pub fn removeListenerAt(self: *Audio, target: *EventTarget, typ: []const u8, callback: EventManagerBase.Callback, capture: bool, exec: *js.Execution) void {
+    const previous_local = self._listener_local;
+    self._listener_local = exec.js.local.?;
+    defer self._listener_local = previous_local;
+    self._events.remove(target, typ, callback, capture);
+}
+
+pub const ListenerRoot = struct {
+    audio: *Audio,
+    target: *EventTarget,
+    listener: *EventManagerBase.Listener,
+    slot: *js.GlobalSlot,
+    data: js.Object.Global,
+    signal: ?*@import("AbortSignal.zig"),
+    node: std.DoublyLinkedList.Node = .{},
+    key: [32]u8 = undefined,
+    key_len: usize = 0,
+
+    fn dispose(self: *ListenerRoot, local: ?*const js.Local) void {
+        const audio = self.audio;
+        if (local) |l| {
+            const data = self.data.local(l);
+            var deleted: js.v8.MaybeBool = undefined;
+            js.v8.v8__Object__Delete(data.handle, l.handle, @ptrCast(l.newString(self.key[0..self.key_len]).handle), &deleted);
+        }
+        if (self.signal) |signal| {
+            for (signal._dependents.items, 0..) |dep, i| {
+                if (dep == .audio_listener and dep.audio_listener == self) {
+                    _ = signal._dependents.swapRemove(i);
+                    break;
+                }
+            }
+        }
+        audio._listener_roots.remove(&self.node);
+        self.slot.release();
+        self.data.release();
+        audio._listener_pool.destroy(self);
+    }
+    fn removed(ptr: *anyopaque) void {
+        const self: *ListenerRoot = @ptrCast(@alignCast(ptr));
+        self.dispose(self.audio._listener_local);
+    }
+    pub fn abort(self: *ListenerRoot, exec: *const js.Execution) void {
+        const audio = self.audio;
+        var scope: js.Local.Scope = undefined;
+        exec.js.localScope(&scope);
+        defer scope.deinit();
+        // Aborting a signal need not otherwise retain the listener's target.
+        _ = scope.local.zigValueToJs(self.target, .{}) catch return;
+        const previous_local = audio._listener_local;
+        audio._listener_local = &scope.local;
+        defer audio._listener_local = previous_local;
+        const list = audio._events.getListeners(self.target, self.listener.typ) orelse return;
+        audio._events.removeListener(list, self.listener);
+    }
+};
+
+pub fn dispatchAt(self: *Audio, target: *EventTarget, event: *Event, exec: *js.Execution) !void {
+    var scope: js.Local.Scope = undefined;
+    exec.js.localScope(&scope);
+    defer scope.deinit();
+    const local = &scope.local;
+    const previous_local = self._listener_local;
+    self._listener_local = local;
+    defer self._listener_local = previous_local;
+    // Retained Event.target must keep the native context alive as well.
+    const wrapper = try local.zigValueToJs(event, .{});
+    const owner = try local.zigValueToJs(target, .{});
+    const key: *const js.v8.Private = @ptrCast(js.v8.v8__Global__Get(&local.ctx.env.private_symbols.speech_callbacks.handle, local.isolate.handle).?);
+    var saved: js.v8.MaybeBool = undefined;
+    js.v8.v8__Object__SetPrivate(@ptrCast(wrapper.handle), local.handle, key, owner.handle, &saved);
+    if (!saved.has_value or !saved.value) return error.JsException;
+    try Speech.dispatchDirect(target, &self._events, event, exec);
+}
+fn currentTime(self: *const Audio) f64 {
+    const seconds = self._elapsed + if (self._state == .running)
+        @as(f64, @floatFromInt(lp.datetime.microTimestamp(.boot) - self._started_us)) / 1e6
+    else
+        0;
+    return @floor(seconds * self._sample_rate / 128) * 128 / self._sample_rate;
+}
+fn freeze(self: *Audio) void {
+    self._elapsed = self.currentTime();
+}
+fn closedError(local: *const js.Local) !js.Value {
+    const exception = try local.ctx.execution._factory.create(DOMException.init("The audio context is closed", "InvalidStateError"));
+    return local.zigValueToJs(exception, .{});
+}
+fn result(exec: *js.Execution, reject: bool) !js.Promise {
+    const local = exec.js.local.?;
+    const resolver = js.PromiseResolver.init(local);
+    if (reject) {
+        try resolver.rejectValue(try closedError(local));
+    } else try resolver.resolveValue(try local.zigValueToJs({}, .{}));
+    return resolver.promise();
+}
+fn @"suspend"(self: *Audio, exec: *js.Execution) !js.Promise {
+    if (self._state == .closed or self._context == null) return result(exec, true);
+    self._user_suspended = true;
+    const changed = self._state != .suspended;
+    self.freeze();
+    self._state = .suspended;
+    // An accepted resume must complete before a later suspend, not disappear.
+    var node = self._pending.first;
+    while (node) |entry| : (node = entry.next) {
+        const task: *Task = @fieldParentPtr("node", entry);
+        if (task.kind == .@"resume" and task.scheduled) return self.transition(.@"suspend", exec);
+    }
+    if (changed) try self.schedule(.event, exec, exec.js.local.?);
+    return result(exec, false);
+}
+fn @"resume"(self: *Audio, exec: *js.Execution) !js.Promise {
+    if (self._state == .closed or self._context == null) return result(exec, true);
+    self._user_suspended = false;
+    if (self._state == .running) return result(exec, false);
+    return self.transition(.@"resume", exec);
+}
+fn transition(self: *Audio, kind: Task.Kind, exec: *js.Execution) !js.Promise {
+    const resolver = js.PromiseResolver.init(exec.js.local.?);
+    const task = try self.createTask(kind, exec, exec.js.local.?);
+    errdefer task.dispose();
+    task.resolver = try resolver.persist();
+    self._pending.append(&task.node);
+    if (kind == .@"suspend") try task.enqueue() else try self.startResume();
+    return resolver.promise();
+}
+fn startResume(self: *Audio) !void {
+    if (self._state == .closed or !self.allowed()) return;
+    var entry = self._pending.first;
+    while (entry) |node| : (entry = node.next) {
+        const task: *Task = @fieldParentPtr("node", node);
+        if (task.kind == .@"resume" and !task.scheduled) try task.enqueue();
+    }
+}
+fn close(self: *Audio, exec: *js.Execution) !js.Promise {
+    if (self._state == .closed or self._context == null) return result(exec, true);
+    self.freeze();
+    self._state = .closed;
+    while (self._pending.first) |node| {
+        const task: *Task = @fieldParentPtr("node", node);
+        try task.settle(exec.js.local.?, true);
+        if (!task.scheduled) task.dispose();
+    }
+    try self.schedule(.event, exec, exec.js.local.?);
+    return result(exec, false);
+}
+fn getBaseLatency(self: *const Audio) f64 {
+    return self._base_latency;
+}
+fn getOutputLatency(_: *const Audio) f64 {
+    return 128.0 / 48000.0;
+}
+fn getOutputTimestamp(self: *const Audio, exec: *js.Execution) struct { contextTime: f64, performanceTime: f64 } {
+    if (self._state != .running) return .{ .contextTime = 0, .performanceTime = 0 };
+    return .{ .contextTime = @max(0, self.currentTime() - self._base_latency), .performanceTime = exec.js.global.frame.window._performance.now() };
+}
+
+const Task = struct {
+    audio: *Audio,
+    arena: *lp.Arena,
+    root: js.Value.Global,
+    kind: Kind,
+    node: std.DoublyLinkedList.Node = .{},
+    resolver: ?js.PromiseResolver.Global = null,
+    scheduled: bool = false,
+    const Kind = enum { @"resume", @"suspend", event };
+
+    fn enqueue(self: *Task) !void {
+        const ctx = self.audio._context orelse return error.InvalidStateError;
+        try ctx.scheduler.add(self, Task.run, 0, .{ .name = "AudioContext", .finalizer = Task.cancel });
+        self.scheduled = true;
+    }
+    fn abandon(self: *Task) void {
+        if (self.resolver) |resolver| {
+            self.audio._pending.remove(&self.node);
+            self.resolver = null;
+            resolver.release();
+        }
+        if (!self.scheduled) self.dispose();
+    }
+    fn dispose(self: *Task) void {
+        if (self.resolver) |resolver| {
+            self.audio._pending.remove(&self.node);
+            resolver.release();
+        }
+        self.root.release();
+        self.arena.release();
+    }
+    fn settle(self: *Task, local: *const js.Local, reject: bool) !void {
+        const resolver = self.resolver orelse return;
+        self.audio._pending.remove(&self.node);
+        self.resolver = null;
+        defer resolver.release();
+        if (reject) {
+            try resolver.local(local).rejectValue(try closedError(local));
+        } else try resolver.local(local).resolveValue(try local.zigValueToJs({}, .{}));
+    }
+    fn cancel(ptr: *anyopaque) void {
+        const self: *Task = @ptrCast(@alignCast(ptr));
+        self.dispose();
+    }
+    fn run(ptr: *anyopaque) !?u32 {
+        const self: *Task = @ptrCast(@alignCast(ptr));
+        defer self.dispose();
+        const audio = self.audio;
+        const ctx = audio._context orelse return null;
+        var scope: js.Local.Scope = undefined;
+        ctx.localScope(&scope);
+        defer scope.deinit();
+        defer scope.local.runMicrotasks();
+        if (self.kind == .event) {
+            const event = try Event.init("statechange", null, ctx.page);
+            event._is_trusted = true;
+            try audio.dispatchAt(audio._proto._proto, event, &ctx.execution);
+        } else {
+            if (audio._state == .closed) {
+                try self.settle(&scope.local, true);
+                return null;
+            }
+            const state: State = if (self.kind == .@"resume") .running else .suspended;
+            if (audio._state != state) {
+                audio.freeze();
+                audio._state = state;
+                if (state == .running) audio._started_us = lp.datetime.microTimestamp(.boot);
+                try audio.schedule(.event, &ctx.execution, &scope.local);
+            }
+            try self.settle(&scope.local, false);
+        }
+        return null;
+    }
+};
+fn createTask(self: *Audio, kind: Task.Kind, exec: *js.Execution, local: *const js.Local) !*Task {
+    const arena = try exec.getArena(.tiny, "AudioContext.task");
+    errdefer arena.release();
+    const root = try (try local.zigValueToJs(self, .{})).persist();
+    errdefer root.release();
+    const task = try arena.create(Task);
+    task.* = .{ .audio = self, .arena = arena, .root = root, .kind = kind };
+    return task;
+}
+fn schedule(self: *Audio, kind: Task.Kind, exec: *js.Execution, local: *const js.Local) !void {
+    const task = try self.createTask(kind, exec, local);
+    errdefer task.dispose();
+    try task.enqueue();
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(Audio);
+    pub const Meta = struct {
+        pub const name = "AudioContext";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub const creation_context = Audio.creationContext;
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const constructor = bridge.constructor(init, .{});
+    pub const baseLatency = bridge.accessor(getBaseLatency, null, .{});
+    pub const outputLatency = bridge.accessor(getOutputLatency, null, .{});
+    pub const getOutputTimestamp = bridge.function(Audio.getOutputTimestamp, .{});
+    pub const @"suspend" = bridge.function(Audio.@"suspend", .{});
+    pub const @"resume" = bridge.function(Audio.@"resume", .{});
