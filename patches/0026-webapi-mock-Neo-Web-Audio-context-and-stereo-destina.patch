+        pub const currentTime = bridge.accessor(getCurrentTime, null, .{});
+        pub const state = bridge.accessor(getState, null, .{});
+        pub const onstatechange = bridge.accessor(getHandler, setHandler, .{});
+    };
+};
+
+pub const Node = struct {
+    pub const Proto = EventTarget;
+    _proto: *EventTarget,
+    _audio: *Audio,
+    _type: Type = .audio_destination_node,
+    _channels: u32 = 2,
+    _mode: []const u8 = "explicit",
+    _interpretation: []const u8 = "speakers",
+    pub const Type = enum { audio_destination_node };
+    pub fn Subtype(comptime _: Type) type {
+        return Destination;
+    }
+    pub fn subtype(self: *Node, comptime _: type) *Destination {
+        return @ptrFromInt(@intFromPtr(self) + comptime Factory.protoOffset(Destination));
+    }
+    pub fn acquireRef(self: *Node) void {
+        self._audio.acquireRef();
+    }
+    pub fn releaseRef(self: *Node, page: *Page) void {
+        self._audio.releaseRef(page);
+    }
+    fn getContext(self: *const Node, exec: *js.Execution) !*Audio {
+        try self._audio.linkWrappers(exec.js.local.?);
+        return self._audio;
+    }
+    fn getInputs(_: *const Node) u32 {
+        return 1;
+    }
+    fn getOutputs(_: *const Node) u32 {
+        return 0;
+    }
+    fn getChannels(self: *const Node) u32 {
+        return self._channels;
+    }
+    fn setChannels(self: *Node, count: u32) !void {
+        if (count == 0) return error.NotSupported;
+        if (count > 2) return error.IndexSizeError;
+        self._channels = count;
+    }
+    fn getMode(self: *const Node) []const u8 {
+        return self._mode;
+    }
+    fn setMode(self: *Node, value: []const u8) void {
+        inline for (.{ "max", "clamped-max", "explicit" }) |mode| {
+            if (std.mem.eql(u8, value, mode)) self._mode = mode;
+        }
+    }
+    fn getInterpretation(self: *const Node) []const u8 {
+        return self._interpretation;
+    }
+    fn setInterpretation(self: *Node, value: []const u8) void {
+        inline for (.{ "speakers", "discrete" }) |mode| {
+            if (std.mem.eql(u8, value, mode)) self._interpretation = mode;
+        }
+    }
+    fn connect(self: *Node, destination: *Node, _: ?u32, _: ?u32) !*Node {
+        if (self._audio != destination._audio) return error.InvalidAccessError;
+        // The destination is a sink, so no output index can be connected.
+        return error.IndexSizeError;
+    }
+    fn disconnect(_: *Node, destination: ?js.Value, _: ?u32, _: ?u32) !void {
+        const value = destination orelse return;
+        if (value.isNumber()) return error.IndexSizeError;
+        _ = try value.toZig(*Node);
+        return error.InvalidAccessError;
+    }
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(Node);
+        pub const Meta = struct {
+            pub const name = "AudioNode";
+            pub const prototype_chain = bridge.prototypeChain();
+            pub var class_id: bridge.ClassId = undefined;
+        };
+        pub const context = bridge.accessor(getContext, null, .{});
+        pub const numberOfInputs = bridge.accessor(getInputs, null, .{});
+        pub const numberOfOutputs = bridge.accessor(getOutputs, null, .{});
+        pub const channelCount = bridge.accessor(getChannels, setChannels, .{});
+        pub const channelCountMode = bridge.accessor(getMode, setMode, .{});
+        pub const channelInterpretation = bridge.accessor(getInterpretation, setInterpretation, .{});
+        pub const connect = bridge.function(Node.connect, .{});
+        pub const disconnect = bridge.function(Node.disconnect, .{});
+    };
+};
+
+pub const Destination = struct {
+    pub const Proto = Node;
+    _proto: *Node,
+    fn getMaxChannels(_: *const Destination) u32 {
+        return 2;
+    }
+    fn creationContext(self: *const Destination, local: *const js.Local) *const js.v8.Context {
+        return self._proto._audio.creationContext(local);
+    }
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(Destination);
+        pub const Meta = struct {
+            pub const name = "AudioDestinationNode";
+            pub const prototype_chain = bridge.prototypeChain();
+            pub const creation_context = Destination.creationContext;
+            pub var class_id: bridge.ClassId = undefined;
+        };
+        pub const maxChannelCount = bridge.accessor(getMaxChannels, null, .{});
+    };
+};
