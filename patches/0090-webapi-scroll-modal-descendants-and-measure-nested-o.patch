+
+// Scrollable overflow can extend past an auto-sized child's synthetic box.
+// Cache both flow axes in one preorder pass instead of recounting sibling
+// subtrees per descendant. Clipping and escaping positioned subtrees do not
+// contribute, but still occupy preorder slots in the synthetic flow model.
+fn scrollContentAxis(self: *Element, frame: *Frame, comptime axis: Axis) f64 {
+    var extent = self.contentAxis(frame, axis);
+    const owner = self.ownerFrame(frame) orelse return extent;
+    const manager = &owner._style_manager;
+    const axes = manager.overflowAxes(self);
+    if (!(if (axis == .width) axes.x else axes.y)) return extent;
+    const origin = self.clientCoordinate(owner, axis, null);
+    const scroll: f64 = @floatFromInt(if (axis == .width) self.getScrollLeft(owner) else self.getScrollTop(owner));
+    var positions: FlowPositions = .empty;
+    defer positions.deinit(owner.local_arena);
+    const Entry = struct { node: *Node, x: f64, excluded: bool };
+    var stack: std.ArrayList(Entry) = .empty;
+    defer stack.deinit(owner.local_arena);
+    stack.append(owner.local_arena, .{ .node = self.asNode(), .x = self.flowHorizontalPosition(owner), .excluded = false }) catch return extent;
+    var y = self.flowCoordinate(owner, .height, null);
+    while (stack.pop()) |entry| {
+        var excluded = entry.excluded;
+        if (entry.node.is(Element)) |element| {
+            positions.put(owner.local_arena, element, .{ .x = entry.x, .y = y }) catch return extent;
+            if (element != self) {
+                excluded = excluded or manager.hasDisplayNone(element);
+                const position = element.positionStyle(owner);
+                if (!excluded and (position == .absolute or position == .fixed)) {
+                    excluded = !element.scrollsWithAncestor(self, owner);
+                }
+                if (!excluded) {
+                    // Direct children are already included by contentAxis.
+                    if (layoutParent(element) != self) {
+                        const rect = element.clientRectValuesUntil(owner, &positions, self);
+                        const end = (if (axis == .width) rect.x + rect.width else rect.y + rect.height) - origin + scroll;
+                        extent = @max(extent, end);
+                    }
+                    const clips = manager.overflowClipAxes(element);
+                    excluded = if (axis == .width) clips.x else clips.y;
+                }
+            }
+        }
+        y += 5;
+        // Push in reverse order while carrying horizontal sibling prefixes.
+        var end_x = entry.x;
+        var child = entry.node.firstChild();
+        while (child) |node| : (child = node.nextSibling()) {
+            if (node.is(Element)) |element| {
+                if (!manager.hasDisplayNone(element)) end_x += element.getElementAxis(owner, .width).value;
+            }
+        }
+        child = entry.node.lastChild();
+        while (child) |node| : (child = node.previousSibling()) {
+            if (node.is(Element)) |element| {
+                if (!manager.hasDisplayNone(element)) end_x -= element.getElementAxis(owner, .width).value;
+            }
+            stack.append(owner.local_arena, .{ .node = node, .x = end_x, .excluded = excluded }) catch return extent;
+        }
+    }
+    return extent;
 }
 
