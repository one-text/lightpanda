+// Out-of-flow boxes skip scrollers between them and their containing block.
+fn scrollsWithAncestor(self: *Element, ancestor: *Element, frame: *Frame) bool {
+    var current = self;
+    while (current != ancestor) {
+        const position = current.positionStyle(frame);
+        current = (if (position == .absolute or position == .fixed)
+            current.positionedContainingBlock(frame, position == .fixed)
+        else
+            layoutParent(current)) orelse return false;
+    }
+    return true;
+}
