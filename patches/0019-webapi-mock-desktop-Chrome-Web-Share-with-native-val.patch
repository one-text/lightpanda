+pub fn setWebShareExposure(self: *const Env, ctx: *Context, v8_context: *const v8.Context, global_obj: *const v8.Object, secure: bool) void {
+    if (secure == (ctx.web_share_bindings == null)) return;
+    const isolate = self.isolate.handle;
+    const names = &self.disabled_api_names;
+    const constructor = v8.v8__Object__Get(global_obj, v8_context, @ptrCast(names.get(isolate, "navigator"))) orelse return;
+    const prototype = v8.v8__Object__Get(@ptrCast(constructor), v8_context, @ptrCast(names.get(isolate, "prototype"))) orelse return;
+    const keys = [_]*const v8.String{ names.get(isolate, "can_share"), names.get(isolate, "share") };
+    var result: v8.MaybeBool = undefined;
+    if (secure) {
+        for (keys, &ctx.web_share_bindings.?) |key, *binding| {
+            v8.v8__Object__DefineOwnProperty(@ptrCast(prototype), v8_context, @ptrCast(key), v8.v8__Global__Get(binding, isolate), v8.None, &result);
+            v8.v8__Global__Reset(binding);
+        }
+        ctx.web_share_bindings = null;
+    } else {
+        var bindings: [2]v8.Global = undefined;
+        for (keys, &bindings) |key, *binding| {
+            const method = v8.v8__Object__Get(@ptrCast(prototype), v8_context, @ptrCast(key)) orelse return;
+            v8.v8__Global__New(isolate, method, binding);
+            v8.v8__Object__Delete(@ptrCast(prototype), v8_context, @ptrCast(key), &result);
+        }
+        ctx.web_share_bindings = bindings;
+    }
+}
+
 fn deletePrototypeMember(self: *const Env, v8_context: *const v8.Context, global_obj: *const v8.Object, comptime interface: []const u8, comptime member: []const u8) void {
