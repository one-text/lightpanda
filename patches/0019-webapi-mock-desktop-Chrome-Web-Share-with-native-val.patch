+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+const std = @import("std");
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Frame = @import("../Frame.zig");
+const URL = @import("../URL.zig");
+const Navigator = @import("Navigator.zig");
+const File = @import("File.zig");
+const Event = @import("Event.zig");
+const DOMException = @import("DOMException.zig");
+const KeyboardEvent = @import("event/KeyboardEvent.zig");
+const PointerEvent = @import("event/PointerEvent.zig");
+
+const Data = struct {
+    files: []*File = &.{},
+    text: ?js.String = null,
+    title: ?js.String = null,
+    url: ?[]const u8 = null,
+    url_length: usize = 0,
+
+    fn parse(value: ?js.Value, exec: *js.Execution) !Data {
+        const input = value orelse return .{};
+        if (input.isNullOrUndefined()) return .{};
+        if (!input.isObject()) return error.TypeError;
+        const object = input.toObject();
+        var data: Data = .{};
+        // Web IDL reads dictionary members in lexicographic order, without Has.
+        const files = try object.get("files");
+        if (!files.isUndefined()) {
+            const iterator = try files.iterator() orelse return error.TypeError;
+            var list: std.ArrayList(*File) = .empty;
+            while (try iterator.next()) |item| {
+                const file = item.toZig(*File) catch |err| {
+                    if (err == error.ExecutionTerminated) return err;
+                    closeIterator(iterator, exec.js.local.?);
+                    return error.TypeError;
+                };
+                try list.append(exec.call_arena, file);
+            }
+            data.files = list.items;
+        }
+        inline for (.{ "text", "title", "url" }) |name| {
+            const member = try object.get(name);
+            if (!member.isUndefined()) {
+                if (member.isSymbol()) return error.TypeError;
+                const string = try member.toString();
+                if (comptime std.mem.eql(u8, name, "url")) {
+                    data.url = try string.toSlice();
+                    data.url_length = @intCast(js.v8.v8__String__Length(string.handle));
+                } else {
+                    @field(data, name) = string;
+                }
+            }
+        }
+        return data;
+    }
+
+    fn valid(self: Data, frame: *Frame, exec: *js.Execution) !bool {
+        if (self.text == null and self.title == null and self.url == null and self.files.len == 0) return false;
+        if (self.url) |url| {
+            const resolved = URL.resolve(exec.call_arena, frame.base(), url, .{}) catch |err| {
+                if (err == error.TypeError) return false;
+                return err;
+            };
+            const scheme = URL.getProtocol(resolved);
+            if (!std.mem.eql(u8, scheme, "https:") and !std.mem.eql(u8, scheme, "http:") and
+                !std.mem.eql(u8, scheme, URL.getProtocol(frame.origin orelse ""))) return false;
+        }
+        return true;
+    }
+
+    fn safeToShare(self: Data) bool {
+        if (self.title) |title| if (js.v8.v8__String__Length(title.handle) > 16 * 1024) return false;
+        if (self.text) |text| if (js.v8.v8__String__Length(text.handle) > 1024 * 1024) return false;
+        if (self.url_length > 16 * 1024 or self.files.len > 10) return false;
+        var bytes: u64 = 0;
+        for (self.files) |file| {
+            bytes +|= file._proto._slice.len;
+            if (bytes > 50 * 1024 * 1024 or !safeFile(file)) return false;
+        }
+        return true;
+    }
+};
+
+pub fn canShare(self: *Navigator, value: ?js.Value, exec: *js.Execution) !bool {
+    const data = try Data.parse(value, exec);
+    if (!active(self)) return false;
+    const frame = self._frame.?;
+    return frame.isSecureContext() and allowed(frame) and try data.valid(frame, exec);
+}
+
+pub fn share(self: *Navigator, value: ?js.Value, exec: *js.Execution) !js.Promise {
+    const local = exec.js.local.?;
+    var caught: js.TryCatch = undefined;
+    caught.init(local);
+    defer caught.deinit();
+    return shareInternal(self, value, exec) catch |err| {
+        if (err == error.ExecutionTerminated or exec.js.env.terminatePending()) return error.ExecutionTerminated;
+        const resolver = local.createPromiseResolver();
+        if (caught.exceptionValue()) |exception| {
+            try resolver.rejectValue(exception);
+        } else if (err == error.TypeError) {
+            resolver.rejectError("navigator.share", .{ .type_error = "Invalid share data" });
+        } else {
+            const exception = switch (err) {
+                error.NotAllowedError => DOMException.init("Permission denied", "NotAllowedError"),
+                error.InvalidStateError => DOMException.init("The document is not active or a share is pending", "InvalidStateError"),
+                else => return err,
+            };
+            // Rejections may be retained by another realm after this context dies.
+            resolver.reject("navigator.share", try exec._factory.create(exception));
+        }
+        return resolver.promise();
+    };
+}
+
+fn shareInternal(self: *Navigator, value: ?js.Value, exec: *js.Execution) !js.Promise {
+    const data = try Data.parse(value, exec);
+    if (!active(self)) return error.InvalidStateError;
+    const frame = self._frame.?;
+    if (!frame.isSecureContext() or !allowed(frame)) return error.NotAllowedError;
+    if (self._share_pending) return error.InvalidStateError;
+    const activation = self._share_activation_ms orelse return error.NotAllowedError;
+    if (lp.datetime.milliTimestamp(.boot) - activation >= 5000) return error.NotAllowedError;
+    consumeActivation(root(frame));
+    if (!try data.valid(frame, exec)) return error.TypeError;
+    if (!data.safeToShare()) return error.NotAllowedError;
+
+    const resolver = exec.js.local.?.createPromiseResolver();
+    const arena = try exec.getArena(.tiny, "navigator.share");
+    errdefer arena.release();
+    const task = try arena.create(ShareTask);
+    const exception = try exec._factory.create(DOMException.init("Share canceled", "AbortError"));
+    task.* = .{
+        .navigator = self,
+        .exec = &frame.js.execution,
+        .resolver = try resolver.persist(),
+        .arena = arena,
+        .exception = exception,
+    };
+    errdefer task.resolver.release();
+    try frame.js.scheduler.add(task, ShareTask.run, 0, .{
+        .name = "navigator.share",
+        .finalizer = ShareTask.finalize,
+    });
+    self._share_pending = true;
+    return resolver.promise();
+}
+
+fn active(navigator: *Navigator) bool {
+    if (navigator._pdf_detached) return false;
+    const frame = navigator._frame orelse return false;
+    return frame.document._frame == frame;
+}
+
+const ShareTask = struct {
+    navigator: *Navigator,
+    exec: *js.Execution,
+    resolver: js.PromiseResolver.Global,
+    arena: *lp.Arena,
+    exception: *DOMException,
+    settled: bool = false,
+
+    fn finalize(ctx: *anyopaque) void {
+        const self: *ShareTask = @ptrCast(@alignCast(ctx));
+        if (!self.settled) self.navigator._share_pending = false;
+        self.resolver.release();
+        self.arena.release();
+    }
+
+    fn run(ctx: *anyopaque) !?u32 {
+        const self: *ShareTask = @ptrCast(@alignCast(ctx));
+        defer finalize(ctx);
+        var scope: js.Local.Scope = undefined;
+        self.exec.js.localScope(&scope);
+        defer scope.deinit();
+        // No OS sheet or delivery: model the user cancelling on a later task.
+        self.navigator._share_pending = false;
+        self.settled = true;
+        scope.toLocal(self.resolver).reject("navigator.share", self.exception);
+        return null;
+    }
+};
+
+fn closeIterator(iterator: js.Value.Iterator, local: *const js.Local) void {
+    // IteratorClose with a throwing completion preserves the original TypeError,
+    // even if getting/calling return() throws or returns a non-object.
+    var caught: js.TryCatch = undefined;
+    caught.init(local);
+    defer caught.deinit();
+    const method = iterator.object.getFunction("return") catch return;
+    const function = method orelse return;
+    _ = function.callWithThisRethrow(js.Value, iterator.object, .{}) catch {};
+}
+
+fn safeFile(file: *File) bool {
+    const extensions = [_][]const u8{
+        ".avif", ".bmp",  ".css",  ".csv",  ".ehtml", ".flac", ".gif",   ".htm",  ".html", ".ico",
+        ".jfif", ".jpeg", ".jpg",  ".m4a",  ".m4v",   ".mp3",  ".mp4",   ".mpeg", ".mpg",  ".oga",
+        ".ogg",  ".ogm",  ".ogv",  ".opus", ".pdf",   ".pjp",  ".pjpeg", ".png",  ".shtm", ".shtml",
+        ".svg",  ".svgz", ".text", ".tif",  ".tiff",  ".txt",  ".wav",   ".weba", ".webm", ".webp",
+        ".xbm",
+    };
+    const types = std.StaticStringMap(void).initComptime(.{
+        .{ "application/pdf", {} }, .{ "audio/flac", {} },     .{ "audio/mp3", {} },       .{ "audio/mpeg", {} },
+        .{ "audio/ogg", {} },       .{ "audio/wav", {} },      .{ "audio/webm", {} },      .{ "audio/x-m4a", {} },
+        .{ "image/avif", {} },      .{ "image/bmp", {} },      .{ "image/gif", {} },       .{ "image/jpeg", {} },
+        .{ "image/png", {} },       .{ "image/svg+xml", {} },  .{ "image/tiff", {} },      .{ "image/webp", {} },
+        .{ "image/x-icon", {} },    .{ "image/x-ms-bmp", {} }, .{ "image/x-xbitmap", {} }, .{ "text/comma-separated-values", {} },
+        .{ "text/css", {} },        .{ "text/csv", {} },       .{ "text/html", {} },       .{ "text/plain", {} },
+        .{ "video/mp4", {} },       .{ "video/mpeg", {} },     .{ "video/ogg", {} },       .{ "video/webm", {} },
+    });
+    if (!types.has(file._proto._mime)) return false;
+    const name = file.getName();
+    if (name.len == 0 or std.mem.indexOfAny(u8, name, "/\x00") != null) return false;
+    for (extensions) |extension| {
+        if (std.ascii.endsWithIgnoreCase(name, extension)) return true;
+    }
+    return false;
+}
+
+fn sameOrigin(a: *Frame, b: *Frame) bool {
+    return URL.isSameOrigin(a.origin orelse return false, b.origin orelse return false);
+}
+
+// Only the web-share directive is interpreted; this is not a general policy API.
+fn allowed(frame: *Frame) bool {
+    if (!headerAllows(frame, frame)) return false;
+    const parent = frame.parent orelse return true;
+    if (!allowed(parent) or !headerAllows(parent, frame)) return false;
+    const iframe = frame.iframe orelse return sameOrigin(parent, frame);
+    const allow = iframe.asElement().getAttributeSafe(.wrap("allow")) orelse return sameOrigin(parent, frame);
+    var directives = std.mem.splitScalar(u8, allow, ';');
+    while (directives.next()) |directive| {
+        var tokens = std.mem.tokenizeAny(u8, directive, " \t\r\n");
+        if (!std.mem.eql(u8, tokens.next() orelse continue, "web-share")) continue;
+        var token = tokens.next();
+        if (token == null) return sourceMatches(frame, parent, iframe.asElement().getAttributeSafe(.wrap("src")) orelse "");
+        var matches = false;
+        while (token) |item| : (token = tokens.next()) {
+            if (std.mem.eql(u8, item, "'none'")) return false;
+            if (std.mem.eql(u8, item, "*") or
+                (std.mem.eql(u8, item, "'self'") and sameOrigin(parent, frame)) or
+                (std.mem.eql(u8, item, "'src'") and sourceMatches(frame, parent, iframe.asElement().getAttributeSafe(.wrap("src")) orelse "")) or
+                URL.isSameOrigin(item, frame.origin orelse "")) matches = true;
+        }
+        return matches;
+    }
+    return sameOrigin(parent, frame);
+}
+
+fn sourceMatches(frame: *Frame, parent: *Frame, source: []const u8) bool {
+    if (source.len == 0) return sameOrigin(frame, parent);
+    const resolved = URL.resolve(parent.call_arena, parent.base(), source, .{}) catch return false;
+    return frame.isSameOrigin(resolved);
+}
+
+fn headerAllows(owner: *Frame, target: *Frame) bool {
+    for (owner._http_headers.items) |header| {
+        if (!std.ascii.eqlIgnoreCase(header.name, "permissions-policy")) continue;
+        var directives = std.mem.splitScalar(u8, header.value, ',');
+        while (directives.next()) |directive| {
+            const equal = std.mem.indexOfScalar(u8, directive, '=') orelse continue;
+            if (!std.mem.eql(u8, std.mem.trim(u8, directive[0..equal], " \t"), "web-share")) continue;
+            const list = std.mem.trim(u8, directive[equal + 1 ..], " \t");
+            if (std.mem.eql(u8, list, "*")) continue;
+            if (list.len < 2 or list[0] != '(' or list[list.len - 1] != ')') continue;
+            var tokens = std.mem.tokenizeAny(u8, list[1 .. list.len - 1], " \t");
+            var matches = false;
+            while (tokens.next()) |token| {
+                if (std.mem.eql(u8, token, "self") and sameOrigin(owner, target)) matches = true;
+                if (token.len >= 2 and token[0] == '"' and token[token.len - 1] == '"' and
+                    URL.isSameOrigin(token[1 .. token.len - 1], target.origin orelse "")) matches = true;
+            }
+            if (!matches) return false;
+        }
+    }
+    return true;
+}
+
+pub fn notifyActivation(frame: *Frame, event: *Event) void {
+    if (!event._is_trusted or event._activation_notification_suppressed) return;
+    const typ = event._type_string;
+    if (typ.eql(.wrap("keydown"))) {
+        const key = event.is(KeyboardEvent) orelse return;
+        if (key._key == .Escape or key._ctrl_key or key._alt_key or key._meta_key) return;
+    } else if (typ.eql(.wrap("pointerdown")) or typ.eql(.wrap("pointerup"))) {
+        const pointer = event.is(PointerEvent) orelse return;
+        if (typ.eql(.wrap("pointerdown")) != (pointer._pointer_type == .mouse)) return;
+    } else if (!typ.eql(.wrap("mousedown")) and !typ.eql(.wrap("touchend"))) return;
+
+    const now = lp.datetime.milliTimestamp(.boot);
+    var ancestor: ?*Frame = frame;
+    while (ancestor) |current| : (ancestor = current.parent) {
+        current.window._navigator._share_activation_ms = now;
+    }
+    activateSameOrigin(root(frame), frame, now);
+}
+
+fn activateSameOrigin(frame: *Frame, source: *Frame, now: u64) void {
+    if (sameOrigin(frame, source)) frame.window._navigator._share_activation_ms = now;
+    for (frame.child_frames.items) |child| activateSameOrigin(child, source, now);
+}
+
+fn root(frame: *Frame) *Frame {
+    var current = frame;
+    while (current.parent) |parent| current = parent;
+    return current;
+}
+
+fn consumeActivation(frame: *Frame) void {
+    frame.window._navigator._share_activation_ms = null;
+    for (frame.child_frames.items) |child| consumeActivation(child);
+}
