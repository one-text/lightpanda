+/// Lightweight Navigation Timing Level 2 shape. Timings and sizes stay zero;
+/// every document is reported as an ordinary navigation, including reloads.
+pub const NavigationTiming = struct {
+    pub const Proto = ResourceTiming;
+    _proto: *ResourceTiming,
+
+    const zero_fields = .{
+        "unloadEventStart",           "unloadEventEnd",           "domInteractive",
+        "domContentLoadedEventStart", "domContentLoadedEventEnd", "domComplete",
+        "loadEventStart",             "loadEventEnd",             "activationStart",
+        "criticalCHRestart",
+    };
+
+    fn getZero(_: *const NavigationTiming) f64 {
+        return 0;
+    }
+
+    fn getType(_: *const NavigationTiming) []const u8 {
+        return "navigate";
+    }
+
+    fn getRedirectCount(_: *const NavigationTiming) u16 {
+        return 0;
+    }
+
+    fn getNotRestoredReasons(_: *const NavigationTiming) ?js.Object {
+        return null;
+    }
+
+    fn toJSON(self: *const NavigationTiming, exec: *const Execution) !js.Object {
+        const local = exec.js.local.?;
+        const result = (try local.zigValueToJs(self._proto.toJSON(), .{})).toObject();
+        inline for (zero_fields) |name| {
+            if (!(try result.set(name, @as(f64, 0), .{}))) return error.JsException;
+        }
+        if (!(try result.set("type", self.getType(), .{}))) return error.JsException;
+        if (!(try result.set("redirectCount", self.getRedirectCount(), .{}))) return error.JsException;
+        if (!(try result.set("notRestoredReasons", null, .{}))) return error.JsException;
+        return result;
+    }
+
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(NavigationTiming);
+        pub const Meta = struct {
+            pub const name = "PerformanceNavigationTiming";
+            pub const prototype_chain = bridge.prototypeChain();
+            pub var class_id: bridge.ClassId = undefined;
+        };
+
+        pub const unloadEventStart = bridge.accessor(getZero, null, .{});
+        pub const unloadEventEnd = bridge.accessor(getZero, null, .{});
+        pub const domInteractive = bridge.accessor(getZero, null, .{});
+        pub const domContentLoadedEventStart = bridge.accessor(getZero, null, .{});
+        pub const domContentLoadedEventEnd = bridge.accessor(getZero, null, .{});
+        pub const domComplete = bridge.accessor(getZero, null, .{});
+        pub const loadEventStart = bridge.accessor(getZero, null, .{});
+        pub const loadEventEnd = bridge.accessor(getZero, null, .{});
+        pub const activationStart = bridge.accessor(getZero, null, .{});
+        pub const criticalCHRestart = bridge.accessor(getZero, null, .{});
+        pub const @"type" = bridge.accessor(getType, null, .{});
+        pub const redirectCount = bridge.accessor(getRedirectCount, null, .{});
+        pub const notRestoredReasons = bridge.accessor(getNotRestoredReasons, null, .{});
+        pub const toJSON = bridge.function(NavigationTiming.toJSON, .{});
+    };
+};
+
 /// PerformanceTiming — Navigation Timing Level 1 (legacy, but widely used).
 /// https://developer.mozilla.org/en-US/docs/Web/API/PerformanceTiming
 /// All properties return 0 as stub values; the object must not be undefined
