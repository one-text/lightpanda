+pub fn setNavigationName(self: *Performance, name: []const u8) void {
+    self._navigation_name = name;
+    if (self._navigation_timing) |entry| entry._proto._proto._name = name;
+}
+
+// One lazy native entry per document; no network instrumentation or load tasks.
+// Retained Performance objects must not consult their destroyed owning context.
+pub fn ensureNavigation(self: *Performance) !void {
+    if (self._navigation_timing != null) return;
+    const name = self._navigation_name orelse return;
+    const navigation = try self._factory.chained(.{
+        Entry{
+            ._name = name,
+            ._type = undefined,
+        },
+        ResourceTiming{
+            ._proto = undefined,
+            ._initiator_type = "navigation",
+            ._next_hop_protocol = "",
+            ._delivery_type = "",
+            ._redirect_start = 0,
+            ._redirect_end = 0,
+            ._fetch_start = 0,
+            ._domain_lookup_start = 0,
+            ._domain_lookup_end = 0,
+            ._connect_start = 0,
+            ._connect_end = 0,
+            ._secure_connection_start = 0,
+            ._request_start = 0,
+            ._response_start = 0,
+            ._response_end = 0,
+            ._transfer_size = 0,
+            ._encoded_body_size = 0,
+            ._decoded_body_size = 0,
+            ._response_status = 200,
+            ._content_type = "text/html",
+            ._content_encoding = "",
+        },
+        NavigationTiming{ ._proto = undefined },
+    });
+    navigation._proto._proto._type = .{ .navigation = navigation };
+    try self.insertOrdered(&self._entries, navigation._proto._proto);
+    self._navigation_timing = navigation;
+}
