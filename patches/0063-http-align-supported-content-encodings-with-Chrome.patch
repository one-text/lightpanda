             }
diff --git a/src/network/http.zig b/src/network/http.zig
index 6a6d121..2475efa 100644
--- a/src/network/http.zig
+++ b/src/network/http.zig
@@ -385,10 +385,8 @@ pub const Connection = struct {
         self._header_list = updated;
     }
 
-    pub fn addDefaultAcceptEncoding(self: *Connection, allocator: std.mem.Allocator) !void {
-        const encodings = libcurl.Curl_get_content_encodings() orelse return error.OutOfMemory;
-        defer libcurl.curl_free(encodings);
-        try self.addHeader(allocator, "Accept-Encoding", std.mem.span(encodings));
+    pub fn addDefaultAcceptEncoding(self: *Connection, allocator: std.mem.Allocator, trustworthy: bool) !void {
+        try self.addHeader(allocator, "Accept-Encoding", if (trustworthy) "gzip, deflate, br, zstd" else "gzip, deflate");
     }
 
     pub fn commitHeaders(self: *const Connection) !void {
