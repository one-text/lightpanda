diff --git a/src/network/HttpClient.zig b/src/network/HttpClient.zig
index 4caf9b5..bb1a82a 100644
--- a/src/network/HttpClient.zig
+++ b/src/network/HttpClient.zig
@@ -3735,7 +3735,7 @@ pub const Transfer = struct {
                 // A custom header suppresses curl's earlier automatic emission,
                 // while CURLOPT_ACCEPT_ENCODING still enables native decoding.
                 if (std.ascii.eqlIgnoreCase(name, "accept-encoding") and self.findRequestHeader(name) == null) {
-                    try conn.addDefaultAcceptEncoding(arena);
+                    try conn.addDefaultAcceptEncoding(arena, URL.isPotentiallyTrustworthy(req.url));
                 }
