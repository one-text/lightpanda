+pub fn postMessage(self: *ServiceWorker, data: js.Value, options: ?js.Value, exec: *js.Execution) !void {
+    try @import("Client.zig").checkTransfer(options);
+    const scope = self._scope orelse return error.InvalidStateError;
+    // The incumbent may differ from the wrapper's realm (a same-origin page
+    // can legitimately hold another page's worker object).
+    const context = exec.js.getIncumbentContext() orelse return error.InvalidStateError;
+    const frame = switch (context.global) {
+        .frame => |frame| frame,
+        .worker => return error.NotSupported,
+    };
+    if (frame._session != scope._proto._session or frame.isSameOrigin(scope._proto.url) == false) return error.SecurityError;
+    if (frame._service_worker_client_id == 0) return error.InvalidStateError;
+    return scope.receiveMessage(data, frame);
 }
 
