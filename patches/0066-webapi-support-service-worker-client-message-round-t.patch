+pub fn checkTransfer(options: ?js.Value) !void {
+    const opts = options orelse return;
+    if (opts.isNullOrUndefined()) return;
+    if (!opts.isObject()) return error.TypeError;
+    // Web IDL selects the sequence overload for iterable objects, not just
+    // arrays. Do not accidentally treat a Set as an empty options dictionary.
+    if (try opts.iterator()) |iterator| {
+        if (try iterator.next() != null) return error.DataClone;
+        return;
+    }
+    const transfer = try opts.toObject().get("transfer");
+    if (transfer.isUndefined()) return;
+    const iterator = try transfer.iterator() orelse return error.TypeError;
+    // This subset does not implement transferring ownership of any objects.
+    if (try iterator.next() != null) return error.DataClone;
+}
+
+pub fn init(scope: *ServiceWorkerGlobalScope, frame: *Frame) !*Client {
+    const arena = try scope._proto._session.getArena(.small, "Client");
+    errdefer arena.release();
+    return scope._proto._factory.windowClient(arena, .{
+        ._type = undefined,
+        ._arena = arena,
+        ._scope = scope,
+        ._client_id = frame._service_worker_client_id,
+        ._id = try std.fmt.allocPrint(arena.allocator(), "{d}", .{frame._service_worker_client_id}),
+        ._url = try arena.dupe(u8, frame._service_worker_creation_url orelse frame.url),
+        ._origin = try arena.dupe(u8, frame.origin orelse "null"),
+        ._frame_type = if (frame.parent != null) "nested" else if (frame.window._opener != null) "auxiliary" else "top-level",
+    });
+}
+
+pub fn acquireRef(self: *Client) void {
+    self._rc.acquire();
+}
+
+pub fn releaseRef(self: *Client, page: *Page) void {
+    self._rc.release(self, page);
+}
+
+pub fn deinit(self: *Client, _: *Page) void {
+    self._arena.release();
+}
+
+fn getId(self: *const Client) []const u8 {
+    return self._id;
+}
+
+fn getUrl(self: *const Client) []const u8 {
+    return self._url;
+}
+
+fn getType(_: *const Client) []const u8 {
+    return "window";
+}
+
+fn getFrameType(self: *const Client) []const u8 {
+    return self._frame_type;
+}
+
+pub fn postMessage(self: *Client, data: js.Value, options: ?js.Value) !void {
+    try checkTransfer(options);
+    const scope = self._scope;
+    const session = scope._proto._session;
+    const frame = session.service_worker_clients.get(self._client_id);
+    // Even a discarded destination must synchronously reject uncloneable data.
+    const destination = if (frame) |f| f.js else scope._proto.js;
+    const cloned = blk: {
+        var ls: js.Local.Scope = undefined;
+        destination.localScope(&ls);
+        defer ls.deinit();
+        var try_catch: js.TryCatch = undefined;
+        try_catch.init(&ls.local);
+        defer try_catch.deinit();
+        const value = data.structuredCloneTo(&ls.local) catch |err| {
+            if (try_catch.hasCaught()) try_catch.rethrow();
+            return err;
+        };
+        break :blk try value.persist();
+    };
+    var owned = true;
+    defer if (owned) cloned.release();
+
+    const live = session.service_worker_clients.get(self._client_id) orelse return;
+    if (live.page.destroying or live.window._closed or live.isSameOrigin(scope._proto.url) == false) return;
+    const navigator = live.window._navigator;
+    const container = navigator._service_worker orelse blk: {
+        const container = try ServiceWorkerContainer.init(live);
+        navigator._service_worker = container;
+        break :blk container;
+    };
+    try container.receiveMessage(scope, cloned);
+    owned = false;
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(Client);
+    pub const Meta = struct {
