-// Messages from a worker are delivered as soon as they're posted
-pub fn startMessages(_: *ServiceWorkerContainer) void {}
+pub fn startMessages(self: *ServiceWorkerContainer) void {
+    if (self._messages_enabled) return;
+    self._messages_enabled = true;
+    for (self._pending_messages.items) |message| {
+        self.scheduleMessage(message) catch |err| {
+            log.debug(.browser, "SWC startMessages", .{ .err = err });
+            MessageCallback.cancelled(message);
+        };
+    }
+    self._pending_messages.clearRetainingCapacity();
+}
+
+pub fn getOnMessage(self: *const ServiceWorkerContainer) ?js.Function.Global {
+    return self._on_message;
+}
+
+pub fn setOnMessage(self: *ServiceWorkerContainer, setter: ?WorkerGlobalScope.FunctionSetter) void {
+    self._on_message = WorkerGlobalScope.getFunctionFromSetter(setter);
+    self.startMessages();
+}
+
+pub fn getOnMessageError(self: *const ServiceWorkerContainer) ?js.Function.Global {
+    return self._on_message_error;
+}
+
+pub fn setOnMessageError(self: *ServiceWorkerContainer, setter: ?WorkerGlobalScope.FunctionSetter) void {
+    self._on_message_error = WorkerGlobalScope.getFunctionFromSetter(setter);
+}
+
+// Takes ownership only on success, like MessagePort.scheduleDelivery.
+pub fn receiveMessage(self: *ServiceWorkerContainer, scope: *ServiceWorkerGlobalScope, data: js.Value.Global) !void {
+    const frame = self._frame;
+    const registration = try self.track(scope);
+    const worker = try registration.worker(scope);
+    const arena = try frame._session.getArena(.tiny, "ServiceWorkerContainer.message");
+    errdefer arena.release();
+    const message = try arena.create(MessageCallback);
+    message.* = .{
+        .arena = arena,
+        .session = frame._session,
+        .client_id = frame._service_worker_client_id,
+        .data = data,
+        .worker = worker,
+        .origin = try arena.dupe(u8, scope._proto.origin orelse "null"),
+    };
+    if (!self._messages_enabled) {
+        try self._pending_messages.append(frame.arena, message);
+        return;
+    }
+    try self.scheduleMessage(message);
+}
+
+fn scheduleMessage(self: *ServiceWorkerContainer, message: *MessageCallback) !void {
+    try self._frame.js.scheduler.add(message, MessageCallback.run, 0, .{
+        .name = "ServiceWorkerContainer.message",
+        .finalizer = MessageCallback.cancelled,
+    });
+}
+
+const MessageCallback = struct {
+    arena: *lp.Arena,
+    session: *@import("../Session.zig"),
+    client_id: u64,
+    data: ?js.Value.Global,
+    worker: *ServiceWorker,
+    origin: []const u8,
+
+    fn cancelled(ctx: *anyopaque) void {
+        const self: *MessageCallback = @ptrCast(@alignCast(ctx));
+        if (self.data) |data| data.release();
+        self.arena.release();
+    }
+
+    fn run(ctx: *anyopaque) !?u32 {
+        const self: *MessageCallback = @ptrCast(@alignCast(ctx));
+        defer cancelled(ctx);
+        const frame = self.session.service_worker_clients.get(self.client_id) orelse return null;
+        if (frame.page.destroying or frame.window._closed) return null;
+        const container = frame.window._navigator._service_worker orelse return null;
+        const exec = &frame.js.execution;
+        const event = try MessageEvent.initTrusted(.wrap("message"), .{
+            .data = .{ .value = self.data.? },
+            .origin = self.origin,
+            .source = .{ .worker = self.worker },
+        }, frame.page);
+        self.data = null;
+        event.acquireRef();
+        defer event.releaseRef(frame.page);
+        try exec.dispatch(container._proto, event.asEvent(), container._on_message, .{ .context = "SWC message" });
+        return null;
+    }
+};
 
