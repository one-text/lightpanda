+const EventManagerBase = @import("../EventManagerBase.zig");
+const DOMException = @import("DOMException.zig");
+const Speech = @import("SpeechSynthesis.zig");
+const Conversion = @import("media_constraints.zig");
+const Config = @import("eme_configuration.zig");
+
+pub fn registerTypes() []const type {
+    return &.{ Access, Keys, Session, StatusMap, EmptyIterator };
+}
+
+fn active(navigator: *const Navigator) bool {
+    if (navigator._pdf_detached) return false;
+    const frame = navigator._frame orelse return false;
+    return frame.document._frame == frame;
+}
+
+fn reject(exec: *js.Execution, caught: ?*js.TryCatch, err: anyerror) !js.Promise {
+    if (err == error.ExecutionTerminated or exec.js.env.terminatePending()) return error.ExecutionTerminated;
+    if (err == error.OutOfMemory) return err;
+    const local = exec.js.local.?;
+    const resolver = local.createPromiseResolver();
+    const exception_value = if (caught) |value| value.exceptionValue() else null;
+    const reason = if (exception_value) |value| value else switch (err) {
+        error.TypeError, error.InvalidArgument => js.Value{ .local = local, .handle = local.isolate.createTypeError("Invalid encrypted media arguments") },
+        else => blk: {
+            const exception = DOMException.fromError(err) orelse return err;
+            const stored = try exec._factory.create(exception);
+            break :blk try local.zigValueToJs(stored, .{});
+        },
+    };
+    try resolver.rejectValue(reason);
+    return resolver.promise();
+}
+fn throwDom(exec: *js.Execution, err: anyerror) anyerror {
+    const exception = DOMException.fromError(err) orelse return err;
+    const stored = exec._factory.create(exception) catch |failure| return failure;
+    const local = exec.js.local.?;
+    const value = local.zigValueToJs(stored, .{}) catch |failure| return failure;
+    _ = local.isolate.throwException(value.handle);
+    return error.JsException;
+}
+fn resolved(exec: *js.Execution, value: anytype) !js.Promise {
+    const local = exec.js.local.?;
+    const resolver = local.createPromiseResolver();
+    try resolver.resolveValue(try local.zigValueToJs(value, .{}));
+    return resolver.promise();
+}
+
+pub fn request(navigator: *Navigator, key_system: js.Value, configurations: js.Value, exec: *js.Execution) !js.Promise {
+    var caught: js.TryCatch = undefined;
+    caught.init(exec.js.local.?);
+    defer caught.deinit();
+    const access = negotiate(navigator, key_system, configurations, exec) catch |err| return reject(exec, &caught, err);
+    defer access.releaseRef(exec.page);
+    return resolved(exec, access);
+}
+fn negotiate(navigator: *Navigator, key_system: js.Value, configurations: js.Value, exec: *js.Execution) !*Access {
+    const name = try (try Conversion.domString(key_system)).toSlice();
+    const candidates = try Config.configurations(configurations, exec.call_arena);
+    if (name.len == 0 or candidates.len == 0) return error.TypeError;
+    if (!active(navigator)) return error.InvalidStateError;
+    if (!std.mem.eql(u8, name, "com.widevine.alpha")) return error.NotSupported;
+    const frame = navigator._frame.?;
+    if (!@import("MediaDevices.zig").allowed(frame, "encrypted-media")) return error.SecurityError;
+    for (candidates) |candidate| {
+        if (try Config.select(candidate, exec.call_arena)) |selected| {
+            const arena = try exec.getArena(.small, "MediaKeySystemAccess");
+            errdefer arena.release();
+            const self = try arena.create(Access);
+            self.* = .{ ._arena = arena, ._rc = lp.RC.init(1), ._navigator = navigator, ._config = try Config.clone(selected, arena.allocator()) };
+            return self;
+        }
+    }
+    return error.NotSupported;
+}
+
+pub fn mediaKeys(media: *const Media) ?*Keys {
+    return media._media_keys;
+}
+pub fn clearMediaKeys(media: *Media, page: *Page) void {
+    const keys = media._media_keys orelse return;
+    page.media_key_attachments.remove(&media._media_keys_node);
+    media._media_keys = null;
+    keys._media = null;
+    keys.releaseRef(page);
+}
+pub fn setMediaKeys(media: *Media, keys: js.Nullable(*Keys), exec: *js.Execution) !js.Promise {
+    if (media._attaching_media_keys) return reject(exec, null, error.InvalidStateError);
+    const local = exec.js.local.?;
+    const next = try local.zigValueToJs(keys.value, .{});
+    if (media._media_keys == keys.value) return resolved(exec, js.Undefined{});
+    const owner = try local.zigValueToJs(media, .{});
+    const task = try exec._factory.create(Attachment{ .media = media, .exec = exec, .owner = undefined, .keys = undefined, .resolver = undefined });
+    errdefer exec._factory.destroy(task);
+    task.owner = try owner.persist();
+    errdefer task.owner.release();
+    task.keys = try next.persist();
+    errdefer task.keys.release();
+    const resolver = local.createPromiseResolver();
+    task.resolver = try resolver.persist();
+    errdefer task.resolver.release();
+    try exec._scheduler.add(task, Attachment.run, 0, .{ .name = "media.setMediaKeys", .finalizer = Attachment.cancelled });
+    media._attaching_media_keys = true;
+    return resolver.promise();
+}
+const Attachment = struct {
+    media: *Media,
+    exec: *js.Execution,
+    owner: js.Value.Global,
+    keys: js.Value.Global,
+    resolver: js.PromiseResolver.Global,
+
+    fn deinit(self: *Attachment) void {
+        self.owner.release();
+        self.keys.release();
+        self.resolver.release();
+        self.exec._factory.destroy(self);
+    }
+    fn cancelled(ptr: *anyopaque) void {
+        const self: *Attachment = @ptrCast(@alignCast(ptr));
+        self.media._attaching_media_keys = false;
+        self.deinit();
+    }
+    fn attach(self: *Attachment, local: *const js.Local) !void {
+        const value = self.keys.local(local);
+        const next = if (value.isNull()) null else try value.toZig(*Keys);
+        if (next) |keys| {
+            if (!active(keys._navigator)) return error.InvalidStateError;
+            if (keys._media != null and keys._media != self.media) return error.QuotaExceeded;
+        }
+        clearMediaKeys(self.media, self.exec.page);
+        if (next) |keys| {
+            keys.acquireRef();
+            keys._media = self.media;
+            self.media._media_keys = keys;
+            self.exec.page.media_key_attachments.append(&self.media._media_keys_node);
+        }
+    }
+    fn run(ptr: *anyopaque) !?u32 {
+        const self: *Attachment = @ptrCast(@alignCast(ptr));
+        defer self.deinit();
+        var scope: js.Local.Scope = undefined;
+        self.exec.js.localScope(&scope);
+        defer scope.deinit();
+        const local = &scope.local;
+        const resolver = self.resolver.local(local);
+        self.attach(local) catch |err| {
+            self.media._attaching_media_keys = false;
+            const exception = DOMException.fromError(err) orelse return err;
+            const stored = try self.exec._factory.create(exception);
+            try resolver.rejectValue(try local.zigValueToJs(stored, .{}));
+            local.runMicrotasks();
+            return null;
+        };
+        self.media._attaching_media_keys = false;
+        try resolver.resolveValue(try local.zigValueToJs(js.Undefined{}, .{}));
+        local.runMicrotasks();
+        return null;
+    }
+};
+
+pub fn MediaHandler(comptime name: @import("global_event_handlers.zig").Handler) type {
+    return struct {
+        pub fn get(media: *Media, frame: *@import("../Frame.zig")) !?js.Function.Global {
+            return @import("../Factory.zig").protoOf(media).getAttributeFunction(name, frame);
+        }
+        pub fn set(media: *Media, callback: ?js.Function.Global, frame: *@import("../Frame.zig")) !void {
+            try @import("../Factory.zig").protoOf(media).setAttributeListener(name, callback, frame);
+        }
+    };
+}
+
+pub const Access = struct {
+    _arena: *lp.Arena,
+    _rc: lp.RC = .{},
+    _navigator: *Navigator,
+    _config: Config.Configuration,
+
+    pub fn acquireRef(self: *Access) void {
+        self._rc.acquire();
+    }
+    pub fn releaseRef(self: *Access, page: *Page) void {
+        self._rc.release(self, page);
+    }
+    pub fn deinit(self: *Access, _: *Page) void {
+        self._arena.release();
+    }
+    pub fn creationContext(self: *const Access, local: *const js.Local) *const js.v8.Context {
+        return self._navigator.creationContext(local);
+    }
+    fn keySystem(_: *const Access) []const u8 {
+        return "com.widevine.alpha";
+    }
+    fn getConfiguration(self: *const Access, exec: *js.Execution) !js.Object {
+        return Config.serialize(self._config, exec.js.local.?);
+    }
+    fn createMediaKeys(self: *const Access, exec: *js.Execution) !js.Promise {
+        if (!active(self._navigator)) return reject(exec, null, error.InvalidStateError);
+        const arena = try exec.getArena(.tiny, "MediaKeys");
+        var owned = true;
+        errdefer if (owned) arena.release();
+        const keys = try arena.create(Keys);
+        keys.* = .{ ._arena = arena, ._rc = lp.RC.init(1), ._navigator = self._navigator };
+        owned = false;
+        defer keys.releaseRef(exec.page);
+        return resolved(exec, keys);
+    }
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(Access);
+        pub const Meta = struct {
+            pub const name = "MediaKeySystemAccess";
+            pub const prototype_chain = bridge.prototypeChain();
+            pub const creation_context = Access.creationContext;
+            pub var class_id: bridge.ClassId = undefined;
+        };
+        pub const keySystem = bridge.accessor(Access.keySystem, null, .{});
+        pub const getConfiguration = bridge.function(Access.getConfiguration, .{});
+        pub const createMediaKeys = bridge.function(Access.createMediaKeys, .{});
+    };
+};
+
+pub const Keys = struct {
+    _arena: *lp.Arena,
+    _rc: lp.RC = .{},
+    _navigator: *Navigator,
+    _media: ?*Media = null,
+
+    pub fn acquireRef(self: *Keys) void {
+        self._rc.acquire();
+    }
