+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+const std = @import("std");
+const js = @import("../js/js.zig");
+const Mime = @import("../Mime.zig");
+const Conversion = @import("media_constraints.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Capability = struct {
+    contentType: []const u8 = "",
+    encryptionScheme: ?[]const u8 = null,
+    robustness: []const u8 = "",
+};
+pub const Configuration = struct {
+    audioCapabilities: []const Capability = &.{},
+    distinctiveIdentifier: []const u8 = "optional",
+    initDataTypes: []const []const u8 = &.{},
+    label: []const u8 = "",
+    persistentState: []const u8 = "optional",
+    sessionTypes: []const []const u8 = &.{"temporary"},
+    videoCapabilities: []const Capability = &.{},
+};
+
+// Convert the entire sequence before selecting a candidate, including getters
+// on candidates which follow an otherwise supported one.
+pub fn configurations(value: js.Value, allocator: Allocator) ![]const Configuration {
+    const iterator = try value.iterator() orelse return error.TypeError;
+    var result: std.ArrayList(Configuration) = .empty;
+    while (try iterator.next()) |item| {
+        errdefer Conversion.closeIterator(iterator, value.local);
+        try result.append(allocator, try configuration(item, allocator));
+    }
+    return result.items;
+}
+
+fn strings(value: js.Value, allocator: Allocator) ![]const []const u8 {
+    const iterator = try value.iterator() orelse return error.TypeError;
+    var result: std.ArrayList([]const u8) = .empty;
+    while (try iterator.next()) |item| {
+        errdefer Conversion.closeIterator(iterator, value.local);
+        try result.append(allocator, try (try Conversion.domString(item)).toSlice());
+    }
+    return result.items;
+}
+fn text(object: js.Object, name: []const u8, default: []const u8) ![]const u8 {
+    const value = try object.get(name);
+    return if (value.isUndefined()) default else (try Conversion.domString(value)).toSlice();
+}
+fn requirement(object: js.Object, name: []const u8) ![]const u8 {
+    const result = try text(object, name, "optional");
+    for ([_][]const u8{ "required", "optional", "not-allowed" }) |choice| {
+        if (std.mem.eql(u8, result, choice)) return result;
+    }
+    return error.TypeError;
+}
+fn capabilities(value: js.Value, allocator: Allocator) ![]const Capability {
+    if (value.isUndefined()) return &.{};
+    const iterator = try value.iterator() orelse return error.TypeError;
+    var result: std.ArrayList(Capability) = .empty;
+    while (try iterator.next()) |item| {
+        errdefer Conversion.closeIterator(iterator, value.local);
+        var cap: Capability = .{};
+        if (try Conversion.dictionary(item)) |object| {
+            cap.contentType = try text(object, "contentType", "");
+            const scheme = try object.get("encryptionScheme");
+            if (!scheme.isNullOrUndefined()) cap.encryptionScheme = try (try Conversion.domString(scheme)).toSlice();
+            cap.robustness = try text(object, "robustness", "");
+        }
+        try result.append(allocator, cap);
+    }
+    return result.items;
+}
+fn configuration(value: js.Value, allocator: Allocator) !Configuration {
+    const object = try Conversion.dictionary(value) orelse return .{};
+    var result: Configuration = .{};
+    result.audioCapabilities = try capabilities(try object.get("audioCapabilities"), allocator);
+    result.distinctiveIdentifier = try requirement(object, "distinctiveIdentifier");
+    const init_types = try object.get("initDataTypes");
+    if (!init_types.isUndefined()) result.initDataTypes = try strings(init_types, allocator);
+    result.label = try text(object, "label", "");
+    result.persistentState = try requirement(object, "persistentState");
+    const sessions = try object.get("sessionTypes");
+    if (!sessions.isUndefined()) result.sessionTypes = try strings(sessions, allocator);
+    result.videoCapabilities = try capabilities(try object.get("videoCapabilities"), allocator);
+    return result;
+}
+
+pub fn select(input: Configuration, allocator: Allocator) !?Configuration {
+    if (std.mem.eql(u8, input.distinctiveIdentifier, "required") or std.mem.eql(u8, input.persistentState, "required")) return null;
+    if (input.sessionTypes.len == 0) return null;
+    for (input.sessionTypes) |session| if (!std.mem.eql(u8, session, "temporary")) return null;
+    if (input.audioCapabilities.len == 0 and input.videoCapabilities.len == 0) return null;
+    for (input.audioCapabilities) |cap| if (cap.contentType.len == 0) return null;
+    for (input.videoCapabilities) |cap| if (cap.contentType.len == 0) return null;
+    var result = input;
+    result.distinctiveIdentifier = "not-allowed";
+    result.persistentState = "not-allowed";
+    if (input.initDataTypes.len != 0) {
+        var supported: std.ArrayList([]const u8) = .empty;
+        for (input.initDataTypes) |init_type| {
+            if (std.mem.eql(u8, init_type, "cenc")) try supported.append(allocator, init_type);
+        }
+        if (supported.items.len == 0) return null;
+        result.initDataTypes = supported.items;
+    }
+    result.audioCapabilities = try filter(input.audioCapabilities, true, allocator);
+    result.videoCapabilities = try filter(input.videoCapabilities, false, allocator);
+    if (input.audioCapabilities.len != 0 and result.audioCapabilities.len == 0) return null;
+    if (input.videoCapabilities.len != 0 and result.videoCapabilities.len == 0) return null;
+    return result;
+}
+fn filter(input: []const Capability, audio: bool, allocator: Allocator) ![]const Capability {
+    var result: std.ArrayList(Capability) = .empty;
+    for (input) |cap| {
+        if (cap.encryptionScheme) |scheme| if (!std.mem.eql(u8, scheme, "cenc")) continue;
+        if (cap.robustness.len != 0 and !std.mem.eql(u8, cap.robustness, "SW_SECURE_CRYPTO") and !std.mem.eql(u8, cap.robustness, "SW_SECURE_DECODE")) continue;
+        if (supportsContent(cap.contentType, audio)) try result.append(allocator, cap);
+    }
+    return result.items;
+}
+fn supportsContent(content_type: []const u8, audio: bool) bool {
+    _ = Mime.parse(content_type) catch return false;
+    var mime = Mime.ContentTypeIterator.init(content_type);
+    if (!std.ascii.eqlIgnoreCase(mime.essence, if (audio) "audio/mp4" else "video/mp4")) return false;
+    var codec: ?[]const u8 = null;
+    while (mime.next()) |param| {
+        if (std.ascii.eqlIgnoreCase(param.key, "codecs")) {
+            if (codec != null) return false;
+            codec = param.value;
+        } else return false;
+    }
+    const value = codec orelse return false;
+    if (audio) return std.mem.eql(u8, value, "mp4a.40.2");
+    if (value.len != 11 or (!std.mem.startsWith(u8, value, "avc1.") and !std.mem.startsWith(u8, value, "avc3."))) return false;
+    const profile = std.fmt.parseUnsigned(u8, value[5..7], 16) catch return false;
+    _ = std.fmt.parseUnsigned(u8, value[7..9], 16) catch return false;
+    const level = std.fmt.parseUnsigned(u8, value[9..11], 16) catch return false;
+    return (profile == 0x42 or profile == 0x4d or profile == 0x58 or profile == 0x64) and
+        std.mem.indexOfScalar(u8, &.{ 9, 10, 11, 12, 13, 20, 21, 22, 30, 31, 32, 40, 41, 42, 50, 51, 52 }, level) != null;
+}
+pub fn clone(input: Configuration, allocator: Allocator) !Configuration {
+    var result = input;
+    result.label = try allocator.dupe(u8, input.label);
+    inline for (.{ "initDataTypes", "sessionTypes" }) |field| {
+        const copied = try allocator.alloc([]const u8, @field(input, field).len);
+        for (@field(input, field), copied) |value, *entry| entry.* = try allocator.dupe(u8, value);
+        @field(result, field) = copied;
+    }
+    inline for (.{ "audioCapabilities", "videoCapabilities" }) |field| {
+        const copied = try allocator.dupe(Capability, @field(input, field));
+        for (copied) |*cap| {
+            cap.contentType = try allocator.dupe(u8, cap.contentType);
+            cap.robustness = try allocator.dupe(u8, cap.robustness);
+            if (cap.encryptionScheme) |scheme| cap.encryptionScheme = try allocator.dupe(u8, scheme);
+        }
+        @field(result, field) = copied;
+    }
+    return result;
+}
+pub fn put(object: js.Object, name: []const u8, value: anytype) !void {
+    const converted = try object.local.zigValueToJs(value, .{});
+    if (!(object.defineOwnProperty(name, converted, 0) orelse return error.JsException)) return error.JsException;
+}
+fn stringArray(values: []const []const u8, local: *const js.Local) !js.Array {
+    const array = local.newArray(0);
+    for (values, 0..) |value, i| {
+        var buf: [20]u8 = undefined;
+        try put(array.toObject(), try std.fmt.bufPrint(&buf, "{d}", .{i}), value);
+    }
+    return array;
+}
+pub fn serialize(config: Configuration, local: *const js.Local) !js.Object {
+    const result = local.newObject();
+    try put(result, "label", config.label);
+    try put(result, "initDataTypes", try stringArray(config.initDataTypes, local));
+    inline for (.{ "audioCapabilities", "videoCapabilities" }) |field| {
+        const array = local.newArray(0);
+        for (@field(config, field), 0..) |cap, i| {
+            const object = local.newObject();
+            try put(object, "contentType", cap.contentType);
+            try put(object, "robustness", cap.robustness);
+            try put(object, "encryptionScheme", cap.encryptionScheme);
+            var buf: [20]u8 = undefined;
+            try put(array.toObject(), try std.fmt.bufPrint(&buf, "{d}", .{i}), object);
+        }
+        try put(result, field, array);
+    }
+    try put(result, "distinctiveIdentifier", config.distinctiveIdentifier);
+    try put(result, "persistentState", config.persistentState);
+    try put(result, "sessionTypes", try stringArray(config.sessionTypes, local));
+    return result;
+}
