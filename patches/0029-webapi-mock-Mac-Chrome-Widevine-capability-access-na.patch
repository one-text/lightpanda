+const eme_entries = .{ "requestMediaKeySystemAccess", "MediaKeySystemAccess", "MediaKeys", "MediaKeySession", "MediaKeyStatusMap", "mediaKeys", "setMediaKeys" };
+
+// Run before page code can replace global constructors or their properties.
+fn captureEncryptedMediaBindings(self: *const Env, ctx: *Context, v8_context: *const v8.Context, global_obj: *const v8.Object) !void {
+    const isolate = self.isolate.handle;
+    var bindings: [10]v8.Global = @splat(.{ .data_ptr = 0 });
+    errdefer for (&bindings) |*binding| v8.v8__Global__Reset(binding);
+    var prototypes: [2]*const v8.Object = undefined;
+    inline for (.{ "Navigator", "HTMLMediaElement" }, 0..) |name, i| {
+        const constructor = v8.v8__Object__Get(global_obj, v8_context, self.isolate.initStringHandle(name)) orelse return error.JsException;
+        if (!v8.v8__Value__IsFunction(constructor)) return error.JsException;
+        const prototype = v8.v8__Object__Get(@ptrCast(constructor), v8_context, self.isolate.initStringHandle("prototype")) orelse return error.JsException;
+        if (!v8.v8__Value__IsObject(prototype)) return error.JsException;
+        prototypes[i] = @ptrCast(prototype);
+        v8.v8__Global__New(isolate, prototype, &bindings[8 + i]);
+    }
+    const targets = [_]*const v8.Object{ prototypes[0], global_obj, global_obj, global_obj, global_obj, prototypes[1], prototypes[1] };
+    inline for (eme_entries, 0..) |name, i| {
+        const descriptor = v8.v8__Object__GetOwnPropertyDescriptor(targets[i], v8_context, self.isolate.initStringHandle(name)) orelse return error.JsException;
+        if (!v8.v8__Value__IsObject(descriptor)) return error.JsException;
+        v8.v8__Global__New(isolate, descriptor, &bindings[i]);
+    }
+    const object = v8.v8__Object__Get(global_obj, v8_context, self.isolate.initStringHandle("Object")) orelse return error.JsException;
+    if (!v8.v8__Value__IsObject(object)) return error.JsException;
+    const define = v8.v8__Object__Get(@ptrCast(object), v8_context, self.isolate.initStringHandle("defineProperty")) orelse return error.JsException;
+    if (!v8.v8__Value__IsFunction(define)) return error.JsException;
+    v8.v8__Global__New(isolate, define, &bindings[7]);
+    ctx.eme_bindings = bindings;
+}
+
+pub fn setEncryptedMediaExposure(self: *const Env, ctx: *Context, v8_context: *const v8.Context, global_obj: *const v8.Object, secure: bool) !void {
+    if (secure == !ctx.eme_hidden) return;
+    const isolate = self.isolate.handle;
+    const bindings = &(ctx.eme_bindings orelse return error.JsException);
+    const navigator_prototype: *const v8.Object = @ptrCast(v8.v8__Global__Get(&bindings[8], isolate));
+    const media_prototype: *const v8.Object = @ptrCast(v8.v8__Global__Get(&bindings[9], isolate));
+    const targets = [_]*const v8.Object{ navigator_prototype, global_obj, global_obj, global_obj, global_obj, media_prototype, media_prototype };
+    inline for (eme_entries, 0..) |name, i| {
+        const key = self.isolate.initStringHandle(name);
+        if (secure) {
+            const args = [_]?*const v8.Value{ @ptrCast(targets[i]), key, v8.v8__Global__Get(&bindings[i], isolate) };
+            const define: *const v8.Function = @ptrCast(v8.v8__Global__Get(&bindings[7], isolate));
+            _ = v8.v8__Function__Call(define, v8_context, @ptrCast(global_obj), args.len, &args) orelse return error.JsException;
+        } else {
+            var result: v8.MaybeBool = undefined;
+            v8.v8__Object__Delete(targets[i], v8_context, key, &result);
+            if (!result.has_value or !result.value) return error.JsException;
+        }
+    }
+    ctx.eme_hidden = !secure;
+}
+
