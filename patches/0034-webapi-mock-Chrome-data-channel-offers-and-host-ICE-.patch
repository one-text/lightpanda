+
+// Native data-channel offer/ICE emulation, not a transport. Never inspect the
+// host's interfaces, contact STUN/TURN, or claim a connected peer/open channel.
+pub fn registerTypes() []const type {
+    return &.{ Peer, Channel, Description, Candidate, IceEvent };
+}
+
+fn resolved(exec: *js.Execution, value: anytype) !js.Promise {
+    const resolver = js.PromiseResolver.init(exec.js.local.?);
+    try resolver.resolveValue(try exec.js.local.?.zigValueToJs(value, .{}));
+    return resolver.promise();
+}
+fn rejectCaught(exec: *js.Execution, caught: *js.TryCatch, err: anyerror) !js.Promise {
+    if (err == error.ExecutionTerminated or exec.js.env.terminatePending()) return error.ExecutionTerminated;
+    const reason = caught.exceptionValue() orelse return err;
+    const resolver = js.PromiseResolver.init(exec.js.local.?);
+    try resolver.rejectValue(reason);
+    return resolver.promise();
+}
+fn dictionary(comptime T: type, input: ?js.Value) !T {
+    const object = try Convert.dictionary(input) orelse return T{};
+    return object.toZig(T);
+}
+fn text(value: js.Value) ![]const u8 {
+    return (try Convert.domString(value)).toSlice();
+}
+fn copy(allocator: std.mem.Allocator, value: []const u8) ![]const u8 {
+    return allocator.dupe(u8, value);
+}
+fn edgeData(owner: anytype, local: *const js.Local) !js.Object {
+    const wrapper = try local.zigValueToJs(owner, .{});
+    const key: *const js.v8.Private = @ptrCast(js.v8.v8__Global__Get(&local.ctx.env.private_symbols.speech_callbacks.handle, local.isolate.handle).?);
+    if (js.v8.v8__Object__GetPrivate(@ptrCast(wrapper.handle), local.handle, key)) |value| {
+        const data = js.Value{ .local = local, .handle = @ptrCast(value) };
+        if (data.isObject()) return data.toObject();
+    }
+    const data = local.newObject();
+    var saved: js.v8.MaybeBool = undefined;
+    js.v8.v8__Object__SetPrivate(@ptrCast(wrapper.handle), local.handle, key, @ptrCast(data.handle), &saved);
+    if (!saved.has_value or !saved.value) return error.JsException;
+    return data;
+}
+fn edge(owner: anytype, name: []const u8, value: anytype, local: *const js.Local) !void {
+    const data = try edgeData(owner, local);
+    if (!(data.defineOwnProperty(name, try local.zigValueToJs(value, .{}), 0) orelse false)) return error.JsException;
+}
+
+// Same JS-owned callback storage as the other native mocks. Queued work roots
+// wrappers temporarily; callback cycles themselves remain collectible.
+fn Listeners(comptime T: type) type {
+    return struct {
+        pub fn register(self: *T, typ: []const u8, callback: EventManager.Callback, options: EventManager.RegisterOptions, exec: *js.Execution) !void {
+            const listener = (try self._events.register(self._proto, typ, callback, options)) orelse return;
+            const slot = switch (listener.function) {
+                .value => |v| v.slot,
+                .object => |v| v.slot,
+                .string => unreachable,
+            };
+            errdefer {
+                self._events.remove(self._proto, typ, callback, options.capture);
+                slot.release();
+            }
+            const root = try self._listener_pool.create(self._arena.allocator());
+            errdefer self._listener_pool.destroy(root);
+            const value = switch (callback) {
+                .function => |f| js.Value{ .local = f.local, .handle = @ptrCast(f.handle) },
+                .object => |o| o.toValue(),
+            };
+            const data = try Speech.callbackData(self._proto, exec.js.local.?);
+            root.* = .{ .owner = if (T == Peer) .{ .peer = self } else .{ .channel = self }, .target = self._proto, .listener = listener, .slot = slot, .data = try data.persist(), .signal = options.signal };
+            errdefer root.data.release();
+            const key = try std.fmt.bufPrint(&root.key, "listener{d}", .{@intFromPtr(root)});
+            root.key_len = key.len;
+            if (!(data.defineOwnProperty(key, value, 0) orelse false)) return error.JsException;
+            if (options.signal) |signal| try signal._dependents.append(exec.arena, .{ .rtc_listener = root });
+            js.v8.v8__Global__SetWeak(&slot.handle);
+            js.v8.v8__Global__SetWeak(&root.data.slot.handle);
+            self._listener_roots.append(&root.node);
+            listener.on_remove = .{ .ctx = root, .callback = ListenerRoot.removed };
+        }
+        pub fn remove(self: *T, typ: []const u8, callback: EventManager.Callback, capture: bool, exec: *js.Execution) void {
+            const previous = self._listener_local;
+            self._listener_local = exec.js.local.?;
+            defer self._listener_local = previous;
+            self._events.remove(self._proto, typ, callback, capture);
+        }
+        pub fn dispatch(self: *T, event: *Event, exec: *js.Execution) !void {
+            // Retained events keep their native target alive via a JS edge.
+            var scope: js.Local.Scope = undefined;
+            exec.js.localScope(&scope);
+            defer scope.deinit();
+            const local = &scope.local;
+            const previous = self._listener_local;
+            self._listener_local = local;
+            defer self._listener_local = previous;
+            try edge(event, "target", self, local);
+            try Speech.dispatchDirect(self._proto, &self._events, event, exec);
+        }
+        pub fn emit(self: *T, typ: []const u8, exec: *js.Execution) !void {
+            const event = try Event.init(typ, null, exec.page);
+            event._is_trusted = true;
+            try dispatch(self, event, exec);
+        }
+    };
+}
+
+pub const ListenerRoot = struct {
+    owner: union(enum) { peer: *Peer, channel: *Channel },
+    target: *EventTarget,
+    listener: *EventManager.Listener,
+    slot: *js.GlobalSlot,
+    data: js.Object.Global,
+    signal: ?*@import("AbortSignal.zig"),
+    node: std.DoublyLinkedList.Node = .{},
+    key: [32]u8 = undefined,
+    key_len: usize = 0,
+    fn dispose(self: *ListenerRoot, local: ?*const js.Local) void {
+        if (local) |l| {
+            var deleted: js.v8.MaybeBool = undefined;
+            js.v8.v8__Object__Delete(self.data.local(l).handle, l.handle, @ptrCast(l.newString(self.key[0..self.key_len]).handle), &deleted);
+        }
+        if (self.signal) |signal| {
+            for (signal._dependents.items, 0..) |dep, i| {
+                if (dep == .rtc_listener and dep.rtc_listener == self) {
+                    _ = signal._dependents.swapRemove(i);
+                    break;
+                }
+            }
+        }
+        self.slot.release();
+        self.data.release();
+        switch (self.owner) {
+            inline else => |owner| {
+                owner._listener_roots.remove(&self.node);
+                owner._listener_pool.destroy(self);
+            },
+        }
+    }
+    fn removed(ptr: *anyopaque) void {
+        const self: *ListenerRoot = @ptrCast(@alignCast(ptr));
+        switch (self.owner) {
+            inline else => |owner| self.dispose(owner._listener_local),
+        }
+    }
+    pub fn abort(self: *ListenerRoot, exec: *const js.Execution) void {
+        var scope: js.Local.Scope = undefined;
+        exec.js.localScope(&scope);
+        defer scope.deinit();
+        _ = scope.local.zigValueToJs(self.target, .{}) catch return;
+        switch (self.owner) {
+            inline else => |owner| {
+                const previous = owner._listener_local;
+                owner._listener_local = &scope.local;
+                defer owner._listener_local = previous;
+                const list = owner._events.getListeners(self.target, self.listener.typ) orelse return;
+                owner._events.removeListener(list, self.listener);
+            },
+        }
+    }
+};
+
+const Policy = enum {
+    all,
+    relay,
+    pub const js_enum_from_string = true;
+};
+const Bundle = enum {
+    balanced,
+    @"max-compat",
+    @"max-bundle",
+    pub const js_enum_from_string = true;
+};
+const Mux = enum {
+    negotiate,
+    require,
+    pub const js_enum_from_string = true;
+};
+const Server = struct { urls: []const []const u8, username: ?[]const u8 = null, credential: ?[]const u8 = null };
+const Configuration = struct {
+    bundle: Bundle = .balanced,
+    policy: Policy = .all,
+    pool: u8 = 0,
+    servers: []const Server = &.{},
+    encoded: bool = false,
+    always_data: bool = false,
+
+    fn parse(input: ?js.Value, allocator: std.mem.Allocator) !Configuration {
+        const object = try Convert.dictionary(input) orelse return .{};
+        var result: Configuration = .{};
+        const always = try object.get("alwaysNegotiateDataChannels");
+        if (!always.isUndefined()) result.always_data = always.toBool();
+        const bundle = try object.get("bundlePolicy");
+        if (!bundle.isUndefined()) result.bundle = std.meta.stringToEnum(Bundle, try text(bundle)) orelse return error.TypeError;
+        const certificates = try object.get("certificates");
+        if (!certificates.isUndefined()) {
+            const iterator = try certificates.iterator() orelse return error.TypeError;
+            if (try iterator.next() != null) return error.NotSupported;
+        }
+        const encoded = try object.get("encodedInsertableStreams");
+        if (!encoded.isUndefined()) result.encoded = encoded.toBool();
+        const pool = try object.get("iceCandidatePoolSize");
+        if (!pool.isUndefined()) {
+            const n = try pool.toF64();
+            if (!std.math.isFinite(n) or n < 0 or n > 255) return error.TypeError;
+            result.pool = @intFromFloat(n);
+        }
+        const servers = try object.get("iceServers");
+        if (!servers.isUndefined()) {
+            const iterator = try servers.iterator() orelse return error.TypeError;
+            var list: std.ArrayList(Server) = .empty;
+            while (try iterator.next()) |item| {
+                const server = try Convert.dictionary(item) orelse return error.TypeError;
+                const credential = try server.get("credential");
+                const credential_type = try server.get("credentialType");
+                if (!credential_type.isUndefined() and !std.mem.eql(u8, try text(credential_type), "password")) return error.TypeError;
+                const urls = try server.get("urls");
+                var url_list: std.ArrayList([]const u8) = .empty;
+                if (urls.isUndefined()) return error.TypeError;
+                if (urls.isString() != null) {
+                    try url_list.append(allocator, try copy(allocator, try text(urls)));
+                } else {
+                    const url_iterator = try urls.iterator() orelse return error.TypeError;
+                    while (try url_iterator.next()) |url| try url_list.append(allocator, try copy(allocator, try text(url)));
+                }
+                const username = try server.get("username");
+                const entry = Server{
+                    .urls = url_list.items,
+                    .username = if (username.isUndefined()) null else try copy(allocator, try text(username)),
+                    .credential = if (credential.isUndefined()) null else try copy(allocator, try text(credential)),
+                };
+                for (entry.urls) |url| {
+                    const colon = std.mem.indexOfScalar(u8, url, ':') orelse return error.SyntaxError;
+                    const scheme = url[0..colon];
