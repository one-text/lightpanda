+pub const Candidate = struct {
+    _arena: *lp.Arena,
+    _rc: lp.RC = .{},
+    _input: Init,
+    _foundation: ?[]const u8 = null,
+    _component: ?[]const u8 = null,
+    _priority: ?u32 = null,
+    _address: ?[]const u8 = null,
+    _protocol: ?[]const u8 = null,
+    _port: ?u16 = null,
+    _type: ?[]const u8 = null,
+    _tcp: ?[]const u8 = null,
+    _related_address: ?[]const u8 = null,
+    _related_port: ?u16 = null,
+    const Init = struct { candidate: []const u8 = "", sdpMLineIndex: ?u16 = null, sdpMid: ?[]const u8 = null, usernameFragment: ?[]const u8 = null };
+    fn init(options: ?Init, exec: *js.Execution) !*Candidate {
+        const opts = options orelse Init{};
+        if (opts.sdpMid == null and opts.sdpMLineIndex == null) return error.TypeError;
