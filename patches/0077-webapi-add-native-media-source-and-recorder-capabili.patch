+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Page = @import("../Page.zig");
+const EventTarget = @import("EventTarget.zig");
+const Events = @import("media_events.zig");
+const Speech = @import("SpeechSynthesis.zig");
+const Conversion = @import("media_constraints.zig");
+
+const MediaStream = @This();
+pub const Proto = EventTarget;
+_proto: *EventTarget,
+_arena: *lp.Arena,
+_rc: lp.RC = .{},
+_events: Events,
+_handlers: [2]Speech.Handler = undefined,
+_id: [36]u8 = undefined,
+
+// Capture is denied by MediaDevices; only empty streams can be produced.
+fn init(input: ?js.Value, exec: *js.Execution) !*MediaStream {
+    if (input) |value| {
+        if (!value.isUndefined()) {
+            const stream = if (value.isObject()) value.toZig(*MediaStream) catch null else null;
+            if (stream == null) {
+                const iterator = try value.iterator() orelse return error.TypeError;
+                if (try iterator.next() != null) {
+                    Conversion.closeIterator(iterator, exec.js.local.?);
+                    return error.TypeError;
+                }
+            }
+        }
+    }
+    const arena = try exec.getArena(.small, "MediaStream");
+    errdefer arena.release();
+    const self = try exec._factory.eventTargetWithAllocator(arena.allocator(), MediaStream{
+        ._proto = undefined,
+        ._arena = arena,
+        ._events = .init(arena),
+    });
+    @import("../../id.zig").uuidv4(&self._id);
+    self._events.handlers(&self._handlers, &.{ "addtrack", "removetrack" }, self._proto);
+    return self;
+}
+pub fn acquireRef(self: *MediaStream) void {
+    self._rc.acquire();
+}
+pub fn releaseRef(self: *MediaStream, page: *Page) void {
+    self._rc.release(self, page);
+}
+pub fn deinit(self: *MediaStream, _: *Page) void {
+    self._events.deinit(&self._handlers);
+    self._arena.release();
+}
+fn id(self: *const MediaStream) []const u8 {
+    return &self._id;
+}
+fn active(_: *const MediaStream) bool {
+    return false;
+}
+fn getTracks(_: *const MediaStream, exec: *js.Execution) js.Array {
+    return exec.js.local.?.newArray(0);
+}
+fn getTrackById(_: *const MediaStream, input: js.Value) !?js.Value {
+    _ = try Conversion.domString(input);
+    return null;
+}
+fn track(_: *MediaStream, _: js.Value) !void {
+    // No native MediaStreamTrack exists; arbitrary objects are not tracks.
+    return error.TypeError;
+}
+fn clone(_: *const MediaStream, exec: *js.Execution) !*MediaStream {
+    return init(null, exec);
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(MediaStream);
+    pub const Meta = struct {
+        pub const name = "MediaStream";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const constructor = bridge.constructor(init, .{});
+    pub const id = bridge.accessor(MediaStream.id, null, .{});
+    pub const active = bridge.accessor(MediaStream.active, null, .{});
+    pub const getTracks = bridge.function(MediaStream.getTracks, .{});
+    pub const getAudioTracks = bridge.function(MediaStream.getTracks, .{});
+    pub const getVideoTracks = bridge.function(MediaStream.getTracks, .{});
+    pub const getTrackById = bridge.function(MediaStream.getTrackById, .{});
+    pub const addTrack = bridge.function(track, .{});
+    pub const removeTrack = bridge.function(track, .{});
+    pub const clone = bridge.function(MediaStream.clone, .{});
+    pub const onaddtrack = bridge.accessor(Speech.Binding(MediaStream, 0).get, Speech.Binding(MediaStream, 0).set, .{});
+    pub const onremovetrack = bridge.accessor(Speech.Binding(MediaStream, 1).get, Speech.Binding(MediaStream, 1).set, .{});
+};
