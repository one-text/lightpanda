+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+const std = @import("std");
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Page = @import("../Page.zig");
+const EventTarget = @import("EventTarget.zig");
+const Events = @import("media_events.zig");
+const Speech = @import("SpeechSynthesis.zig");
+const Conversion = @import("media_constraints.zig");
+const Mime = @import("media_mime.zig");
+
+const MediaSource = @This();
+pub fn registerTypes() []const type {
+    return &.{ MediaSource, List, Handle };
+}
+pub const Proto = EventTarget;
+_proto: *EventTarget,
+_arena: *lp.Arena,
+_rc: lp.RC = .{},
+_events: Events,
+_handlers: [3]Speech.Handler = undefined,
+_source_buffers: ?*List = null,
+_active_buffers: ?*List = null,
+_handle: ?*Handle = null,
+
+fn init(exec: *js.Execution) !*MediaSource {
+    const arena = try exec.getArena(.small, "MediaSource");
+    errdefer arena.release();
+    const self = try exec._factory.eventTargetWithAllocator(arena.allocator(), MediaSource{
+        ._proto = undefined,
+        ._arena = arena,
+        ._events = .init(arena),
+    });
+    self._events.handlers(&self._handlers, &.{ "sourceopen", "sourceended", "sourceclose" }, self._proto);
+    return self;
+}
+pub fn acquireRef(self: *MediaSource) void {
+    self._rc.acquire();
+}
+pub fn releaseRef(self: *MediaSource, page: *Page) void {
+    self._rc.release(self, page);
+}
+pub fn deinit(self: *MediaSource, page: *Page) void {
+    self._events.deinit(&self._handlers);
+    if (self._source_buffers) |list| list.releaseRef(page);
+    if (self._active_buffers) |list| list.releaseRef(page);
+    self._arena.release();
+}
+fn readyState(_: *const MediaSource) []const u8 {
+    return "closed";
+}
+fn duration(_: *const MediaSource) f64 {
+    return std.math.nan(f64);
+}
+fn setDuration(_: *MediaSource, value: f64) !void {
+    if (std.math.isNan(value) or value < 0) return error.InvalidAccessError;
+    return error.InvalidStateError;
+}
+fn canConstructInDedicatedWorker() bool {
+    return true;
+}
+fn sourceBuffers(self: *MediaSource, exec: *js.Execution) !*List {
+    return self.buffers(&self._source_buffers, exec);
+}
+fn activeSourceBuffers(self: *MediaSource, exec: *js.Execution) !*List {
+    return self.buffers(&self._active_buffers, exec);
+}
+fn buffers(_: *MediaSource, slot: *?*List, exec: *js.Execution) !*List {
+    if (slot.*) |list| return list;
+    const list = try List.init(exec);
+    list.acquireRef();
+    slot.* = list;
+    return list;
+}
+fn handle(self: *MediaSource) !*Handle {
+    if (self._handle) |value| return value;
+    const value = try self._arena.create(Handle);
+    value.* = .{ .source = self };
+    self._handle = value;
+    return value;
+}
+fn isTypeSupported(value: js.Value, exec: *js.Execution) !bool {
+    return Mime.probe(value, .source, exec);
+}
+fn addSourceBuffer(_: *MediaSource, value: js.Value, exec: *js.Execution) !void {
+    const text = try (try Conversion.domString(value)).toSlice();
+    if (text.len == 0) return error.TypeError;
+    if (!try Mime.supported(text, .source, exec.call_arena)) return error.NotSupported;
+    // No attachment/decoder backend: the source remains closed.
+    return error.InvalidStateError;
+}
+fn removeSourceBuffer(_: *MediaSource, _: js.Value) !void {
+    // There can be no native SourceBuffer before a source is attached.
+    return error.TypeError;
+}
+fn endOfStream(_: *MediaSource, value: ?js.Value) !void {
+    if (value) |v| {
+        if (!v.isUndefined()) {
+            const text = try (try Conversion.domString(v)).toSlice();
+            if (!std.mem.eql(u8, text, "network") and !std.mem.eql(u8, text, "decode")) return error.TypeError;
+        }
+    }
+    return error.InvalidStateError;
+}
+fn setLiveSeekableRange(_: *MediaSource, start: f64, end: f64) !void {
+    if (!std.math.isFinite(start) or !std.math.isFinite(end)) return error.TypeError;
+    return error.InvalidStateError;
+}
+fn clearLiveSeekableRange(_: *MediaSource) !void {
+    return error.InvalidStateError;
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(MediaSource);
+    pub const Meta = struct {
+        pub const name = "MediaSource";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const constructor = bridge.constructor(init, .{});
+    pub const isTypeSupported = bridge.function(MediaSource.isTypeSupported, .{ .static = true });
+    pub const canConstructInDedicatedWorker = bridge.accessor(MediaSource.canConstructInDedicatedWorker, null, .{ .static = true });
+    pub const readyState = bridge.accessor(MediaSource.readyState, null, .{});
+    pub const duration = bridge.accessor(MediaSource.duration, setDuration, .{});
+    pub const sourceBuffers = bridge.accessor(MediaSource.sourceBuffers, null, .{ .cache = .{ .private = "media_source_buffers" } });
+    pub const activeSourceBuffers = bridge.accessor(MediaSource.activeSourceBuffers, null, .{ .cache = .{ .private = "media_active_source_buffers" } });
+    pub const handle = bridge.accessor(MediaSource.handle, null, .{ .exposed = .worker, .cache = .{ .private = "media_source_handle" } });
+    pub const addSourceBuffer = bridge.function(MediaSource.addSourceBuffer, .{});
+    pub const removeSourceBuffer = bridge.function(MediaSource.removeSourceBuffer, .{});
+    pub const endOfStream = bridge.function(MediaSource.endOfStream, .{});
+    pub const setLiveSeekableRange = bridge.function(MediaSource.setLiveSeekableRange, .{});
+    pub const clearLiveSeekableRange = bridge.function(MediaSource.clearLiveSeekableRange, .{});
+    pub const onsourceopen = bridge.accessor(Speech.Binding(MediaSource, 0).get, Speech.Binding(MediaSource, 0).set, .{});
+    pub const onsourceended = bridge.accessor(Speech.Binding(MediaSource, 1).get, Speech.Binding(MediaSource, 1).set, .{});
+    pub const onsourceclose = bridge.accessor(Speech.Binding(MediaSource, 2).get, Speech.Binding(MediaSource, 2).set, .{});
+};
+
+pub const List = struct {
+    pub const Proto = EventTarget;
+    _proto: *EventTarget,
+    _arena: *lp.Arena,
+    _rc: lp.RC = .{},
+    _events: Events,
+    _handlers: [2]Speech.Handler = undefined,
+
+    fn init(exec: *js.Execution) !*List {
+        const arena = try exec.getArena(.small, "SourceBufferList");
+        errdefer arena.release();
+        const self = try exec._factory.eventTargetWithAllocator(arena.allocator(), List{
+            ._proto = undefined,
+            ._arena = arena,
+            ._events = .init(arena),
+        });
+        self._events.handlers(&self._handlers, &.{ "addsourcebuffer", "removesourcebuffer" }, self._proto);
+        return self;
+    }
+    pub fn acquireRef(self: *List) void {
+        self._rc.acquire();
+    }
+    pub fn releaseRef(self: *List, page: *Page) void {
+        self._rc.release(self, page);
+    }
+    pub fn deinit(self: *List, _: *Page) void {
+        self._events.deinit(&self._handlers);
+        self._arena.release();
+    }
+    fn length(_: *const List) u32 {
+        return 0;
+    }
+    fn index(_: *const List, _: u32) !js.Undefined {
+        return error.NotHandled;
+    }
+    fn indexes(_: *const List, exec: *js.Execution) js.Array {
+        return exec.js.local.?.newArray(0);
+    }
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(List);
+        pub const Meta = struct {
+            pub const name = "SourceBufferList";
+            pub const array_iterator = true;
+            pub const prototype_chain = bridge.prototypeChain();
+            pub var class_id: bridge.ClassId = undefined;
+        };
+        pub const length = bridge.accessor(List.length, null, .{});
+        pub const @"[]" = bridge.indexed(index, indexes, .{});
+        pub const onaddsourcebuffer = bridge.accessor(Speech.Binding(List, 0).get, Speech.Binding(List, 0).set, .{});
+        pub const onremovesourcebuffer = bridge.accessor(Speech.Binding(List, 1).get, Speech.Binding(List, 1).set, .{});
+    };
+};
+
+pub const Handle = struct {
+    source: *MediaSource,
+    pub fn acquireRef(self: *Handle) void {
+        self.source.acquireRef();
+    }
+    pub fn releaseRef(self: *Handle, page: *Page) void {
+        self.source.releaseRef(page);
+    }
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(Handle);
+        pub const Meta = struct {
+            pub const name = "MediaSourceHandle";
+            pub const prototype_chain = bridge.prototypeChain();
+            pub var class_id: bridge.ClassId = undefined;
+        };
+    };
+};
