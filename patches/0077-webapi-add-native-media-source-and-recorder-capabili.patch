+}
+fn parse(input: []const u8, allocator: std.mem.Allocator) !?Mime {
+    const semi = std.mem.indexOfScalar(u8, input, ';') orelse input.len;
+    const essence = std.mem.trim(u8, input[0..semi], " \t\r\n");
