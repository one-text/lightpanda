+const std = @import("std");
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Page = @import("../Page.zig");
+const EventTarget = @import("EventTarget.zig");
+const MediaStream = @import("MediaStream.zig");
+const Events = @import("media_events.zig");
+const Speech = @import("SpeechSynthesis.zig");
+const Conversion = @import("media_constraints.zig");
+const Mime = @import("media_mime.zig");
+
+const MediaRecorder = @This();
+pub const Proto = EventTarget;
+_proto: *EventTarget,
+_arena: *lp.Arena,
+_rc: lp.RC = .{},
+_events: Events,
+_handlers: [6]Speech.Handler = undefined,
+_stream: *MediaStream,
+_mime: []const u8,
+_audio: u32 = 128000,
+_video: u32 = 2500000,
+_mode: []const u8 = "variable",
+
+fn init(stream: *MediaStream, input: ?js.Value, exec: *js.Execution) !*MediaRecorder {
+    var audio: u32 = 128000;
+    var video: u32 = 2500000;
+    var mode: []const u8 = "variable";
+    var mime: []const u8 = "";
+    // Dictionary members are converted in Web IDL lexicographic order.
+    if (try Conversion.dictionary(input)) |options| {
+        const bitrate_mode = try options.get("audioBitrateMode");
+        if (!bitrate_mode.isUndefined()) {
+            mode = try (try Conversion.domString(bitrate_mode)).toSlice();
+            if (!std.mem.eql(u8, mode, "variable") and !std.mem.eql(u8, mode, "constant")) return error.TypeError;
+        }
+        const a = try options.get("audioBitsPerSecond");
+        if (!a.isUndefined()) audio = try a.toU32();
+        const total = try options.get("bitsPerSecond");
+        const bits: ?u32 = if (total.isUndefined()) null else try total.toU32();
+        const m = try options.get("mimeType");
+        if (!m.isUndefined()) mime = try (try Conversion.domString(m)).toSlice();
+        const v = try options.get("videoBitsPerSecond");
+        if (!v.isUndefined()) video = try v.toU32();
+        const count = try options.get("videoKeyFrameIntervalCount");
+        if (!count.isUndefined()) _ = try count.toU32();
+        const duration = try options.get("videoKeyFrameIntervalDuration");
+        if (!duration.isUndefined()) {
+            const number = try duration.toZig(f64);
+            if (!std.math.isFinite(number)) return error.TypeError;
+        }
+        if (bits) |b| {
+            audio = @intFromFloat(@as(f64, @floatFromInt(b)) * 0.1);
+            video = b - audio;
+        }
+    }
+    if (!try Mime.supported(mime, .recorder, exec.call_arena)) return error.NotSupported;
+    const arena = try exec.getArena(.small, "MediaRecorder");
+    var arena_owned = true;
+    errdefer if (arena_owned) arena.release();
+    const self = try exec._factory.eventTargetWithAllocator(arena.allocator(), MediaRecorder{
+        ._proto = undefined,
+        ._arena = arena,
+        ._rc = lp.RC.init(1),
+        ._events = .init(arena),
+        ._stream = stream,
+        ._mime = try arena.dupe(u8, mime),
+        ._audio = audio,
+        ._video = video,
+        ._mode = try arena.dupe(u8, mode),
+    });
+    stream.acquireRef();
+    self._events.handlers(&self._handlers, &.{ "start", "stop", "dataavailable", "pause", "resume", "error" }, self._proto);
+    arena_owned = false;
+    defer self.releaseRef(exec.page);
+    const local = exec.js.local.?;
+    const data = try Speech.callbackData(self._proto, local);
+    if (!(data.defineOwnProperty("stream", try local.zigValueToJs(stream, .{}), 0) orelse false)) return error.JsException;
+    return self;
+}
+pub fn acquireRef(self: *MediaRecorder) void {
+    self._rc.acquire();
+}
+pub fn releaseRef(self: *MediaRecorder, page: *Page) void {
+    self._rc.release(self, page);
+}
+pub fn deinit(self: *MediaRecorder, page: *Page) void {
+    self._events.deinit(&self._handlers);
+    self._stream.releaseRef(page);
+    self._arena.release();
+}
+fn isTypeSupported(value: js.Value, exec: *js.Execution) !bool {
+    return Mime.probe(value, .recorder, exec);
+}
+fn getStream(self: *const MediaRecorder) *MediaStream {
+    return self._stream;
+}
+fn mimeType(self: *const MediaRecorder) []const u8 {
+    return self._mime;
+}
+fn state(_: *const MediaRecorder) []const u8 {
+    return "inactive";
+}
+fn audioBitsPerSecond(self: *const MediaRecorder) u32 {
+    return self._audio;
+}
+fn videoBitsPerSecond(self: *const MediaRecorder) u32 {
+    return self._video;
+}
+fn audioBitrateMode(self: *const MediaRecorder) []const u8 {
+    return self._mode;
+}
+fn start(_: *MediaRecorder, timeslice: ?js.Value) !void {
+    if (timeslice) |value| {
+        if (!value.isUndefined()) _ = try value.toU32();
+    }
+    // All constructible streams have no live tracks. Do not fake encoded data.
+    return error.NotSupported;
+}
+fn stop(_: *MediaRecorder) void {}
+fn inactive(_: *MediaRecorder) !void {
+    return error.InvalidStateError;
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(MediaRecorder);
+    pub const Meta = struct {
+        pub const name = "MediaRecorder";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const constructor = bridge.constructor(init, .{});
+    pub const isTypeSupported = bridge.function(MediaRecorder.isTypeSupported, .{ .static = true });
+    pub const stream = bridge.accessor(getStream, null, .{});
+    pub const mimeType = bridge.accessor(MediaRecorder.mimeType, null, .{});
+    pub const state = bridge.accessor(MediaRecorder.state, null, .{});
+    pub const audioBitsPerSecond = bridge.accessor(MediaRecorder.audioBitsPerSecond, null, .{});
+    pub const videoBitsPerSecond = bridge.accessor(MediaRecorder.videoBitsPerSecond, null, .{});
+    pub const audioBitrateMode = bridge.accessor(MediaRecorder.audioBitrateMode, null, .{});
+    pub const start = bridge.function(MediaRecorder.start, .{});
+    pub const stop = bridge.function(MediaRecorder.stop, .{});
+    pub const pause = bridge.function(inactive, .{});
+    pub const @"resume" = bridge.function(inactive, .{});
+    pub const requestData = bridge.function(inactive, .{});
+    pub const onstart = bridge.accessor(Speech.Binding(MediaRecorder, 0).get, Speech.Binding(MediaRecorder, 0).set, .{});
+    pub const onstop = bridge.accessor(Speech.Binding(MediaRecorder, 1).get, Speech.Binding(MediaRecorder, 1).set, .{});
+    pub const ondataavailable = bridge.accessor(Speech.Binding(MediaRecorder, 2).get, Speech.Binding(MediaRecorder, 2).set, .{});
+    pub const onpause = bridge.accessor(Speech.Binding(MediaRecorder, 3).get, Speech.Binding(MediaRecorder, 3).set, .{});
+    pub const onresume = bridge.accessor(Speech.Binding(MediaRecorder, 4).get, Speech.Binding(MediaRecorder, 4).set, .{});
+    pub const onerror = bridge.accessor(Speech.Binding(MediaRecorder, 5).get, Speech.Binding(MediaRecorder, 5).set, .{});
+};
