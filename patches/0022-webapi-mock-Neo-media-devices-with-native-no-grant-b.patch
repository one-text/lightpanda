index 0000000..6e1c003
--- /dev/null
+++ b/src/browser/webapi/MediaDevices.zig
@@ -0,0 +1,313 @@
+// Copyright (C) 2026 Brenno Flávio
+//
+// Brenno Flávio <contato@brennoflavio.com.br>
