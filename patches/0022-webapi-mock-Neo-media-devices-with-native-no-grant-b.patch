+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Page = @import("../Page.zig");
+const Factory = @import("../Factory.zig");
+const InputDeviceInfo = @import("InputDeviceInfo.zig");
+const Navigator = @import("Navigator.zig");
+
+const MediaDeviceInfo = @This();
+
+_navigator: *Navigator,
+_kind: []const u8,
+_arena: *lp.Arena,
+_rc: lp.RC = .{},
+
+pub fn init(exec: *js.Execution, navigator: *Navigator, kind: []const u8) !js.Value {
+    const arena = try exec.getArena(.tiny, "MediaDeviceInfo");
+    var owned = true;
+    errdefer if (owned) arena.release();
+    const info = MediaDeviceInfo{ ._navigator = navigator, ._kind = kind, ._arena = arena, ._rc = lp.RC.init(1) };
+    if (@import("std").mem.eql(u8, kind, "audiooutput")) {
+        const device = try arena.create(MediaDeviceInfo);
+        device.* = info;
+        owned = false;
+        defer device.releaseRef(exec.page);
+        return exec.js.local.?.zigValueToJs(device, .{});
+    }
+    const device = try Factory.chainedWithAllocator(arena.allocator(), .{ info, InputDeviceInfo{ ._proto = undefined } });
+    owned = false;
+    defer device._proto.releaseRef(exec.page);
+    return exec.js.local.?.zigValueToJs(device, .{});
+}
+
+pub fn acquireRef(self: *MediaDeviceInfo) void {
+    self._rc.acquire();
+}
+
+pub fn releaseRef(self: *MediaDeviceInfo, page: *Page) void {
+    self._rc.release(self, page);
+}
+
+pub fn deinit(self: *MediaDeviceInfo, _: *Page) void {
+    self._arena.release();
+}
+
+pub fn creationContext(self: *const MediaDeviceInfo, local: *const js.Local) *const js.v8.Context {
+    return self._navigator.creationContext(local);
+}
+
+// Before a capture grant, Chrome exposes one anonymized device per kind.
+fn getPrivateString(_: *const MediaDeviceInfo) []const u8 {
+    return "";
+}
+
+fn getKind(self: *const MediaDeviceInfo) []const u8 {
+    return self._kind;
+}
+
+fn toJSON(self: *const MediaDeviceInfo, exec: *js.Execution) !js.Object {
+    const local = exec.js.local.?;
+    const result = local.newObject();
+    inline for (.{ "deviceId", "kind", "label", "groupId" }) |name| {
+        const value = if (comptime @import("std").mem.eql(u8, name, "kind")) self._kind else "";
+        if (!(result.defineOwnProperty(name, local.newString(value).toValue(), 0) orelse return error.JsException)) return error.TypeError;
+    }
+    return result;
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(MediaDeviceInfo);
+    pub const Meta = struct {
+        pub const name = "MediaDeviceInfo";
+        pub const creation_context = MediaDeviceInfo.creationContext;
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const deviceId = bridge.accessor(getPrivateString, null, .{});
+    pub const kind = bridge.accessor(getKind, null, .{});
+    pub const label = bridge.accessor(getPrivateString, null, .{});
+    pub const groupId = bridge.accessor(getPrivateString, null, .{});
+    pub const toJSON = bridge.function(MediaDeviceInfo.toJSON, .{});
+};
diff --git a/src/browser/webapi/MediaDevices.zig b/src/browser/webapi/MediaDevices.zig
