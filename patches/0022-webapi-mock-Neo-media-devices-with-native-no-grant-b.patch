+
+const std = @import("std");
+const js = @import("../js/js.zig");
+
+const Kind = enum { integer, number, boolean, boolean_string, string, points, boolean_number };
+const Constraint = struct { name: []const u8, kind: Kind };
+
+// Chrome 155's enabled MediaTrackSupportedConstraints, in Web IDL order.
+const constraints = [_]Constraint{
+    .{ .name = "aspectRatio", .kind = .number },
+    .{ .name = "autoGainControl", .kind = .boolean },
+    .{ .name = "brightness", .kind = .number },
+    .{ .name = "channelCount", .kind = .integer },
+    .{ .name = "colorTemperature", .kind = .number },
+    .{ .name = "contrast", .kind = .number },
+    .{ .name = "deviceId", .kind = .string },
+    .{ .name = "displaySurface", .kind = .string },
+    .{ .name = "echoCancellation", .kind = .boolean_string },
+    .{ .name = "exposureCompensation", .kind = .number },
+    .{ .name = "exposureMode", .kind = .string },
+    .{ .name = "exposureTime", .kind = .number },
+    .{ .name = "facingMode", .kind = .string },
+    .{ .name = "focusDistance", .kind = .number },
+    .{ .name = "focusMode", .kind = .string },
+    .{ .name = "frameRate", .kind = .number },
+    .{ .name = "groupId", .kind = .string },
+    .{ .name = "height", .kind = .integer },
+    .{ .name = "iso", .kind = .number },
+    .{ .name = "latency", .kind = .number },
+    .{ .name = "noiseSuppression", .kind = .boolean },
+    .{ .name = "pan", .kind = .boolean_number },
+    .{ .name = "pointsOfInterest", .kind = .points },
+    .{ .name = "resizeMode", .kind = .string },
+    .{ .name = "restrictOwnAudio", .kind = .boolean },
+    .{ .name = "sampleRate", .kind = .integer },
+    .{ .name = "sampleSize", .kind = .integer },
+    .{ .name = "saturation", .kind = .number },
+    .{ .name = "sharpness", .kind = .number },
+    .{ .name = "suppressLocalAudioPlayback", .kind = .boolean },
+    .{ .name = "tilt", .kind = .boolean_number },
+    .{ .name = "torch", .kind = .boolean },
+    .{ .name = "voiceIsolation", .kind = .boolean },
+    .{ .name = "whiteBalanceMode", .kind = .string },
+    .{ .name = "width", .kind = .integer },
+    .{ .name = "zoom", .kind = .boolean_number },
+};
+
+pub fn supported(local: *const js.Local) !js.Object {
+    const result = local.newObject();
+    for (constraints) |constraint| {
+        if (!(result.defineOwnProperty(constraint.name, try local.zigValueToJs(true, .{}), 0) orelse return error.JsException)) return error.TypeError;
+    }
+    return result;
+}
+
+pub fn dictionary(value: ?js.Value) !?js.Object {
+    const input = value orelse return null;
+    if (input.isNullOrUndefined()) return null;
+    if (!input.isObject()) return error.TypeError;
+    return input.toObject();
+}
+
+pub fn domString(value: js.Value) !js.String {
+    if (value.isSymbol()) return error.TypeError;
+    return value.toString();
+}
+
+pub const Track = struct {
+    requested: bool,
+    restricted: bool = false,
+};
+
+pub fn track(value: js.Value, default: bool) !Track {
+    if (value.isUndefined()) return .{ .requested = default };
+    if (!value.isObject() and !value.isNull()) return .{ .requested = value.toBool() };
+    var result: Track = .{ .requested = true };
+    if (!value.isNull()) {
+        const object = value.toObject();
+        result.restricted = try constraintSet(object);
+        // MediaTrackConstraints inherits MediaTrackConstraintSet; advanced is
+        // read after all the base members, not between aspectRatio and audio.
+        const advanced = try object.get("advanced");
+        if (!advanced.isUndefined()) {
+            const iterator = try advanced.iterator() orelse return error.TypeError;
+            while (try iterator.next()) |item| {
+                errdefer closeIterator(iterator, value.local);
+                const set = try dictionary(item);
+                if (set) |o| _ = try constraintSet(o);
+            }
+            result.restricted = true;
+        }
+    }
+    return result;
+}
+
+fn constraintSet(object: js.Object) !bool {
+    var restricted = false;
+    const optional = try object.get("_optional");
+    if (!optional.isUndefined()) {
+        const iterator = try optional.iterator() orelse return error.TypeError;
+        while (try iterator.next()) |item| {
+            errdefer closeIterator(iterator, object.local);
+            if (!item.isObject()) return error.TypeError;
+        }
+    }
+    for (constraints) |constraint| {
+        // mandatory sorts between latency and noiseSuppression.
+        if (std.mem.eql(u8, constraint.name, "noiseSuppression")) {
+            const mandatory = try object.get("mandatory");
+            if (!mandatory.isUndefined() and !mandatory.isObject()) return error.TypeError;
+        }
+        const value = try object.get(constraint.name);
+        if (value.isUndefined()) continue;
+        restricted = (try convertConstraint(value, constraint.kind)) or restricted;
+    }
+    return restricted;
+}
+
+fn convertConstraint(value: js.Value, kind: Kind) !bool {
+    if (kind == .string and value.isObject()) {
+        if (try value.iterator()) |iterator| {
+            try stringSequence(iterator, value.local);
+            return false;
+        }
+    }
+    if (kind == .points) {
+        if (try value.iterator()) |iterator| {
+            try pointSequence(iterator);
+            return false;
+        }
+    }
+    if (value.isObject() or value.isNull()) {
+        const object = try dictionary(value) orelse return false;
+        var restricted = false;
+        // Numeric ranges inherit max/min; read the base dictionary first.
+        // Nonnumeric parameter dictionaries have only exact/ideal.
+        for ([_][]const u8{ "max", "min", "exact", "ideal" }) |name| {
+            const numeric = kind == .integer or kind == .number or kind == .boolean_number;
+            if (!numeric and (std.mem.eql(u8, name, "max") or std.mem.eql(u8, name, "min"))) continue;
+            const member = try object.get(name);
+            if (member.isUndefined()) continue;
+            try scalar(member, if (kind == .boolean_number) .number else kind);
+            if (std.mem.eql(u8, name, "exact") or std.mem.eql(u8, name, "min")) restricted = true;
+        }
+        return restricted;
+    }
+    try scalar(value, kind);
+    return false;
+}
+
+fn scalar(value: js.Value, kind: Kind) !void {
+    switch (kind) {
+        .integer => {
+            _ = try value.toI32();
+        },
+        .number, .boolean_number => {
+            if (kind == .boolean_number and value.isBoolean()) return;
+            if (!std.math.isFinite(try value.toF64())) return error.TypeError;
+        },
+        .boolean => {
+            _ = value.toBool();
+        },
+        .boolean_string => {
+            if (value.isBoolean()) return;
+            _ = try domString(value);
+        },
+        .string => {
+            if (value.isObject()) {
+                if (try value.iterator()) |iterator| {
+                    try stringSequence(iterator, value.local);
+                    return;
+                }
+            }
+            _ = try domString(value);
+        },
+        .points => {
+            const iterator = try value.iterator() orelse return error.TypeError;
+            try pointSequence(iterator);
+        },
+    }
+}
+
+fn stringSequence(iterator: js.Value.Iterator, local: *const js.Local) !void {
+    while (try iterator.next()) |item| {
+        errdefer closeIterator(iterator, local);
+        _ = try domString(item);
+    }
+}
+
+pub fn closeIterator(iterator: js.Value.Iterator, local: *const js.Local) void {
+    // IteratorClose with a throwing completion preserves the original error.
+    var caught: js.TryCatch = undefined;
+    caught.init(local);
+    defer caught.deinit();
+    const method = iterator.object.getFunction("return") catch return;
+    const function = method orelse return;
+    _ = function.callWithThisRethrow(js.Value, iterator.object, .{}) catch {};
+}
+
+fn pointSequence(iterator: js.Value.Iterator) !void {
+    while (try iterator.next()) |item| {
+        errdefer closeIterator(iterator, item.local);
+        if (try dictionary(item)) |point| {
+            inline for (.{ "x", "y" }) |name| {
+                const v = try point.get(name);
+                if (!v.isUndefined() and !std.math.isFinite(try v.toF64())) return error.TypeError;
+            }
+        }
+    }
+}
+
+pub const Stream = struct { audio: Track = .{ .requested = false }, video: Track = .{ .requested = false } };
+
+pub fn stream(value: ?js.Value, display: bool) !Stream {
+    var result: Stream = .{ .video = .{ .requested = display } };
+    const object = try dictionary(value) orelse return result;
+    result.audio = try track(try object.get("audio"), false);
+    if (display) {
+        const controller = try object.get("controller");
+        if (!controller.isUndefined()) return error.TypeError;
+        _ = try enumMember(object, "monitorTypeSurfaces", &.{ "include", "exclude" });
+        _ = (try object.get("preferCurrentTab")).toBool();
+        _ = try enumMember(object, "selfBrowserSurface", &.{ "include", "exclude" });
+        _ = try enumMember(object, "surfaceSwitching", &.{ "include", "exclude" });
+        _ = try enumMember(object, "systemAudio", &.{ "include", "exclude" });
+    }
+    result.video = try track(try object.get("video"), display);
+    if (display) _ = try enumMember(object, "windowAudio", &.{ "system", "window", "exclude" });
+    return result;
+}
+
+fn enumMember(object: js.Object, name: []const u8, choices: []const []const u8) !?[]const u8 {
+    const value = try object.get(name);
+    if (value.isUndefined()) return null;
+    const text = try (try domString(value)).toSlice();
+    for (choices) |choice| if (std.mem.eql(u8, text, choice)) return text;
+    return error.TypeError;
+}
