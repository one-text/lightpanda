+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+const std = @import("std");
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Frame = @import("../Frame.zig");
+const URL = @import("../URL.zig");
+const Navigator = @import("Navigator.zig");
+const MediaDeviceInfo = @import("MediaDeviceInfo.zig");
+const Event = @import("Event.zig");
+const EventTarget = @import("EventTarget.zig");
+const EventManagerBase = @import("../EventManagerBase.zig");
+const DOMException = @import("DOMException.zig");
+const Constraints = @import("media_constraints.zig");
+
+const MediaDevices = @This();
+pub const Proto = EventTarget;
+
+_proto: *EventTarget,
+_navigator: *Navigator,
+_events: EventManagerBase,
+_onchange: ?js.Object.Global = null,
+_change_listener: ?js.Function.Global = null,
+
+pub fn init(exec: *js.Execution, navigator: *Navigator) !*MediaDevices {
+    return exec._factory.eventTargetWithAllocator(exec.arena, MediaDevices{
+        ._proto = undefined,
+        ._navigator = navigator,
+        ._events = EventManagerBase.init(exec.arena),
+    });
+}
+
+pub fn creationContext(self: *const MediaDevices, local: *const js.Local) *const js.v8.Context {
+    return self._navigator.creationContext(local);
+}
+
+fn active(self: *const MediaDevices) bool {
+    if (self._navigator._pdf_detached) return false;
+    const frame = self._navigator._frame orelse return false;
+    return frame.document._frame == frame;
+}
+
+fn enumerateDevices(self: *MediaDevices, exec: *js.Execution) !js.Promise {
+    const local = exec.js.local.?;
+    const resolver = local.createPromiseResolver();
+    if (!self.active()) {
+        try resolver.rejectValue(try exceptionValue(exec, "Current frame is detached", "NotSupportedError"));
+        return resolver.promise();
+    }
+    const frame = self._navigator._frame.?;
+    const array = local.newArray(0);
+    var index: u32 = 0;
+    // The Neo has one logical microphone, built-in camera, and speaker endpoint.
+    // No capture grants: expose only the anonymized default of each kind.
+    for ([_][]const u8{ "audioinput", "videoinput", "audiooutput" }, [_][]const u8{ "microphone", "camera", "speaker-selection" }) |kind, feature| {
+        if (!allowed(frame, feature)) continue;
+        const value = try MediaDeviceInfo.init(exec, self._navigator, kind);
+        var key_buf: [10]u8 = undefined;
+        const key = try std.fmt.bufPrint(&key_buf, "{d}", .{index});
+        if (!(array.toObject().defineOwnProperty(key, value, 0) orelse return error.JsException)) return error.TypeError;
+        index += 1;
+    }
+    try resolver.resolveValue(array.toValue());
+    return resolver.promise();
+}
+
+fn getSupportedConstraints(_: *const MediaDevices, exec: *js.Execution) !js.Object {
+    return Constraints.supported(exec.js.local.?);
+}
+
+fn getUserMedia(self: *MediaDevices, value: ?js.Value, exec: *js.Execution) !js.Promise {
+    return self.capture(value, false, exec);
+}
+
+fn getDisplayMedia(self: *MediaDevices, value: ?js.Value, exec: *js.Execution) !js.Promise {
+    return self.capture(value, true, exec);
+}
+
+fn capture(self: *MediaDevices, value: ?js.Value, display: bool, exec: *js.Execution) !js.Promise {
+    const local = exec.js.local.?;
+    var caught: js.TryCatch = undefined;
+    caught.init(local);
+    defer caught.deinit();
+    self.validateCapture(value, display) catch |err| {
+        if (err == error.ExecutionTerminated or exec.js.env.terminatePending()) return error.ExecutionTerminated;
+        const resolver = local.createPromiseResolver();
+        if (caught.exceptionValue()) |exception| {
+            try resolver.rejectValue(exception);
+        } else if (err == error.TypeError) {
+            try resolver.rejectValue(.{ .local = local, .handle = local.isolate.createTypeError("Invalid media constraints") });
+        } else {
+            const exception = switch (err) {
+                error.NotAllowedError => try exceptionValue(exec, "Permission denied", "NotAllowedError"),
+                error.InvalidStateError => try exceptionValue(exec, "The document is not active or transient activation is missing", "InvalidStateError"),
+                else => return err,
+            };
+            try resolver.rejectValue(exception);
+        }
+        return resolver.promise();
+    };
+    unreachable;
+}
+
+fn validateCapture(self: *MediaDevices, value: ?js.Value, display: bool) !void {
+    const stream = try Constraints.stream(value, display);
+    if (!self.active()) return error.InvalidStateError;
+    if (display) {
+        const frame = self._navigator._frame.?;
+        if (!allowed(frame, "display-capture")) return error.NotAllowedError;
+        const activation = self._navigator._share_activation_ms orelse return error.InvalidStateError;
+        if (lp.datetime.milliTimestamp(.boot) - activation >= 5000) return error.InvalidStateError;
+        if (!stream.video.requested or stream.audio.restricted or stream.video.restricted) return error.TypeError;
+    } else if (!stream.audio.requested and !stream.video.requested) return error.TypeError;
+    // Model the user denying capture, never a successful but non-existent stream.
+    return error.NotAllowedError;
+}
+
+fn exceptionValue(exec: *js.Execution, message: []const u8, name: []const u8) !js.Value {
+    // Native DOMExceptions must survive destruction of their creating context.
+    return exec.js.local.?.zigValueToJs(try exec._factory.create(DOMException.init(message, name)), .{});
+}
+
+fn setCaptureHandleConfig(self: *MediaDevices, value: ?js.Value, exec: *js.Execution) !void {
+    self.validateHandleConfig(value, exec) catch |err| {
+        const exception = switch (err) {
+            error.InvalidStateError => try exceptionValue(exec, "The document is detached or not top-level", "InvalidStateError"),
+            error.NotSupported => try exceptionValue(exec, "Invalid permitted origins", "NotSupportedError"),
+            else => return err,
+        };
+        _ = exec.js.local.?.isolate.throwException(exception.handle);
+        return error.JsException;
+    };
+}
+
+fn validateHandleConfig(self: *MediaDevices, value: ?js.Value, exec: *js.Execution) !void {
+    var origins: std.ArrayList([]const u8) = .empty;
+    var handle_length: c_int = 0;
+    if (try Constraints.dictionary(value)) |object| {
+        _ = (try object.get("exposeOrigin")).toBool();
+        const handle = try object.get("handle");
+        if (!handle.isUndefined()) handle_length = js.v8.v8__String__Length((try Constraints.domString(handle)).handle);
+        const permitted = try object.get("permittedOrigins");
+        if (!permitted.isUndefined()) {
+            const iterator = try permitted.iterator() orelse return error.TypeError;
+            while (try iterator.next()) |item| {
+                errdefer Constraints.closeIterator(iterator, exec.js.local.?);
+                try origins.append(exec.call_arena, try (try Constraints.domString(item)).toSlice());
+            }
+        }
+    }
+    if (handle_length > 1024) return error.TypeError;
+    if (!self.active() or self._navigator._frame.?.parent != null) return error.InvalidStateError;
+    if (origins.items.len == 1 and std.mem.eql(u8, origins.items[0], "*")) return;
+    for (origins.items) |origin| {
+        if (std.mem.eql(u8, origin, "*")) return error.NotSupported;
+        const resolved = URL.resolve(exec.call_arena, "", origin, .{}) catch |err| {
+            if (err == error.TypeError) return error.NotSupported;
+            return err;
+        };
+        if (try URL.getOrigin(exec.call_arena, resolved) == null) return error.NotSupported;
+    }
+    // With no capture backend there is no consumer of an accepted handle config.
+}
+
+fn getOnChange(self: *const MediaDevices) ?js.Object.Global {
+    return self._onchange;
+}
+
+fn setOnChange(self: *MediaDevices, value: js.Value, exec: *js.Execution) !void {
+    const local = exec.js.local.?;
+    const callback = if (value.isObject())
+        try (js.Object{ .local = local, .handle = @ptrCast(value.handle) }).persist()
+    else
+        null;
+    errdefer if (callback) |cb| cb.release();
+
+    // Keep the handler's place among listeners when replacing its callback.
+    if (self._onchange == null and callback != null) {
+        if (self._change_listener == null) {
+            self._change_listener = try local.newCallback(invokeOnChange, self).persist();
+        }
+        _ = try self._events.register(self._proto, "devicechange", .{
+            .function = self._change_listener.?.local(local),
+        }, .{});
+    } else if (self._onchange != null and callback == null) {
+        self._events.remove(self._proto, "devicechange", .{
+            .function = self._change_listener.?.local(local),
+        }, false);
+    }
+
+    if (self._onchange) |old| old.release();
+    self._onchange = callback;
+}
+
+fn invokeOnChange(self: *MediaDevices, event: *Event, exec: *js.Execution) !void {
+    const callback = self._onchange orelse return;
+    const local = exec.js.local.?;
+    const object = callback.local(local);
+    if (!object.toValue().isFunction()) return local.typeError("The event handler is not callable");
+    const function = js.Function{ .local = local, .handle = @ptrCast(object.handle) };
+    const result = try function.callWithThisRethrow(js.Value, self, .{event});
+    if (result.isBoolean() and result.isFalse()) event.preventDefault();
+}
+
+pub fn dispatch(self: *MediaDevices, event: *Event, exec: *js.Execution) !void {
+    event._target = self._proto;
+    event._dispatch_target = self._proto;
+    event._event_phase = .at_target;
+    defer {
+        event._event_phase = .none;
+        event._current_target = null;
+        event._dispatch_target = null;
+        event._stop_propagation = false;
+        event._stop_immediate_propagation = false;
+        event._in_passive_listener = false;
+    }
+    if (event._stop_propagation) return;
+    try self._events.dispatchDirect(exec.page.frame_arena, exec.js, self._proto, event, null, exec.page, .{ .run_microtasks = false });
+}
+
+fn sameOrigin(a: *Frame, b: *Frame) bool {
+    return URL.isSameOrigin(a.origin orelse return false, b.origin orelse return false);
+}
+
+// Only media-device directives are interpreted; this is not a general policy API.
+fn allowed(frame: *Frame, feature: []const u8) bool {
+    return headerAllows(frame, frame, feature) and inheritedAllows(frame, feature);
+}
+
+fn inheritedAllows(frame: *Frame, feature: []const u8) bool {
+    const parent = frame.parent orelse return true;
+    // A parent may delegate to a child without allowing its own origin.
+    if (!inheritedAllows(parent, feature) or !headerAllows(parent, frame, feature)) return false;
+    const iframe = frame.iframe orelse return sameOrigin(parent, frame);
+    const allow = iframe.asElement().getAttributeSafe(.wrap("allow")) orelse return sameOrigin(parent, frame);
+    var directives = std.mem.splitScalar(u8, allow, ';');
+    while (directives.next()) |directive| {
+        var tokens = std.mem.tokenizeAny(u8, directive, " \t\r\n");
+        if (!std.mem.eql(u8, tokens.next() orelse continue, feature)) continue;
+        var token = tokens.next();
+        if (token == null) return sourceMatches(frame, parent, iframe.asElement().getAttributeSafe(.wrap("src")) orelse "");
+        var matches = false;
+        while (token) |item| : (token = tokens.next()) {
+            if (std.mem.eql(u8, item, "'none'")) return false;
+            if (std.mem.eql(u8, item, "*") or
+                (std.mem.eql(u8, item, "'self'") and sameOrigin(parent, frame)) or
+                (std.mem.eql(u8, item, "'src'") and sourceMatches(frame, parent, iframe.asElement().getAttributeSafe(.wrap("src")) orelse "")) or
+                URL.isSameOrigin(item, frame.origin orelse "")) matches = true;
+        }
+        return matches;
+    }
+    return sameOrigin(parent, frame);
+}
+
+fn sourceMatches(frame: *Frame, parent: *Frame, source: []const u8) bool {
+    if (source.len == 0) return sameOrigin(frame, parent);
+    const resolved = URL.resolve(parent.call_arena, parent.base(), source, .{}) catch return false;
+    return frame.isSameOrigin(resolved);
+}
+
+fn headerAllows(owner: *Frame, target: *Frame, feature: []const u8) bool {
+    for (owner._http_headers.items) |header| {
+        if (!std.ascii.eqlIgnoreCase(header.name, "permissions-policy")) continue;
+        var directives = std.mem.splitScalar(u8, header.value, ',');
+        while (directives.next()) |directive| {
+            const equal = std.mem.indexOfScalar(u8, directive, '=') orelse continue;
+            if (!std.mem.eql(u8, std.mem.trim(u8, directive[0..equal], " \t"), feature)) continue;
+            const list = std.mem.trim(u8, directive[equal + 1 ..], " \t");
+            if (std.mem.eql(u8, list, "*")) continue;
+            if (list.len < 2 or list[0] != '(' or list[list.len - 1] != ')') continue;
+            var tokens = std.mem.tokenizeAny(u8, list[1 .. list.len - 1], " \t");
+            var matches = false;
+            while (tokens.next()) |token| {
+                if (std.mem.eql(u8, token, "self") and sameOrigin(owner, target)) matches = true;
+                if (token.len >= 2 and token[0] == '"' and token[token.len - 1] == '"' and
+                    URL.isSameOrigin(token[1 .. token.len - 1], target.origin orelse "")) matches = true;
+            }
+            if (!matches) return false;
+        }
+    }
+    return true;
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(MediaDevices);
+    pub const Meta = struct {
+        pub const name = "MediaDevices";
+        pub const creation_context = MediaDevices.creationContext;
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const ondevicechange = bridge.accessor(getOnChange, setOnChange, .{});
+    pub const enumerateDevices = bridge.function(MediaDevices.enumerateDevices, .{});
+    pub const getSupportedConstraints = bridge.function(MediaDevices.getSupportedConstraints, .{});
+    pub const getUserMedia = bridge.function(MediaDevices.getUserMedia, .{});
+    pub const getDisplayMedia = bridge.function(MediaDevices.getDisplayMedia, .{});
+    pub const setCaptureHandleConfig = bridge.function(MediaDevices.setCaptureHandleConfig, .{});
+};
