+pub fn setMediaDevicesExposure(self: *const Env, ctx: *Context, v8_context: *const v8.Context, global_obj: *const v8.Object, secure: bool) !void {
+    if (secure == (ctx.media_device_bindings == null)) return;
+    const isolate = self.isolate.handle;
+    const names = &self.disabled_api_names;
+    const constructor = v8.v8__Object__Get(global_obj, v8_context, @ptrCast(names.get(isolate, "navigator"))) orelse return error.JsException;
+    const prototype: *const v8.Object = @ptrCast(v8.v8__Object__Get(@ptrCast(constructor), v8_context, @ptrCast(names.get(isolate, "prototype"))) orelse return error.JsException);
+    const key = names.get(isolate, "media_devices");
+    const keys = [_]*const v8.String{
+        names.get(isolate, "media_devices_interface"),
+        names.get(isolate, "media_device_info"),
+        names.get(isolate, "input_device_info"),
+    };
+    var result: v8.MaybeBool = undefined;
+    if (secure) {
+        const bindings = &ctx.media_device_bindings.?;
+        const args = [_]?*const v8.Value{
+            @ptrCast(prototype), @ptrCast(key), v8.v8__Global__Get(&bindings.descriptor, isolate),
+        };
+        const define: *const v8.Function = @ptrCast(v8.v8__Global__Get(&bindings.define_property, isolate));
+        _ = v8.v8__Function__Call(define, v8_context, @ptrCast(global_obj), args.len, &args) orelse return error.JsException;
+        for (keys, &bindings.interfaces) |interface_key, *binding| {
+            v8.v8__Object__DefineOwnProperty(global_obj, v8_context, @ptrCast(interface_key), v8.v8__Global__Get(binding, isolate), v8.DontEnum, &result);
+            if (!result.has_value or !result.value) return error.JsException;
+        }
+        v8.v8__Global__Reset(&bindings.descriptor);
+        v8.v8__Global__Reset(&bindings.define_property);
+        for (&bindings.interfaces) |*binding| v8.v8__Global__Reset(binding);
+        ctx.media_device_bindings = null;
+    } else {
+        const descriptor = v8.v8__Object__GetOwnPropertyDescriptor(prototype, v8_context, @ptrCast(key)) orelse return error.JsException;
+        const object = v8.v8__Object__Get(global_obj, v8_context, self.isolate.initStringHandle("Object")) orelse return error.JsException;
+        const define = v8.v8__Object__Get(@ptrCast(object), v8_context, self.isolate.initStringHandle("defineProperty")) orelse return error.JsException;
+        var interfaces: [3]*const v8.Value = undefined;
+        for (keys, &interfaces) |interface_key, *interface| {
+            interface.* = v8.v8__Object__Get(global_obj, v8_context, @ptrCast(interface_key)) orelse return error.JsException;
+        }
+        ctx.media_device_bindings = .{ .descriptor = undefined, .define_property = undefined, .interfaces = undefined };
+        const bindings = &ctx.media_device_bindings.?;
+        v8.v8__Global__New(isolate, descriptor, &bindings.descriptor);
+        v8.v8__Global__New(isolate, define, &bindings.define_property);
+        for (interfaces, &bindings.interfaces) |interface, *binding| v8.v8__Global__New(isolate, interface, binding);
+        v8.v8__Object__Delete(prototype, v8_context, @ptrCast(key), &result);
+        if (!result.has_value or !result.value) return error.JsException;
+        for (keys) |interface_key| {
+            v8.v8__Object__Delete(global_obj, v8_context, @ptrCast(interface_key), &result);
+            if (!result.has_value or !result.value) return error.JsException;
+        }
+    }
+}
