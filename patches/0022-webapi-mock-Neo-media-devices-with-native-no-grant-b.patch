+    input_device_info: v8.Eternal,
 
     fn init(isolate: *v8.Isolate) DisabledApiNames {
         var self: DisabledApiNames = undefined;
@@ -947,6 +1001,10 @@ const DisabledApiNames = struct {
         intern(isolate, &self.battery_manager, "BatteryManager");
         intern(isolate, &self.can_share, "canShare");
         intern(isolate, &self.share, "share");
