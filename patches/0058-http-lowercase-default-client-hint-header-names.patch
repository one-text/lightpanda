From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: brennoflavio <contato@brennoflavio.com.br>
Date: Mon, 2 Nov 2026 00:19:13 -0300
Subject: [PATCH] http: lowercase default client-hint header names

Match the lowercase sec-ch-ua, sec-ch-ua-mobile and sec-ch-ua-platform
wire spelling observed from Chrome 154 over HTTP/1.1 by fingerprint/.
Keep values, ordering, fixed-header precedence, trust gating and redirect
recomputation unchanged. HTTP/2 already lowercases these names.

Limit this patch to the three default low-entropy names. High-entropy
hint spelling, fetch ordering, Connection and compression remain separate
work. Temporary diagnostics cover HTTP/1.1 navigation, redirects, repeat
requests, mixed-case CDP/author overrides and unchanged HTTP/2 headers and
startup behavior. All 1658 existing upstream tests pass. No new unit tests.

References: fingerprint/README.md; Chrome 154.0.8037.97 local wire captures.
---
 src/network/HttpClient.zig | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/network/HttpClient.zig b/src/network/HttpClient.zig
index ae05ea6..54868fe 100644
--- a/src/network/HttpClient.zig
+++ b/src/network/HttpClient.zig
@@ -469,8 +469,8 @@ pub fn getLanguages(self: *const Client) []const []const u8 {
 pub fn baselineHeaders(self: *const Client) [4]Transfer.RequestHeader {
     return .{
         .{ .name = "User-Agent", .value = self.getUserAgent() },
-        .{ .name = "Sec-Ch-Ua", .value = lp.Config.HttpHeaders.sec_ch_ua, .source = .fixed },
-        .{ .name = "Sec-Ch-Ua-Platform", .value = lp.Config.HttpHeaders.sec_ch_ua_platform, .source = .fixed },
+        .{ .name = "sec-ch-ua", .value = lp.Config.HttpHeaders.sec_ch_ua, .source = .fixed },
+        .{ .name = "sec-ch-ua-platform", .value = lp.Config.HttpHeaders.sec_ch_ua_platform, .source = .fixed },
         // Omitting Accept-Language triggers bot-protection on some CDNs
         // (Akamai) when Accept-Encoding is present.
         .{ .name = "Accept-Language", .value = self.getAcceptLanguage() },
@@ -1338,10 +1338,10 @@ fn setClientHintHeaders(transfer: *Transfer) !void {
     }
 
     if (transfer.req.internal or !URL.isPotentiallyTrustworthy(transfer.req.url)) {
-        transfer.removeHeader("Sec-Ch-Ua-Mobile");
+        transfer.removeHeader("sec-ch-ua-mobile");
         return;
     }
-    try transfer.setHeader("Sec-Ch-Ua-Mobile", "?0", .{ .source = .fixed });
+    try transfer.setHeader("sec-ch-ua-mobile", "?0", .{ .source = .fixed });
     const owner = transfer.owner orelse return;
     const hints = owner.client_hints orelse return;
     if (transfer.req.resource_type != .document or owner.parent != null) {
