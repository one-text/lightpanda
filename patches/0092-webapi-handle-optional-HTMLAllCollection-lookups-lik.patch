 // This program is free software: you can redistribute it and/or modify
@@ -81,15 +83,25 @@ fn isAllNamed(el: *Element) bool {
     };
 }
 
-const CAllAsFunctionArg = union(enum) {
-    index: u32,
-    id: []const u8,
-};
-pub fn callable(self: *HTMLAllCollection, arg: CAllAsFunctionArg, frame: *Frame) ?*Element {
-    return switch (arg) {
-        .index => |i| self.getAtIndex(i, frame),
-        .id => |id| self.getByName(id, frame),
-    };
+pub fn callable(self: *HTMLAllCollection, args: []const js.Value, frame: *Frame) !?*Element {
+    if (args.len == 0 or args[0].isUndefined()) return null;
+    if (args[0].isSymbol()) return error.TypeError;
+    const name = try args[0].toStringSlice();
+    if (name.len == 0) return null;
+
+    // Only canonical array-index strings select an indexed element.
+    if (name.len == 1 or name[0] != '0') {
+        var digits = true;
+        for (name) |c| if (!std.ascii.isDigit(c)) {
+            digits = false;
+            break;
+        };
+        if (digits) {
+            const index = std.fmt.parseInt(u32, name, 10) catch null;
+            if (index) |i| if (i != std.math.maxInt(u32)) return self.getAtIndex(i, frame);
+        }
+    }
+    return self.getByName(name, frame);
 }
 
 pub fn iterator(self: *HTMLAllCollection, exec: *const Execution) !*Iterator {
@@ -135,19 +147,12 @@ pub const JsApi = struct {
         }
     }.wrap, .{ .null_as_undefined = true });
 
-    pub const item = bridge.function(struct {
-        fn wrap(self: *HTMLAllCollection, index: i32, frame: *Frame) ?*Element {
-            if (index < 0) {
-                return null;
-            }
-            return self.getAtIndex(@intCast(index), frame);
-        }
-    }.wrap, .{});
+    pub const item = bridge.function(HTMLAllCollection.callable, .{});
 
     pub const namedItem = bridge.function(HTMLAllCollection.getByName, .{});
     pub const symbol_iterator = bridge.iterator(HTMLAllCollection.iterator, .{});
 
-    pub const callable = bridge.callable(HTMLAllCollection.callable, .{ .null_as_undefined = true });
+    pub const callable = bridge.callable(HTMLAllCollection.callable, .{});
 };
 
 const testing = @import("../../../testing.zig");
