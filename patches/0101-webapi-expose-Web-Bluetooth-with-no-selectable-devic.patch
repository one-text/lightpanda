+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const v8 = js.v8;
+const Frame = @import("../Frame.zig");
+const Navigator = @import("Navigator.zig");
+const DOMException = @import("DOMException.zig");
+const EventTarget = @import("EventTarget.zig");
+const EventManagerBase = @import("../EventManagerBase.zig");
+const Conversion = @import("media_constraints.zig");
+const policyAllows = @import("MediaDevices.zig").allowed;
+
+const Bluetooth = @This();
+pub const Proto = EventTarget;
+
+_proto: *EventTarget,
+_navigator: *Navigator,
+_events: EventManagerBase,
+
+pub fn init(navigator: *Navigator, exec: *js.Execution) !*Bluetooth {
+    return exec._factory.eventTargetWithAllocator(exec.arena, Bluetooth{
+        ._proto = undefined,
+        ._navigator = navigator,
+        ._events = .init(exec.arena),
+    });
+}
+
+fn creationContext(self: *const Bluetooth, local: *const js.Local) *const v8.Context {
+    return self._navigator.creationContext(local);
+}
+
+fn activeFrame(self: *const Bluetooth) ?*Frame {
+    const frame = self._navigator._frame orelse return null;
+    if (self._navigator._pdf_detached or frame.document._frame != frame or !frame.isSecureContext()) return null;
+    return frame;
+}
+
+fn getAvailability(self: *const Bluetooth, exec: *js.Execution) !js.Promise {
+    const local = exec.js.local.?;
+    const resolver = local.createPromiseResolver();
+    if (self.activeFrame()) |frame| {
+        // The persona has an adapter, independent of nearby peripherals.
+        try resolver.resolveValue(try local.zigValueToJs(policyAllows(frame, "bluetooth"), .{}));
+    } else {
+        try resolver.rejectValue(.{ .local = local, .handle = local.isolate.createTypeError("Document not active") });
+    }
+    return resolver.promise();
+}
+
+fn requestDevice(self: *const Bluetooth, input: ?js.Value, exec: *js.Execution) !js.Promise {
+    const local = exec.js.local.?;
+    const resolver = local.createPromiseResolver();
+    var caught: js.TryCatch = undefined;
+    caught.init(local);
+    defer caught.deinit();
+    self.request(input, exec, resolver) catch |err| {
+        if (err == error.ExecutionTerminated or exec.js.env.terminatePending()) return error.ExecutionTerminated;
+        const value = caught.exceptionValue() orelse switch (err) {
+            error.InactiveDocument => js.Value{ .local = local, .handle = local.isolate.createTypeError("Document not active") },
+            error.TypeError => js.Value{ .local = local, .handle = local.isolate.createTypeError("Invalid Bluetooth device request options") },
+            error.PolicyBlocked => try exceptionValue(exec, local, "Access to the feature \"bluetooth\" is disallowed by permissions policy.", "SecurityError"),
+            error.NoActivation => try exceptionValue(exec, local, "Must be handling a user gesture to show a permission request.", "SecurityError"),
+            else => return err,
+        };
+        try resolver.rejectValue(value);
+    };
+    return resolver.promise();
+}
+
+fn request(self: *const Bluetooth, input: ?js.Value, exec: *js.Execution, resolver: js.PromiseResolver) !void {
+    const options = try Conversion.dictionary(input);
+    const frame = self.activeFrame() orelse return error.InactiveDocument;
+    if (!policyAllows(frame, "bluetooth")) return error.PolicyBlocked;
+    const activation = self._navigator._share_activation_ms orelse return error.NoActivation;
+    if (lp.datetime.milliTimestamp(.boot) - activation >= 5000) return error.NoActivation;
+    try validateOptions(options orelse return error.TypeError);
+
+    // No host scanning or chooser UI. Dismiss the empty chooser on a later task.
+    const arena = try exec.getArena(.tiny, "Bluetooth.requestDevice");
+    errdefer arena.release();
+    const task = try arena.create(Dismissal);
+    task.* = .{ .arena = arena, .exec = exec, .resolver = try resolver.persist() };
+    errdefer task.resolver.release();
+    try exec.js.scheduler.add(task, Dismissal.run, 0, .{
+        .name = "Bluetooth.requestDevice",
+        .finalizer = Dismissal.finalize,
+    });
+}
+
+fn exceptionValue(exec: *js.Execution, local: *const js.Local, message: []const u8, name: []const u8) !js.Value {
+    const exception = try exec._factory.create(DOMException.init(message, name));
+    return local.zigValueToJs(exception, .{});
+}
+
+fn validateOptions(options: js.Object) !void {
+    const accept_all = (try options.get("acceptAllDevices")).toBool();
+    const exclusions = try options.get("exclusionFilters");
+    const filters = try options.get("filters");
+    const has_filters = !filters.isUndefined();
+    if (accept_all == has_filters or (!has_filters and !exclusions.isUndefined())) return error.TypeError;
+    if (has_filters) try validateFilters(filters);
+    if (!exclusions.isUndefined()) try validateFilters(exclusions);
+}
+
+// Check filter structure without canonicalizing UUIDs or matching peripherals.
+fn validateFilters(filters: js.Value) !void {
+    const iterator = try filters.iterator() orelse return error.TypeError;
+    var has_filter = false;
+    while (try iterator.next()) |value| {
+        errdefer Conversion.closeIterator(iterator, filters.local);
+        has_filter = true;
+        const filter = try Conversion.dictionary(value) orelse return error.TypeError;
+        var restricted = false;
+        inline for (.{ "manufacturerData", "name", "namePrefix", "services" }) |key| {
+            const member = try filter.get(key);
+            if (!member.isUndefined()) {
+                restricted = true;
+                if (comptime key[0] == 'n') {
+                    const name = try (try Conversion.domString(member)).toSlice();
+                    if (name.len > 248 or (key.len > 4 and name.len == 0)) return error.TypeError;
+                } else {
+                    const entries = try member.iterator() orelse return error.TypeError;
+                    _ = try entries.next() orelse return error.TypeError;
+                    while (try entries.next()) |_| {}
+                }
+            }
+        }
+        if (!restricted) return error.TypeError;
+    }
+    if (!has_filter) return error.TypeError;
+}
+
+const Dismissal = struct {
+    arena: *lp.Arena,
+    exec: *js.Execution,
+    resolver: js.PromiseResolver.Global,
+
+    fn run(ctx: *anyopaque) !?u32 {
+        const self: *Dismissal = @ptrCast(@alignCast(ctx));
+        defer finalize(ctx);
+        var scope: js.Local.Scope = undefined;
+        self.exec.js.localScope(&scope);
+        defer scope.deinit();
+        const exception = try exceptionValue(self.exec, &scope.local, "User cancelled the requestDevice() chooser.", "NotFoundError");
+        try self.resolver.local(&scope.local).rejectValue(exception);
+        scope.local.runMicrotasks();
+        return null;
+    }
+
+    fn finalize(ctx: *anyopaque) void {
+        const self: *Dismissal = @ptrCast(@alignCast(ctx));
+        self.resolver.release();
+        self.arena.release();
+    }
+};
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(Bluetooth);
+    pub const Meta = struct {
+        pub const name = "Bluetooth";
+        pub const creation_context = Bluetooth.creationContext;
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const getAvailability = bridge.function(Bluetooth.getAvailability, .{});
+    pub const requestDevice = bridge.function(Bluetooth.requestDevice, .{});
+};
+
+pub const Bindings = struct {
+    prototype: v8.Global,
+    descriptor: v8.Global,
+    interface: v8.Global,
+    define_property: v8.Global,
+    hidden: bool = false,
+
+    pub fn deinit(self: *Bindings) void {
+        v8.v8__Global__Reset(&self.prototype);
+        v8.v8__Global__Reset(&self.descriptor);
+        v8.v8__Global__Reset(&self.interface);
+        v8.v8__Global__Reset(&self.define_property);
+    }
+};
+
+pub fn expose(ctx: *js.Context, context: *const v8.Context, global: *const v8.Object, secure: bool) !void {
+    const isolate = ctx.isolate;
+    const key = isolate.initStringHandle("bluetooth");
+    const interface_key = isolate.initStringHandle("Bluetooth");
+    if (ctx.bluetooth_bindings == null) {
+        const navigator = v8.v8__Object__Get(global, context, isolate.initStringHandle("Navigator")) orelse return error.JsException;
+        const prototype = v8.v8__Object__Get(@ptrCast(navigator), context, isolate.initStringHandle("prototype")) orelse return error.JsException;
+        const descriptor = v8.v8__Object__GetOwnPropertyDescriptor(@ptrCast(prototype), context, key) orelse return error.JsException;
+        const interface = v8.v8__Object__Get(global, context, interface_key) orelse return error.JsException;
+        const object = v8.v8__Object__Get(global, context, isolate.initStringHandle("Object")) orelse return error.JsException;
+        const define = v8.v8__Object__Get(@ptrCast(object), context, isolate.initStringHandle("defineProperty")) orelse return error.JsException;
+        ctx.bluetooth_bindings = .{ .prototype = undefined, .descriptor = undefined, .interface = undefined, .define_property = undefined };
+        const bindings = &ctx.bluetooth_bindings.?;
+        v8.v8__Global__New(isolate.handle, prototype, &bindings.prototype);
+        v8.v8__Global__New(isolate.handle, descriptor, &bindings.descriptor);
+        v8.v8__Global__New(isolate.handle, interface, &bindings.interface);
+        v8.v8__Global__New(isolate.handle, define, &bindings.define_property);
+    }
+
+    const bindings = &ctx.bluetooth_bindings.?;
+    if (secure != bindings.hidden) return;
+    const prototype: *const v8.Object = @ptrCast(v8.v8__Global__Get(&bindings.prototype, isolate.handle).?);
+    var result: v8.MaybeBool = undefined;
+    if (secure) {
+        const define: *const v8.Function = @ptrCast(v8.v8__Global__Get(&bindings.define_property, isolate.handle).?);
+        const args = [_]?*const v8.Value{ @ptrCast(prototype), key, v8.v8__Global__Get(&bindings.descriptor, isolate.handle) };
+        _ = v8.v8__Function__Call(define, context, @ptrCast(global), args.len, &args) orelse return error.JsException;
+        v8.v8__Object__DefineOwnProperty(global, context, @ptrCast(interface_key), v8.v8__Global__Get(&bindings.interface, isolate.handle), v8.DontEnum, &result);
+    } else {
+        v8.v8__Object__Delete(prototype, context, key, &result);
+        if (!result.has_value or !result.value) return error.JsException;
+        v8.v8__Object__Delete(global, context, interface_key, &result);
+    }
+    if (!result.has_value or !result.value) return error.JsException;
+    bindings.hidden = !secure;
+}
