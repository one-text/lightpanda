 src/browser/js/Env.zig             |   3 +
 src/browser/js/bridge.zig          |   1 +
 src/browser/webapi/Bluetooth.zig   | 235 +++++++++++++++++++++++++++++
 src/browser/webapi/EventTarget.zig |  18 +++
 src/browser/webapi/Navigator.zig   |   8 +
 6 files changed, 268 insertions(+)
 create mode 100644 src/browser/webapi/Bluetooth.zig

