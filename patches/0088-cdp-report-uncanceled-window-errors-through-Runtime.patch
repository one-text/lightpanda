+const CallFrame = struct {
+    functionName: []const u8,
+    scriptId: []const u8,
+    url: []const u8,
+    lineNumber: i32,
+    columnNumber: i32,
+};
+
+const StackTrace = struct {
+    callFrames: []const CallFrame,
+};
+
+pub fn exceptionThrown(arena: Allocator, attached: *CDP.BrowserContext.AttachedSession, report: *const Notification.RuntimeException) !void {
+    // Enter the originating world, not the main frame's default world. The
+    // report's local handles remain rooted by the synchronous dispatch caller.
+    var ls: js.Local.Scope = undefined;
+    report.value.local.ctx.localScope(&ls);
+    defer ls.deinit();
+    const local = &ls.local;
+
+    var frames: std.ArrayList(CallFrame) = .empty;
+    var description: std.Io.Writer.Allocating = .init(arena);
+    try description.writer.writeAll(report.message);
+    if (report.stack) |stack| {
+        const count = js.v8.v8__StackTrace__GetFrameCount(stack);
+        for (0..@intCast(count)) |i| {
+            const frame = js.v8.v8__StackTrace__GetFrame(stack, local.isolate.handle, @intCast(i)) orelse continue;
+            const name = try nativeString(arena, local, js.v8.v8__StackFrame__GetFunctionName(frame));
+            const url = try nativeString(arena, local, js.v8.v8__StackFrame__GetScriptNameOrSourceURL(frame));
+            const line = js.v8.v8__StackFrame__GetLineNumber(frame);
+            const column = js.v8.v8__StackFrame__GetColumn(frame);
+            try frames.append(arena, .{
+                .functionName = name,
+                .scriptId = try std.fmt.allocPrint(arena, "{d}", .{js.v8.v8__StackFrame__GetScriptId(frame)}),
+                .url = url,
+                .lineNumber = @max(0, line - 1),
+                .columnNumber = @max(0, column - 1),
+            });
+            try description.writer.print("\n    at {s} ({s}:{d}:{d})", .{
+                if (name.len == 0) "<anonymous>" else name,
+                if (url.len == 0) "<anonymous>" else url,
+                line,
+                column,
+            });
+        }
+    }
+
+    // V8 releases the diagnostic "console" group across sessions when the
+    // client calls Runtime.discardConsoleEntries or the page clears its console.
+    const remote = try attached.inspector_session.getConsoleRemoteObject(local, report.value);
+    defer remote.deinit();
+    var exception: RemoteObject = .{
+        .type = try remote.getType(arena),
+        .subtype = try remote.getSubtype(arena),
+        .className = try remote.getClassName(arena),
+        .description = if (report.value.isNativeError()) description.written() else try remote.getDescription(arena),
+        .objectId = try remote.getObjectId(arena),
+    };
+    try exception.setPrimitive(arena, report.value);
+
+    const first = if (frames.items.len == 0) null else frames.items[0];
+    return attached.bc.cdp.sendEvent("Runtime.exceptionThrown", .{
+        .timestamp = report.timestamp,
+        .exceptionDetails = .{
+            .exceptionId = attached.exception_id,
+            .text = "Uncaught",
+            .lineNumber = if (first) |f| f.lineNumber else 0,
+            .columnNumber = if (first) |f| f.columnNumber else 0,
+            .scriptId = if (first) |f| f.scriptId else @as(?[]const u8, null),
+            .url = if (first) |f| (if (f.url.len == 0) null else f.url) else @as(?[]const u8, null),
+            .stackTrace = if (first != null) StackTrace{ .callFrames = frames.items } else @as(?StackTrace, null),
+            .exception = exception,
+            .executionContextId = attached.bc.inspector().getContextId(local),
+        },
+    }, .{ .session_id = attached.id });
+}
+
+fn nativeString(arena: Allocator, local: *const js.Local, handle: ?*const js.v8.String) ![]const u8 {
+    const str: js.String = .{ .local = local, .handle = handle orelse return "" };
+    return str.toSliceWithAlloc(arena);
+}
+
