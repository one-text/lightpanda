 }
 
 fn getReadyState(self: *const Media) u16 {
@@ -265,6 +270,84 @@ fn setSrc(self: *Media, value: []const u8, frame: *Frame) !void {
     try self.asElement().setAttributeSafe(comptime .wrap("src"), .wrap(value), frame);
 }
 
+pub fn sourceChanged(self: *Media, frame: *Frame) !void {
+    self._source_generation +%= 1;
+    self._duration = std.math.nan(f64);
+    self._ready_state = .HAVE_NOTHING;
+    self._network_state = .NETWORK_EMPTY;
+    self._error = null;
+    const src = self.asElement().getAttributeInterned("src") orelse return;
+    const comma = std.mem.indexOfScalar(u8, src, ',') orelse return;
+    if (src.len < 5 or !std.ascii.eqlIgnoreCase(src[0..5], "data:")) return;
+    const meta = std.mem.trim(u8, src[5..comma], &std.ascii.whitespace);
+    const essence = std.mem.trim(u8, meta[0 .. std.mem.indexOfScalar(u8, meta, ';') orelse meta.len], &std.ascii.whitespace);
+    if (!std.ascii.eqlIgnoreCase(essence, "audio/mpeg") and !std.ascii.eqlIgnoreCase(essence, "audio/mp3")) return;
+    const arena = try frame.js.execution.getArena(.small, "Media.metadata");
+    errdefer arena.release();
+    const source = try arena.dupe(u8, src);
+    @memcpy(source[0..5], "data:");
+    const task = try arena.create(MetadataTask);
+    task.* = .{ .media = self, .frame = frame, .arena = arena, .source = source, .generation = self._source_generation };
+    try frame.js.scheduler.add(task, MetadataTask.run, 0, .{ .name = "Media.metadata", .blocks_done = false, .finalizer = MetadataTask.finalize });
+    self._network_state = .NETWORK_LOADING;
+}
+const MetadataTask = struct {
+    media: *Media,
+    frame: *Frame,
+    arena: *lp.Arena,
+    source: []const u8,
+    generation: u32,
+    fn finalize(ptr: *anyopaque) void {
+        const task: *MetadataTask = @ptrCast(@alignCast(ptr));
+        task.arena.release();
+    }
+    fn emit(task: *MetadataTask, comptime name: []const u8) !void {
+        const event = try Event.init(name, .{ .bubbles = false, .cancelable = false }, task.frame.page);
+        event._is_trusted = true;
+        try task.frame._event_manager.dispatch(task.media.asElement().asEventTarget(), event);
+    }
+    fn run(ptr: *anyopaque) !?u32 {
+        const task: *MetadataTask = @ptrCast(@alignCast(ptr));
+        defer finalize(ptr);
+        const self = task.media;
+        if (task.frame.isGoingAway() or self._source_generation != task.generation) return null;
+        var scope: js.Local.Scope = undefined;
+        task.frame.js.localScope(&scope);
+        defer scope.deinit();
+        defer scope.local.runMicrotasks();
+        const parsed = @import("../../../data_url.zig").parse(task.arena.allocator(), task.source) catch |err| switch (err) {
+            error.OutOfMemory => return err,
+            else => return task.failed(),
+        };
+        const duration = @import("../../../media/mpeg_audio.zig").duration(parsed.body) orelse return task.failed();
+        self._duration = duration;
+        if (self._ready_state == .HAVE_NOTHING) self._ready_state = .HAVE_METADATA;
+        self._network_state = .NETWORK_IDLE;
+        try task.emit("durationchange");
+        if (self._source_generation != task.generation) return null;
+        try task.emit("loadedmetadata");
+        return null;
+    }
+    fn failed(task: *MetadataTask) !?u32 {
+        const err = try task.frame.arena.create(MediaError);
+        err.* = .{ ._code = 4 };
+        task.media._error = err;
+        task.media._ready_state = .HAVE_NOTHING;
+        task.media._paused = true;
+        task.media._network_state = .NETWORK_NO_SOURCE;
+        try task.emit("error");
+        return null;
+    }
+};
+pub const Build = struct {
+    pub fn attributeChange(element: *Element, name: lp.String, _: lp.String, frame: *Frame) !void {
+        if (name.eql(comptime .wrap("src"))) try element.as(Media).sourceChanged(frame);
+    }
+    pub fn attributeRemove(element: *Element, name: lp.String, frame: *Frame) !void {
+        if (name.eql(comptime .wrap("src"))) try element.as(Media).sourceChanged(frame);
+    }
+};
+
 pub const JsApi = struct {
     pub const bridge = js.Bridge(Media);
 
