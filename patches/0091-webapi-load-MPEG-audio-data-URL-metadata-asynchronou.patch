+const std = @import("std");
+const Header = struct { size: usize, rate: u32, samples: u32, mono: bool, mpeg1: bool, crc: bool };
+fn header(b: []const u8) ?Header {
+    if (b.len < 4 or b[0] != 0xff or b[1] & 0xe0 != 0xe0) return null;
+    const version = (b[1] >> 3) & 3;
+    if (version == 1 or (b[1] >> 1) & 3 != 1 or b[3] & 3 == 2) return null;
+    const bitrates1 = [_]u32{ 0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 0 };
+    const bitrates2 = [_]u32{ 0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160, 0 };
+    const bitrate = if (version == 3) bitrates1[b[2] >> 4] else bitrates2[b[2] >> 4];
+    const rate_index = (b[2] >> 2) & 3;
+    if (bitrate == 0 or rate_index == 3) return null;
+    const rates = [_]u32{ 44100, 48000, 32000 };
+    const rate = rates[rate_index] / @as(u32, if (version == 3) 1 else if (version == 2) 2 else 4);
+    const size = (if (version == 3) @as(u32, 144000) else 72000) * bitrate / rate + ((b[2] >> 1) & 1);
+    if (size > b.len or size < 4) return null;
+    return .{ .size = size, .rate = rate, .samples = if (version == 3) 1152 else 576, .mono = b[3] >> 6 == 3, .mpeg1 = version == 3, .crc = b[1] & 1 == 0 };
+}
+fn be32(b: []const u8) u32 {
+    return std.mem.readInt(u32, b[0..4], .big);
+}
+fn xing(frame: []const u8, h: Header, frame_count: u32) error{InvalidXing}!?f64 {
+    const offset: usize = 4 + @as(usize, if (h.crc) 2 else 0) + @as(usize, if (h.mpeg1) (if (h.mono) 17 else 32) else (if (h.mono) 9 else 17));
+    if (offset + 4 > frame.len or (!std.mem.eql(u8, frame[offset .. offset + 4], "Xing") and !std.mem.eql(u8, frame[offset .. offset + 4], "Info"))) return null;
+    if (offset + 12 > frame.len) return error.InvalidXing;
+    const flags = be32(frame[offset + 4 ..]);
+    if (flags & 1 == 0 or flags & ~@as(u32, 15) != 0) return error.InvalidXing;
+    const frames = be32(frame[offset + 8 ..]);
+    var end = offset + 12;
+    if (flags & 2 != 0) end += 4;
+    if (flags & 4 != 0) end += 100;
+    if (flags & 8 != 0) end += 4;
+    if (end > frame.len) return error.InvalidXing;
+    // A zero frame count carries no duration; scan the complete stream instead.
+    if (frames == 0) return null;
+    if (frames != frame_count and frames +| 1 != frame_count) return error.InvalidXing;
+    var samples: u64 = @as(u64, frames) * h.samples;
+    if (end + 24 <= frame.len and (std.mem.startsWith(u8, frame[end..], "LAME") or std.mem.startsWith(u8, frame[end..], "Lavc"))) {
+        const delay: u32 = (@as(u32, frame[end + 21]) << 4) | (frame[end + 22] >> 4);
+        const padding: u32 = (@as(u32, frame[end + 22] & 15) << 8) | frame[end + 23];
+        if (delay + padding < samples) samples -= delay + padding;
+    }
+    return @as(f64, @floatFromInt(samples)) / @as(f64, @floatFromInt(h.rate));
+}
+pub fn duration(bytes: []const u8) ?f64 {
+    var offset: usize = 0;
+    if (bytes.len >= 10 and std.mem.eql(u8, bytes[0..3], "ID3")) {
+        var size: usize = 0;
+        for (bytes[6..10]) |b| {
+            if (b & 128 != 0) return null;
+            size = (size << 7) | b;
+        }
+        offset = 10 + size + @as(usize, if (bytes[3] == 4 and bytes[5] & 16 != 0) 10 else 0);
+        if (offset > bytes.len) return null;
+    }
+    const first_offset = offset;
+    const first = header(bytes[offset..]) orelse return null;
+    var seconds: f64 = 0;
+    var frame_count: u32 = 0;
+    while (offset < bytes.len) {
+        if (bytes.len - offset == 128 and std.mem.eql(u8, bytes[offset .. offset + 3], "TAG")) break;
+        const h = header(bytes[offset..]) orelse return null;
+        if (h.rate != first.rate or h.mpeg1 != first.mpeg1) return null;
+        seconds += @as(f64, @floatFromInt(h.samples)) / @as(f64, @floatFromInt(h.rate));
+        offset += h.size;
+        frame_count += 1;
+    }
+    if (xing(bytes[first_offset .. first_offset + first.size], first, frame_count) catch return null) |result| return result;
+    return seconds;
+}
