diff --git a/src/StartupLocation.zig b/src/StartupLocation.zig
new file mode 100644
index 0000000..236d9f9
--- /dev/null
+++ b/src/StartupLocation.zig
@@ -0,0 +1,169 @@
+// Copyright (C) 2026 Brenno Flávio
+//
+// Brenno Flávio <contato@brennoflavio.com.br>
+//
