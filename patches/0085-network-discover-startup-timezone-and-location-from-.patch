+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+const std = @import("std");
+const lp = @import("lightpanda");
+const http = @import("network/http.zig");
+const Certificates = @import("network/Certificates.zig");
+const libcurl = @import("sys/libcurl.zig");
+const Geolocation = @import("browser/webapi/geolocation/Geolocation.zig");
+
+const StartupLocation = @This();
+
+const fallback_timezone = "America/Los_Angeles";
+const timeout_ms = 5000;
+
+timezone_buf: [65]u8 = @splat(0),
+timezone_len: usize = fallback_timezone.len,
+position: Geolocation.Override = .{
+    .latitude = 37.7749,
+    .longitude = -122.4194,
+    .accuracy = 50000,
+},
+
+pub fn timezone(self: *const StartupLocation) [:0]const u8 {
+    return self.timezone_buf[0..self.timezone_len :0];
+}
+
+pub fn resolve(allocator: std.mem.Allocator, config: *const lp.Config) StartupLocation {
+    var fallback: StartupLocation = .{};
+    @memcpy(fallback.timezone_buf[0..fallback_timezone.len], fallback_timezone);
+    // Existing upstream tests must not depend on public network availability.
+    if (lp.IS_TEST) return fallback;
+
+    const location = discover(allocator, config) catch |err| {
+        lp.log.warn(.app, "startup location fallback", .{
+            .err = err,
+            .timezone = config.timezone() orelse fallback.timezone(),
+            .location = "San Francisco, US",
+        });
+        return fallback;
+    };
+    lp.log.info(.app, "startup location discovered", .{
+        .timezone = location.timezone(),
+    });
+    return location;
+}
+
+fn discover(allocator: std.mem.Allocator, config: *const lp.Config) !StartupLocation {
+    var arena = std.heap.ArenaAllocator.init(allocator);
+    defer arena.deinit();
+    const scratch = arena.allocator();
+
+    try libcurl.curl_global_init(.{ .ssl = true }, null);
+    defer libcurl.curl_global_cleanup();
+
+    const certificates = try Certificates.init(scratch, config);
+    // A custom store is borrowed here; Network.init takes ownership later.
+    defer if (!config.tlsVerifyHost() or config.customCertStore() == null) certificates.deinit();
+
+    var conn = try http.Connection.init(certificates, config, null);
+    defer conn.deinit();
+    try conn.setURL("https://api.ip.sb/geoip");
+    try conn.setGetMode();
+    try conn.setTimeout(timeout_ms);
+    try libcurl.curl_easy_setopt(conn._easy, .connect_timeout_ms, timeout_ms);
+    try conn.setHttpVersion(config.httpVersion());
+
+    const headers = try lp.Config.HttpHeaders.init(scratch, config);
+    defer headers.deinit(scratch);
+    try conn.addHeader(scratch, "User-Agent", headers.user_agent);
+    try conn.addHeader(scratch, "Accept", "application/json");
+    try conn.secretHeaders(&headers);
+    try conn.commitHeaders();
+
+    var body: Body = .{};
+    try libcurl.curl_easy_setopt(conn._easy, .write_data, &body);
+    try libcurl.curl_easy_setopt(conn._easy, .write_function, Body.receive);
+    const status = try conn.perform();
+    if (status != 200) return error.GeolocationHttpStatus;
+
+    const payload = try std.json.parseFromSlice(struct {
+        ip: []const u8,
+        timezone: []const u8,
+        latitude: f64,
+        longitude: f64,
+    }, scratch, body.bytes[0..body.len], .{ .ignore_unknown_fields = true });
+    defer payload.deinit();
+    const geo = payload.value;
+    _ = try std.Io.net.IpAddress.parse(geo.ip, 0);
+    if (!std.math.isFinite(geo.latitude) or @abs(geo.latitude) > 90 or
+        !std.math.isFinite(geo.longitude) or @abs(geo.longitude) > 180)
+    {
+        return error.InvalidCoordinates;
+    }
+    try validateTimezone(geo.timezone);
+
+    var location: StartupLocation = .{
+        .timezone_len = geo.timezone.len,
+        .position = .{ .latitude = geo.latitude, .longitude = geo.longitude, .accuracy = 50000 },
+    };
+    @memcpy(location.timezone_buf[0..geo.timezone.len], geo.timezone);
+    return location;
+}
+
+fn validateTimezone(id: []const u8) !void {
+    try lp.Config.validateTimezone(id);
+    // Reject paths and POSIX TZ expressions; accept only installed IANA zones.
+    for (id) |c| {
+        if (!std.ascii.isAlphanumeric(c) and c != '/' and c != '_' and c != '-' and c != '+') {
+            return error.InvalidTimezone;
+        }
+    }
+    if (std.mem.indexOf(u8, id, "//") != null) return error.InvalidTimezone;
+    const area = id[0 .. std.mem.indexOfScalar(u8, id, '/') orelse id.len];
+    _ = std.meta.stringToEnum(enum {
+        Africa,
+        America,
+        Antarctica,
+        Arctic,
+        Asia,
+        Atlantic,
+        Australia,
+        Europe,
+        Indian,
+        Pacific,
+        Etc,
+        UTC,
+    }, area) orelse return error.InvalidTimezone;
+    const roots = [_][]const u8{ "/usr/share/zoneinfo/", "/var/db/timezone/zoneinfo/" };
+    for (roots) |root| {
+        var path_buf: [128]u8 = undefined;
+        const path = try std.fmt.bufPrint(&path_buf, "{s}{s}", .{ root, id });
+        const file = std.Io.Dir.cwd().openFile(lp.io, path, .{}) catch continue;
+        defer file.close(lp.io);
+        var magic: [4]u8 = undefined;
+        var reader = file.reader(lp.io, &.{});
+        reader.interface.readSliceAll(&magic) catch continue;
+        if (std.mem.eql(u8, &magic, "TZif")) return;
+    }
+    return error.UnknownTimezone;
+}
+
+const Body = struct {
+    bytes: [16384]u8 = undefined,
+    len: usize = 0,
+
+    fn receive(buffer: [*]const u8, count: usize, size: usize, ctx: *anyopaque) callconv(.c) usize {
+        const self: *Body = @ptrCast(@alignCast(ctx));
+        const length = std.math.mul(usize, count, size) catch return 0;
+        if (length > self.bytes.len - self.len) return 0;
+        @memcpy(self.bytes[self.len..][0..length], buffer[0..length]);
+        self.len += length;
+        return length;
+    }
+};
