+
+const std = @import("std");
+const js = @import("../js/js.zig");
+const v8 = js.v8;
+const Frame = @import("../Frame.zig");
+const URL = @import("../URL.zig");
+const Navigator = @import("Navigator.zig");
+const AbortSignal = @import("AbortSignal.zig");
+const DOMException = @import("DOMException.zig");
+const Conversion = @import("media_constraints.zig");
+
+const CredentialsContainer = @This();
+_navigator: *Navigator,
+
+pub fn init(navigator: *Navigator, exec: *js.Execution) !*CredentialsContainer {
+    return exec._factory.create(CredentialsContainer{ ._navigator = navigator });
+}
+
+fn creationContext(self: *const CredentialsContainer, local: *const js.Local) *const v8.Context {
+    return self._navigator.creationContext(local);
+}
+
+fn activeFrame(self: *const CredentialsContainer) !*const Frame {
+    if (self._navigator._pdf_detached) return error.InvalidStateError;
+    const frame = self._navigator._frame orelse return error.InvalidStateError;
+    if (frame.document._frame != frame) return error.InvalidStateError;
+    if (!frame.isSecureContext()) return error.SecurityError;
+    return frame;
+}
+
+const Operation = enum { get, create };
+const Options = struct {
+    const Mediation = enum { silent, optional, required, conditional };
+    const UiMode = enum { active, immediate, passive };
+
+    mediation: Mediation = .optional,
+    ui_mode: UiMode = .active,
+    password: bool = false,
+    other_type: bool = false,
+    signal: ?*AbortSignal = null,
+
+    fn parse(comptime operation: Operation, input: ?js.Value) !Options {
+        const object = try Conversion.dictionary(input) orelse return .{};
+        var options: Options = .{};
+        // Web IDL dictionary members are read in lexicographic order.
+        const fields = switch (operation) {
+            .get => .{ "digital", "federated", "identity", "mediation", "otp", "password", "publicKey", "signal", "uiMode" },
+            .create => .{ "digital", "federated", "mediation", "password", "publicKey", "signal" },
+        };
+        inline for (fields) |name| {
+            const value = try object.get(name);
+            if (!value.isUndefined()) {
+                if (comptime std.mem.eql(u8, name, "signal")) {
+                    options.signal = value.toZig(*AbortSignal) catch return error.TypeError;
+                } else if (comptime std.mem.eql(u8, name, "mediation")) {
+                    options.mediation = try parseEnum(Mediation, value);
+                } else if (comptime std.mem.eql(u8, name, "uiMode")) {
+                    options.ui_mode = try parseEnum(UiMode, value);
+                } else if (comptime std.mem.eql(u8, name, "password")) {
+                    if (operation == .create and !value.isObject()) return error.TypeError;
+                    options.password = if (operation == .get) value.toBool() else true;
+                } else {
+                    _ = try Conversion.dictionary(value);
+                    options.other_type = true;
+                }
+            }
+        }
+        return options;
+    }
+
+    fn parseEnum(comptime T: type, value: js.Value) !T {
+        const text = try (try Conversion.domString(value)).toSlice();
+        return std.meta.stringToEnum(T, text) orelse error.TypeError;
+    }
+};
+
+fn get(self: *CredentialsContainer, input: ?js.Value, exec: *js.Execution) !js.Promise {
+    return self.request(.get, input, exec);
+}
+
+fn create(self: *CredentialsContainer, input: ?js.Value, exec: *js.Execution) !js.Promise {
+    return self.request(.create, input, exec);
+}
+
+fn request(self: *CredentialsContainer, comptime operation: Operation, input: ?js.Value, exec: *js.Execution) !js.Promise {
+    const local = exec.js.local.?;
+    const options = blk: {
+        var caught: js.TryCatch = undefined;
+        caught.init(local);
+        defer caught.deinit();
+        break :blk Options.parse(operation, input) catch |err| {
+            if (err == error.ExecutionTerminated or exec.js.env.terminatePending()) return error.ExecutionTerminated;
+            const exception = caught.exceptionValue() orelse return err;
+            const resolver = local.createPromiseResolver();
+            try resolver.rejectValue(exception);
+            return resolver.promise();
+        };
+    };
+
+    const frame = try self.activeFrame();
+    if (options.signal) |signal| {
+        if (signal.getAborted()) {
+            const resolver = local.createPromiseResolver();
+            try resolver.rejectValue(try AbortSignal.reasonJsValue(signal._reason, local));
+            return resolver.promise();
+        }
+    }
+    if (operation == .create or !options.password or options.other_type) return error.NotSupported;
+    const origin = frame.origin orelse return error.SecurityError;
+    var ancestor = frame.parent;
+    while (ancestor) |parent| : (ancestor = parent.parent) {
+        if (!URL.isSameOrigin(origin, parent.origin orelse "")) {
+            const exception = try exec._factory.create(DOMException.init("Password retrieval requires a same-origin ancestor chain", "NotAllowedError"));
+            const resolver = local.createPromiseResolver();
+            try resolver.rejectValue(try local.zigValueToJs(exception, .{}));
+            return resolver.promise();
+        }
+    }
+    if (options.mediation == .conditional or options.ui_mode == .immediate) return error.NotSupported;
+    // Chrome exposes the interface in secure subframes, but only binds its
+    // password manager service in the main frame.
+    if (frame.parent != null) return error.NotSupported;
+
+    // An empty store cannot supply a credential, regardless of mediation.
+    const resolver = local.createPromiseResolver();
+    try resolver.resolveValue(try local.zigValueToJs(null, .{}));
+    return resolver.promise();
+}
+
+fn store(_: *CredentialsContainer, _: js.Value) !js.Promise {
+    // There are no supported Credential instances and no storage backend.
+    return error.TypeError;
+}
+
+fn preventSilentAccess(self: *CredentialsContainer, exec: *js.Execution) !js.Promise {
+    const frame = try self.activeFrame();
+    if (frame.parent != null) return error.NotSupported;
+    const local = exec.js.local.?;
+    const resolver = local.createPromiseResolver();
+    try resolver.resolveValue(try local.zigValueToJs({}, .{}));
+    return resolver.promise();
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(CredentialsContainer);
+    pub const Meta = struct {
+        pub const name = "CredentialsContainer";
+        pub const creation_context = CredentialsContainer.creationContext;
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+
+    pub const get = bridge.function(CredentialsContainer.get, .{});
+    pub const store = bridge.function(CredentialsContainer.store, .{});
+    pub const create = bridge.function(CredentialsContainer.create, .{});
+    pub const preventSilentAccess = bridge.function(CredentialsContainer.preventSilentAccess, .{});
+};
+
+pub const Bindings = struct {
+    prototype: v8.Global,
+    accessor_descriptor: v8.Global,
+    interface_descriptor: v8.Global,
+    define_property: v8.Global,
+    hidden: bool = false,
+
+    pub fn deinit(self: *Bindings) void {
+        v8.v8__Global__Reset(&self.prototype);
+        v8.v8__Global__Reset(&self.accessor_descriptor);
+        v8.v8__Global__Reset(&self.interface_descriptor);
+        v8.v8__Global__Reset(&self.define_property);
+    }
+};
+
+pub fn expose(ctx: *js.Context, context: *const v8.Context, global: *const v8.Object, secure: bool) !void {
+    if (ctx.credentials_bindings) |*bindings| {
+        if (secure != bindings.hidden) return;
+    }
+    const isolate = ctx.isolate;
+    const accessor_key = isolate.initStringHandle("credentials");
+    const interface_key = isolate.initStringHandle("CredentialsContainer");
+    if (ctx.credentials_bindings == null) {
+        // Capture the native descriptors before scripts can replace Navigator or Object.
+        const navigator = v8.v8__Object__Get(global, context, isolate.initStringHandle("Navigator")) orelse return error.JsException;
+        const prototype = v8.v8__Object__Get(@ptrCast(navigator), context, isolate.initStringHandle("prototype")) orelse return error.JsException;
+        const accessor_descriptor = v8.v8__Object__GetOwnPropertyDescriptor(@ptrCast(prototype), context, accessor_key) orelse return error.JsException;
+        const interface_descriptor = v8.v8__Object__GetOwnPropertyDescriptor(global, context, interface_key) orelse return error.JsException;
+        const object = v8.v8__Object__Get(global, context, isolate.initStringHandle("Object")) orelse return error.JsException;
+        const define = v8.v8__Object__Get(@ptrCast(object), context, isolate.initStringHandle("defineProperty")) orelse return error.JsException;
+        ctx.credentials_bindings = .{ .prototype = undefined, .accessor_descriptor = undefined, .interface_descriptor = undefined, .define_property = undefined };
+        const bindings = &ctx.credentials_bindings.?;
+        v8.v8__Global__New(isolate.handle, prototype, &bindings.prototype);
+        v8.v8__Global__New(isolate.handle, accessor_descriptor, &bindings.accessor_descriptor);
+        v8.v8__Global__New(isolate.handle, interface_descriptor, &bindings.interface_descriptor);
+        v8.v8__Global__New(isolate.handle, define, &bindings.define_property);
+        if (secure) return;
+    }
+
+    const bindings = &ctx.credentials_bindings.?;
+    const prototype: *const v8.Object = @ptrCast(v8.v8__Global__Get(&bindings.prototype, isolate.handle).?);
+    for ([_]*const v8.Object{ prototype, global }, [_]*const v8.String{ accessor_key, interface_key }, [_]*v8.Global{ &bindings.accessor_descriptor, &bindings.interface_descriptor }) |target, key, descriptor| {
+        if (secure) {
+            const define: *const v8.Function = @ptrCast(v8.v8__Global__Get(&bindings.define_property, isolate.handle).?);
+            const args = [_]?*const v8.Value{ @ptrCast(target), @ptrCast(key), v8.v8__Global__Get(descriptor, isolate.handle) };
+            _ = v8.v8__Function__Call(define, context, @ptrCast(global), args.len, &args) orelse return error.JsException;
+        } else {
+            var deleted: v8.MaybeBool = undefined;
+            v8.v8__Object__Delete(target, context, @ptrCast(key), &deleted);
+            if (!deleted.has_value or !deleted.value) return error.JsException;
+        }
+    }
+    bindings.hidden = !secure;
+}
