@@ -77,6 +77,7 @@ media_device_bindings: ?struct {
     interfaces: [3]v8.Global,
 } = null,
 
+credentials_bindings: ?@import("../webapi/CredentialsContainer.zig").Bindings = null,
 webgpu_bindings: ?[10]v8.Global = null,
 webgpu_hidden: bool = false,
 eme_bindings: ?[10]v8.Global = null,
@@ -279,6 +280,7 @@ pub fn deinit(self: *Context) void {
         v8.v8__Global__Reset(&bindings.define_property);
         for (&bindings.interfaces) |*binding| v8.v8__Global__Reset(binding);
