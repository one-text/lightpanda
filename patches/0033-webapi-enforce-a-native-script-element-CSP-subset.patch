+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+const std = @import("std");
+const Frame = @import("Frame.zig");
+const URL = @import("URL.zig");
+const Element = @import("webapi/Element.zig");
+const ViolationEvent = @import("webapi/event/SecurityPolicyViolationEvent.zig");
+const Allocator = std.mem.Allocator;
+const ScriptPolicy = @This();
+const whitespace = " \t\r\n\x0c";
+
+// Document-owned script-element CSP subset. Does not police eval, event-handler
+// attributes, module dependencies, workers, other resources or reporting URLs.
+policies: std.ArrayList(Policy) = .empty,
+
+const Policy = struct {
+    raw: []const u8,
+    sources: []const u8,
+    origin: []const u8,
+};
+
+pub fn add(self: *ScriptPolicy, arena: Allocator, serialized: []const u8, origin: ?[]const u8) !void {
+    // A response header can contain a comma-separated policy list. Each policy
+    // is enforced independently, including repeated response headers/meta tags.
+    var list = std.mem.splitScalar(u8, serialized, ',');
+    while (list.next()) |raw| {
+        const owned = try arena.dupe(u8, std.mem.trim(u8, raw, whitespace));
+        var elem: ?[]const u8 = null;
+        var script: ?[]const u8 = null;
+        var fallback: ?[]const u8 = null;
+        var directives = std.mem.splitScalar(u8, owned, ';');
+        while (directives.next()) |directive| {
+            var tokens = std.mem.tokenizeAny(u8, directive, whitespace);
+            const name = tokens.next() orelse continue;
+            const value = std.mem.trim(u8, tokens.rest(), whitespace);
+            // CSP ignores later occurrences of the same directive.
+            if (std.ascii.eqlIgnoreCase(name, "script-src-elem")) {
+                if (elem == null) elem = value;
+            } else if (std.ascii.eqlIgnoreCase(name, "script-src")) {
+                if (script == null) script = value;
+            } else if (std.ascii.eqlIgnoreCase(name, "default-src")) {
+                if (fallback == null) fallback = value;
+            }
+        }
+        const sources = elem orelse script orelse fallback orelse continue;
+        try self.policies.append(arena, .{
+            .raw = owned,
+            .sources = sources,
+            .origin = try arena.dupe(u8, origin orelse ""),
+        });
+    }
+}
+
+pub fn inherit(self: *ScriptPolicy, arena: Allocator, parent: *const ScriptPolicy) !void {
+    // Copy both list and strings: child additions must not mutate the parent's
+    // policy container, and an opener's page can be destroyed before a popup.
+    for (parent.policies.items) |policy| try self.add(arena, policy.raw, policy.origin);
+}
+
+pub fn allowsPreload(self: *const ScriptPolicy, frame: *Frame, url: [:0]const u8) !bool {
+    if (frame._session.bypass_csp) return true;
+    for (self.policies.items) |policy| {
+        if (!try matches(policy, "", "", url, false, frame.local_arena)) return false;
+    }
+    return true;
+}
+
+pub fn allows(self: *const ScriptPolicy, frame: *Frame, element: *Element, source: []const u8, url: ?[:0]const u8) !bool {
+    return self.check(frame, element, source, url, false);
+}
+
+pub fn allowsRedirect(self: *const ScriptPolicy, frame: *Frame, element: ?*Element, url: [:0]const u8) !bool {
+    if (element) |el| return self.check(frame, el, "", url, true);
+    if (frame._session.bypass_csp) return true;
+    for (self.policies.items) |policy| {
+        if (!try matches(policy, "", "", url, true, frame.local_arena)) return false;
+    }
+    return true;
+}
+
+fn check(self: *const ScriptPolicy, frame: *Frame, element: *Element, source: []const u8, url: ?[:0]const u8, redirected: bool) !bool {
+    if (frame._session.bypass_csp) return true;
+    const nonce = element.getAttributeSafe(.wrap("nonce")) orelse "";
+    var allowed = true;
+    for (self.policies.items) |policy| {
+        if (try matches(policy, nonce, source, url, redirected, frame.local_arena)) continue;
+        allowed = false;
+        try report(frame, element, policy, source, url);
+    }
+    return allowed;
+}
+
+fn matches(policy: Policy, nonce: []const u8, source: []const u8, url: ?[:0]const u8, redirected: bool, arena: Allocator) !bool {
+    var unsafe_inline = false;
+    var has_authorization = false;
+    var strict_dynamic = false;
+    var tokens = std.mem.tokenizeAny(u8, policy.sources, whitespace);
+    while (tokens.next()) |token| {
+        if (quotedValue(token, "nonce-")) |value| {
+            if (validBase64(value)) {
+                has_authorization = true;
+                if (nonce.len > 0 and std.mem.eql(u8, nonce, value)) return true;
+            }
+        } else if (hashValue(token)) |hash| {
+            has_authorization = true;
+            if (url == null and hashMatches(hash, source)) return true;
+        } else if (std.ascii.eqlIgnoreCase(token, "'unsafe-inline'")) {
+            unsafe_inline = true;
+        } else if (std.ascii.eqlIgnoreCase(token, "'strict-dynamic'")) {
+            strict_dynamic = true;
+        }
+    }
+    if (url == null) return unsafe_inline and !has_authorization and !strict_dynamic;
+    // Trust propagation and external-script integrity hashes are outside this
+    // subset; never silently turn strict-dynamic into an unrestricted allowlist.
+    if (strict_dynamic) return false;
+    tokens.reset();
+    while (tokens.next()) |token| {
+        if (try sourceMatches(token, policy.origin, url.?, redirected, arena)) return true;
+    }
+    return false;
+}
+
+fn quotedValue(token: []const u8, prefix: []const u8) ?[]const u8 {
+    if (token.len < prefix.len + 3 or token[0] != '\'' or token[token.len - 1] != '\'') return null;
+    if (!std.ascii.startsWithIgnoreCase(token[1..], prefix)) return null;
+    return token[1 + prefix.len .. token.len - 1];
+}
+
+fn validBase64(value: []const u8) bool {
+    const data = std.mem.trimEnd(u8, value, "=");
+    if (data.len == 0 or value.len - data.len > 2) return false;
+    for (data) |c| {
+        if (!std.ascii.isAlphanumeric(c) and std.mem.indexOfScalar(u8, "+/-_", c) == null) return false;
+    }
+    return true;
+}
+
+const HashAlgorithm = enum { sha256, sha384, sha512 };
+const Hash = struct { algorithm: HashAlgorithm, encoded: []const u8 };
+fn hashValue(token: []const u8) ?Hash {
+    inline for (.{ "sha256", "sha384", "sha512" }) |name| {
+        if (quotedValue(token, name ++ "-")) |value| {
+            if (validBase64(value)) return .{ .algorithm = @field(HashAlgorithm, name), .encoded = value };
+        }
+    }
+    return null;
+}
+
+fn hashMatches(hash: Hash, source: []const u8) bool {
+    var digest: [64]u8 = undefined;
+    const size: usize = switch (hash.algorithm) {
+        .sha256 => blk: {
+            std.crypto.hash.sha2.Sha256.hash(source, digest[0..32], .{});
+            break :blk 32;
+        },
+        .sha384 => blk: {
+            std.crypto.hash.sha2.Sha384.hash(source, digest[0..48], .{});
+            break :blk 48;
+        },
+        .sha512 => blk: {
+            std.crypto.hash.sha2.Sha512.hash(source, &digest, .{});
+            break :blk 64;
+        },
+    };
+    var encoded: [88]u8 = undefined;
+    const actual = std.mem.trimEnd(u8, std.base64.standard.Encoder.encode(&encoded, digest[0..size]), "=");
+    const expected = std.mem.trimEnd(u8, hash.encoded, "=");
+    if (actual.len != expected.len) return false;
+    for (actual, expected) |a, b| {
+        const normalized: u8 = switch (b) {
+            '-' => '+',
+            '_' => '/',
+            else => b,
+        };
+        if (a != normalized) return false;
+    }
+    return true;
+}
+
+fn schemeMatches(expected: []const u8, actual: []const u8) bool {
+    return std.ascii.eqlIgnoreCase(expected, actual) or
+        (std.ascii.eqlIgnoreCase(expected, "http:") and std.ascii.eqlIgnoreCase(actual, "https:"));
+}
+
+fn sourceMatches(token: []const u8, origin: []const u8, url: [:0]const u8, redirected: bool, arena: Allocator) !bool {
+    if (std.ascii.eqlIgnoreCase(token, "'self'")) {
+        return origin.len > 0 and schemeMatches(URL.getProtocol(origin), URL.getProtocol(url)) and
+            std.ascii.eqlIgnoreCase(URL.getHostname(origin), URL.getHostname(url)) and
+            portsMatch(URL.getPort(origin), URL.getProtocol(origin), URL.getPort(url), URL.getProtocol(url));
+    }
+    if (token.len == 0 or token[0] == '\'') return false;
+    const protocol = URL.getProtocol(url);
+    if (std.mem.eql(u8, token, "*")) return std.mem.eql(u8, protocol, "http:") or std.mem.eql(u8, protocol, "https:");
+    if (token[token.len - 1] == ':') return schemeMatches(token, protocol);
+
+    // Host sources: optional scheme, wildcard subdomain/port, optional path.
+    const separator = std.mem.indexOf(u8, token, "://");
+    const scheme = if (separator) |i| token[0 .. i + 1] else URL.getProtocol(origin);
+    if (!schemeMatches(scheme, protocol)) return false;
+    const rest = if (separator) |i| token[i + 3 ..] else token;
+    const path_start = std.mem.indexOfScalar(u8, rest, '/') orelse rest.len;
+    const authority = rest[0..path_start];
+    const wildcard_port = std.mem.endsWith(u8, authority, ":*");
+    const host_source = if (wildcard_port) authority[0 .. authority.len - 2] else authority;
+    const candidate = try std.fmt.allocPrintSentinel(arena, "{s}//{s}/", .{ scheme, host_source }, 0);
+    if (!URL.canParse(candidate, null)) return false;
+    const host = URL.getHostname(candidate);
+    const actual_host = URL.getHostname(url);
+    if (std.mem.startsWith(u8, host, "*.")) {
+        if (actual_host.len <= host.len - 1 or !std.ascii.endsWithIgnoreCase(actual_host, host[1..])) return false;
+    } else if (!std.mem.eql(u8, host, "*") and !std.ascii.eqlIgnoreCase(host, actual_host)) return false;
+    if (!wildcard_port) {
+        if (!portsMatch(URL.getPort(candidate), scheme, URL.getPort(url), protocol)) return false;
+    }
+    // CSP source paths constrain the initial request, not redirect targets.
+    if (!redirected and path_start < rest.len) {
+        const path = rest[path_start..];
+        const actual_path = URL.getPathname(url);
+        if (path[path.len - 1] == '/') return std.mem.startsWith(u8, actual_path, path);
+        return std.mem.eql(u8, actual_path, path);
+    }
+    return true;
+}
+
+fn portsMatch(expected: []const u8, scheme: []const u8, actual: []const u8, protocol: []const u8) bool {
+    const want = if (expected.len > 0) expected else defaultPort(scheme);
+    const got = if (actual.len > 0) actual else defaultPort(protocol);
+    return std.mem.eql(u8, want, got) or
+        (std.ascii.eqlIgnoreCase(scheme, "http:") and std.ascii.eqlIgnoreCase(protocol, "https:") and
+            std.mem.eql(u8, want, "80") and std.mem.eql(u8, got, "443"));
+}
+
+fn defaultPort(scheme: []const u8) []const u8 {
+    if (std.ascii.eqlIgnoreCase(scheme, "http:")) return "80";
+    if (std.ascii.eqlIgnoreCase(scheme, "https:")) return "443";
+    return "";
+}
+
+const ViolationTask = struct {
+    frame: *Frame,
+    element: *Element,
+    policy: Policy,
+    blocked: []const u8,
+    sample: []const u8,
+
+    fn cancel(ctx: *anyopaque) void {
+        const task: *ViolationTask = @ptrCast(@alignCast(ctx));
+        task.frame._factory.destroy(task);
+    }
+    fn run(ctx: *anyopaque) !?u32 {
+        const task: *ViolationTask = @ptrCast(@alignCast(ctx));
+        defer cancel(ctx);
+        const frame = task.frame;
+        const event = try ViolationEvent.initTrusted(.{
+            .documentURI = frame.url,
+            .referrer = frame._referrer orelse "",
+            .blockedURI = task.blocked,
+            .effectiveDirective = "script-src-elem",
+            .violatedDirective = "script-src-elem",
+            .originalPolicy = task.policy.raw,
+            .statusCode = frame._http_status orelse 0,
+            .sample = task.sample,
+            .bubbles = true,
+            .composed = true,
+        }, frame);
+        const node = task.element.asNode();
+        const target = if (node.isConnected() and node.getDocument(frame) == frame.document)
+            task.element.asEventTarget()
+        else
+            frame.document.asNode().asEventTarget();
+        try frame._event_manager.dispatch(target, event.asEvent());
+        return null;
+    }
+};
+
+fn report(frame: *Frame, element: *Element, policy: Policy, source: []const u8, url: ?[:0]const u8) !void {
+    var sample = false;
+    var tokens = std.mem.tokenizeAny(u8, policy.sources, whitespace);
+    while (tokens.next()) |token| {
+        if (std.ascii.eqlIgnoreCase(token, "'report-sample'")) sample = true;
+    }
+    const task = try frame._factory.create(ViolationTask{
+        .frame = frame,
+        .element = element,
+        .policy = policy,
+        .blocked = try frame.arena.dupe(u8, url orelse "inline"),
+        .sample = if (sample and url == null) try frame.arena.dupe(u8, source[0..@min(source.len, 40)]) else "",
+    });
+    errdefer frame._factory.destroy(task);
+    try frame.js.scheduler.add(task, ViolationTask.run, 0, .{
+        .name = "csp.securitypolicyviolation",
+        .finalizer = ViolationTask.cancel,
+    });
+}
