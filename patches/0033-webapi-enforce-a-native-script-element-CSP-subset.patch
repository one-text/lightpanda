+const lp = @import("lightpanda");
+const js = @import("../../js/js.zig");
+const Frame = @import("../../Frame.zig");
+const Event = @import("../Event.zig");
+const SecurityPolicyViolationEvent = @This();
+
+pub const Proto = Event;
+_proto: *Event,
+_detail: Detail,
+
+const Disposition = enum {
+    enforce,
+    report,
+    pub const js_enum_from_string = true;
+};
+const Detail = struct {
+    blockedURI: []const u8 = "",
+    columnNumber: u32 = 0,
+    disposition: Disposition = .enforce,
+    documentURI: []const u8 = "",
+    effectiveDirective: []const u8 = "",
+    lineNumber: u32 = 0,
+    originalPolicy: []const u8 = "",
+    referrer: []const u8 = "",
+    sample: []const u8 = "",
+    sourceFile: []const u8 = "",
+    statusCode: u16 = 0,
+    violatedDirective: []const u8 = "",
+};
+pub const Options = Event.inheritOptions(SecurityPolicyViolationEvent, Detail);
+
+pub fn init(typ: []const u8, opts: ?Options, frame: *Frame) !*SecurityPolicyViolationEvent {
+    return create(typ, opts orelse .{}, false, frame);
+}
+
+pub fn initTrusted(opts: Options, frame: *Frame) !*SecurityPolicyViolationEvent {
+    return create("securitypolicyviolation", opts, true, frame);
+}
+
+fn create(typ: []const u8, opts: Options, trusted: bool, frame: *Frame) !*SecurityPolicyViolationEvent {
+    const arena = try frame.getArena(.tiny, "SecurityPolicyViolationEvent");
+    errdefer arena.release();
+    var detail: Detail = undefined;
+    inline for (@import("std").meta.fields(Detail)) |field| {
+        @field(detail, field.name) = if (field.type == []const u8)
+            try arena.dupe(u8, @field(opts, field.name))
+        else
+            @field(opts, field.name);
+    }
+    const event = try frame._factory.event(arena, try lp.String.init(arena.allocator(), typ, .{}), SecurityPolicyViolationEvent{
+        ._proto = undefined,
+        ._detail = detail,
+    });
+    Event.populatePrototypes(event, opts, trusted);
+    return event;
+}
+
+pub fn asEvent(self: *SecurityPolicyViolationEvent) *Event {
+    return self._proto;
+}
+
+fn getDisposition(self: *const SecurityPolicyViolationEvent) []const u8 {
+    return @tagName(self._detail.disposition);
+}
+
+fn getter(comptime field: []const u8) fn (*const SecurityPolicyViolationEvent) @FieldType(Detail, field) {
+    return struct {
+        fn get(self: *const SecurityPolicyViolationEvent) @FieldType(Detail, field) {
+            return @field(self._detail, field);
+        }
+    }.get;
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(SecurityPolicyViolationEvent);
+    pub const Meta = struct {
+        pub const name = "SecurityPolicyViolationEvent";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const constructor = bridge.constructor(SecurityPolicyViolationEvent.init, .{});
+    pub const documentURI = bridge.accessor(getter("documentURI"), null, .{});
+    pub const referrer = bridge.accessor(getter("referrer"), null, .{});
+    pub const blockedURI = bridge.accessor(getter("blockedURI"), null, .{});
+    pub const violatedDirective = bridge.accessor(getter("violatedDirective"), null, .{});
+    pub const effectiveDirective = bridge.accessor(getter("effectiveDirective"), null, .{});
+    pub const originalPolicy = bridge.accessor(getter("originalPolicy"), null, .{});
+    pub const sourceFile = bridge.accessor(getter("sourceFile"), null, .{});
+    pub const sample = bridge.accessor(getter("sample"), null, .{});
+    pub const disposition = bridge.accessor(getDisposition, null, .{});
+    pub const statusCode = bridge.accessor(getter("statusCode"), null, .{});
+    pub const lineNumber = bridge.accessor(getter("lineNumber"), null, .{});
+    pub const columnNumber = bridge.accessor(getter("columnNumber"), null, .{});
+};
