From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: brennoflavio <contato@brennoflavio.com.br>
Date: Sun, 15 Nov 2026 14:12:50 -0300
Subject: [PATCH] webapi: use intrinsic Array methods for NodeList iteration

Install the realm's Array entries, forEach, keys and values functions on
NodeList.prototype, with values also exposed as Symbol.iterator. Keep
Web IDL property descriptors and native builtin identity instead of
branded NodeList callbacks.

Amazon Brazil Subscribe & Save passes scoped DOM NodeList proxies to
Array.from and forEach. The branded callbacks rejected those receivers
with invalid argument or Illegal invocation, preventing subscriptions,
alerts and navigation initialization.

An account-free fixture now matches Chrome 154.0.8037.97 for generic
receivers, proxy iteration, builtin identity and descriptors. Native
clicks open the coffee subscription dialog and schedule manager,
including after reload, without saving changes. All 1658 existing
upstream tests pass.
---
 src/browser/js/Snapshot.zig                 | 9 +++++++++
 src/browser/webapi/collections/NodeList.zig | 3 +++
 2 files changed, 12 insertions(+)

diff --git a/src/browser/js/Snapshot.zig b/src/browser/js/Snapshot.zig
index 040d91c..765275b 100644
--- a/src/browser/js/Snapshot.zig
+++ b/src/browser/js/Snapshot.zig
@@ -374,6 +374,15 @@ fn createSnapshotContext(
             var result: v8.MaybeBool = undefined;
             v8.v8__Object__DefineOwnProperty(@ptrCast(proto), context, @ptrCast(v8.v8__Symbol__GetIterator(isolate)), values, v8.DontEnum, &result);
             if (!result.has_value or !result.value) return error.IteratorInstallFailed;
+
+            if (comptime @hasDecl(JsApi.Meta, "array_methods")) {
+                inline for (JsApi.Meta.array_methods) |name| {
+                    const key = v8.v8__String__NewFromUtf8(isolate, name.ptr, v8.kNormal, @intCast(name.len));
+                    const method = v8.v8__Object__Get(@ptrCast(array_proto), context, key) orelse return error.IteratorLookupFailed;
+                    v8.v8__Object__DefineOwnProperty(@ptrCast(proto), context, key, method, v8.None, &result);
+                    if (!result.has_value or !result.value) return error.IteratorInstallFailed;
+                }
+            }
         }
 
         // WebIDL [Exposed=...] gating. Members are installed on the shared
diff --git a/src/browser/webapi/collections/NodeList.zig b/src/browser/webapi/collections/NodeList.zig
index da685ca..d66cef8 100644
--- a/src/browser/webapi/collections/NodeList.zig
+++ b/src/browser/webapi/collections/NodeList.zig
@@ -2,6 +2,7 @@
 //
 // Francis Bouvier <francis@lightpanda.io>
 // Pierre Tachoire <pierre@lightpanda.io>
+// Brenno Flávio <contato@brennoflavio.com.br>
 //
 // This program is free software: you can redistribute it and/or modify
 // it under the terms of the GNU Affero General Public License as
@@ -142,6 +143,8 @@ pub const JsApi = struct {
 
     pub const Meta = struct {
         pub const name = "NodeList";
+        pub const array_iterator = true;
+        pub const array_methods = .{ "entries", "forEach", "keys", "values" };
         pub const prototype_chain = bridge.prototypeChain();
         pub var class_id: bridge.ClassId = undefined;
     };
