diff --git a/src/browser/webapi/css/FontFace.zig b/src/browser/webapi/css/FontFace.zig
index 3cd7a6e..ff76e98 100644
--- a/src/browser/webapi/css/FontFace.zig
+++ b/src/browser/webapi/css/FontFace.zig
@@ -29,6 +29,7 @@ const loaded_promise_slot = 1;
 _rc: lp.RC = .{},
 _arena: *lp.Arena,
 _family: []const u8,
+_status: enum { unloaded, loading, loaded } = .unloaded,
 
 pub fn init(family: []const u8, source: []const u8, frame: *Frame) !*FontFace {
     _ = source;
@@ -60,29 +61,73 @@ fn getFamily(self: *const FontFace) []const u8 {
     return self._family;
 }
 
-// load() - resolves immediately; headless browser has no real font loading.
+fn getStatus(self: *const FontFace) []const u8 {
+    return @tagName(self._status);
+}
+
+// Fonts still load synthetically, but completion runs in a later task.
 pub fn load(self: *FontFace, frame: *Frame) !js.Promise {
-    return self.getLoaded(frame);
+    const promise = try self.getLoaded(frame);
+    if (self._status != .unloaded) return promise;
+
+    const arena = try frame.getArena(.tiny, "FontFace.load");
+    errdefer arena.release();
+    const root = try (try frame.js.local.?.zigValueToJs(self, .{})).persist();
+    errdefer root.release();
+    const task = try arena.create(LoadTask);
+    task.* = .{ .face = self, .context = frame.js, .arena = arena, .root = root };
+    try frame.js.scheduler.add(task, LoadTask.run, 0, .{ .name = "FontFace.load", .finalizer = LoadTask.finalize });
+    self._status = .loading;
+    return promise;
 }
 
-// loaded - returns the same fulfilled promise as load().
 fn getLoaded(self: *FontFace, frame: *Frame) !js.Promise {
-    const local = frame.js.local.?;
+    return (try self.loadedResolver(frame.js.local.?)).promise();
+}
+
+fn loadedResolver(self: *FontFace, local: *const js.Local) !js.PromiseResolver {
     const wrapper = try local.mapZigInstanceToJs(null, self);
-    if (js.v8.v8__Object__GetInternalField(wrapper.handle, loaded_promise_slot)) |cached| {
-        if (!js.v8.v8__Value__IsUndefined(cached)) {
-            return .{ .local = local, .handle = @ptrCast(cached) };
-        }
+    const key: *const js.v8.Private = @ptrCast(js.v8.v8__Global__Get(&local.ctx.env.private_symbols.font_face_resolver.handle, local.isolate.handle).?);
+    const cached = js.v8.v8__Object__GetPrivate(wrapper.handle, local.handle, key) orelse return error.JsException;
+    if (!js.v8.v8__Value__IsUndefined(cached)) {
+        return .{ .local = local, .handle = @ptrCast(cached) };
     }
 
     const resolver = local.createPromiseResolver();
-    const promise = resolver.promise();
-    // Keep the cycle GC-traced, and publish before resolution can read a then getter.
-    js.v8.v8__Object__SetInternalField(wrapper.handle, loaded_promise_slot, promise.toValue().handle);
-    try resolver.resolveValue(wrapper.toValue());
-    return promise;
+    // Keep pending reactions and the fulfilled FontFace cycle GC-traced.
+    var saved: js.v8.MaybeBool = undefined;
+    js.v8.v8__Object__SetPrivate(wrapper.handle, local.handle, key, @ptrCast(resolver.handle), &saved);
+    if (!saved.has_value or !saved.value) return error.JsException;
+    return resolver;
 }
 
+const LoadTask = struct {
+    face: *FontFace,
+    context: *js.Context,
+    arena: *lp.Arena,
+    root: js.Value.Global,
+
+    fn finalize(ptr: *anyopaque) void {
+        const self: *LoadTask = @ptrCast(@alignCast(ptr));
+        self.root.release();
+        self.arena.release();
+    }
+
+    fn run(ptr: *anyopaque) !?u32 {
+        const self: *LoadTask = @ptrCast(@alignCast(ptr));
+        defer finalize(ptr);
+        var scope: js.Local.Scope = undefined;
+        self.context.localScope(&scope);
+        defer scope.deinit();
+        defer scope.local.runMicrotasks();
+
+        const resolver = try self.face.loadedResolver(&scope.local);
+        self.face._status = .loaded;
+        try resolver.resolveValue(self.root.local(&scope.local));
+        return null;
+    }
+};
+
 pub const JsApi = struct {
     pub const bridge = js.Bridge(FontFace);
 
@@ -94,7 +139,7 @@ pub const JsApi = struct {
 
     pub const constructor = bridge.constructor(FontFace.init, .{});
     pub const family = bridge.accessor(FontFace.getFamily, null, .{});
-    pub const status = bridge.property("loaded", .{ .template = false, .readonly = true });
+    pub const status = bridge.accessor(FontFace.getStatus, null, .{});
     pub const style = bridge.property("normal", .{ .template = false, .readonly = true });
     pub const weight = bridge.property("normal", .{ .template = false, .readonly = true });
     pub const stretch = bridge.property("normal", .{ .template = false, .readonly = true });
