diff --git a/src/browser/webapi/Element.zig b/src/browser/webapi/Element.zig
index 7b563c4..df12c16 100644
--- a/src/browser/webapi/Element.zig
+++ b/src/browser/webapi/Element.zig
@@ -27,7 +27,8 @@ const StyleManager = @import("../StyleManager.zig");
 const Factory = @import("../Factory.zig");
 const text_measure = @import("../text_measure.zig");
 
-const CSS = @import("CSS.zig");
+const Matrix = @import("DOMMatrixReadOnly.zig");
+const units = @import("../css/units.zig");
 const Node = @import("Node.zig");
 const TreeWalker = @import("TreeWalker.zig");
 const ShadowRoot = @import("ShadowRoot.zig");
@@ -1666,12 +1667,177 @@ pub fn boundingClientRectValues(self: *Element, frame: *Frame) DOMRect.Data {
 
 // Some cases need the bounding rect but have already done the visibility check.
 pub fn boundingClientRectValuesForVisible(self: *Element, frame: *Frame) DOMRect.Data {
-    return .{
-        .x = self.horizontalPosition(frame),
-        .y = self.clientCoordinate(frame, .height, null),
+    return self.clientRectValues(frame, null);
+}
+
+pub fn clientRectValues(self: *Element, frame: *Frame, positions: ?*const FlowPositions) DOMRect.Data {
+    const corners = self.clientQuadValues(frame, positions);
+    var left = corners[0][0];
+    var right = left;
+    var top = corners[0][1];
+    var bottom = top;
+    for (corners[1..]) |point| {
+        left = @min(left, point[0]);
+        right = @max(right, point[0]);
+        top = @min(top, point[1]);
+        bottom = @max(bottom, point[1]);
+    }
+    return .{ .x = left, .y = top, .width = right - left, .height = bottom - top };
+}
+
+pub fn hasVisualTransform(self: *Element, frame: *Frame) bool {
+    const owner = self.ownerFrame(frame) orelse return false;
+    var current: ?*Element = self;
+    while (current) |element| : (current = layoutParent(element)) {
+        const transform = owner._style_manager.transformStyle(element).transform;
+        if (transform.len > 0 and !std.ascii.eqlIgnoreCase(transform, "none")) return true;
+    }
+    return false;
+}
+
+pub fn transformedContains(self: *Element, x: f64, y: f64, ignore_x: bool, frame: *Frame, positions: *const FlowPositions) bool {
+    const corners = self.clientQuadValues(frame, positions);
+    if (ignore_x) {
+        var top = corners[0][1];
+        var bottom = top;
+        for (corners[1..]) |point| {
+            top = @min(top, point[1]);
+            bottom = @max(bottom, point[1]);
+        }
+        return y >= top and y <= bottom;
+    }
+    var positive = false;
+    var negative = false;
+    for (corners, 0..) |point, i| {
+        const next = corners[(i + 1) % corners.len];
+        const cross = (next[0] - point[0]) * (y - point[1]) - (next[1] - point[1]) * (x - point[0]);
+        positive = positive or cross > 0;
+        negative = negative or cross < 0;
+        if (positive and negative) return false;
+    }
+    return positive != negative;
+}
+
+// Keep layout coordinates untransformed. Apply each ancestor's visual matrix
+// to the original corners, not intermediate bounding boxes (which lose rotation).
+fn clientQuadValues(self: *Element, frame: *Frame, positions: ?*const FlowPositions) [4][2]f64 {
+    const rect: DOMRect.Data = .{
+        .x = self.clientCoordinate(frame, .width, positions),
+        .y = self.clientCoordinate(frame, .height, positions),
         .width = self.boxAxis(frame, .width),
         .height = self.boxAxis(frame, .height),
     };
+    const original = [4][2]f64{
+        .{ rect.x, rect.y },
+        .{ rect.x + rect.width, rect.y },
+        .{ rect.x + rect.width, rect.y + rect.height },
+        .{ rect.x, rect.y + rect.height },
+    };
+    const owner = self.ownerFrame(frame) orelse return original;
+    var corners = original;
+    var current: ?*Element = self;
+    while (current) |element| : (current = layoutParent(element)) {
+        const style = owner._style_manager.transformStyle(element);
+        if (style.transform.len == 0 or std.ascii.eqlIgnoreCase(style.transform, "none")) continue;
+        const width = element.boxAxis(owner, .width);
