+pub fn setVideoDecoderExposure(self: *const Env, ctx: *Context, v8_context: *const v8.Context, global_obj: *const v8.Object, secure: bool) void {
+    if (secure == (ctx.video_bindings == null)) return;
+    const isolate = self.isolate.handle;
+    var result: v8.MaybeBool = undefined;
+    if (!secure) ctx.video_bindings = @splat(undefined);
+    inline for (.{ "VideoDecoder", "EncodedVideoChunk", "VideoFrame", "VideoColorSpace" }, 0..) |name, i| {
+        const key = self.isolate.initStringHandle(name);
+        const binding = &ctx.video_bindings.?[i];
+        if (secure) {
+            v8.v8__Object__DefineOwnProperty(global_obj, v8_context, key, v8.v8__Global__Get(binding, isolate), v8.DontEnum, &result);
+            v8.v8__Global__Reset(binding);
+        } else {
+            const value = v8.v8__Object__Get(global_obj, v8_context, key).?;
+            v8.v8__Global__New(isolate, value, binding);
+            v8.v8__Object__Delete(global_obj, v8_context, key, &result);
+        }
+    }
+    if (secure) ctx.video_bindings = null;
+}
+
