+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Page = @import("../Page.zig");
+const Chunk = @This();
+
+_arena: *lp.Arena,
+_rc: lp.RC = .{},
+_type: Type,
+_timestamp: i64,
+_duration: ?u64,
+_data: []const u8,
+
+const Type = enum {
+    key,
+    delta,
+    pub const js_enum_from_string = true;
+};
+const Init = struct {
+    data: js.Value,
+    duration: ?u64 = null,
+    timestamp: i64,
+    type: Type,
+};
+fn init(options: Init, exec: *js.Execution) !*Chunk {
+    // Resolve the bytes only after all dictionary getters have run.
+    const data = try options.data.toZig(js.BufferSource);
+    const arena = try exec.getArena(.small, "EncodedVideoChunk");
+    errdefer arena.release();
+    const self = try arena.create(Chunk);
+    self.* = .{
+        ._arena = arena,
+        ._type = options.type,
+        ._timestamp = options.timestamp,
+        ._duration = options.duration,
+        ._data = try arena.dupe(u8, data.bytes),
+    };
+    return self;
+}
+pub fn acquireRef(self: *Chunk) void {
+    self._rc.acquire();
+}
+pub fn releaseRef(self: *Chunk, page: *Page) void {
+    self._rc.release(self, page);
+}
+pub fn deinit(self: *Chunk, _: *Page) void {
+    self._arena.release();
+}
+fn getType(self: *const Chunk) []const u8 {
+    return @tagName(self._type);
+}
+fn getTimestamp(self: *const Chunk) i64 {
+    return self._timestamp;
+}
+fn getDuration(self: *const Chunk) ?u64 {
+    return self._duration;
+}
+fn getByteLength(self: *const Chunk) usize {
+    return self._data.len;
+}
+fn copyTo(self: *const Chunk, value: js.Value) !void {
+    const destination = try value.toZig(js.BufferSource);
+    if (destination.bytes.len < self._data.len) return error.TypeError;
+    @memcpy(@constCast(destination.bytes[0..self._data.len]), self._data);
+}
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(Chunk);
+    pub const Meta = struct {
+        pub const name = "EncodedVideoChunk";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const constructor = bridge.constructor(Chunk.init, .{});
+    pub const @"type" = bridge.accessor(getType, null, .{});
+    pub const timestamp = bridge.accessor(getTimestamp, null, .{});
+    pub const duration = bridge.accessor(getDuration, null, .{});
+    pub const byteLength = bridge.accessor(getByteLength, null, .{});
+    pub const copyTo = bridge.function(Chunk.copyTo, .{});
+};
