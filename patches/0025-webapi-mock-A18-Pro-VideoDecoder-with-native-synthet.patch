diff --git a/src/browser/webapi/VideoDecoder.zig b/src/browser/webapi/VideoDecoder.zig
new file mode 100644
index 0000000..d943ea0
--- /dev/null
+++ b/src/browser/webapi/VideoDecoder.zig
@@ -0,0 +1,384 @@
+// Copyright (C) 2026 Brenno Flávio
+//
+// Brenno Flávio <contato@brennoflavio.com.br>
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License as
+// published by the Free Software Foundation, either version 3 of the
+// License, or (at your option) any later version.
