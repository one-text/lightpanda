+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+const std = @import("std");
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Page = @import("../Page.zig");
+const Event = @import("Event.zig");
+const EventTarget = @import("EventTarget.zig");
+const EventManagerBase = @import("../EventManagerBase.zig");
+const Speech = @import("SpeechSynthesis.zig");
+const DOMException = @import("DOMException.zig");
+const VideoFrame = @import("VideoFrame.zig");
+const Chunk = @import("EncodedVideoChunk.zig");
+const Decoder = @This();
+
+pub fn registerTypes() []const type {
+    return &.{ Decoder, Chunk, VideoFrame, VideoFrame.ColorSpace };
+}
+
+pub const Proto = EventTarget;
+_proto: *EventTarget,
+_arena: *lp.Arena,
+_rc: lp.RC = .{},
+_context: ?*js.Context,
+_context_node: std.DoublyLinkedList.Node = .{},
+_events: EventManagerBase,
+_handlers: [1]Speech.Handler = undefined,
+_listener_roots: std.ArrayList(*js.GlobalSlot) = .empty,
+_state: State = .unconfigured,
+_queue_size: u32 = 0,
+_generation: u64 = 0,
+_key_required: bool = true,
+_width: u32 = 1920,
+_height: u32 = 1080,
+_display_width: u32 = 1920,
+_display_height: u32 = 1080,
+_flushes: std.DoublyLinkedList = .{},
+
+const State = enum { unconfigured, configured, closed };
+const HardwareAcceleration = enum {
+    @"no-preference",
+    @"prefer-hardware",
+    @"prefer-software",
+    pub const js_enum_from_string = true;
+};
+const Config = struct {
+    codec: []const u8,
+    codedHeight: ?u32 = null,
+    codedWidth: ?u32 = null,
+    description: ?js.Value = null,
+    displayAspectHeight: ?u32 = null,
+    displayAspectWidth: ?u32 = null,
+    hardwareAcceleration: HardwareAcceleration = .@"no-preference",
+    optimizeForLatency: bool = false,
+};
+const Init = struct { @"error": js.Function, output: js.Function };
+
+fn validate(config: Config) !void {
+    if (config.codec.len == 0 or std.mem.indexOfAny(u8, config.codec, " \t\r\n,") != null) return error.TypeError;
+    inline for (.{ config.codedWidth, config.codedHeight, config.displayAspectWidth, config.displayAspectHeight }) |dimension| {
+        if (dimension != null and dimension.? == 0) return error.TypeError;
+    }
+    if (config.description) |value| _ = try value.toZig(js.BufferSource);
+    if ((config.displayAspectWidth == null) != (config.displayAspectHeight == null)) return error.TypeError;
+}
+
+fn supported(config: Config) bool {
+    // Synthetic A18 Pro H.264 capability, not a query of the host's codecs.
+    const codec = config.codec;
+    if (codec.len != 11 or (!std.mem.startsWith(u8, codec, "avc1.") and !std.mem.startsWith(u8, codec, "avc3."))) return false;
+    const profile = std.fmt.parseUnsigned(u8, codec[5..7], 16) catch return false;
+    _ = std.fmt.parseUnsigned(u8, codec[7..9], 16) catch return false;
+    const level = std.fmt.parseUnsigned(u8, codec[9..11], 16) catch return false;
+    if (profile != 0x42 and profile != 0x4d and profile != 0x58 and profile != 0x64) return false;
+    const levels = [_]u8{ 9, 10, 11, 12, 13, 20, 21, 22, 30, 31, 32, 40, 41, 42, 50, 51, 52 };
+    if (std.mem.indexOfScalar(u8, &levels, level) == null) return false;
+    const width = config.codedWidth orelse 1920;
+    const height = config.codedHeight orelse 1080;
+    return width <= 4096 and height <= 4096 and @as(u64, width) * height <= 4096 * 2304;
+}
+
+fn isConfigSupported(config: Config, exec: *js.Execution) !js.Promise {
+    try validate(config);
+    const local = exec.js.local.?;
+    const result = local.newObject();
+    const normalized = local.newObject();
+    _ = try normalized.set("codec", config.codec, .{});
+    inline for (.{ "codedWidth", "codedHeight", "displayAspectWidth", "displayAspectHeight" }) |field| {
+        if (@field(config, field)) |value| _ = try normalized.set(field, value, .{});
+    }
+    _ = try normalized.set("hardwareAcceleration", @tagName(config.hardwareAcceleration), .{});
+    _ = try normalized.set("optimizeForLatency", config.optimizeForLatency, .{});
+    if (config.description) |value| {
+        const description = try value.toZig(js.BufferSource);
+        _ = try normalized.set("description", js.ArrayBuffer{ .values = description.bytes }, .{});
+    }
+    _ = try result.set("supported", supported(config), .{});
+    _ = try result.set("config", normalized, .{});
+    const resolver = js.PromiseResolver.init(local);
+    try resolver.resolveValue(result.toValue());
+    return resolver.promise();
+}
+
+fn init(options: Init, exec: *js.Execution) !*Decoder {
+    const arena = try exec.getArena(.small, "VideoDecoder");
+    const self = exec._factory.eventTargetWithAllocator(arena.allocator(), Decoder{
+        ._proto = undefined,
+        ._arena = arena,
+        ._context = exec.js,
+        ._events = .init(arena.allocator()),
+    }) catch |err| {
+        arena.release();
+        return err;
+    };
+    self._handlers[0] = .{ .target = self._proto, .events = &self._events, .name = "dequeue", .weak = true };
+    exec.js.video_decoders.append(&self._context_node);
+    // Reuse JS-owned callback storage: closures capturing the decoder remain
+    // collectible, while each queued task roots the wrapper until delivery.
+    const data = try Speech.callbackData(self._proto, exec.js.local.?);
+    const local = exec.js.local.?;
+    if (!(data.defineOwnProperty("output", try local.zigValueToJs(options.output, .{}), 0) orelse false)) return error.JsException;
+    if (!(data.defineOwnProperty("error", try local.zigValueToJs(options.@"error", .{}), 0) orelse false)) return error.JsException;
+    return self;
+}
+
+pub fn acquireRef(self: *Decoder) void {
+    self._rc.acquire();
+}
+pub fn releaseRef(self: *Decoder, page: *Page) void {
+    self._rc.release(self, page);
+}
+pub fn deinit(self: *Decoder, _: *Page) void {
+    if (self._context) |ctx| ctx.video_decoders.remove(&self._context_node);
+    for (&self._handlers) |*handler| handler.deinit();
+    for (self._listener_roots.items) |slot| slot.release();
+    self._arena.release();
+}
+pub fn detach(self: *Decoder) void {
+    if (self._context) |ctx| ctx.video_decoders.remove(&self._context_node);
+    self._context = null;
+    self._state = .closed;
+    self._generation +%= 1;
+    self._queue_size = 0;
+}
+
+pub fn registerListener(self: *Decoder, typ: []const u8, callback: EventManagerBase.Callback, options: EventManagerBase.RegisterOptions, exec: *js.Execution) !void {
+    try self._listener_roots.ensureUnusedCapacity(self._arena.allocator(), 1);
+    const listener = (try self._events.register(self._proto, typ, callback, options)) orelse return;
+    const slot = switch (listener.function) {
+        .value => |value| value.slot,
+        .object => |value| value.slot,
+        .string => unreachable,
+    };
+    errdefer {
+        self._events.remove(self._proto, typ, callback, options.capture);
+        slot.release();
+    }
+    const value = switch (callback) {
+        .function => |f| js.Value{ .local = f.local, .handle = @ptrCast(f.handle) },
+        .object => |o| o.toValue(),
+    };
+    const data = try Speech.callbackData(self._proto, exec.js.local.?);
+    var buf: [32]u8 = undefined;
+    const key = try std.fmt.bufPrint(&buf, "listener{d}", .{self._listener_roots.items.len});
+    if (!(data.defineOwnProperty(key, value, 0) orelse false)) return error.JsException;
+    js.v8.v8__Global__SetWeak(&slot.handle);
+    self._listener_roots.appendAssumeCapacity(slot);
+}
+
+pub fn dispatch(self: *Decoder, event: *Event, exec: *js.Execution) !void {
+    var scope: js.Local.Scope = undefined;
+    exec.js.localScope(&scope);
+    defer scope.deinit();
+    const local = &scope.local;
+    // Event.target is a native pointer; let retained events keep the wrapper
+    // alive through a JS edge rather than a permanent native root.
+    const wrapper = try local.zigValueToJs(event, .{});
+    const owner = try local.zigValueToJs(self, .{});
+    const key: *const js.v8.Private = @ptrCast(js.v8.v8__Global__Get(&local.ctx.env.private_symbols.speech_callbacks.handle, local.isolate.handle).?);
+    var saved: js.v8.MaybeBool = undefined;
+    js.v8.v8__Object__SetPrivate(@ptrCast(wrapper.handle), local.handle, key, owner.handle, &saved);
+    if (!saved.has_value or !saved.value) return error.JsException;
+    try Speech.dispatchDirect(self._proto, &self._events, event, exec);
+}
+fn dequeue(self: *Decoder, exec: *js.Execution) !void {
+    const event = try Event.init("dequeue", null, exec.page);
+    event._is_trusted = true;
+    try self.dispatch(event, exec);
+}
+fn getState(self: *const Decoder) []const u8 {
+    return @tagName(self._state);
+}
+fn getQueueSize(self: *const Decoder) u32 {
+    return self._queue_size;
+}
+fn requireOpen(self: *const Decoder) !void {
+    if (self._state == .closed or self._context == null) return error.InvalidStateError;
+}
+fn configure(self: *Decoder, config: Config, exec: *js.Execution) !void {
+    try self.requireOpen();
+    try validate(config);
+    const coded_width = config.codedWidth orelse 1920;
+    const coded_height = config.codedHeight orelse 1080;
+    var display_width = coded_width;
+    var display_height = coded_height;
+    if (config.displayAspectWidth) |aspect_width| {
+        const aspect_height = config.displayAspectHeight.?;
+        const width = @as(u64, coded_height) * aspect_width / aspect_height;
+        const height = @as(u64, coded_width) * aspect_height / aspect_width;
+        if (width > std.math.maxInt(u32) or height > std.math.maxInt(u32)) return error.TypeError;
+        if (width > coded_width) display_width = @intCast(width) else display_height = @intCast(height);
+    }
+    if (!supported(config)) _ = try self.schedule(.failure, exec, exec.js.local.?);
+    self._width = coded_width;
+    self._height = coded_height;
+    self._display_width = display_width;
+    self._display_height = display_height;
+    self._state = .configured;
+    self._key_required = true;
+}
+fn decode(self: *Decoder, chunk: *Chunk, exec: *js.Execution) !void {
+    if (self._state != .configured or self._context == null) return error.InvalidStateError;
+    if (self._key_required and chunk._type != .key) return error.DataError;
+    if (chunk._data.len == 0) return error.TypeError;
+    const task = try self.schedule(.decode, exec, exec.js.local.?);
+    task.timestamp = chunk._timestamp;
+    task.duration = chunk._duration;
+    task.width = self._width;
+    task.height = self._height;
+    task.display_width = self._display_width;
+    task.display_height = self._display_height;
+    self._key_required = false;
+    self._queue_size += 1;
+}
+fn flush(self: *Decoder, exec: *js.Execution) !js.Promise {
+    if (self._state != .configured or self._context == null) return error.InvalidStateError;
+    const resolver = js.PromiseResolver.init(exec.js.local.?);
+    const global = try resolver.persist();
+    errdefer global.release();
+    const task = try self.schedule(.flush, exec, exec.js.local.?);
+    task.resolver = global;
+    self._flushes.append(&task.node);
+    self._key_required = true;
+    return resolver.promise();
+}
+fn clear(self: *Decoder, exec: *js.Execution, local: *const js.Local) !void {
+    self._generation +%= 1;
+    self._key_required = true;
+    const had_queue = self._queue_size != 0;
+    self._queue_size = 0;
+    while (self._flushes.popFirst()) |node| {
+        const task: *Task = @fieldParentPtr("node", node);
+        const resolver = task.resolver.?;
+        task.resolver = null;
+        defer resolver.release();
+        try resolver.local(local).rejectValue(try local.zigValueToJs(DOMException.init("The decoder was reset", "AbortError"), .{}));
+    }
+    if (had_queue) _ = try self.schedule(.dequeue, exec, local);
+}
+fn reset(self: *Decoder, exec: *js.Execution) !void {
+    try self.requireOpen();
+    self._state = .unconfigured;
+    try self.clear(exec, exec.js.local.?);
+}
+fn close(self: *Decoder, exec: *js.Execution) !void {
+    try self.requireOpen();
+    self._state = .closed;
+    try self.clear(exec, exec.js.local.?);
+}
+
+const Task = struct {
+    const Kind = enum { decode, flush, failure, dequeue };
+    decoder: *Decoder,
+    arena: *lp.Arena,
+    root: js.Value.Global,
+    generation: u64,
+    kind: Kind,
+    node: std.DoublyLinkedList.Node = .{},
+    resolver: ?js.PromiseResolver.Global = null,
+    timestamp: i64 = 0,
+    duration: ?u64 = null,
+    width: u32 = 0,
+    height: u32 = 0,
+    display_width: u32 = 0,
+    display_height: u32 = 0,
+
+    fn dispose(self: *Task) void {
+        if (self.resolver) |resolver| {
+            self.decoder._flushes.remove(&self.node);
+            resolver.release();
+        }
+        self.root.release();
+        self.arena.release();
+    }
+    fn cancelled(ptr: *anyopaque) void {
+        const self: *Task = @ptrCast(@alignCast(ptr));
+        self.dispose();
+    }
+    fn run(ptr: *anyopaque) !?u32 {
+        const self: *Task = @ptrCast(@alignCast(ptr));
+        defer self.dispose();
+        const decoder = self.decoder;
+        const ctx = decoder._context orelse return null;
+        var scope: js.Local.Scope = undefined;
+        ctx.localScope(&scope);
+        defer scope.deinit();
+        defer scope.local.runMicrotasks();
+        const exec = &ctx.execution;
+        const local = &scope.local;
+        if (self.generation != decoder._generation) return null;
+        switch (self.kind) {
+            .dequeue => try decoder.dequeue(exec),
+            .decode => {
+                decoder._queue_size -= 1;
+                const frame = try VideoFrame.synthetic(self.width, self.height, self.display_width, self.display_height, self.timestamp, self.duration, exec);
+                const data = try Speech.callbackData(decoder._proto, local);
+                const output = (try data.getFunction("output")).?;
+                // Callback exceptions are reported, not decoder failures.
+                output.call(void, .{frame}) catch |err| exec.page.recordJsError(err);
+                if (self.generation == decoder._generation) try decoder.dequeue(exec);
+            },
+            .flush => {
+                const resolver = self.resolver.?;
+                decoder._flushes.remove(&self.node);
+                self.resolver = null;
+                defer resolver.release();
+                try resolver.local(local).resolveValue(try local.zigValueToJs({}, .{}));
+            },
+            .failure => {
+                decoder._state = .closed;
+                try decoder.clear(exec, local);
+                const data = try Speech.callbackData(decoder._proto, local);
+                const callback = (try data.getFunction("error")).?;
+                callback.call(void, .{DOMException.init("The codec configuration is not supported", "NotSupportedError")}) catch |err| exec.page.recordJsError(err);
+            },
+        }
+        return null;
+    }
+};
+fn schedule(self: *Decoder, kind: Task.Kind, exec: *js.Execution, local: *const js.Local) !*Task {
+    const ctx = self._context orelse return error.InvalidStateError;
+    const arena = try exec.getArena(.tiny, "VideoDecoder.task");
+    errdefer arena.release();
+    const root = try (try local.zigValueToJs(self, .{})).persist();
+    errdefer root.release();
+    const task = try arena.create(Task);
+    task.* = .{ .decoder = self, .arena = arena, .root = root, .generation = self._generation, .kind = kind };
+    try ctx.scheduler.add(task, Task.run, 0, .{ .name = "VideoDecoder", .finalizer = Task.cancelled });
+    return task;
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(Decoder);
+    pub const Meta = struct {
+        pub const name = "VideoDecoder";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const constructor = bridge.constructor(Decoder.init, .{});
+    pub const isConfigSupported = bridge.function(Decoder.isConfigSupported, .{ .static = true });
+    pub const state = bridge.accessor(getState, null, .{});
+    pub const decodeQueueSize = bridge.accessor(getQueueSize, null, .{});
+    pub const ondequeue = bridge.accessor(Speech.Binding(Decoder, 0).get, Speech.Binding(Decoder, 0).set, .{});
+    pub const configure = bridge.function(Decoder.configure, .{});
+    pub const decode = bridge.function(Decoder.decode, .{});
+    pub const flush = bridge.function(Decoder.flush, .{});
+    pub const reset = bridge.function(Decoder.reset, .{});
+    pub const close = bridge.function(Decoder.close, .{});
+};
