+
+const std = @import("std");
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Page = @import("../Page.zig");
+const Rect = @import("DOMRectReadOnly.zig");
+const Frame = @This();
+
+_arena: *lp.Arena,
+_rc: lp.RC = .{},
+_width: u32,
+_height: u32,
+_visible: Region,
+_display_width: u32,
+_display_height: u32,
+_timestamp: i64,
+_duration: ?u64,
+_pixels: ?[]const u8 = null,
+_closed: bool = false,
+_color_space: *ColorSpace,
+
+const Region = struct { height: u32, width: u32, x: u32 = 0, y: u32 = 0 };
+const Layout = struct { offset: u32, stride: u32 };
+const Init = struct {
+    alpha: enum {
+        keep,
+        discard,
+        pub const js_enum_from_string = true;
+    } = .keep,
+    codedHeight: ?u32 = null,
+    codedWidth: ?u32 = null,
+    colorSpace: ?ColorSpace.Init = null,
+    displayHeight: ?u32 = null,
+    displayWidth: ?u32 = null,
+    duration: ?u64 = null,
+    format: ?[]const u8 = null,
+    layout: ?[]const Layout = null,
+    timestamp: ?i64 = null,
+    visibleRect: ?Region = null,
+};
+const CopyOptions = struct {
+    format: ?[]const u8 = null,
+    layout: ?[]const Layout = null,
+    rect: ?Region = null,
+};
+
+fn checkedRegion(region: Region, width: u32, height: u32) !Region {
+    if (region.width == 0 or region.height == 0 or @as(u64, region.x) + region.width > width or @as(u64, region.y) + region.height > height) return error.TypeError;
+    return region;
+}
+fn layoutFor(region: Region, layouts: ?[]const Layout) !Layout {
+    const row = region.width * 4;
+    if (layouts) |layout| {
+        if (layout.len != 1 or layout[0].stride < row) return error.TypeError;
+        return layout[0];
+    }
+    return .{ .offset = 0, .stride = row };
+}
+fn sizeFor(region: Region, layout: Layout) !u32 {
+    const size = @as(u64, layout.offset) + @as(u64, layout.stride) * (region.height - 1) + region.width * 4;
+    if (size > std.math.maxInt(u32)) return error.TypeError;
+    return @intCast(size);
+}
+fn checkFormat(format: ?[]const u8) !void {
+    if (format) |value| {
+        if (!std.mem.eql(u8, value, "RGBA")) return error.NotSupported;
+    }
+}
+
+pub fn synthetic(width: u32, height: u32, display_width: u32, display_height: u32, timestamp: i64, duration: ?u64, exec: *js.Execution) !*Frame {
+    if (width == 0 or height == 0 or width > 16384 or height > 16384) return error.TypeError;
+    const color = try ColorSpace.init(.{ .primaries = .bt709, .transfer = .@"iec61966-2-1", .matrix = .rgb, .fullRange = true }, exec);
+    const arena = try exec.getArena(.small, "VideoFrame");
+    errdefer arena.release();
+    const self = try arena.create(Frame);
+    self.* = .{
+        ._arena = arena,
+        ._width = width,
+        ._height = height,
+        ._visible = .{ .width = width, .height = height },
+        ._display_width = display_width,
+        ._display_height = display_height,
+        ._timestamp = timestamp,
+        ._duration = duration,
+        ._color_space = color,
+    };
+    return self;
+}
+fn init(source: js.Value, options_: ?Init, exec: *js.Execution) !*Frame {
+    const options = options_ orelse Init{};
+    if (source.toZig(*Frame) catch null) |original| {
+        try original.requireOpen();
+        const copy = try original.clone(exec);
+        errdefer copy._arena.release();
+        if (options.timestamp) |value| copy._timestamp = value;
+        if (options.duration) |value| copy._duration = value;
+        if (options.visibleRect) |value| copy._visible = try checkedRegion(value, copy._width, copy._height);
+        if (options.displayWidth) |value| copy._display_width = value;
+        if (options.displayHeight) |value| copy._display_height = value;
+        if (copy._display_width == 0 or copy._display_height == 0) return error.TypeError;
+        return copy;
+    }
+    const buffer = try source.toZig(js.BufferSource);
+    const width = options.codedWidth orelse return error.TypeError;
+    const height = options.codedHeight orelse return error.TypeError;
+    const timestamp = options.timestamp orelse return error.TypeError;
+    if (options.format == null) return error.TypeError;
+    try checkFormat(options.format);
+    const self = try synthetic(width, height, options.displayWidth orelse width, options.displayHeight orelse height, timestamp, options.duration, exec);
+    errdefer self._arena.release();
+    if (self._display_width == 0 or self._display_height == 0) return error.TypeError;
+    const region = Region{ .width = width, .height = height };
+    const layout = try layoutFor(region, options.layout);
+    if (buffer.bytes.len < try sizeFor(region, layout)) return error.TypeError;
+    const pixels = try self._arena.alloc(u8, width * height * 4);
+    for (0..height) |y| {
+        const start = layout.offset + y * layout.stride;
+        @memcpy(pixels[y * width * 4 ..][0 .. width * 4], buffer.bytes[start..][0 .. width * 4]);
+    }
+    if (options.alpha == .discard) {
+        var i: usize = 3;
+        while (i < pixels.len) : (i += 4) pixels[i] = 255;
+    }
+    self._pixels = pixels;
+    if (options.visibleRect) |value| self._visible = try checkedRegion(value, width, height);
+    if (options.colorSpace) |color| self._color_space = try ColorSpace.init(color, exec);
+    return self;
+}
+pub fn acquireRef(self: *Frame) void {
+    self._rc.acquire();
+}
+pub fn releaseRef(self: *Frame, page: *Page) void {
+    self._rc.release(self, page);
+}
+pub fn deinit(self: *Frame, _: *Page) void {
+    self._arena.release();
+}
+fn requireOpen(self: *const Frame) !void {
+    if (self._closed) return error.InvalidStateError;
+}
+fn close(self: *Frame) void {
+    self._closed = true;
+    if (self._pixels) |pixels| self._arena.allocator().free(pixels);
+    self._pixels = null;
+}
+fn clone(self: *const Frame, exec: *js.Execution) !*Frame {
+    try self.requireOpen();
+    const copy = try synthetic(self._width, self._height, self._display_width, self._display_height, self._timestamp, self._duration, exec);
+    errdefer copy._arena.release();
+    copy._visible = self._visible;
+    copy._color_space = self._color_space;
+    if (self._pixels) |pixels| copy._pixels = try copy._arena.dupe(u8, pixels);
+    return copy;
+}
+fn allocationSize(self: *const Frame, options_: ?CopyOptions) !u32 {
+    try self.requireOpen();
+    const options = options_ orelse CopyOptions{};
+    try checkFormat(options.format);
+    const region = try checkedRegion(options.rect orelse self._visible, self._width, self._height);
+    return sizeFor(region, try layoutFor(region, options.layout));
+}
+fn copyTo(self: *const Frame, value: js.Value, options_: ?CopyOptions, exec: *js.Execution) !js.Promise {
+    try self.requireOpen();
+    const options = options_ orelse CopyOptions{};
+    try checkFormat(options.format);
+    const region = try checkedRegion(options.rect orelse self._visible, self._width, self._height);
+    const layout = try layoutFor(region, options.layout);
+    // Options getters can detach/resize the destination before this point.
+    const destination = try value.toZig(js.BufferSource);
+    if (destination.bytes.len < try sizeFor(region, layout)) return error.TypeError;
+    for (0..region.height) |y| {
+        const start = layout.offset + y * layout.stride;
+        const row = @constCast(destination.bytes[start..][0 .. region.width * 4]);
+        if (self._pixels) |pixels| {
+            const source = ((region.y + y) * self._width + region.x) * 4;
+            @memcpy(row, pixels[source..][0..row.len]);
+        } else {
+            // A synthetic decoded frame is opaque black, generated lazily.
+            @memset(row, 0);
+            var i: usize = 3;
+            while (i < row.len) : (i += 4) row[i] = 255;
+        }
+    }
+    const local = exec.js.local.?;
+    const resolver = js.PromiseResolver.init(local);
+    try resolver.resolveValue(try local.zigValueToJs([_]Layout{layout}, .{}));
+    return resolver.promise();
+}
+fn getFormat(self: *const Frame) ?[]const u8 {
+    return if (self._closed) null else "RGBA";
+}
+fn getWidth(self: *const Frame) u32 {
+    return if (self._closed) 0 else self._width;
+}
+fn getHeight(self: *const Frame) u32 {
+    return if (self._closed) 0 else self._height;
+}
+fn getDisplayWidth(self: *const Frame) u32 {
+    return if (self._closed) 0 else self._display_width;
+}
+fn getDisplayHeight(self: *const Frame) u32 {
+    return if (self._closed) 0 else self._display_height;
+}
+fn getTimestamp(self: *const Frame) i64 {
+    return self._timestamp;
+}
+fn getDuration(self: *const Frame) ?u64 {
+    return self._duration;
+}
+fn getCodedRect(self: *const Frame, exec: *js.Execution) !?*Rect {
+    if (self._closed) return null;
+    return try Rect.init(0, 0, @floatFromInt(self._width), @floatFromInt(self._height), exec);
+}
+fn getVisibleRect(self: *const Frame, exec: *js.Execution) !?*Rect {
+    if (self._closed) return null;
+    const r = self._visible;
+    return try Rect.init(@floatFromInt(r.x), @floatFromInt(r.y), @floatFromInt(r.width), @floatFromInt(r.height), exec);
+}
+fn getColorSpace(self: *const Frame) *ColorSpace {
+    return self._color_space;
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(Frame);
+    pub const Meta = struct {
+        pub const name = "VideoFrame";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const constructor = bridge.constructor(Frame.init, .{});
+    pub const format = bridge.accessor(getFormat, null, .{});
+    pub const codedWidth = bridge.accessor(getWidth, null, .{});
+    pub const codedHeight = bridge.accessor(getHeight, null, .{});
+    pub const codedRect = bridge.accessor(getCodedRect, null, .{});
+    pub const visibleRect = bridge.accessor(getVisibleRect, null, .{});
+    pub const displayWidth = bridge.accessor(getDisplayWidth, null, .{});
+    pub const displayHeight = bridge.accessor(getDisplayHeight, null, .{});
+    pub const timestamp = bridge.accessor(getTimestamp, null, .{});
+    pub const duration = bridge.accessor(getDuration, null, .{});
+    pub const colorSpace = bridge.accessor(getColorSpace, null, .{});
+    pub const allocationSize = bridge.function(Frame.allocationSize, .{});
+    pub const copyTo = bridge.function(Frame.copyTo, .{});
+    pub const clone = bridge.function(Frame.clone, .{});
+    pub const close = bridge.function(Frame.close, .{});
+};
+
+pub const ColorSpace = struct {
+    _data: ColorSpace.Init,
+    const Primaries = enum {
+        bt709,
+        bt470bg,
+        smpte170m,
+        bt2020,
+        smpte432,
+        pub const js_enum_from_string = true;
+    };
+    const Transfer = enum {
+        bt709,
+        smpte170m,
+        @"iec61966-2-1",
+        linear,
+        pq,
+        hlg,
+        pub const js_enum_from_string = true;
+    };
+    const Matrix = enum {
+        rgb,
+        bt709,
+        bt470bg,
+        smpte170m,
+        @"bt2020-ncl",
+        pub const js_enum_from_string = true;
+    };
+    pub const Init = struct { fullRange: ?bool = null, matrix: ?Matrix = null, primaries: ?Primaries = null, transfer: ?Transfer = null };
+    fn init(options: ?ColorSpace.Init, exec: *js.Execution) !*ColorSpace {
+        return exec._factory.create(ColorSpace{ ._data = options orelse .{} });
+    }
+    fn getPrimaries(self: *const ColorSpace) ?[]const u8 {
+        return if (self._data.primaries) |value| @tagName(value) else null;
+    }
+    fn getTransfer(self: *const ColorSpace) ?[]const u8 {
+        return if (self._data.transfer) |value| @tagName(value) else null;
+    }
+    fn getMatrix(self: *const ColorSpace) ?[]const u8 {
+        return if (self._data.matrix) |value| @tagName(value) else null;
+    }
+    fn getFullRange(self: *const ColorSpace) ?bool {
+        return self._data.fullRange;
+    }
+    fn toJSON(self: *const ColorSpace, exec: *js.Execution) !js.Object {
+        const result = exec.js.local.?.newObject();
+        _ = try result.set("primaries", self.getPrimaries(), .{});
+        _ = try result.set("transfer", self.getTransfer(), .{});
+        _ = try result.set("matrix", self.getMatrix(), .{});
+        _ = try result.set("fullRange", self.getFullRange(), .{});
+        return result;
+    }
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(ColorSpace);
+        pub const Meta = struct {
+            pub const name = "VideoColorSpace";
+            pub const prototype_chain = bridge.prototypeChain();
+            pub var class_id: bridge.ClassId = undefined;
+        };
+        pub const constructor = bridge.constructor(ColorSpace.init, .{});
+        pub const primaries = bridge.accessor(getPrimaries, null, .{});
+        pub const transfer = bridge.accessor(getTransfer, null, .{});
+        pub const matrix = bridge.accessor(getMatrix, null, .{});
+        pub const fullRange = bridge.accessor(getFullRange, null, .{});
+        pub const toJSON = bridge.function(ColorSpace.toJSON, .{});
+    };
+};
