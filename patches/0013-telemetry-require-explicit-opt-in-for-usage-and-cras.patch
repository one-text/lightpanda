From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: brennoflavio <contato@brennoflavio.com.br>
Date: Wed, 14 Oct 2026 02:01:01 -0300
Subject: [PATCH] telemetry: require explicit opt-in for usage and crash
 reports

Require LIGHTPANDA_ENABLE_TELEMETRY=true; keep debug and test builds disabled. The shared gate also disables crash uploads by default. Explicit version checks remain unchanged. Update the existing test and documentation.
---
 README.md                   |  4 +++-
 src/telemetry/telemetry.zig | 11 +++++++----
 2 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/README.md b/README.md
index 461ae20..b327940 100644
--- a/README.md
+++ b/README.md
@@ -1,3 +1,5 @@
+<!-- Brenno Flávio <contato@brennoflavio.com.br> -->
+
 <p align="center">
   <a href="https://lightpanda.io"><img src="https://cdn.lightpanda.io/assets/images/logo/lpd-logo.png" alt="Logo" height=170></a>
 </p>
@@ -249,7 +251,7 @@ A skill is available in [lightpanda-io/agent-skill](https://github.com/lightpand
 
 ### Telemetry
 
-By default, Lightpanda collects and sends usage telemetry. This can be disabled by setting an environment variable `LIGHTPANDA_DISABLE_TELEMETRY=true`. You can read Lightpanda's privacy policy at: [https://lightpanda.io/privacy-policy](https://lightpanda.io/privacy-policy).
+Usage telemetry and automatic crash-report uploads are disabled by default. Set `LIGHTPANDA_ENABLE_TELEMETRY=true` to enable them in release builds; only the exact value `true` enables reporting. Debug and test builds always disable reporting. `LIGHTPANDA_DISABLE_TELEMETRY` is no longer used. Explicit version checks still contact the update service regardless of this setting. You can read Lightpanda's privacy policy at: [https://lightpanda.io/privacy-policy](https://lightpanda.io/privacy-policy).
 
 ### Core dumps
 
diff --git a/src/telemetry/telemetry.zig b/src/telemetry/telemetry.zig
index 53cc582..43d2590 100644
--- a/src/telemetry/telemetry.zig
+++ b/src/telemetry/telemetry.zig
@@ -1,3 +1,5 @@
+// Brenno Flávio <contato@brennoflavio.com.br>
+
 const std = @import("std");
 const lp = @import("lightpanda");
 
@@ -13,7 +15,8 @@ pub fn isDisabled() bool {
         return true;
     }
 
-    return std.c.getenv("LIGHTPANDA_DISABLE_TELEMETRY") != null;
+    const value = std.c.getenv("LIGHTPANDA_ENABLE_TELEMETRY") orelse return true;
+    return !std.mem.eql(u8, std.mem.span(value), "true");
 }
 
 pub const Telemetry = TelemetryT(@import("lightpanda.zig"));
@@ -159,11 +162,11 @@ extern fn unsetenv(name: [*:0]u8) c_int;
 const testing = @import("../testing.zig");
 test "telemetry: always disabled in debug builds" {
     // Must be disabled regardless of environment variable.
-    _ = unsetenv(@constCast("LIGHTPANDA_DISABLE_TELEMETRY"));
+    _ = unsetenv(@constCast("LIGHTPANDA_ENABLE_TELEMETRY"));
     try testing.expectEqual(true, isDisabled());
 
-    _ = setenv(@constCast("LIGHTPANDA_DISABLE_TELEMETRY"), @constCast(""), 0);
-    defer _ = unsetenv(@constCast("LIGHTPANDA_DISABLE_TELEMETRY"));
+    _ = setenv(@constCast("LIGHTPANDA_ENABLE_TELEMETRY"), @constCast("true"), 0);
+    defer _ = unsetenv(@constCast("LIGHTPANDA_ENABLE_TELEMETRY"));
     try testing.expectEqual(true, isDisabled());
 
     const FailingProvider = struct {
