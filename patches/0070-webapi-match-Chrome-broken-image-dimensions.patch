diff --git a/src/browser/webapi/Element.zig b/src/browser/webapi/Element.zig
index 52da6a2..e6168ea 100644
--- a/src/browser/webapi/Element.zig
+++ b/src/browser/webapi/Element.zig
@@ -1473,6 +1473,7 @@ pub fn hasPointerEventsNone(self: *Element, frame: *Frame) bool {
 }
 
 pub fn isVisible(self: *Element, frame: *Frame) bool {
+    if (self.is(Html.Image) != null and !self.asNode().isConnected()) return false;
     const owner = self.ownerFrame(frame) orelse return false;
     return !owner._style_manager.isHidden(self, .{});
 }
@@ -1506,6 +1507,9 @@ pub const Axis = enum {
 
 pub fn getElementAxis(self: *Element, frame: *Frame, comptime axis: Axis) Axis.State {
     const tag = self.getTag();
+    if (self.is(Html.Image)) |image| {
+        return .{ .value = image.layoutAxis(frame, axis), .explicit = true };
+    }
     const root = self.isRootContainer();
 
     if (self.ownerFrame(frame)) |owner| {
@@ -1812,14 +1816,16 @@ pub fn getOffsetHeight(self: *Element, frame: *Frame) f64 {
     if (!self.isVisible(frame)) {
         return 0.0;
     }
-    return self.boxAxis(frame, .height);
+    const size = self.boxAxis(frame, .height);
+    return if (self.is(Html.Image) != null) @round(size) else size;
 }
 
 pub fn getOffsetWidth(self: *Element, frame: *Frame) f64 {
     if (!self.isVisible(frame)) {
         return 0.0;
     }
-    return self.boxAxis(frame, .width);
+    const size = self.boxAxis(frame, .width);
+    return if (self.is(Html.Image) != null) @round(size) else size;
 }
 
 pub fn getOffsetTop(self: *Element, frame: *Frame) f64 {
diff --git a/src/browser/webapi/element/html/Image.zig b/src/browser/webapi/element/html/Image.zig
index 5c8454b..a60cd8b 100644
--- a/src/browser/webapi/element/html/Image.zig
+++ b/src/browser/webapi/element/html/Image.zig
@@ -26,6 +26,7 @@ const Factory = @import("../../../Factory.zig");
 const Node = @import("../../Node.zig");
 const Element = @import("../../Element.zig");
 const HtmlElement = @import("../Html.zig");
+const reflection = @import("../reflection.zig");
 
 const Picture = @import("Picture.zig");
 const Source = @import("Source.zig");
@@ -42,6 +43,7 @@ _generation: u32 = 0,
 _complete: bool = true,
 _natural_width: u32 = 0,
 _natural_height: u32 = 0,
+_broken: bool = false,
 // Hash of the URL the last update selected, so a <picture> mutation that
 // leaves the selection unchanged doesn't restart the load.
 _selected_hash: u64 = 0,
@@ -102,6 +104,76 @@ fn setLoading(self: *Image, value: []const u8, frame: *Frame) !void {
     try self.asElement().setAttributeSafe(comptime .wrap("loading"), .wrap(value), frame);
 }
 
+fn getWidth(self: *Image, frame: *Frame) u32 {
+    return self.getAxis(frame, .width);
+}
+
+fn getHeight(self: *Image, frame: *Frame) u32 {
+    return self.getAxis(frame, .height);
+}
+
+fn getAxis(self: *Image, frame: *Frame, comptime axis: Element.Axis) u32 {
+    const element = self.asElement();
+    if (element.asNode().isConnected() and element.isVisible(frame)) {
+        const size = self.layoutAxis(frame, axis);
+        return @intFromFloat(std.math.clamp(@round(size), 0, std.math.maxInt(u32)));
+    }
+    return self.attributeAxis(axis) orelse switch (axis) {
+        .width => self._natural_width,
+        .height => self._natural_height,
+    };
+}
+
+fn attributeAxis(self: *Image, comptime axis: Element.Axis) ?u32 {
+    const text = self.asElement().getAttributeInterned(@tagName(axis)) orelse return null;
+    const value = reflection.parseInteger(text) orelse return null;
+    if (value < 0 or value > std.math.maxInt(i32)) return null;
+    return @intCast(value);
+}
+
+fn specifiedAxis(self: *Image, frame: *Frame, comptime axis: Element.Axis) ?f64 {
+    const element = self.asElement();
+    if (element.ownerFrame(frame)) |owner| {
+        if (owner._style_manager.declaredSize(element, axis)) |size| return size;
+    }
+    return @floatFromInt(self.attributeAxis(axis) orelse return null);
+}
+
+// Shared by the IDL dimensions and synthetic geometry; no bitmap is rendered.
+pub fn layoutAxis(self: *Image, frame: *Frame, comptime axis: Element.Axis) f64 {
+    const width = self.specifiedAxis(frame, .width);
+    const height = self.specifiedAxis(frame, .height);
+    const specified = if (axis == .width) width else height;
+    if (width != null and height != null) return specified.?;
+
+    const natural = if (axis == .width) self._natural_width else self._natural_height;
+    const other_natural = if (axis == .width) self._natural_height else self._natural_width;
+    if (natural > 0 and other_natural > 0) {
+        if (specified) |size| return size;
+        if (if (axis == .width) height else width) |other| {
+            return other * @as(f64, @floatFromInt(natural)) / @as(f64, @floatFromInt(other_natural));
+        }
+        return @floatFromInt(natural);
+    }
+
+    // Chrome's unsized fallback is a 16 CSS-pixel icon, not a natural size.
+    // An empty alt suppresses the icon; one explicit axis alone is not a box.
+    if (self._broken) {
+        const alt = self.asElement().getAttributeInterned("alt");
+        if (alt == null or alt.?.len != 0) return 16;
+    }
+    return 0;
+}
+
+pub fn sizeChanged(self: *Image, frame: *Frame) void {
+    const element = self.asElement();
+    const owner = element.ownerFrame(frame) orelse return;
+    if (owner.isGoingAway() or !self.asNode().isConnected()) return;
+    owner.styleChanged();
+    Frame.observers.scheduleResizeDelivery(owner);
+    Frame.observers.scheduleIntersectionChecks(owner);
+}
+
 fn getNaturalWidth(self: *const Image) u32 {
     return self._natural_width;
 }
@@ -138,6 +210,8 @@ fn imageAddedCallback(self: *Image, frame: *Frame) !void {
     self._complete = true;
     self._natural_width = 0;
     self._natural_height = 0;
+    self._broken = false;
+    self.sizeChanged(frame);
 
     const src = self.selectSource(frame);
     self._selected_hash = std.hash.Wyhash.hash(0, src);
@@ -152,6 +226,9 @@ fn imageAddedCallback(self: *Image, frame: *Frame) !void {
 
     Frame.resource_load.image(frame, self, src) catch |err| {
         log.debug(.http, "image fetch", .{ .err = err, .src = src });
+        self._complete = true;
+        self._broken = true;
+        self.sizeChanged(frame);
         return frame.queueElementEvent(Factory.protoOf(self), .@"error");
     };
 }
