+<!-- Brenno Flávio <contato@brennoflavio.com.br> -->
 <head>
   <script src="../testing.js"></script>
 </head>
@@ -8,10 +9,7 @@
 </body>
 
 <!--
-  There is no rasterizer: every 2D draw call is a no-op, so a canvas is always
-  blank and serializes to a fixed 1x1 transparent PNG. A real browser would
-  size the image to the canvas, but nothing here can observe image dimensions
-  (Image.naturalWidth is always 0).
+  The lightweight display list synthesizes a dimension-correct PNG on demand.
 -->
 
 <script id=toDataURL_basic>
@@ -32,15 +30,14 @@
 }
 </script>
 
-<script id=toDataURL_is_size_independent>
+<script id=toDataURL_depends_on_size>
 {
-  // Deliberate: with no rasterizer every canvas is blank, so they all
-  // serialize to the same 1x1 transparent PNG regardless of dimensions.
+  // PNG dimensions follow the canvas even when it has not been drawn on.
   const a = document.createElement('canvas');
   a.width = 10; a.height = 10;
   const b = document.createElement('canvas');
   b.width = 20; b.height = 20;
-  testing.expectEqual(a.toDataURL(), b.toDataURL());
+  testing.expectEqual(false, a.toDataURL() === b.toDataURL());
 }
 </script>
 
@@ -84,7 +81,7 @@
     // A thrown TypeError in here is only logged, so guard before dereferencing.
