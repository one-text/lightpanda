+/// The regular and offscreen contexts share one deliberately bounded painter.
+/// Transforms, paths, gradients and actual font rasterization remain unsupported.
+pub fn Painting(comptime Context: type) type {
+    return struct {
+        pub fn reset(self: *Context) void {
+            self._recording.reset();
+            self._state = .{};
+            self._saved.clearRetainingCapacity();
+        }
+
+        pub fn save(self: *Context, exec: *Execution) !void {
+            try self._saved.append(exec._factory.storageAllocator(), self._state);
+        }
+
+        pub fn restore(self: *Context) void {
+            self._state = self._saved.pop() orelse return;
+        }
+
+        pub fn getGlobalAlpha(self: *const Context) f64 {
+            return self._state.global_alpha;
+        }
+
+        pub fn setGlobalAlpha(self: *Context, value: f64) void {
+            if (value >= 0 and value <= 1) self._state.global_alpha = value;
+        }
+
+        pub fn getTextAlign(self: *const Context) []const u8 {
+            return @tagName(self._state.text_align);
+        }
+
+        pub fn setTextAlign(self: *Context, value: []const u8) void {
+            self._state.text_align = std.meta.stringToEnum(TextAlign, value) orelse return;
+        }
+
+        pub fn getTextBaseline(self: *const Context) []const u8 {
+            return @tagName(self._state.text_baseline);
+        }
+
+        pub fn setTextBaseline(self: *Context, value: []const u8) void {
+            self._state.text_baseline = std.meta.stringToEnum(TextBaseline, value) orelse return;
+        }
+
+        fn fillColor(self: *const Context) ?@import("../../color.zig").RGBA {
+            var c = switch (self._state.fill_style) {
+                .color => |c| c,
+                else => return null,
+            };
+            c.a = @intFromFloat(@round(@as(f64, @floatFromInt(c.a)) * self._state.global_alpha));
+            return c;
+        }
+
+        pub fn clearRect(self: *Context, x: f64, y: f64, w: f64, h: f64, exec: *Execution) !void {
+            const width = self._canvas.getWidth();
+            const height = self._canvas.getHeight();
+            const area = Recording.bounds(x, y, w, h, width, height) orelse return;
+            try self._recording.rectangle(area, null, width, height, exec);
+        }
+
+        pub fn fillRect(self: *Context, x: f64, y: f64, w: f64, h: f64, exec: *Execution) !void {
+            const c = fillColor(self) orelse return;
+            const width = self._canvas.getWidth();
+            const height = self._canvas.getHeight();
+            const area = Recording.bounds(x, y, w, h, width, height) orelse return;
+            try self._recording.rectangle(area, c, width, height, exec);
+        }
+
+        pub fn fillText(self: *Context, text: []const u8, x: f64, y: f64, max_width: ?js.Value, exec: *Execution) !void {
+            const limit = if (max_width) |v| try v.toF64() else null;
+            if (!std.math.isFinite(x) or !std.math.isFinite(y)) return;
+            const c = fillColor(self) orelse return;
+            if (c.a == 0) return;
+            const state = &self._state;
+            const size = state.font_size;
+            const natural_width = measureWidth(text, size, state.font_face);
+            if (!(natural_width > 0) or !std.math.isFinite(natural_width)) return;
+            var scale: f64 = 1;
+            if (limit) |value| {
+                if (!(value > 0) or !std.math.isFinite(value)) return;
+                scale = @min(1, value / natural_width);
+            }
+            const width = self._canvas.getWidth();
+            const height = self._canvas.getHeight();
+            if (!Recording.hasBitmap(width, height)) return;
+            var pen = x - natural_width * scale * switch (state.text_align) {
+                .center => @as(f64, 0.5),
+                .end, .right => @as(f64, 1),
+                else => @as(f64, 0),
+            };
+            const top = y - size * switch (state.text_baseline) {
+                .top => @as(f64, 0),
+                .hanging => @as(f64, 0.2),
+                .middle => @as(f64, 0.5),
+                .alphabetic => @as(f64, 0.8),
+                .ideographic, .bottom => @as(f64, 1),
+            };
+            var it = std.unicode.Utf8Iterator{ .bytes = text, .i = 0 };
+            while (it.i < text.len) {
+                const start = it.i;
+                const cp = it.nextCodepoint() orelse break;
+                const advance = measureWidth(text[start..it.i], size, state.font_face) * scale;
+                if (cp > ' ' and advance > 0) {
+                    try self._recording.glyph(.{ .x = pen, .y = top, .width = advance * 0.85, .height = size, .codepoint = cp, .color = c }, width, height, exec);
+                }
+                pen += advance;
+            }
+        }
+
+        pub fn putImageData(self: *Context, image: *@import("../ImageData.zig"), dx: f64, dy: f64, dirty_x: ?js.Value, dirty_y: ?js.Value, dirty_w: ?js.Value, dirty_h: ?js.Value, exec: *Execution) !void {
+            if (dirty_x != null and (dirty_y == null or dirty_w == null or dirty_h == null)) return error.TypeError;
+            const x = if (dirty_x) |v| try v.toF64() else null;
+            const y = if (dirty_y) |v| try v.toF64() else null;
+            const w = if (dirty_w) |v| try v.toF64() else null;
+            const h = if (dirty_h) |v| try v.toF64() else null;
+            try self._recording.put(image, dx, dy, x, y, w, h, self._canvas.getWidth(), self._canvas.getHeight(), exec);
+        }
+
+        pub fn getImageData(self: *const Context, sx: i32, sy: i32, sw: i32, sh: i32, exec: *Execution) !*@import("../ImageData.zig") {
+            return self._recording.imageData(sx, sy, sw, sh, self._canvas.getWidth(), self._canvas.getHeight(), exec);
+        }
+    };
+}
