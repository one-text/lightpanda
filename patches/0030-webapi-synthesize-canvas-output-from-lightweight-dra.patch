+    const recording = if (self._cached) |cached| &cached.@"2d"._recording else &empty_recording;
+    const blob = try Blob.initFromBytes(try recording.png(self._width, self._height, exec), "image/png", exec);
     return exec.js.local.?.resolvePromise(blob);
 }
 
