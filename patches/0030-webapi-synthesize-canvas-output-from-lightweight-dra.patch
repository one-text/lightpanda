+//! A display list, not a rasterizer. Only output requests synthesize pixels.
+//! Synthetic 5x7 glyph masks deliberately do not claim CoreText fidelity.
+const std = @import("std");
+const RGBA = @import("../../color.zig").RGBA;
+const Execution = @import("../../js/js.zig").Execution;
+const ImageData = @import("../ImageData.zig");
+const Allocator = std.mem.Allocator;
+const Recording = @This();
+
+allocator: ?Allocator = null,
+commands: std.ArrayList(Command) = .empty,
+
+pub const Bounds = struct { left: u32, top: u32, right: u32, bottom: u32 };
+pub const Glyph = struct { x: f64, y: f64, width: f64, height: f64, codepoint: u21, color: RGBA };
+const Command = struct {
+    bounds: Bounds,
+    paint: union(enum) { fill: RGBA, clear, glyph: Glyph, pixels: []const u8 },
+};
+
+pub fn hasBitmap(width: u32, height: u32) bool {
+    return width > 0 and height > 0 and @as(u64, width) * height <= 16384 * 16384;
+}
+
+pub fn reset(self: *Recording) void {
+    const allocator = self.allocator orelse return;
+    for (self.commands.items) |command| {
+        if (command.paint == .pixels) allocator.free(command.paint.pixels);
+    }
+    // Reuse display-list storage across animation frames, without retaining pixels.
+    self.commands.clearRetainingCapacity();
+}
+
+/// Replacement operations make fully covered history irrelevant. In particular,
+/// repeated partial putImageData calls must recycle old pixel snapshots.
+fn discardCovered(self: *Recording, area: Bounds) void {
+    const allocator = self.allocator orelse return;
+    var kept: usize = 0;
+    for (self.commands.items) |command| {
+        const b = command.bounds;
+        if (area.left <= b.left and area.top <= b.top and area.right >= b.right and area.bottom >= b.bottom) {
+            if (command.paint == .pixels) allocator.free(command.paint.pixels);
+        } else {
+            self.commands.items[kept] = command;
+            kept += 1;
+        }
+    }
+    self.commands.items.len = kept;
+}
+
+fn append(self: *Recording, command: Command, exec: *Execution) !void {
+    const allocator = self.allocator orelse exec._factory.storageAllocator();
+    self.allocator = allocator;
+    try self.commands.append(allocator, command);
+}
+
+pub fn bounds(x: f64, y: f64, w: f64, h: f64, width: u32, height: u32) ?Bounds {
+    if (!hasBitmap(width, height)) return null;
+    inline for (.{ x, y, w, h }) |v| if (!std.math.isFinite(v)) return null;
+    // Sample pixel centres; normalize negative rectangles before clipping.
+    const left: u32 = @intFromFloat(@ceil(std.math.clamp(@min(x, x + w) - 0.5, 0, @as(f64, @floatFromInt(width)))));
+    const right: u32 = @intFromFloat(@ceil(std.math.clamp(@max(x, x + w) - 0.5, 0, @as(f64, @floatFromInt(width)))));
+    const top: u32 = @intFromFloat(@ceil(std.math.clamp(@min(y, y + h) - 0.5, 0, @as(f64, @floatFromInt(height)))));
+    const bottom: u32 = @intFromFloat(@ceil(std.math.clamp(@max(y, y + h) - 0.5, 0, @as(f64, @floatFromInt(height)))));
+    if (left >= right or top >= bottom) return null;
+    return .{ .left = left, .right = right, .top = top, .bottom = bottom };
+}
+
+pub fn rectangle(self: *Recording, area: Bounds, color: ?RGBA, width: u32, height: u32, exec: *Execution) !void {
+    if (color) |c| if (c.a == 0) return;
+    const full = area.left == 0 and area.top == 0 and area.right == width and area.bottom == height;
+    if (color == null or color.?.a == 255) self.discardCovered(area);
+    if (full and color == null) return;
+    try self.append(.{ .bounds = area, .paint = if (color) |c| .{ .fill = c } else .clear }, exec);
+}
+
+pub fn glyph(self: *Recording, shape: Glyph, width: u32, height: u32, exec: *Execution) !void {
+    if (shape.color.a == 0 or shape.width <= 0 or shape.height <= 0) return;
+    const area = bounds(shape.x, shape.y, shape.width, shape.height, width, height) orelse return;
+    try self.append(.{ .bounds = area, .paint = .{ .glyph = shape } }, exec);
+}
+
+/// Copy only the visible dirty rectangle now; subsequent ImageData writes
+/// must not change a recorded putImageData operation.
+pub fn put(self: *Recording, image: *ImageData, dx: f64, dy: f64, dirty_x: ?f64, dirty_y: ?f64, dirty_w: ?f64, dirty_h: ?f64, width: u32, height: u32, exec: *Execution) !void {
+    const values = .{ dx, dy, dirty_x orelse 0, dirty_y orelse 0, dirty_w orelse @as(f64, @floatFromInt(image._width)), dirty_h orelse @as(f64, @floatFromInt(image._height)) };
+    inline for (values) |v| if (!std.math.isFinite(v)) return error.NotSupported;
+    const source = image._data.local(exec.js.local.?).slice();
+    if (source.len == 0) return error.InvalidState;
+    const dirty = bounds(@trunc(values[2]), @trunc(values[3]), @trunc(values[4]), @trunc(values[5]), image._width, image._height) orelse return;
+    const x = @trunc(dx);
+    const y = @trunc(dy);
+    const area = bounds(x + @as(f64, @floatFromInt(dirty.left)), y + @as(f64, @floatFromInt(dirty.top)), @floatFromInt(dirty.right - dirty.left), @floatFromInt(dirty.bottom - dirty.top), width, height) orelse return;
+    const allocator = self.allocator orelse exec._factory.storageAllocator();
+    const stride = @as(usize, area.right - area.left) * 4;
+    const pixels = try allocator.alloc(u8, stride * (area.bottom - area.top));
+    errdefer allocator.free(pixels);
+    const sx: usize = @intFromFloat(@as(f64, @floatFromInt(area.left)) - x);
+    const sy: usize = @intFromFloat(@as(f64, @floatFromInt(area.top)) - y);
+    for (0..area.bottom - area.top) |row| {
+        const start = ((sy + row) * image._width + sx) * 4;
+        @memcpy(pixels[row * stride ..][0..stride], source[start..][0..stride]);
+    }
+    self.discardCovered(area);
+    try self.append(.{ .bounds = area, .paint = .{ .pixels = pixels } }, exec);
+}
+
+fn blend(pixel: *[4]u8, color: RGBA) void {
+    if (color.a == 255) {
+        pixel.* = .{ color.r, color.g, color.b, 255 };
+        return;
+    }
+    if (color.a == 0) return;
+    const sa: u32 = color.a;
+    const da: u32 = pixel[3];
+    const alpha = sa * 255 + da * (255 - sa);
+    inline for (.{ color.r, color.g, color.b }, 0..) |c, channel| {
+        pixel[channel] = @intCast((@as(u32, c) * sa * 255 + @as(u32, pixel[channel]) * da * (255 - sa) + alpha / 2) / alpha);
+    }
+    pixel[3] = @intCast((alpha + 127) / 255);
+}
+
+/// Replays only operations intersecting this requested span, in paint order.
+/// No canvas-sized pixel allocation, even during PNG serialization.
+pub fn readSpan(self: *const Recording, sx: i64, sy: i64, destination: []u8, width: u32, height: u32) void {
+    @memset(destination, 0);
+    if (!hasBitmap(width, height) or sy < 0 or sy >= height) return;
+    for (self.commands.items) |command| {
+        const b = command.bounds;
+        if (sy < b.top or sy >= b.bottom) continue;
+        const left = @max(sx, b.left);
+        const right = @min(sx + @as(i64, @intCast(destination.len / 4)), b.right);
+        if (left >= right) continue;
+        const offset: usize = @intCast((left - sx) * 4);
+        const length: usize = @intCast((right - left) * 4);
+        const span = destination[offset..][0..length];
+        switch (command.paint) {
+            .clear => @memset(span, 0),
+            .pixels => |pixels| {
+                const start: usize = @intCast(((sy - b.top) * (b.right - b.left) + left - b.left) * 4);
+                @memcpy(span, pixels[start..][0..length]);
+            },
+            .fill => |c| {
+                var i: usize = 0;
+                while (i < span.len) : (i += 4) blend(span[i..][0..4], c);
+            },
+            .glyph => |g| {
+                const row: u32 = @intFromFloat(@floor((@as(f64, @floatFromInt(sy)) + 0.5 - g.y) * 7 / g.height));
+                if (row >= 7) continue;
+                const mask = (@as(u32, g.codepoint) *% @as(u32, 0x45d9f3b)) ^ (row *% @as(u32, 0x9e3779b9));
+                var x = left;
+                while (x < right) : (x += 1) {
+                    const column: u32 = @intFromFloat(@floor((@as(f64, @floatFromInt(x)) + 0.5 - g.x) * 5 / g.width));
+                    if (column < 5 and (mask >> @as(u5, @intCast(column))) & 1 != 0) {
+                        const i: usize = @intCast((x - left) * 4);
+                        blend(span[i..][0..4], g.color);
+                    }
+                }
+            },
+        }
+    }
+}
+
+pub fn imageData(self: *const Recording, sx: i32, sy: i32, sw: i32, sh: i32, width: u32, height: u32, exec: *Execution) !*ImageData {
+    if (sw == 0 or sh == 0) return error.IndexSizeError;
+    const result = try ImageData.init(@intCast(@abs(@as(i64, sw))), @intCast(@abs(@as(i64, sh))), null, exec);
+    const pixels = result._data.local(exec.js.local.?).slice();
+    const x = @as(i64, sx) + @min(@as(i64, sw), 0);
+    const y = @as(i64, sy) + @min(@as(i64, sh), 0);
+    const stride = @as(usize, result._width) * 4;
+    for (0..result._height) |row| self.readSpan(x, y + @as(i64, @intCast(row)), pixels[row * stride ..][0..stride], width, height);
+    return result;
+}
+
+fn chunk(writer: *std.Io.Writer, kind: *const [4]u8, bytes: []const u8) !void {
+    try writer.writeInt(u32, @intCast(bytes.len), .big);
+    try writer.writeAll(kind);
+    try writer.writeAll(bytes);
+    var crc = std.hash.Crc32.init();
+    crc.update(kind);
+    crc.update(bytes);
+    try writer.writeInt(u32, crc.final(), .big);
+}
+
+pub fn png(self: *const Recording, width: u32, height: u32, exec: *Execution) ![]const u8 {
+    const arena = try exec.getArena(.medium, "canvas.png");
+    defer arena.release();
+    const allocator = arena.allocator();
+    var compressed: std.Io.Writer.Allocating = .init(allocator);
+    try compressed.ensureUnusedCapacity(256);
+    const flate = std.compress.flate;
+    const compressor = try allocator.create(flate.Compress);
+    compressor.* = try flate.Compress.init(&compressed.writer, try allocator.alloc(u8, flate.max_window_len), .zlib, .fastest);
+    var tile: [4096]u8 = undefined;
+    for (0..height) |row| {
+        try compressor.writer.writeByte(0); // PNG filter: None.
+        var x: u32 = 0;
+        while (x < width) {
+            const n: u32 = @min(width - x, tile.len / 4);
+            self.readSpan(x, @intCast(row), tile[0 .. n * 4], width, height);
+            try compressor.writer.writeAll(tile[0 .. n * 4]);
+            x += n;
+        }
+    }
+    try compressor.finish();
+    var result: std.Io.Writer.Allocating = .init(exec.local_arena);
+    try result.writer.writeAll("\x89PNG\r\n\x1a\n");
+    var header: [13]u8 = .{0} ** 13;
+    std.mem.writeInt(u32, header[0..4], width, .big);
+    std.mem.writeInt(u32, header[4..8], height, .big);
+    header[8] = 8;
+    header[9] = 6; // 8-bit RGBA, no interlace.
+    try chunk(&result.writer, "IHDR", &header);
+    try chunk(&result.writer, "IDAT", compressed.written());
+    try chunk(&result.writer, "IEND", "");
+    return result.written();
+}
