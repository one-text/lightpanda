diff --git a/src/browser/webapi/Element.zig b/src/browser/webapi/Element.zig
index c0b24b5..1f0858c 100644
--- a/src/browser/webapi/Element.zig
+++ b/src/browser/webapi/Element.zig
@@ -1635,7 +1635,7 @@ pub fn boundingClientRectValues(self: *Element, frame: *Frame) DOMRect.Data {
 pub fn boundingClientRectValuesForVisible(self: *Element, frame: *Frame) DOMRect.Data {
     return .{
         .x = self.horizontalPosition(frame),
-        .y = self.positionedClientCoordinate(frame, .height) orelse calculateDocumentPosition(self.asNode()),
+        .y = self.clientCoordinate(frame, .height, null),
         .width = self.boxAxis(frame, .width),
         .height = self.boxAxis(frame, .height),
     };
@@ -1980,7 +1980,18 @@ fn countSubtreeNodes(node: *Node) f64 {
 // translateX is commonly used to shift elements around, e.g. in a carousel to
 // shift things around. So we honor any transform: translateX inline styles.
 pub fn horizontalPosition(self: *Element, frame: *Frame) f64 {
-    return self.positionedClientCoordinate(frame, .width) orelse self.flowHorizontalPosition(frame);
+    return self.clientCoordinate(frame, .width, null);
+}
+
+// Positioned coordinates are already viewport-relative. Preserve the synthetic
+// anchor for auto-inset viewport-fixed axes too; only ordinary flow scrolls.
+pub fn clientCoordinate(self: *Element, frame: *Frame, comptime axis: Axis, positions: ?*const FlowPositions) f64 {
+    if (self.positionedCoordinate(frame, axis, positions)) |value| return value;
+    const flow = self.flowCoordinate(frame, axis, positions);
+    if (self.isViewportFixed(frame)) return flow;
+    const owner = self.ownerFrame(frame) orelse return 0;
+    const window_scroll: f64 = @floatFromInt(if (axis == .width) owner.window.getScrollX() else owner.window.getScrollY());
+    return flow - self.ancestorScroll(null, frame, axis) - window_scroll;
 }
 
 fn flowHorizontalPosition(self: *Element, frame: *Frame) f64 {
@@ -2176,15 +2187,41 @@ pub fn clone(self: *Element, deep: bool, document: *const Node.Document, frame:
 }
 
 pub fn scrollIntoViewIfNeeded(self: *Element, center_if_needed: ?bool, frame: *Frame) void {
-    _ = center_if_needed;
-    const positioned_y = self.positionedClientCoordinate(frame, .height);
-    const y = positioned_y orelse calculateDocumentPosition(self.asNode());
-    const scroll_y: f64 = if (positioned_y != null) 0 else @floatFromInt(frame.window.getScrollY());
-    const viewport_height: f64 = @floatFromInt(frame.window.getInnerHeight(frame));
-    if (y >= scroll_y and y <= scroll_y + viewport_height) {
-        return;
-    }
-    self.scrollIntoView(null, frame);
+    self.scrollClientRectIntoView(null, center_if_needed orelse false, frame) catch {};
+}
+
+// Shared by the DOM and CDP entry points. The optional rectangle is relative
+// to the element; only axes outside the viewport need to move. This uses the
+// existing window scroller, not a separate automation-only scroll state.
+pub fn scrollClientRectIntoView(self: *Element, relative_rect: ?DOMRect.Data, center: bool, frame: *Frame) !void {
+    if (!self.isVisible(frame) or self.isViewportFixed(frame)) return;
+    const owner = self.ownerFrame(frame) orelse return;
+    var rect = self.boundingClientRectValuesForVisible(owner);
+    if (relative_rect) |relative| {
+        if (!std.math.isFinite(relative.x) or !std.math.isFinite(relative.y) or
+            !std.math.isFinite(relative.width) or !std.math.isFinite(relative.height) or
+            relative.width < 0 or relative.height < 0) return error.InvalidParams;
+        rect.x += relative.x;
+        rect.y += relative.y;
+        rect.width = relative.width;
+        rect.height = relative.height;
+    }
+    const viewport = owner.page.getViewport();
+    const width: f64 = @floatFromInt(viewport.width);
+    const height: f64 = @floatFromInt(viewport.height);
+    const left = if (rect.x < 0 or rect.x + rect.width > width)
+        scrollOffset(@as(f64, @floatFromInt(owner.window.getScrollX())) + rect.x + if (center) (rect.width - width) / 2 else @as(f64, 0))
+    else
+        null;
+    const top = if (rect.y < 0 or rect.y + rect.height > height)
+        scrollOffset(@as(f64, @floatFromInt(owner.window.getScrollY())) + rect.y + if (center) (rect.height - height) / 2 else @as(f64, 0))
+    else
+        null;
+    try owner.window.scrollTo(.{ .opts = .{ .left = left, .top = top } }, null, owner);
+}
+
+fn scrollOffset(value: f64) i32 {
+    return @intFromFloat(std.math.clamp(value, 0, std.math.maxInt(i32)));
 }
 
 const ScrollIntoViewOpts = union {
@@ -2196,11 +2233,8 @@ pub fn scrollIntoView(self: *Element, opts: ?ScrollIntoViewOpts, frame: *Frame)
     // Convert supported positioned client coordinates back to document space.
     if (self.isViewportFixed(frame)) return;
     const owner = self.ownerFrame(frame) orelse return;
-    const y = if (self.positionedClientCoordinate(frame, .height)) |client_y|
-        client_y + @as(f64, @floatFromInt(owner.window.getScrollY()))
-    else
-        calculateDocumentPosition(self.asNode());
-    const target: i32 = @intFromFloat(std.math.clamp(y, 0, std.math.maxInt(i32)));
+    const y = self.clientCoordinate(owner, .height, null) + @as(f64, @floatFromInt(owner.window.getScrollY()));
+    const target = scrollOffset(y);
     owner.window.scrollTo(.{ .x = 0 }, target, owner) catch {};
 }
 
