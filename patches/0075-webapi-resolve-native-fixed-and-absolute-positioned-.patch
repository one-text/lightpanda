+fn positionedContainingBlock(self: *Element, frame: *Frame, fixed: bool) ?*Element {
+    var parent = layoutParent(self);
+    while (parent) |element| : (parent = layoutParent(element)) {
+        // Preserve the existing translateX subset; a transformed ancestor also
+        // establishes a containing block for fixed descendants.
+        if (element.inlineStyle(frame)) |style| {
+            const transform = style.asCSSStyleDeclaration().getPropertyValue("transform", frame);
+            if (transform.len > 0 and !std.ascii.eqlIgnoreCase(transform, "none")) return element;
+        }
+        if (!fixed and element.positionStyle(frame) != .static) return element;
+    }
+    return null;
+}
