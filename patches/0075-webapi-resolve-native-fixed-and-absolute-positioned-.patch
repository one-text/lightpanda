+// Resolve explicit fixed/absolute insets without replacing the renderless
+// flow model. Walk containing blocks iteratively so deeply nested page DOMs
+// cannot exhaust the native stack. Each axis may independently remain auto.
+pub const FlowPositions = std.AutoHashMapUnmanaged(*Element, f64);
+
+pub fn positionedClientCoordinate(self: *Element, frame: *Frame, comptime axis: Axis) ?f64 {
+    return self.positionedCoordinate(frame, axis, null);
+}
+
+// Hit testing already knows every ancestor's preorder position. Reuse those
+// values instead of recounting sibling subtrees for every positioned descendant.
+pub fn positionedCoordinate(self: *Element, frame: *Frame, comptime axis: Axis, flow_positions: ?*const FlowPositions) ?f64 {
+    const owner = self.ownerFrame(frame) orelse return null;
+    const manager = &owner._style_manager;
+    const window_scroll: f64 = @floatFromInt(if (axis == .width) owner.window.getScrollX() else owner.window.getScrollY());
+    var current = self;
+    var value: f64 = 0;
+    var positioned = false;
+
+    while (true) {
+        var anchor: ?*Element = current;
+        var p: StyleManager.Positioning = .{};
+        var inset: f64 = 0;
+        while (anchor) |element| : (anchor = layoutParent(element)) {
+            p = manager.positioning(element);
+            if (p.position != .absolute and p.position != .fixed) continue;
+            inset = (if (axis == .width) p.left else p.top) orelse continue;
+            break;
+        }
+        const element = anchor orelse {
+            if (!positioned) return null;
+            return value + current.flowCoordinate(frame, axis, flow_positions) - current.ancestorScroll(null, frame, axis) - window_scroll;
+        };
+        positioned = true;
+        if (current != element) {
+            value += current.flowCoordinate(frame, axis, flow_positions) - element.flowCoordinate(frame, axis, flow_positions);
+            value -= current.ancestorScroll(element, frame, axis);
+        }
+        value += inset;
+        if (axis == .width) value += element.translateX(frame);
+
+        const containing = element.positionedContainingBlock(frame, p.position == .fixed) orelse {
+            return value - if (p.position == .fixed) @as(f64, 0) else window_scroll;
+        };
+        if (!containing.isRootContainer()) {
+            value -= @as(f64, @floatFromInt(if (axis == .width) containing.getScrollLeft(frame) else containing.getScrollTop(frame)));
+        }
+        current = containing;
+    }
+}
+
+fn flowCoordinate(self: *Element, frame: *Frame, comptime axis: Axis, positions: ?*const FlowPositions) f64 {
+    if (axis == .width) return self.flowHorizontalPosition(frame);
+    if (positions) |known| {
+        if (known.get(self)) |value| return value;
+    }
+    return calculateDocumentPosition(self.asNode());
+}
+
+pub fn isViewportFixed(self: *Element, frame: *Frame) bool {
+    var current: ?*Element = self;
+    while (current) |element| : (current = layoutParent(element)) {
+        if (element.positionStyle(frame) == .fixed and element.positionedContainingBlock(frame, true) == null) return true;
+    }
+    return false;
+}
