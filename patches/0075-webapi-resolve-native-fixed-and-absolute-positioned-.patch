+fn translateX(self: *Element, frame: *Frame) f64 {
+    const style = self.inlineStyle(frame) orelse return 0;
+    return CSS.parseTranslateX(style.asCSSStyleDeclaration().getPropertyValue("transform", frame));
+}
+
+fn layoutParent(self: *Element) ?*Element {
+    var node = self.asNode().parentNode();
+    while (node) |parent| : (node = parent.parentNode()) {
+        if (parent.is(Element)) |element| return element;
+        if (parent.is(ShadowRoot)) |shadow| return shadow.getHost();
