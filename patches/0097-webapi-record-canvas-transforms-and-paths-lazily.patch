+const std = @import("std");
+const svg = @import("../svg/PathData.zig");
+pub const Matrix = svg.Matrix;
+pub const Point = svg.Point;
+pub const Bounds = svg.Bounds;
+
+pub fn finite(matrix: Matrix) bool {
+    inline for (std.meta.fields(Matrix)) |field| {
+        if (!std.math.isFinite(@field(matrix, field.name))) return false;
+    }
+    return true;
+}
+
+pub fn inverse(matrix: Matrix) ?Matrix {
+    const determinant = matrix.a * matrix.d - matrix.b * matrix.c;
+    if (determinant == 0 or !std.math.isFinite(determinant)) return null;
+    const result = Matrix{
+        .a = matrix.d / determinant,
+        .b = -matrix.b / determinant,
+        .c = -matrix.c / determinant,
+        .d = matrix.a / determinant,
+        .e = (matrix.c * matrix.f - matrix.d * matrix.e) / determinant,
+        .f = (matrix.b * matrix.e - matrix.a * matrix.f) / determinant,
+    };
+    return if (finite(result)) result else null;
+}
+
+pub fn rectangle(matrix: Matrix, x: f64, y: f64, w: f64, h: f64) ?Bounds {
+    inline for (.{ x, y, w, h }) |value| if (!std.math.isFinite(value)) return null;
+    var result: Bounds = .{};
+    for ([_]Point{ .{ .x = x, .y = y }, .{ .x = x + w, .y = y }, .{ .x = x + w, .y = y + h }, .{ .x = x, .y = y + h } }) |point| {
+        const transformed = matrix.apply(point);
+        if (!std.math.isFinite(transformed.x) or !std.math.isFinite(transformed.y)) return null;
+        result.include(transformed);
+    }
+    return result;
+}
