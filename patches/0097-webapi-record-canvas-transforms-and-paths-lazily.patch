+//! Geometry for the current path; no pixels are allocated while drawing.
+const std = @import("std");
+const svg = @import("../svg/PathData.zig");
+const geometry = @import("geometry.zig");
+const Allocator = std.mem.Allocator;
+pub const Point = geometry.Point;
+pub const Rule = enum { nonzero, evenodd };
+pub const Cap = enum { butt, round, square };
+pub const Vertex = struct { point: Point, move: bool = false };
+const Path = @This();
+
+vertices: std.ArrayList(Vertex) = .empty,
+current: ?Point = null,
+start: ?Point = null,
+
+pub fn reset(self: *Path) void {
+    self.vertices.clearRetainingCapacity();
+    self.current = null;
+    self.start = null;
+}
+
+pub fn move(self: *Path, point: Point, allocator: Allocator) !void {
+    if (!finite(point)) return;
+    // Repeated moveTo replaces an empty subpath rather than growing history.
+    if (self.vertices.items.len > 0 and self.vertices.items[self.vertices.items.len - 1].move) {
+        self.vertices.items[self.vertices.items.len - 1].point = point;
+    } else try self.vertices.append(allocator, .{ .point = point, .move = true });
+    self.current = point;
+    self.start = point;
+}
+
+pub fn line(self: *Path, point: Point, allocator: Allocator) !void {
+    if (!finite(point)) return;
+    if (self.current == null) return self.move(point, allocator);
+    try self.vertices.append(allocator, .{ .point = point });
+    self.current = point;
+}
+
+pub fn close(self: *Path, allocator: Allocator) !void {
+    const first = self.start orelse return;
+    if (self.vertices.items[self.vertices.items.len - 1].move) return;
+    try self.line(first, allocator);
+    try self.move(first, allocator);
+}
+
+pub fn curve(self: *Path, segment: svg.Segment, allocator: Allocator, scratch: Allocator) !void {
+    var points: std.ArrayList(Point) = .empty;
+    defer points.deinit(scratch);
+    try svg.flatten(segment, &points, scratch);
