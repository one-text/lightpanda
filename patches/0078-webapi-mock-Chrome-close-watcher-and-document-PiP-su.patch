+const std = @import("std");
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Page = @import("../Page.zig");
+const Event = @import("Event.zig");
+const EventTarget = @import("EventTarget.zig");
+const DOMException = @import("DOMException.zig");
+const AbortSignal = @import("AbortSignal.zig");
+const Window = @import("Window.zig");
+const Events = @import("media_events.zig");
+const Speech = @import("SpeechSynthesis.zig");
+const Conversion = @import("media_constraints.zig");
+
+const CloseWatcher = @This();
+pub fn registerTypes() []const type {
+    return &.{ CloseWatcher, PictureInPicture, PictureInPictureEvent };
+}
+pub const Proto = EventTarget;
+_proto: *EventTarget,
+_arena: *lp.Arena,
+_rc: lp.RC = .{},
+_events: Events,
+_handlers: [2]Speech.Handler = undefined,
+_signal: ?*AbortSignal = null,
+_closed: bool = false,
+_requesting: bool = false,
+
+fn init(input: ?js.Value, exec: *js.Execution) !*CloseWatcher {
+    var signal: ?*AbortSignal = null;
+    if (try Conversion.dictionary(input)) |options| {
+        const value = try options.get("signal");
+        if (!value.isUndefined()) signal = try value.toZig(*AbortSignal);
+    }
+    const arena = try exec.getArena(.small, "CloseWatcher");
+    var owned = true;
+    errdefer if (owned) arena.release();
+    const self = try exec._factory.eventTargetWithAllocator(arena.allocator(), CloseWatcher{
+        ._proto = undefined,
+        ._arena = arena,
+        ._rc = lp.RC.init(1),
+        ._events = .init(arena),
+        ._signal = signal,
+    });
+    self._events.handlers(&self._handlers, &.{ "cancel", "close" }, self._proto);
+    owned = false;
+    defer self.releaseRef(exec.page);
+    const local = exec.js.local.?;
+    const data = try Speech.callbackData(self._proto, local);
+    if (signal) |s| {
+        // A JS edge keeps the signal alive without rooting callback cycles.
+        if (!(data.defineOwnProperty("signal", try local.zigValueToJs(s, .{}), 0) orelse false)) return error.JsException;
+    }
+    return self;
+}
+pub fn acquireRef(self: *CloseWatcher) void {
+    self._rc.acquire();
+}
+pub fn releaseRef(self: *CloseWatcher, page: *Page) void {
+    self._rc.release(self, page);
+}
+pub fn deinit(self: *CloseWatcher, _: *Page) void {
+    self._events.deinit(&self._handlers);
+    self._arena.release();
+}
+fn active(self: *const CloseWatcher) bool {
+    return !self._closed and (self._signal == null or !self._signal.?._aborted);
+}
+fn destroy(self: *CloseWatcher) void {
+    self._closed = true;
+}
+fn close(self: *CloseWatcher, exec: *js.Execution) !void {
+    if (!self.active() or self._requesting) return;
+    self.destroy();
+    try self._events.dispatch(try Event.initTrusted(comptime .wrap("close"), .{}, exec.page), exec);
+}
+fn requestClose(self: *CloseWatcher, exec: *js.Execution) !void {
+    if (!self.active() or self._requesting) return;
+    {
+        self._requesting = true;
+        defer self._requesting = false;
+        // Passive mock: no history-action activation or platform close requests.
+        try self._events.dispatch(try Event.initTrusted(comptime .wrap("cancel"), .{}, exec.page), exec);
+    }
+    try self.close(exec);
+}
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(CloseWatcher);
+    pub const Meta = struct {
+        pub const name = "CloseWatcher";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const constructor = bridge.constructor(init, .{});
+    pub const requestClose = bridge.function(CloseWatcher.requestClose, .{});
+    pub const close = bridge.function(CloseWatcher.close, .{});
+    pub const destroy = bridge.function(CloseWatcher.destroy, .{});
+    pub const oncancel = bridge.accessor(Speech.Binding(CloseWatcher, 0).get, Speech.Binding(CloseWatcher, 0).set, .{});
+    pub const onclose = bridge.accessor(Speech.Binding(CloseWatcher, 1).get, Speech.Binding(CloseWatcher, 1).set, .{});
+};
+
+pub const PictureInPicture = struct {
+    pub const Proto = EventTarget;
+    _proto: *EventTarget,
+    _arena: *lp.Arena,
+    _rc: lp.RC = .{},
+    _events: Events,
+    _handlers: [1]Speech.Handler = undefined,
+
+    pub fn init(exec: *js.Execution) !*PictureInPicture {
+        const arena = try exec.getArena(.small, "DocumentPictureInPicture");
+        errdefer arena.release();
+        const self = try exec._factory.eventTargetWithAllocator(arena.allocator(), PictureInPicture{
+            ._proto = undefined,
+            ._arena = arena,
+            ._events = .init(arena),
+        });
+        self._events.handlers(&self._handlers, &.{"enter"}, self._proto);
+        return self;
+    }
+    pub fn acquireRef(self: *PictureInPicture) void {
+        self._rc.acquire();
+    }
+    pub fn releaseRef(self: *PictureInPicture, page: *Page) void {
+        self._rc.release(self, page);
+    }
+    pub fn deinit(self: *PictureInPicture, _: *Page) void {
+        self._events.deinit(&self._handlers);
+        self._arena.release();
+    }
+    fn getWindow(_: *const PictureInPicture) ?*Window {
+        return null;
+    }
+    fn requestWindow(_: *PictureInPicture, input: ?js.Value, exec: *js.Execution) !js.Promise {
+        const local = exec.js.local.?;
+        var caught: js.TryCatch = undefined;
+        caught.init(local);
+        defer caught.deinit();
+        validate(input) catch |err| {
+            if (err == error.ExecutionTerminated or exec.js.env.terminatePending()) return error.ExecutionTerminated;
+            if (caught.exceptionValue()) |exception| {
+                const resolver = local.createPromiseResolver();
+                try resolver.rejectValue(exception);
+                return resolver.promise();
+            }
+            return err;
+        };
+        // No user activation or PiP window backend: model the passive Chrome path.
+        const resolver = local.createPromiseResolver();
+        resolver.reject("documentPictureInPicture.requestWindow", try exec._factory.create(DOMException.init("Document PiP requires user activation", "NotAllowedError")));
+        return resolver.promise();
+    }
+    fn validate(input: ?js.Value) !void {
+        const options = try Conversion.dictionary(input) orelse return;
+        _ = (try options.get("disallowReturnToOpener")).toBool();
+        try dimension(try options.get("height"));
+        _ = (try options.get("preferInitialWindowPlacement")).toBool();
+        try dimension(try options.get("width"));
+    }
+    fn dimension(value: js.Value) !void {
+        if (value.isUndefined()) return;
+        const number = @trunc(try value.toZig(f64));
+        if (!std.math.isFinite(number) or number < 0 or number >= 18446744073709551616.0) return error.TypeError;
+    }
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(PictureInPicture);
+        pub const Meta = struct {
+            pub const name = "DocumentPictureInPicture";
+            pub const prototype_chain = bridge.prototypeChain();
+            pub var class_id: bridge.ClassId = undefined;
+        };
+        pub const requestWindow = bridge.function(PictureInPicture.requestWindow, .{});
+        pub const window = bridge.accessor(PictureInPicture.getWindow, null, .{});
+        pub const onenter = bridge.accessor(Speech.Binding(PictureInPicture, 0).get, Speech.Binding(PictureInPicture, 0).set, .{});
+    };
+};
+
+pub const PictureInPictureEvent = struct {
+    pub const Proto = Event;
+    _proto: *Event,
+    _window: *Window,
+    const Options = Event.inheritOptions(PictureInPictureEvent, struct { window: *Window });
+
+    fn init(typ: []const u8, options: Options, exec: *js.Execution) !*PictureInPictureEvent {
+        const arena = try exec.getArena(.tiny, "DocumentPictureInPictureEvent");
+        errdefer arena.release();
+        const event = try exec._factory.event(arena, try lp.String.init(arena.allocator(), typ, .{}), PictureInPictureEvent{
+            ._proto = undefined,
+            ._window = options.window,
+        });
+        Event.populatePrototypes(event, options, false);
+        return event;
+    }
+    pub fn asEvent(self: *PictureInPictureEvent) *Event {
+        return self._proto;
+    }
+    fn getWindow(self: *const PictureInPictureEvent) *Window {
+        return self._window;
+    }
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(PictureInPictureEvent);
+        pub const Meta = struct {
+            pub const name = "DocumentPictureInPictureEvent";
+            pub const prototype_chain = bridge.prototypeChain();
+            pub var class_id: bridge.ClassId = undefined;
+        };
+        pub const constructor = bridge.constructor(PictureInPictureEvent.init, .{});
+        pub const window = bridge.accessor(PictureInPictureEvent.getWindow, null, .{});
+    };
+};
+
+// Preserve native descriptors across the initial opaque -> real origin change.
+pub fn expose(ctx: *js.Context, context: *const js.v8.Context, global: *const js.v8.Object, secure: bool) !void {
+    if (ctx.pip_bindings != null and secure == !ctx.pip_hidden) return;
+    const v8 = js.v8;
+    const isolate = ctx.isolate;
+    const names = .{ "DocumentPictureInPicture", "DocumentPictureInPictureEvent", "documentPictureInPicture", "documentPictureInPicture" };
+    if (ctx.pip_bindings == null) {
+        // Capture before page code can replace Window or Object.
+        const constructor = v8.v8__Object__Get(global, context, isolate.initStringHandle("Window")) orelse return error.JsException;
+        const prototype = v8.v8__Object__Get(@ptrCast(constructor), context, isolate.initStringHandle("prototype")) orelse return error.JsException;
+        const targets = [_]*const v8.Object{ global, global, global, @ptrCast(prototype) };
+        var bindings: [6]v8.Global = @splat(.{ .data_ptr = 0 });
+        errdefer for (&bindings) |*binding| v8.v8__Global__Reset(binding);
+        inline for (names, 0..) |name, i| {
+            const descriptor = v8.v8__Object__GetOwnPropertyDescriptor(targets[i], context, isolate.initStringHandle(name)) orelse return error.JsException;
+            v8.v8__Global__New(isolate.handle, descriptor, &bindings[i]);
+        }
+        const object = v8.v8__Object__Get(global, context, isolate.initStringHandle("Object")) orelse return error.JsException;
+        const define = v8.v8__Object__Get(@ptrCast(object), context, isolate.initStringHandle("defineProperty")) orelse return error.JsException;
+        v8.v8__Global__New(isolate.handle, define, &bindings[4]);
+        v8.v8__Global__New(isolate.handle, prototype, &bindings[5]);
+        ctx.pip_bindings = bindings;
+    }
+    if (secure == !ctx.pip_hidden) return;
+    const prototype: *const v8.Object = @ptrCast(v8.v8__Global__Get(&ctx.pip_bindings.?[5], isolate.handle).?);
+    const targets = [_]*const v8.Object{ global, global, global, prototype };
+    inline for (names, 0..) |name, i| {
+        const key = isolate.initStringHandle(name);
+        if (secure) {
+            const descriptor = v8.v8__Global__Get(&ctx.pip_bindings.?[i], isolate.handle).?;
+            // Global interfaces can mirror the accessor only on the instance.
+            if (!v8.v8__Value__IsUndefined(descriptor)) {
+                const args = [_]?*const v8.Value{ @ptrCast(targets[i]), key, descriptor };
+                const define: *const v8.Function = @ptrCast(v8.v8__Global__Get(&ctx.pip_bindings.?[4], isolate.handle).?);
+                _ = v8.v8__Function__Call(define, context, @ptrCast(global), args.len, &args) orelse return error.JsException;
+            }
+        } else {
+            var result: v8.MaybeBool = undefined;
+            v8.v8__Object__Delete(targets[i], context, key, &result);
+            if (!result.has_value or !result.value) return error.JsException;
+        }
+    }
+    ctx.pip_hidden = !secure;
+}
