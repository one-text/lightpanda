 const CONTEXT_GROUP_ID = 1;
 const CLIENT_TRUST_LEVEL = 1;
 
+// V8's default Error mirror reads .stack even without a preview. Limit the
+// embedder description override to this synchronous console argument wrap.
+threadlocal var console_error: ?struct {
+    client: *v8.InspectorClientImpl,
+    value: *const v8.Value,
+} = null;
+
+pub fn isConsoleError(client: *v8.InspectorClientImpl, value: *const v8.Value) bool {
+    const current = console_error orelse return false;
+    return current.client == client and v8.v8__Value__StrictEquals(current.value, value);
+}
+
 // Inspector exists for the lifetime of the Isolate/Env. 1 Isolate = 1 Inspector.
 // It combines the v8.Inspector and the v8.InspectorClientImpl. The v8.InspectorClientImpl
 // is our own implementation that fulfills the InspectorClient API, i.e. it's the
@@ -293,6 +306,23 @@ pub const Session = struct {
         );
     }
 
+    pub fn getConsoleRemoteObject(self: *const Session, local: *const js.Local, value: js.Value) !RemoteObject {
+        if (!value.isNativeError()) return self.getRemoteObject(local, "console", value);
+
+        const previous = console_error;
+        console_error = .{ .client = self.inspector.client, .value = value.handle };
+        defer console_error = previous;
+
+        const remote_object = try self.getRemoteObject(local, "console", value);
+        errdefer remote_object.deinit();
+        const description = try std.fmt.allocPrint(local.call_arena, "{f}", .{value});
+        v8.v8_inspector__RemoteObject__setDescription(remote_object.handle, .{
+            .ptr = description.ptr,
+            .len = description.len,
+        });
+        return remote_object;
+    }
+
     fn wrapObject(
         self: Session,
         isolate: *v8.Isolate,
