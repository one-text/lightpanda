+                    {
+                        name = @ptrCast(own_name);
+                    }
                 }
+                try self.writeString(name, writer);
+                const message = self.ownDataProperty(@ptrCast(handle), "message") orelse return;
+                // Like the inspector, describe only strings; coercing arbitrary
+                // messages can run JS or recurse through cyclic Error objects.
+                if (!v8.v8__Value__IsString(message) or v8.v8__String__Length(@ptrCast(message)) == 0) return;
                 try writer.writeAll(": ");
-                return self.write(message, writer);
+                return self.writeString(@ptrCast(message), writer);
             }
             if (v8.v8__Value__IsObject(handle)) {
                 try writer.writeAll("[object ");
