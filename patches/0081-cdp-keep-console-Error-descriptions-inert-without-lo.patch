+                var name = v8.v8__Object__GetConstructorName(@ptrCast(handle)).?;
+                if (self.ownDataProperty(@ptrCast(handle), "name")) |own_name| {
+                    if (v8.v8__Value__IsString(own_name) and v8.v8__String__Length(@ptrCast(own_name)) > 0 and
