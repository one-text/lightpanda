+// Keep the native owner alive until the context is destroyed after cancellation.
+pub fn cancel(self: *ExtendableEvent) void {
+    self._cancelled = true;
+    self._on_done = null;
+}
+
 fn onSettled(self: *ExtendableEvent, _: ?js.Value) void {
+    if (self._cancelled) return;
     self.settle();
