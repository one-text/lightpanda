+const lp = @import("lightpanda");
+const js = @import("../../js/js.zig");
+const Page = @import("../../Page.zig");
+const Event = @import("../Event.zig");
+const ExtendableEvent = @import("ExtendableEvent.zig");
+const MessagePort = @import("../MessagePort.zig");
+const ServiceWorker = @import("../ServiceWorker.zig");
+
+const ExtendableMessageEvent = @This();
+pub const Proto = ExtendableEvent;
+
+_proto: *ExtendableEvent,
+_data: ?js.Value.Global = null,
+_origin: []const u8 = "",
+_last_event_id: []const u8 = "",
+_source: ?Source = null,
+_ports: []const *MessagePort = &.{},
+
+// Client sources are added with the client reply path, not inferred here.
+pub const Source = union(enum) {
+    worker: *ServiceWorker,
+    port: *MessagePort,
+};
+
+const Options = Event.inheritOptions(ExtendableMessageEvent, struct {
+    data: ?js.Value = null,
+    lastEventId: []const u8 = "",
+    origin: []const u8 = "",
+    ports: []const *MessagePort = &.{},
+    source: ?Source = null,
+});
+
+pub fn init(typ: []const u8, opts: ?Options, page: *Page) !*ExtendableMessageEvent {
+    const arena = try page.getArena(.small, "ExtendableMessageEvent");
+    errdefer arena.release();
+    return initWithTrusted(arena, try lp.String.init(arena.allocator(), typ, .{}), opts, false, page);
+}
+
+// On success the event takes ownership of the already-cloned payload.
+pub fn initTrusted(typ: lp.String, data: ?js.Value.Global, page: *Page) !*ExtendableMessageEvent {
+    const arena = try page.getArena(.small, "ExtendableMessageEvent.trusted");
+    errdefer arena.release();
+    const event = try initWithTrusted(arena, typ, null, true, page);
+    event._data = data;
+    return event;
+}
+
+fn initWithTrusted(arena: *lp.Arena, typ: lp.String, opts_: ?Options, trusted: bool, page: *Page) !*ExtendableMessageEvent {
+    const opts = opts_ orelse Options{};
+    const event = try page.factory.extendableEvent(arena, typ, ExtendableMessageEvent{
+        ._proto = undefined,
+        ._origin = try arena.dupe(u8, opts.origin),
+        ._last_event_id = try arena.dupe(u8, opts.lastEventId),
+        ._source = opts.source,
+        ._ports = try arena.dupe(*MessagePort, opts.ports),
+    });
+    Event.populatePrototypes(event, opts, trusted);
+    // Dictionary conversion and native allocation have both succeeded. Until
+    // here constructor data stays local, including on invalid later fields.
+    if (opts.data) |data| event._data = try data.persist();
+    return event;
+}
+
+pub fn deinit(self: *ExtendableMessageEvent, page: *Page) void {
+    if (self._data) |data| data.release();
+    self._proto.deinit(page);
+}
+
+pub fn acquireRef(self: *ExtendableMessageEvent) void {
+    self._proto.acquireRef();
+}
+
+pub fn releaseRef(self: *ExtendableMessageEvent, page: *Page) void {
+    self.asEvent()._rc.release(self, page);
+}
+
+pub fn asEvent(self: *ExtendableMessageEvent) *Event {
+    return self._proto.asEvent();
+}
+
+fn getData(self: *const ExtendableMessageEvent) ?js.Value.Global {
+    return self._data;
+}
+
+fn getOrigin(self: *const ExtendableMessageEvent) []const u8 {
+    return self._origin;
+}
+
+fn getLastEventId(self: *const ExtendableMessageEvent) []const u8 {
+    return self._last_event_id;
+}
+
+fn getSource(self: *const ExtendableMessageEvent) ?Source {
+    return self._source;
+}
+
+fn getPorts(self: *const ExtendableMessageEvent, exec: *js.Execution) !js.Value {
+    const local = exec.js.local.?;
+    const ports = try local.zigValueToJs(self._ports, .{});
+    const freeze = js.Function{ .local = local, .handle = @ptrCast(js.v8.v8__Global__Get(&exec.js.object_freeze, local.isolate.handle).?) };
+    return freeze.call(js.Value, .{ports});
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(ExtendableMessageEvent);
+    pub const Meta = struct {
+        pub const name = "ExtendableMessageEvent";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const constructor = bridge.constructor(ExtendableMessageEvent.init, .{});
+    pub const data = bridge.accessor(ExtendableMessageEvent.getData, null, .{});
+    pub const origin = bridge.accessor(ExtendableMessageEvent.getOrigin, null, .{});
+    pub const lastEventId = bridge.accessor(ExtendableMessageEvent.getLastEventId, null, .{});
+    pub const source = bridge.accessor(ExtendableMessageEvent.getSource, null, .{});
+    pub const ports = bridge.accessor(ExtendableMessageEvent.getPorts, null, .{});
+};
