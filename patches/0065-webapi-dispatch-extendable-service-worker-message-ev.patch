@@ -493,6 +508,44 @@ fn drainPendingMessages(self: *ServiceWorkerGlobalScope) void {
     self._pending_messages.clearRetainingCapacity();
 }
 
+const PendingMessageEvent = struct {
+    node: std.DoublyLinkedList.Node = .{},
+    scope: *ServiceWorkerGlobalScope,
+    event: *ExtendableMessageEvent,
+    wrapper: js.Value.Global,
+
+    fn done(ctx: *anyopaque) void {
+        const self: *PendingMessageEvent = @ptrCast(@alignCast(ctx));
+        self.release();
+    }
+
+    fn release(self: *PendingMessageEvent) void {
+        self.scope._message_events.remove(&self.node);
+        self.wrapper.release();
+        // This can also free self, allocated in the event's arena.
+        self.event.releaseRef(self.scope._proto.page);
+    }
+};
+
+fn dispatchMessage(self: *ServiceWorkerGlobalScope, event: *ExtendableMessageEvent, handler: ?js.Function.Global) !void {
+    const wgs = self._proto;
+    event.acquireRef();
+    const pending = blk: {
+        errdefer event.releaseRef(wgs.page);
+        const pending = try event.asEvent()._arena.create(PendingMessageEvent);
+        var ls: js.Local.Scope = undefined;
+        wgs.js.localScope(&ls);
+        defer ls.deinit();
+        const wrapper = try ls.local.zigValueToJs(event, .{});
+        pending.* = .{ .scope = self, .event = event, .wrapper = try wrapper.persist() };
+        self._message_events.append(&pending.node);
+        break :blk pending;
+    };
+    // Even an interrupted dispatch may already have accepted lifetime promises.
+    defer event._proto.seal(.{ .ctx = pending, .func = PendingMessageEvent.done });
+    try wgs.dispatch(wgs.asEventTarget(), event.asEvent(), handler, .{});
+}
+
 const ReceiveMessageCallback = struct {
     data: ?js.Value.Global,
     arena: *lp.Arena,
@@ -512,34 +565,27 @@ const ReceiveMessageCallback = struct {
 
     fn run(ctx: *anyopaque) !?u32 {
         const self: *ReceiveMessageCallback = @ptrCast(@alignCast(ctx));
-        defer self.deinit();
+        defer cancelled(ctx);
 
         const wgs = self.worker_scope._proto;
         const target = wgs.asEventTarget();
 
-        const data = self.data orelse {
+        _ = self.data orelse {
             if (wgs._event_manager.hasDirectListeners(target, "messageerror", null)) {
-                const event = (try MessageEvent.initTrusted(comptime .wrap("messageerror"), .{
-                    .bubbles = false,
-                    .cancelable = false,
-                }, wgs.page)).asEvent();
-                try wgs.dispatch(target, event, null, .{});
+                const event = try ExtendableMessageEvent.initTrusted(comptime .wrap("messageerror"), null, wgs.page);
+                try self.worker_scope.dispatchMessage(event, null);
             }
             return null;
         };
 
         const on_message = self.worker_scope._on_message;
         if (wgs._event_manager.hasDirectListeners(target, "message", on_message) == false) {
-            data.release();
             return null;
         }
 
-        const event = (try MessageEvent.initTrusted(comptime .wrap("message"), .{
-            .data = .{ .value = self.data.? },
-            .bubbles = false,
-            .cancelable = false,
-        }, wgs.page)).asEvent();
-        try wgs.dispatch(target, event, on_message, .{});
+        const event = try ExtendableMessageEvent.initTrusted(comptime .wrap("message"), self.data, wgs.page);
+        self.data = null; // the event now owns the structured-cloned payload
+        try self.worker_scope.dispatchMessage(event, on_message);
         return null;
     }
 };
