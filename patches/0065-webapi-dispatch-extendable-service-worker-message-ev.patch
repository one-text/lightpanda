+pub fn extendableEvent(_: *const Factory, arena: *lp.Arena, typ: String, child: anytype) !*@TypeOf(child) {
+    const chain = try PrototypeChain(
+        &.{ Event, @import("webapi/event/ExtendableEvent.zig"), @TypeOf(child) },
