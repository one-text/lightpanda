+const js = @import("../js/js.zig");
+const std = @import("std");
+const PluginArray = @import("PluginArray.zig");
+const MimeType = @import("MimeType.zig");
+
+const Plugin = @This();
+
+_array: *PluginArray,
+_name: []const u8,
+
+pub fn creationContext(self: *const Plugin, local: *const js.Local) *const js.v8.Context {
+    return self._array.creationContext(local);
+}
+
+pub fn getName(self: *const Plugin) []const u8 {
+    return self._name;
+}
+
+pub fn getFilename(_: *const Plugin) []const u8 {
+    return "internal-pdf-viewer";
+}
+
+pub fn getDescription(_: *const Plugin) []const u8 {
+    return "Portable Document Format";
+}
+
+pub fn getLength(_: *const Plugin) u32 {
+    return MimeType.names.len;
+}
+
+pub fn getAtIndex(self: *Plugin, index: u32) !?*MimeType {
+    if (index >= MimeType.names.len) return null;
+    // Chromium's DOMPlugin creates a new DOMMimeType on every lookup.
+    return self._array._factory.create(MimeType{ ._plugin = self, ._index = index });
+}
+
+pub fn getByName(self: *Plugin, name: []const u8) !?*MimeType {
+    for (MimeType.names, 0..) |supported, i| {
+        if (std.mem.eql(u8, name, supported)) return self.getAtIndex(@intCast(i));
+    }
+    return null;
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(Plugin);
+    const Collection = @import("pdf_collection.zig").Binding(Plugin, MimeType, &MimeType.names);
