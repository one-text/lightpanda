+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Page = @import("../Page.zig");
+const Plugin = @import("Plugin.zig");
+
+const MimeType = @This();
+
+pub const names = [_][]const u8{ "application/pdf", "text/pdf" };
+
+_plugin: *Plugin,
+_index: u32,
+_cached: bool = false,
+_rc: lp.RC = .{},
+
+pub fn acquireRef(self: *MimeType) void {
+    self._rc.acquire();
+}
+
+pub fn releaseRef(self: *MimeType, page: *Page) void {
+    self._rc.release(self, page);
+}
+
+pub fn deinit(self: *MimeType, page: *Page) void {
+    page.factory.destroyStandalone(self);
+}
+
+fn hasFinalizer(self: *const MimeType) bool {
+    // The two global entries are arena-owned and strongly identity-cached.
+    // Plugin-level entries use the factory and weak-wrapper finalization.
+    return !self._cached;
+}
+
+pub fn creationContext(self: *const MimeType, local: *const js.Local) *const js.v8.Context {
+    return self._plugin.creationContext(local);
+}
+
+pub fn getType(self: *const MimeType) []const u8 {
+    return names[self._index];
+}
+
+pub fn getSuffixes(_: *const MimeType) []const u8 {
+    return "pdf";
+}
+
+pub fn getDescription(_: *const MimeType) []const u8 {
+    return "Portable Document Format";
+}
+
+pub fn getEnabledPlugin(self: *const MimeType) ?*Plugin {
+    return if (self._plugin._array._frame != null) self._plugin else null;
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(MimeType);
+
+    pub const Meta = struct {
+        pub const name = "MimeType";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+        pub const creation_context = MimeType.creationContext;
+        pub const has_finalizer = MimeType.hasFinalizer;
+    };
+
+    pub const @"type" = bridge.accessor(MimeType.getType, null, .{});
+    pub const suffixes = bridge.accessor(MimeType.getSuffixes, null, .{});
+    pub const description = bridge.accessor(MimeType.getDescription, null, .{});
+    pub const enabledPlugin = bridge.accessor(MimeType.getEnabledPlugin, null, .{});
+};
