+pub fn creationContext(self: *const Navigator, local: *const js.Local) *const js.v8.Context {
+    if (local.ctx.identity.identity_map.getPtr(@intFromPtr(self))) |global| {
+        const wrapper = js.v8.v8__Global__Get(global, local.isolate.handle).?;
+        return js.v8.v8__Object__GetCreationContext(@ptrCast(wrapper)).?;
+    }
+    if (!self._pdf_detached) {
+        if (self._frame) |frame| {
+            if (local.ctx.identity == frame.js.identity) {
+                return @ptrCast(js.v8.v8__Global__Get(&frame.js.handle, local.isolate.handle).?);
+            }
+        }
+    }
+    return local.handle;
+}
+
+fn getPlugins(self: *Navigator) !*PluginArray {
+    if (self._plugins) |plugins| return plugins;
+    const plugins = try PluginArray.init(self._frame.?, self);
+    if (self._pdf_detached) plugins._frame = null;
+    self._plugins = plugins;
+    return plugins;
+}
+
+fn getMimeTypes(self: *Navigator) !*MimeTypeArray {
+    if (self._mime_types) |mimes| return mimes;
+    const mimes = try MimeTypeArray.init(try self.getPlugins());
+    self._mime_types = mimes;
+    return mimes;
+}
+
+fn getPdfViewerEnabled(_: *const Navigator) bool {
+    return true;
+}
+
+pub fn detachPdf(self: *Navigator) void {
+    self._pdf_detached = true;
+    if (self._plugins) |plugins| plugins._frame = null;
 }
 
 fn getPermissions(self: *Navigator) *Permissions {
