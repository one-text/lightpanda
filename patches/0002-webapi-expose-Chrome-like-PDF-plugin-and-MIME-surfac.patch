+const std = @import("std");
+const js = @import("../js/js.zig");
+const Frame = @import("../Frame.zig");
+
+// The three PDF legacy collections share the same Web IDL property policy.
+pub fn Binding(comptime T: type, comptime Item: type, comptime names: []const []const u8) type {
+    return struct {
+        const bridge = js.Bridge(T);
+
+        pub const indexed = bridge.indexedFull(getAtIndex, setAtIndex, deleteAtIndex, queryAtIndex, defineAtIndex, getIndexes, .{});
+        pub const named = bridge.namedIndexedFull(getByName, null, deleteByName, getNames, queryByName, defineByName, describeByName, .{});
+        pub const item = bridge.function(itemImpl, .{});
+        pub const namedItem = bridge.function(namedItemImpl, .{});
+
+        fn lookup(self: *T, index: u32) !?*Item {
+            const result = self.getAtIndex(index);
+            return switch (@typeInfo(@TypeOf(result))) {
+                .error_union => try result,
+                else => result,
+            };
+        }
+
+        fn nameIndex(name: []const u8) ?u32 {
+            for (names, 0..) |supported, i| {
+                if (std.mem.eql(u8, name, supported)) return @intCast(i);
+            }
+            return null;
+        }
+
+        fn itemImpl(self: *T, index: js.Value) !?*Item {
+            // V8 ToUint32 implements Web IDL wraparound and rejects BigInt.
+            return lookup(self, try index.toU32());
+        }
+
+        fn namedItemImpl(self: *T, name: js.Value) !?*Item {
+            // The general bridge string conversion accepts Symbols; DOMString
+            // does not. Keep this correction local to the PDF interfaces.
+            if (name.isSymbol()) return error.TypeError;
+            const index = nameIndex(try name.toStringSlice()) orelse return null;
+            return lookup(self, index);
+        }
+
+        fn getAtIndex(self: *T, index: u32) !*Item {
+            return (try lookup(self, index)) orelse error.NotHandled;
+        }
+
+        fn getByName(self: *T, name: []const u8) !*Item {
+            return getAtIndex(self, nameIndex(name) orelse return error.NotHandled);
+        }
+
+        fn setAtIndex(_: *T, _: u32, _: js.Value) bool {
+            return false;
+        }
+
+        fn defineAtIndex(_: *T, _: u32) bool {
+            return false;
+        }
+
+        fn queryAtIndex(_: *T, index: u32) !u32 {
+            if (index < names.len) return js.v8.ReadOnly;
+            return error.NotHandled;
+        }
+
+        fn deleteAtIndex(_: *T, index: u32) !bool {
+            if (index < names.len) return false;
+            return error.NotHandled;
+        }
+
+        fn queryByName(_: *T, name: []const u8) !u32 {
+            // Like HTMLCollection, allow [[Set]] through derived receivers;
+            // the descriptor and definer enforce readonly on the collection.
+            if (nameIndex(name) != null) return js.v8.DontEnum;
+            return error.NotHandled;
+        }
+
+        fn defineByName(_: *T, name: []const u8) !bool {
+            if (nameIndex(name) != null) return false;
+            return error.NotHandled;
+        }
+
+        fn deleteByName(_: *T, name: []const u8) !bool {
+            if (nameIndex(name) != null) return false;
+            return error.NotHandled;
+        }
+
+        const Descriptor = struct {
+            value: *Item,
+            writable: bool = false,
+            enumerable: bool = false,
+            configurable: bool = true,
+        };
+
+        fn describeByName(self: *T, name: []const u8) !Descriptor {
+            return .{ .value = try getByName(self, name) };
+        }
+
+        fn getIndexes(_: *T, frame: *Frame) !js.Array {
+            var arr = frame.js.local.?.newArray(names.len);
+            for (0..names.len) |i| {
+                _ = try arr.set(@intCast(i), i, .{});
+            }
+            return arr;
+        }
+
+        fn getNames(_: *T, frame: *Frame) !js.Array {
+            var arr = frame.js.local.?.newArray(names.len);
+            for (names, 0..) |name, i| {
+                _ = try arr.set(@intCast(i), name, .{});
+            }
+            return arr;
+        }
+    };
+}
