@@ -341,6 +342,18 @@ fn createSnapshotContext(
             }
         }
 
+        if (comptime @hasDecl(JsApi.Meta, "array_iterator") and JsApi.Meta.array_iterator) {
+            // Use the realm's intrinsic, not a custom callback or injected JS.
+            const array = v8.v8__Array__New(isolate, 0).?;
+            const array_proto = v8.v8__Object__GetPrototype(@ptrCast(array)).?;
+            const values_key = v8.v8__String__NewFromUtf8(isolate, "values", v8.kNormal, 6);
+            const values = v8.v8__Object__Get(@ptrCast(array_proto), context, values_key) orelse return error.IteratorLookupFailed;
+            const proto = v8.v8__Object__Get(@ptrCast(func), context, prototype_key) orelse return error.PrototypeLookupFailed;
+            var result: v8.MaybeBool = undefined;
+            v8.v8__Object__DefineOwnProperty(@ptrCast(proto), context, @ptrCast(v8.v8__Symbol__GetIterator(isolate)), values, v8.DontEnum, &result);
+            if (!result.has_value or !result.value) return error.IteratorInstallFailed;
+        }
+
         // WebIDL [Exposed=...] gating. Members are installed on the shared
         // FunctionTemplate by attachClass; here we delete the ones that don't
         // match this realm from the per-context Func.prototype.
