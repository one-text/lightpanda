+const js = @import("../js/js.zig");
+const std = @import("std");
+const PluginArray = @import("PluginArray.zig");
+const MimeType = @import("MimeType.zig");
+
+const MimeTypeArray = @This();
+
+_plugins: *PluginArray,
+_mimes: [MimeType.names.len]*MimeType,
+
+pub fn init(plugins: *PluginArray) !*MimeTypeArray {
+    const self = try plugins._arena.create(MimeTypeArray);
+    self._plugins = plugins;
+    const first = plugins._plugins[0];
+    for (0..MimeType.names.len) |i| {
+        const mime = try plugins._arena.create(MimeType);
+        mime.* = .{ ._plugin = first, ._index = @intCast(i), ._cached = true };
+        self._mimes[i] = mime;
+    }
+    return self;
+}
+
+pub fn creationContext(self: *const MimeTypeArray, local: *const js.Local) *const js.v8.Context {
+    return self._plugins.creationContext(local);
+}
+
+pub fn getLength(_: *const MimeTypeArray) u32 {
+    return MimeType.names.len;
+}
+
+pub fn getAtIndex(self: *const MimeTypeArray, index: u32) ?*MimeType {
+    if (index >= MimeType.names.len) return null;
+    return self._mimes[index];
+}
+
+pub fn getByName(self: *const MimeTypeArray, name: []const u8) ?*MimeType {
+    for (MimeType.names, 0..) |supported, i| {
+        if (std.mem.eql(u8, name, supported)) return self._mimes[i];
+    }
+    return null;
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(MimeTypeArray);
+    const Collection = @import("pdf_collection.zig").Binding(MimeTypeArray, MimeType, &MimeType.names);
+
+    pub const Meta = struct {
+        pub const name = "MimeTypeArray";
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+        pub const array_iterator = true;
+        pub const creation_context = MimeTypeArray.creationContext;
+    };
+
+    pub const length = bridge.accessor(MimeTypeArray.getLength, null, .{});
+    pub const @"[int]" = Collection.indexed;
+    pub const @"[str]" = Collection.named;
+    pub const item = Collection.item;
+    pub const namedItem = Collection.namedItem;
+};
