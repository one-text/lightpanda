+
+const std = @import("std");
+const lp = @import("lightpanda");
+const js = @import("../js/js.zig");
+const Frame = @import("../Frame.zig");
+const v8 = js.v8;
+
+// Ordinary web-page Chrome bindings, not an extension environment. Installed in
+// the page snapshot so each realm owns its objects before any page code runs.
+pub const callbacks = .{ loadTimes, csi, getDetails, getIsInstalled, installState, runningState, installedGetter, emptySetter, resultGetter };
+
+pub const Timing = struct {
+    epoch: u64,
+    boot: u64,
+    commit: f64 = 0,
+    dom_loaded: f64 = 0,
+    loaded: f64 = 0,
+    navigation_type: []const u8 = "Other",
+    transition: u8 = 15,
+    protocol: []const u8 = "",
+    alpn_negotiated: bool = false,
+
+    pub fn init() Timing {
+        return .{ .epoch = lp.datetime.microTimestamp(.real), .boot = lp.datetime.microTimestamp(.boot) };
+    }
+
+    pub fn elapsed(self: *const Timing) f64 {
+        return @as(f64, @floatFromInt(lp.datetime.microTimestamp(.boot) -| self.boot)) / 1000.0;
+    }
+
+    pub fn epochAt(self: *const Timing, boot: u64) f64 {
+        if (boot == 0) return 0;
+        return @as(f64, @floatFromInt(self.epoch + (boot -| self.boot))) / 1_000_000.0;
+    }
+
+    pub fn epochNow(self: *const Timing) f64 {
+        return self.epochAt(lp.datetime.microTimestamp(.boot));
+    }
+};
+
+pub fn install(isolate: *v8.Isolate, context: *const v8.Context, global: *const v8.Object) !void {
+    const chrome = v8.v8__Object__New(isolate).?;
+    try define(isolate, context, chrome, "loadTimes", @ptrCast(v8.v8__Function__New__DEFAULT(context, loadTimes).?));
+    try define(isolate, context, chrome, "csi", @ptrCast(v8.v8__Function__New__DEFAULT(context, csi).?));
+
+    const app_template = v8.v8__ObjectTemplate__New__DEFAULT(isolate).?;
+    v8.v8__ObjectTemplate__SetNativeDataProperty__DEFAULT2(app_template, @ptrCast(str(isolate, "isInstalled")), installedGetter, emptySetter);
+    const app = v8.v8__ObjectTemplate__NewInstance(app_template, context).?;
+    inline for (.{ .{ "getDetails", getDetails }, .{ "getIsInstalled", getIsInstalled }, .{ "installState", installState }, .{ "runningState", runningState } }) |entry| {
+        const template = v8.v8__FunctionTemplate__New__Config(isolate, &.{
+            .callback = entry[1],
+            .data = null,
+            .signature = null,
+            .length = 0,
+            .behavior = v8.kConstructorBehavior_Throw,
+            .side_effect_type = v8.kSideEffectType_HasSideEffect,
+        }).?;
+        const function = v8.v8__FunctionTemplate__GetFunction(template, context).?;
+        v8.v8__Function__SetName(function, str(isolate, entry[0]));
+        try define(isolate, context, app, entry[0], @ptrCast(function));
+    }
+    const install_state = v8.v8__Object__New(isolate).?;
+    inline for (.{ .{ "DISABLED", "disabled" }, .{ "INSTALLED", "installed" }, .{ "NOT_INSTALLED", "not_installed" } }) |entry| {
+        try define(isolate, context, install_state, entry[0], @ptrCast(str(isolate, entry[1])));
+    }
+    try define(isolate, context, app, "InstallState", @ptrCast(install_state));
+    const running_state = v8.v8__Object__New(isolate).?;
+    inline for (.{ .{ "CANNOT_RUN", "cannot_run" }, .{ "READY_TO_RUN", "ready_to_run" }, .{ "RUNNING", "running" } }) |entry| {
+        try define(isolate, context, running_state, entry[0], @ptrCast(str(isolate, entry[1])));
+    }
+    try define(isolate, context, app, "RunningState", @ptrCast(running_state));
+    try define(isolate, context, chrome, "app", @ptrCast(app));
+    try define(isolate, context, global, "chrome", @ptrCast(chrome));
+}
+
+fn str(isolate: *v8.Isolate, value: []const u8) *const v8.String {
+    return v8.v8__String__NewFromUtf8(isolate, value.ptr, v8.kNormal, @intCast(value.len)).?;
+}
+
+fn define(isolate: *v8.Isolate, context: *const v8.Context, object: *const v8.Object, name: []const u8, value: *const v8.Value) !void {
+    var result: v8.MaybeBool = undefined;
+    v8.v8__Object__DefineOwnProperty(object, context, @ptrCast(str(isolate, name)), value, v8.None, &result);
+    if (!result.has_value or !result.value) return error.ChromePropertyFailed;
+}
+
+fn respond(info: *const v8.FunctionCallbackInfo, value: *const v8.Value) void {
+    var result: v8.ReturnValue = undefined;
+    v8.v8__FunctionCallbackInfo__GetReturnValue(info, &result);
+    v8.v8__ReturnValue__Set(result, value);
+}
+
+fn invalidInvocation(info: *const v8.FunctionCallbackInfo, comptime signature: []const u8) void {
+    const isolate = v8.v8__FunctionCallbackInfo__GetIsolate(info).?;
+    _ = v8.v8__Isolate__ThrowException(isolate, v8.v8__Exception__TypeError(str(isolate, "Error in invocation of app." ++ signature ++ ": ")));
+}
+
+fn getDetails(info_: ?*const v8.FunctionCallbackInfo) callconv(.c) void {
+    const info = info_.?;
+    if (v8.v8__FunctionCallbackInfo__Length(info) != 0) return invalidInvocation(info, "getDetails()");
+    respond(info, v8.v8__Null(v8.v8__FunctionCallbackInfo__GetIsolate(info)).?);
+}
+
+fn getIsInstalled(info_: ?*const v8.FunctionCallbackInfo) callconv(.c) void {
+    const info = info_.?;
+    if (v8.v8__FunctionCallbackInfo__Length(info) != 0) return invalidInvocation(info, "getIsInstalled()");
+    respond(info, @ptrCast(v8.v8__Boolean__New(v8.v8__FunctionCallbackInfo__GetIsolate(info), false).?));
+}
+
+fn runningState(info_: ?*const v8.FunctionCallbackInfo) callconv(.c) void {
+    const info = info_.?;
+    if (v8.v8__FunctionCallbackInfo__Length(info) != 0) return invalidInvocation(info, "runningState()");
+    respond(info, @ptrCast(str(v8.v8__FunctionCallbackInfo__GetIsolate(info).?, "cannot_run")));
+}
+
+fn installState(info_: ?*const v8.FunctionCallbackInfo) callconv(.c) void {
+    const info = info_.?;
+    const count = v8.v8__FunctionCallbackInfo__Length(info);
+    if (count > 1) return invalidInvocation(info, "installState(optional function callback)");
+    if (count == 0) return;
+    const callback = v8.v8__FunctionCallbackInfo__INDEX(info, 0).?;
+    if (v8.v8__Value__IsNullOrUndefined(callback)) return;
+    if (!v8.v8__Value__IsFunction(callback)) return invalidInvocation(info, "installState(optional function callback)");
+    var caller: js.Caller = undefined;
+    if (!caller.initFromHandle(info)) return;
+    defer caller.deinit();
+    const local = &caller.local;
+    scheduleInstallState(local, @ptrCast(callback)) catch {
+        _ = v8.v8__Isolate__ThrowException(local.isolate.handle, local.isolate.createError("Unable to schedule app.installState"));
+    };
+}
+
+fn scheduleInstallState(local: *const js.Local, callback: *const v8.Function) !void {
+    const arena = try local.ctx.execution.getArena(.tiny, "chrome.app.installState");
+    errdefer arena.release();
+    const task = try arena.create(InstallTask);
+    task.* = .{ .ctx = local.ctx, .callback = try (js.Function{ .local = local, .handle = callback }).persist(), .arena = arena };
+    errdefer task.callback.deinit();
+    try local.ctx.scheduler.add(task, InstallTask.run, 0, .{ .name = "chrome.app.installState", .finalizer = InstallTask.finalize });
+}
+
+const InstallTask = struct {
+    ctx: *js.Context,
+    callback: js.Function.Global,
+    arena: *lp.Arena,
+
+    fn finalize(data: *anyopaque) void {
+        const self: *InstallTask = @ptrCast(@alignCast(data));
+        self.callback.deinit();
+        self.arena.release();
+    }
+
+    fn run(data: *anyopaque) !?u32 {
+        const self: *InstallTask = @ptrCast(@alignCast(data));
+        defer finalize(data);
+        var scope: js.Local.Scope = undefined;
+        self.ctx.localScope(&scope);
+        defer scope.deinit();
+        try self.callback.local(&scope.local).call(void, .{"not_installed"});
+        return null;
+    }
+};
+
+fn installedGetter(_: ?*const v8.Name, info_: ?*const v8.PropertyCallbackInfo) callconv(.c) void {
+    const info = info_.?;
+    var result: v8.ReturnValue = undefined;
+    v8.v8__PropertyCallbackInfo__GetReturnValue(info, &result);
+    v8.v8__ReturnValue__Set(result, @ptrCast(v8.v8__Boolean__New(v8.v8__PropertyCallbackInfo__GetIsolate(info), false)));
+}
+
+fn emptySetter(_: ?*const v8.Name, _: ?*const v8.Value, _: ?*const v8.PropertyCallbackInfo) callconv(.c) void {}
+
+// Result values live entirely in V8, so they remain readable after their frame
+// is removed or navigated. Native data properties match Chromium's no-op setter.
+fn resultObject(isolate: *v8.Isolate, context: *const v8.Context, values: anytype) !*const v8.Object {
+    const template = v8.v8__ObjectTemplate__New__DEFAULT(isolate).?;
+    const data = v8.v8__Object__New(isolate).?;
+    const fields = @typeInfo(@TypeOf(values)).@"struct".fields;
+    // V8 prepends native data properties when instantiating a template.
+    inline for (0..fields.len) |i| {
+        const field = fields[fields.len - 1 - i];
+        const value = @field(values, field.name);
+        const handle: *const v8.Value = switch (@TypeOf(value)) {
+            f64 => @ptrCast(v8.v8__Number__New(isolate, value).?),
+            bool => @ptrCast(v8.v8__Boolean__New(isolate, value).?),
+            []const u8 => @ptrCast(str(isolate, value)),
+            else => @compileError("Unsupported Chrome result field"),
+        };
+        try define(isolate, context, data, field.name, handle);
+        v8.v8__ObjectTemplate__SetNativeDataProperty__DEFAULT2(template, @ptrCast(str(isolate, field.name)), resultGetter, emptySetter);
+    }
+    const object = v8.v8__ObjectTemplate__NewInstance(template, context).?;
+    const ctx, _ = js.Context.fromIsolate(.{ .handle = isolate }) orelse return error.ChromeContextMissing;
+    const key: *const v8.Private = @ptrCast(v8.v8__Global__Get(&ctx.env.private_symbols.chrome_result.handle, isolate).?);
+    var result: v8.MaybeBool = undefined;
+    v8.v8__Object__SetPrivate(object, context, key, @ptrCast(data), &result);
+    if (!result.has_value or !result.value) return error.ChromePropertyFailed;
+    v8.v8__Object__SetPrototype(object, context, v8.v8__Object__GetPrototype(data), &result);
+    if (!result.has_value or !result.value) return error.ChromePrototypeFailed;
+    return object;
+}
+
+fn resultGetter(name: ?*const v8.Name, info_: ?*const v8.PropertyCallbackInfo) callconv(.c) void {
+    const info = info_.?;
+    const isolate = v8.v8__PropertyCallbackInfo__GetIsolate(info).?;
+    const context = v8.v8__Isolate__GetCurrentContext(isolate).?;
+    // Despite its name, the C binding returns info.Holder(), not the receiver.
+    // Reflect.get with a foreign receiver must still read this result's values.
+    const holder = v8.v8__PropertyCallbackInfo__This(info).?;
+    const ctx, _ = js.Context.fromIsolate(.{ .handle = isolate }) orelse return;
+    const key: *const v8.Private = @ptrCast(v8.v8__Global__Get(&ctx.env.private_symbols.chrome_result.handle, isolate).?);
+    const backing = v8.v8__Object__GetPrivate(holder, context, key) orelse return;
+    if (!v8.v8__Value__IsObject(backing)) return;
+    const data: *const v8.Object = @ptrCast(backing);
+    const value = v8.v8__Object__Get(data, context, @ptrCast(name)) orelse return;
+    var result: v8.ReturnValue = undefined;
+    v8.v8__PropertyCallbackInfo__GetReturnValue(info, &result);
+    v8.v8__ReturnValue__Set(result, value);
+}
+
+fn currentFrame(isolate: *v8.Isolate) ?*Frame {
+    const context = v8.v8__Isolate__GetCurrentContext(isolate) orelse return null;
+    const ctx: *js.Context = @ptrCast(@alignCast(v8.v8__Context__GetAlignedPointerFromEmbedderData(context, 1) orelse return null));
+    return switch (ctx.global) {
+        .frame => |frame| frame,
+        .worker => null,
+    };
+}
+
+fn csi(info_: ?*const v8.FunctionCallbackInfo) callconv(.c) void {
+    const info = info_.?;
+    const isolate = v8.v8__FunctionCallbackInfo__GetIsolate(info).?;
+    const frame = currentFrame(isolate) orelse return respond(info, v8.v8__Null(isolate).?);
+    const timing = &frame._chrome_timing;
+    const result = resultObject(isolate, v8.v8__Isolate__GetCurrentContext(isolate).?, .{
+        .startE = @floor(@as(f64, @floatFromInt(timing.epoch)) / 1000.0),
+        .onloadT = @floor(timing.dom_loaded * 1000.0),
+        .pageT = timing.elapsed(),
+        .tran = @as(f64, @floatFromInt(timing.transition)),
+    }) catch return;
+    respond(info, @ptrCast(result));
+}
+
+fn loadTimes(info_: ?*const v8.FunctionCallbackInfo) callconv(.c) void {
+    const info = info_.?;
+    const isolate = v8.v8__FunctionCallbackInfo__GetIsolate(info).?;
+    const frame = currentFrame(isolate) orelse return respond(info, v8.v8__Null(isolate).?);
+    const timing = &frame._chrome_timing;
+    const protocol = timing.protocol;
+    const multiplexed = std.mem.eql(u8, protocol, "h2") or std.mem.eql(u8, protocol, "h3");
+    const result = resultObject(isolate, v8.v8__Isolate__GetCurrentContext(isolate).?, .{
+        .requestTime = @as(f64, @floatFromInt(timing.epoch)) / 1_000_000.0,
+        .startLoadTime = @as(f64, @floatFromInt(timing.epoch)) / 1_000_000.0,
+        .commitLoadTime = timing.commit,
+        .finishDocumentLoadTime = timing.dom_loaded,
+        .finishLoadTime = timing.loaded,
+        .firstPaintTime = @as(f64, 0),
+        .firstPaintAfterLoadTime = @as(f64, 0),
+        .navigationType = timing.navigation_type,
+        .wasFetchedViaSpdy = multiplexed,
+        .wasNpnNegotiated = timing.alpn_negotiated,
+        .npnNegotiatedProtocol = if (timing.alpn_negotiated) protocol else @as([]const u8, ""),
+        .wasAlternateProtocolAvailable = false,
+        .connectionInfo = if (protocol.len != 0) protocol else @as([]const u8, "unknown"),
+    }) catch return;
+    respond(info, @ptrCast(result));
+}
diff --git a/src/network/HttpClient.zig b/src/network/HttpClient.zig
index b99e378..fcde7b6 100644
--- a/src/network/HttpClient.zig
