diff --git a/src/browser/webapi/Chrome.zig b/src/browser/webapi/Chrome.zig
new file mode 100644
index 0000000..d940de6
--- /dev/null
+++ b/src/browser/webapi/Chrome.zig
@@ -0,0 +1,282 @@
