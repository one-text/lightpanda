+// Separate native interfaces with shared query behavior, not JS inheritance.
+// This A18 Pro profile has no graphics resources, shaders or rendering backend.
+fn Context(comptime version: u2) type {
+    return struct {
+        const Self = @This();
+
+        _canvas: Owner,
+        _debug_info: ?*DebugRendererInfo = null,
+        _error: u32 = 0,
+
+        fn getCanvas(self: *const Self) Owner {
+            return self._canvas;
+        }
+
+        fn getDrawingBufferWidth(self: *const Self) u32 {
+            return switch (self._canvas) {
+                inline else => |canvas| canvas.getWidth(),
+            };
+        }
+
+        fn getDrawingBufferHeight(self: *const Self) u32 {
+            return switch (self._canvas) {
+                inline else => |canvas| canvas.getHeight(),
+            };
+        }
+
+        fn getParameter(self: *Self, pname: u32) ?Parameter {
+            return switch (pname) {
+                0x1F00 => .{ .string = "WebKit" },
+                0x1F01 => .{ .string = "WebKit WebGL" },
+                0x1F02 => .{ .string = if (version == 2) "WebGL 2.0 (OpenGL ES 3.0 Chromium)" else "WebGL 1.0 (OpenGL ES 2.0 Chromium)" },
+                0x8B8C => .{ .string = if (version == 2) "WebGL GLSL ES 3.00 (OpenGL ES GLSL ES 3.0 Chromium)" else "WebGL GLSL ES 1.0 (OpenGL ES GLSL ES 1.0 Chromium)" },
+                0x9245, 0x9246 => if (self._debug_info != null)
+                    .{ .string = if (pname == 0x9245) "Google Inc. (Apple)" else "ANGLE (Apple, ANGLE Metal Renderer: Apple A18 Pro, Unspecified Version)" }
+                else blk: {
+                    self.invalidEnum();
+                    break :blk null;
+                },
+                0x0D33, 0x851C, 0x84E8 => .{ .number = 16384 },
+                0x0D3A => .{ .int32 = .{ .values = &.{ 16384, 16384 } } },
+                0x8872, 0x8B4C => .{ .number = 16 },
+                0x8B4D => .{ .number = 32 },
+                0x8869 => .{ .number = 16 },
+                else => blk: {
+                    self.invalidEnum();
+                    break :blk null;
+                },
+            };
+        }
+
+        fn getShaderPrecisionFormat(self: *Self, shader_type: u32, precision_type: u32, exec: *js.Execution) !?*ShaderPrecisionFormat {
+            if (shader_type != 0x8B31 and shader_type != 0x8B30) {
+                self.invalidEnum();
+                return null;
+            }
+            // Synthetic half/full-float and 32-bit integer capabilities; not
+            // measurements from an A18 Pro. Both stages use the same table.
+            const format: ShaderPrecisionFormat = switch (precision_type) {
+                0x8DF0, 0x8DF1 => .{ ._range_min = 15, ._range_max = 15, ._precision = 10 },
+                0x8DF2 => .{ ._range_min = 127, ._range_max = 127, ._precision = 23 },
+                0x8DF3, 0x8DF4, 0x8DF5 => .{ ._range_min = 31, ._range_max = 30, ._precision = 0 },
+                else => {
+                    self.invalidEnum();
+                    return null;
+                },
+            };
+            return try exec._factory.create(format);
+        }
+
+        fn invalidEnum(self: *Self) void {
+            if (self._error == 0) self._error = 0x0500;
+        }
+
+        fn getError(self: *Self) u32 {
+            const err = self._error;
+            self._error = 0;
+            return err;
+        }
+
+        fn isContextLost(_: *const Self) bool {
+            return false;
+        }
+
+        fn getExtension(self: *Self, name: []const u8, exec: *js.Execution) !?*DebugRendererInfo {
+            if (!std.ascii.eqlIgnoreCase(name, "WEBGL_debug_renderer_info")) return null;
+            if (self._debug_info == null) {
+                self._debug_info = try exec._factory.create(DebugRendererInfo{});
+            }
+            return self._debug_info;
+        }
+
+        fn getSupportedExtensions(_: *const Self) []const []const u8 {
+            return &.{"WEBGL_debug_renderer_info"};
+        }
+
+        pub const JsApi = struct {
+            pub const bridge = js.Bridge(Self);
+            pub const Meta = struct {
+                pub const name = if (version == 2) "WebGL2RenderingContext" else "WebGLRenderingContext";
+                pub const prototype_chain = bridge.prototypeChain();
+                pub var class_id: bridge.ClassId = undefined;
+            };
+
+            pub const canvas = bridge.accessor(Self.getCanvas, null, .{});
+            pub const drawingBufferWidth = bridge.accessor(Self.getDrawingBufferWidth, null, .{});
+            pub const drawingBufferHeight = bridge.accessor(Self.getDrawingBufferHeight, null, .{});
+            pub const getParameter = bridge.function(Self.getParameter, .{});
+            pub const getShaderPrecisionFormat = bridge.function(Self.getShaderPrecisionFormat, .{});
+            pub const getExtension = bridge.function(Self.getExtension, .{});
