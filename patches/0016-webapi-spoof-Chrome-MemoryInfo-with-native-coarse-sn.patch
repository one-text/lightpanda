 const Factory = @import("../Factory.zig");
+const Page = @import("../Page.zig");
 const Scheduler = @import("../js/Scheduler.zig");
 
 const Event = @import("Event.zig");
@@ -37,7 +39,7 @@ const DEFAULT_RESOURCE_BUFFER_SIZE = 250;
 const BUFFER_FULL = "resourcetimingbufferfull";
 
 pub fn registerTypes() []const type {
-    return &.{ Performance, Entry, Mark, Measure, ResourceTiming, PerformanceTiming, PerformanceNavigation };
+    return &.{ Performance, Entry, Mark, Measure, ResourceTiming, PerformanceTiming, PerformanceNavigation, MemoryInfo };
 }
 
 const Performance = @This();
@@ -106,6 +108,10 @@ pub fn getTiming(self: *Performance) *PerformanceTiming {
     return &self._timing;
 }
 
+fn getMemory(self: *Performance) !*MemoryInfo {
+    return self._factory.create(MemoryInfo{ ._performance = self });
+}
+
 pub fn now(self: *const Performance) f64 {
     const current = highResTimestamp();
     const elapsed = current - self._time_origin;
@@ -752,11 +758,66 @@ pub const JsApi = struct {
     pub const getEntriesByName = bridge.function(Performance.getEntriesByName, .{});
     pub const timeOrigin = bridge.accessor(Performance.getTimeOrigin, null, .{});
     pub const timing = bridge.accessor(Performance.getTiming, null, .{ .exposed = .window });
+    pub const memory = bridge.accessor(Performance.getMemory, null, .{ .exposed = .window });
     pub const navigation = bridge.accessor(Performance.getNavigation, null, .{ .exposed = .window });
     pub const eventCounts = bridge.accessor(Performance.getEventCounts, null, .{ .exposed = .window });
     pub const onresourcetimingbufferfull = bridge.accessor(Performance.getOnResourceTimingBufferFull, Performance.setOnResourceTimingBufferFull, .{});
 };
 
+const MemoryInfo = struct {
+    _performance: *Performance,
+    _rc: lp.RC = .{},
+
+    pub fn acquireRef(self: *MemoryInfo) void {
+        self._rc.acquire();
+    }
+
+    pub fn releaseRef(self: *MemoryInfo, page: *Page) void {
+        self._rc.release(self, page);
+    }
+
+    pub fn deinit(self: *MemoryInfo, page: *Page) void {
+        page.factory.destroyStandalone(self);
+    }
+
+    pub fn creationContext(self: *const MemoryInfo, local: *const js.Local) *const js.v8.Context {
+        if (local.ctx.identity.identity_map.getPtr(@intFromPtr(self._performance))) |global| {
+            const wrapper = js.v8.v8__Global__Get(global, local.isolate.handle).?;
+            return js.v8.v8__Object__GetCreationContext(@ptrCast(wrapper)).?;
+        }
+        return local.handle;
+    }
+
+    // A fixed coarse Chrome snapshot, independent of host/container memory.
+    fn getTotalJSHeapSize(_: *const MemoryInfo) u64 {
+        return 10_000_000;
+    }
+
+    fn getUsedJSHeapSize(_: *const MemoryInfo) u64 {
+        return 10_000_000;
+    }
+
+    fn getJSHeapSizeLimit(_: *const MemoryInfo) u64 {
+        return 3_760_000_000;
+    }
+
+    pub const JsApi = struct {
+        pub const bridge = js.Bridge(MemoryInfo);
+
+        pub const Meta = struct {
+            pub const name = "MemoryInfo";
+            pub const no_interface_object = true;
+            pub const creation_context = MemoryInfo.creationContext;
+            pub const prototype_chain = bridge.prototypeChain();
+            pub var class_id: bridge.ClassId = undefined;
+        };
+
+        pub const totalJSHeapSize = bridge.accessor(getTotalJSHeapSize, null, .{});
+        pub const usedJSHeapSize = bridge.accessor(getUsedJSHeapSize, null, .{});
+        pub const jsHeapSizeLimit = bridge.accessor(getJSHeapSizeLimit, null, .{});
+    };
+};
+
 pub const Entry = struct {
     _duration: f64 = 0.0,
     _type: Type,
