From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: brennoflavio <contato@brennoflavio.com.br>
Date: Thu, 29 Oct 2026 23:34:46 -0300
Subject: [PATCH] http: gate full-version-list on Accept-CH

Move the high-entropy hint from unconditional baseline headers into the existing origin-scoped, session-owned Accept-CH pipeline. Retain full-version-list-only opt-ins, recompute generated headers across redirects and interception, and preserve existing trust, default-self policy and explicit header-source precedence. Keep the Chrome 155 macOS persona and JavaScript values unchanged. WebSocket handshakes lose the unconditional hint; WebSocket opt-in support remains out of scope.
---
 src/network/HttpClient.zig | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/src/network/HttpClient.zig b/src/network/HttpClient.zig
index c6a3a5a..4f9b59c 100644
--- a/src/network/HttpClient.zig
+++ b/src/network/HttpClient.zig
@@ -466,11 +466,10 @@ pub fn getLanguages(self: *const Client) []const []const u8 {
 }
 
 // Headers _all_ requests include.
-pub fn baselineHeaders(self: *const Client) [5]Transfer.RequestHeader {
+pub fn baselineHeaders(self: *const Client) [4]Transfer.RequestHeader {
     return .{
         .{ .name = "User-Agent", .value = self.getUserAgent() },
         .{ .name = "Sec-Ch-Ua", .value = lp.Config.HttpHeaders.sec_ch_ua, .source = .fixed },
-        .{ .name = "Sec-Ch-Ua-Full-Version-List", .value = lp.Config.HttpHeaders.sec_ch_ua_full_version_list, .source = .fixed },
         .{ .name = "Sec-Ch-Ua-Platform", .value = lp.Config.HttpHeaders.sec_ch_ua_platform, .source = .fixed },
         // Omitting Accept-Language triggers bot-protection on some CDNs
         // (Akamai) when Accept-Encoding is present.
@@ -1172,6 +1171,7 @@ fn pipeline(self: *Client, transfer: *Transfer, from: SubmitFrom) !void {
 }
 
 const RequestedHints = struct {
+    full_version_list: bool = false,
     device_memory: bool = false,
     architecture: bool = false,
     bitness: bool = false,
@@ -1188,7 +1188,7 @@ pub const ClientHints = struct {
     }
 
     fn update(self: *ClientHints, allocator: Allocator, origin: []const u8, requested: RequestedHints) !void {
-        if (!requested.device_memory and !requested.architecture and !requested.bitness) {
+        if (!requested.full_version_list and !requested.device_memory and !requested.architecture and !requested.bitness) {
             if (self.origins.fetchRemove(origin)) |removed| allocator.free(removed.key);
         } else if (self.origins.getPtr(origin)) |existing| {
             existing.* = requested;
@@ -1277,7 +1277,9 @@ const ClientHintList = struct {
         if (parser.rest.len == 0) return requested;
         while (true) {
             const hint = parser.token() orelse return null;
-            if (std.ascii.eqlIgnoreCase(hint, "device-memory")) {
+            if (std.ascii.eqlIgnoreCase(hint, "sec-ch-ua-full-version-list")) {
+                requested.full_version_list = true;
+            } else if (std.ascii.eqlIgnoreCase(hint, "device-memory")) {
                 requested.device_memory = true;
             } else if (std.ascii.eqlIgnoreCase(hint, "sec-ch-ua-arch")) {
                 requested.architecture = true;
@@ -1312,7 +1314,8 @@ fn setClientHintHeaders(transfer: *Transfer) !void {
     var i: usize = 0;
     while (i < transfer.req_headers.items.len) {
         const hdr = transfer.req_headers.items[i];
-        if (hdr.source == .user_agent and (std.ascii.eqlIgnoreCase(hdr.name, "device-memory") or
+        if (hdr.source == .user_agent and (std.ascii.eqlIgnoreCase(hdr.name, "sec-ch-ua-full-version-list") or
+            std.ascii.eqlIgnoreCase(hdr.name, "device-memory") or
             std.ascii.eqlIgnoreCase(hdr.name, "sec-ch-ua-arch") or
             std.ascii.eqlIgnoreCase(hdr.name, "sec-ch-ua-bitness")))
         {
@@ -1339,6 +1342,7 @@ fn setClientHintHeaders(transfer: *Transfer) !void {
     }
     const origin = try URL.getOrigin(transfer.arena.allocator(), transfer.req.url) orelse return;
     if (hints.origins.get(origin)) |requested| {
+        if (requested.full_version_list) try transfer.setHeader("Sec-CH-UA-Full-Version-List", lp.Config.HttpHeaders.sec_ch_ua_full_version_list, .{});
         if (requested.device_memory) try transfer.setHeader("Device-Memory", lp.Config.HttpHeaders.device_memory_header, .{});
         if (requested.architecture) try transfer.setHeader("Sec-CH-UA-Arch", lp.Config.HttpHeaders.sec_ch_ua_arch, .{});
         if (requested.bitness) try transfer.setHeader("Sec-CH-UA-Bitness", lp.Config.HttpHeaders.sec_ch_ua_bitness, .{});
