+pub fn setBatteryExposure(self: *const Env, ctx: *Context, v8_context: *const v8.Context, global_obj: *const v8.Object, secure: bool) void {
+    if (secure and ctx.battery_bindings == null) return;
+    if (!secure and ctx.battery_bindings != null) return;
+
+    const isolate = self.isolate.handle;
+    const names = &self.disabled_api_names;
+    const constructor = v8.v8__Object__Get(global_obj, v8_context, @ptrCast(names.get(isolate, "navigator"))) orelse return;
+    const prototype = v8.v8__Object__Get(@ptrCast(constructor), v8_context, @ptrCast(names.get(isolate, "prototype"))) orelse return;
+    const method_key = names.get(isolate, "get_battery");
+    const interface_key = names.get(isolate, "battery_manager");
+    var result: v8.MaybeBool = undefined;
+
+    if (secure) {
+        const bindings = &ctx.battery_bindings.?;
+        v8.v8__Object__DefineOwnProperty(@ptrCast(prototype), v8_context, @ptrCast(method_key), v8.v8__Global__Get(&bindings.method, isolate), v8.None, &result);
+        v8.v8__Object__DefineOwnProperty(global_obj, v8_context, @ptrCast(interface_key), v8.v8__Global__Get(&bindings.interface, isolate), v8.DontEnum, &result);
+        v8.v8__Global__Reset(&bindings.method);
+        v8.v8__Global__Reset(&bindings.interface);
+        ctx.battery_bindings = null;
+    } else {
+        const method = v8.v8__Object__Get(@ptrCast(prototype), v8_context, @ptrCast(method_key)) orelse return;
+        const interface = v8.v8__Object__Get(global_obj, v8_context, @ptrCast(interface_key)) orelse return;
+        ctx.battery_bindings = .{ .method = undefined, .interface = undefined };
+        v8.v8__Global__New(isolate, method, &ctx.battery_bindings.?.method);
+        v8.v8__Global__New(isolate, interface, &ctx.battery_bindings.?.interface);
+        v8.v8__Object__Delete(@ptrCast(prototype), v8_context, @ptrCast(method_key), &result);
+        v8.v8__Object__Delete(global_obj, v8_context, @ptrCast(interface_key), &result);
+    }
+}
+
 fn deletePrototypeMember(self: *const Env, v8_context: *const v8.Context, global_obj: *const v8.Object, comptime interface: []const u8, comptime member: []const u8) void {
     const isolate = self.isolate.handle;
     const names = &self.disabled_api_names;
@@ -875,6 +905,8 @@ const DisabledApiNames = struct {
