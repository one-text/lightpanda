+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+const std = @import("std");
+const js = @import("../js/js.zig");
+const Frame = @import("../Frame.zig");
+const Navigator = @import("Navigator.zig");
+const Event = @import("Event.zig");
+const EventTarget = @import("EventTarget.zig");
+const EventManagerBase = @import("../EventManagerBase.zig");
+
+const BatteryManager = @This();
+
+pub const Proto = EventTarget;
+
+_proto: *EventTarget,
+_navigator: *Navigator,
+_events: EventManagerBase,
+_handlers: [4]Handler = undefined,
+
+pub fn init(frame: *Frame, navigator: *Navigator) !*BatteryManager {
+    const self = try frame._factory.eventTarget(BatteryManager{
+        ._proto = undefined,
+        ._navigator = navigator,
+        ._events = EventManagerBase.init(frame.arena),
+    });
+    inline for (std.meta.tags(Kind), 0..) |kind, i| {
+        self._handlers[i] = .{ .battery = self, .kind = kind };
+    }
+    return self;
+}
+
+pub fn asEventTarget(self: *BatteryManager) *EventTarget {
+    return self._proto;
+}
+
+pub fn dispatch(self: *BatteryManager, event: *Event, exec: *js.Execution) !void {
+    event._target = self.asEventTarget();
+    event._dispatch_target = self.asEventTarget();
+    event._event_phase = .at_target;
+    defer {
+        event._event_phase = .none;
+        event._current_target = null;
+        event._dispatch_target = null;
+        event._stop_propagation = false;
+        event._stop_immediate_propagation = false;
+        event._in_passive_listener = false;
+    }
+    if (event._stop_propagation) return;
+    try self._events.dispatchDirect(exec.page.frame_arena, exec.js, self.asEventTarget(), event, null, exec.page, .{ .run_microtasks = false });
+}
+
+pub fn creationContext(self: *const BatteryManager, local: *const js.Local) *const js.v8.Context {
+    return self._navigator.creationContext(local);
+}
+
+// A plugged-in, fully charged MacBook Neo; never consult the host battery.
+fn getCharging(_: *const BatteryManager) bool {
+    return true;
+}
+
+fn getChargingTime(_: *const BatteryManager) f64 {
+    return 0;
+}
+
+fn getDischargingTime(_: *const BatteryManager) f64 {
+    return std.math.inf(f64);
+}
+
+fn getLevel(_: *const BatteryManager) f64 {
+    return 1;
+}
+
+const Kind = enum { chargingchange, chargingtimechange, dischargingtimechange, levelchange };
+
+// Register a stable native listener when the attribute first becomes non-null.
+// Replacing its callback keeps its position among addEventListener listeners.
+const Handler = struct {
+    battery: *BatteryManager,
+    kind: Kind,
+    callback: ?js.Object.Global = null,
+    listener: ?js.Function.Global = null,
+
+    fn set(self: *Handler, value: js.Value, exec: *js.Execution) !void {
+        const local = exec.js.local.?;
+        const callback = if (value.isObject())
+            try (js.Object{ .local = local, .handle = @ptrCast(value.handle) }).persist()
+        else
+            null;
+        errdefer if (callback) |cb| cb.release();
+
+        if (self.callback == null and callback != null) {
+            if (self.listener == null) {
+                self.listener = try local.newCallback(Handler.dispatch, self).persist();
+            }
+            _ = try self.battery._events.register(self.battery.asEventTarget(), @tagName(self.kind), .{
+                .function = self.listener.?.local(local),
+            }, .{});
+        } else if (self.callback != null and callback == null) {
+            self.battery._events.remove(self.battery.asEventTarget(), @tagName(self.kind), .{
+                .function = self.listener.?.local(local),
+            }, false);
+        }
+
+        if (self.callback) |old| old.release();
+        self.callback = callback;
+    }
+
+    fn dispatch(self: *Handler, event: *Event, exec: *js.Execution) !void {
+        const callback = self.callback orelse return;
+        const local = exec.js.local.?;
+        const object = callback.local(local);
+        if (!object.toValue().isFunction()) return local.typeError("The event handler is not callable");
+        const function = js.Function{ .local = local, .handle = @ptrCast(object.handle) };
+        const result = try function.callWithThisRethrow(js.Value, self.battery, .{event});
+        if (result.isBoolean() and result.isFalse()) {
+            event.preventDefault();
+        }
+    }
+};
+
+fn Binding(comptime kind: Kind) type {
+    return struct {
+        fn get(self: *const BatteryManager) ?js.Object.Global {
+            return self._handlers[@intFromEnum(kind)].callback;
+        }
+
+        fn set(self: *BatteryManager, value: js.Value, exec: *js.Execution) !void {
+            try self._handlers[@intFromEnum(kind)].set(value, exec);
+        }
+    };
+}
+
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(BatteryManager);
+
+    pub const Meta = struct {
+        pub const name = "BatteryManager";
+        pub const creation_context = BatteryManager.creationContext;
+        pub const prototype_chain = bridge.prototypeChain();
+        pub var class_id: bridge.ClassId = undefined;
+    };
+
+    pub const charging = bridge.accessor(getCharging, null, .{});
+    pub const chargingTime = bridge.accessor(getChargingTime, null, .{});
+    pub const dischargingTime = bridge.accessor(getDischargingTime, null, .{});
+    pub const level = bridge.accessor(getLevel, null, .{});
+    pub const onchargingchange = bridge.accessor(Binding(.chargingchange).get, Binding(.chargingchange).set, .{});
+    pub const onchargingtimechange = bridge.accessor(Binding(.chargingtimechange).get, Binding(.chargingtimechange).set, .{});
+    pub const ondischargingtimechange = bridge.accessor(Binding(.dischargingtimechange).get, Binding(.dischargingtimechange).set, .{});
+    pub const onlevelchange = bridge.accessor(Binding(.levelchange).get, Binding(.levelchange).set, .{});
+};
