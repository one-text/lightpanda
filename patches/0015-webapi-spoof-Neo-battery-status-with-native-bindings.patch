diff --git a/src/browser/tests/navigator/navigator.html b/src/browser/tests/navigator/navigator.html
index f5daee5..a815a99 100644
--- a/src/browser/tests/navigator/navigator.html
+++ b/src/browser/tests/navigator/navigator.html
@@ -163,10 +163,67 @@
 </script>
 
 <script id=getBattery type=module>
-  // Like Firefox, we don't expose navigator.getBattery. Sites already
-  // have to handle it being undefined, so this is a real-browser shape
-  // rather than a stub that always rejects.
-  testing.expectEqual('undefined', typeof navigator.getBattery);
+  testing.expectEqual('function', typeof navigator.getBattery);
+  const state = await testing.async();
+  let reentrant;
+  Object.defineProperty(BatteryManager.prototype, "then", {
+    configurable: true,
+    get() { reentrant = navigator.getBattery(); }
+  });
+  let checkpoint = false;
+  Promise.resolve().then(() => { checkpoint = true; });
+  const promise = navigator.getBattery();
+  testing.expectFalse(checkpoint);
+  delete BatteryManager.prototype.then;
+  testing.expectEqual(promise, reentrant);
+  testing.expectEqual(promise, navigator.getBattery());
+  state.resolve(await promise);
+  await state.done((battery) => {
+    testing.expectTrue(battery instanceof BatteryManager);
+    testing.expectTrue(battery instanceof EventTarget);
+    testing.expectEqual(true, battery.charging);
+    testing.expectEqual(0, battery.chargingTime);
+    testing.expectEqual(Infinity, battery.dischargingTime);
+    testing.expectEqual(1, battery.level);
+    const order = [];
+    const listener = () => order.push("listener");
+    battery.addEventListener("levelchange", listener);
+    battery.onlevelchange = () => order.push("old");
+    battery.onlevelchange = function(event) {
+      testing.expectEqual(battery, this);
+      testing.expectEqual(battery, event.target);
+      order.push("handler");
+      return false;
+    };
+    testing.expectFalse(battery.dispatchEvent(new Event("levelchange", {cancelable: true})));
+    testing.expectEqual(["listener", "handler"], order);
+    battery.onlevelchange = null;
+    order.length = 0;
+    testing.expectTrue(battery.dispatchEvent(new Event("levelchange")));
+    testing.expectEqual(["listener"], order);
+    battery.removeEventListener("levelchange", listener);
+    const event = new Event("levelchange");
+    let nestedError;
+    battery.onlevelchange = (active) => {
+      testing.expectEqual(Event.AT_TARGET, active.eventPhase);
+      try {
+        battery.dispatchEvent(active);
+      } catch (error) {
+        nestedError = error.name;
+      }
+      active.stopImmediatePropagation();
+    };
+    battery.dispatchEvent(event);
+    testing.expectEqual("InvalidStateError", nestedError);
+    testing.expectEqual(Event.NONE, event.eventPhase);
+    testing.expectEqual(null, event.currentTarget);
+    testing.expectFalse(event.cancelBubble);
+    let reused = false;
+    battery.onlevelchange = () => { reused = true; };
+    battery.dispatchEvent(event);
+    testing.expectTrue(reused);
+    battery.onlevelchange = null;
+  });
 </script>
 
 
