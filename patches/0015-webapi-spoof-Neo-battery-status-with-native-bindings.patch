+    battery_manager: v8.Eternal,
 
     fn init(isolate: *v8.Isolate) DisabledApiNames {
         var self: DisabledApiNames = undefined;
@@ -884,6 +916,8 @@ const DisabledApiNames = struct {
         intern(isolate, &self.prototype, "prototype");
         intern(isolate, &self.service_worker, "serviceWorker");
         intern(isolate, &self.caches, "caches");
+        intern(isolate, &self.get_battery, "getBattery");
+        intern(isolate, &self.battery_manager, "BatteryManager");
         return self;
     }
 
@@ -902,15 +936,18 @@ const PrivateSymbols = struct {
     const Private = @import("Private.zig");
 
     child_nodes: Private,
+    get_battery: Private,
 
     fn init(isolate: *v8.Isolate) PrivateSymbols {
         return .{
             .child_nodes = Private.init(isolate, "child_nodes"),
+            .get_battery = Private.init(isolate, "get_battery"),
         };
     }
 
     fn deinit(self: *PrivateSymbols) void {
         self.child_nodes.deinit();
+        self.get_battery.deinit();
     }
 };
 
